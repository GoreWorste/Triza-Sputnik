<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="component"
		label="COM_CWHIRE_COMPONENT_LABEL_MAINTAB"
		description="COM_CWHIRE_COMPONENT_DESC_MAINTAB"
		addfieldpath="administrator/components/com_cwhire/models/fields"
	>
		<field name="contract-forms"
		type="repeatable"
		icon="list"
		description="COM_CWHIRE_PARAMS_DESC_CONTRACTFORMS"
		label="COM_CWHIRE_PARAMS_LABEL_CONTRACTFORMS"
		default=''>
			<fieldset hidden="true" name="contractforms" repeat="true">
				<field name="title"
					label="COM_CWHIRE_PARAMS_LABEL_TITLE"
					description="COM_CWHIRE_PARAMS_DESC_CONTRACTFORMS_TITLE"
					size="30"
					type="text" />
				<field name="notes"
					label="COM_CWHIRE_PARAMS_LABEL_NOTES"
					description="COM_CWHIRE_PARAMS_DESC_NOTES"
					size="30"
					type="textarea" />
			</fieldset>
		</field>

		<field name="requirepp" type="radio" default="0" label="COM_CWHIRE_PARAMS_LABEL_REQUIRE_PP" description="COM_CWHIRE_PARAMS_DESC_REQUIRE_PP"
		class="btn-group btn-group-yesno radio">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
		<field name="documentpp" type="sql" default="" label="COM_CWHIRE_PARAMS_LABEL_PRIVACY_POLICY" description="COM_CWHIRE_PARAMS_DESC_PRIVACY_POLICY" query="SELECT id, title FROM #__content" key_field="id" value_field="title" showon="requirepp:1">
			<option value="">- Select a document -</option>
		</field>
		<field name="show_reference" type="radio" default="0" label="COM_CWHIRE_PARAMS_LABEL_SHOW_REFERENCE" description="COM_CWHIRE_PARAMS_DESC_SHOW_REFERENCE"
		class="btn-group btn-group-yesno radio">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
		<field name="usecss" type="radio" default="1" label="COM_CWHIRE_PARAMS_LABEL_USECSS" description="COM_CWHIRE_PARAMS_DESC_USECSS"
		class="btn-group btn-group-yesno radio">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>

		<field type="spacer" name="listoptions_spacer" label="COM_CWHIRE_PARAMS_LISTOPTIONS_LABEL" description="" />

	<field name="list_hidedesc" type="radio" default="0" label="COM_CWHIRE_PARAMS_HIDEDESC_LABEL" description="COM_CWHIRE_PARAMS_HIDEDESC_DESC"
	class="btn-group btn-group-yesno radio">
		<option value="1">JYES</option>
		<option value="0">JNO</option>
	</field>

	<field name="char_limit" type="text" default="0" showon="list_hidedesc:0" label="COM_CWHIRE_PARAMS_CHARLIMIT_LABEL" description="COM_CWHIRE_PARAMS_CHARLIMIT_DESC" />

		<field type="spacer" name="updateid_spacer" label="COM_CWHIRE_PARAMS_UPDATEID_LABEL" description="" />

		<field name="updateid" type="text" default="" label="COM_CWHIRE_UPDATEID" description="COM_CWHIRE_DESC_UPDATEID" />
		<!-- <field name="attachment-types" type="text" default="pdf, doc, docx, txt, jpg, png, gif" label="COM_CWHIRE_PARAMS_LABEL_ALLOWED_FILETYPES" description="Sender address for the application form" /> -->
		<!-- <field name="fbpagetoken" type="hidden" default="" /> -->
	</fieldset>
	<fieldset name="email"
		label="Mail settings"
		description="Mail settings"
	>
		<field name="sender" type="email" default="" label="COM_CWHIRE_PARAMS_LABEL_SENDER" description="COM_CWHIRE_PARAMS_DESC_SENDER" />
		<field name="sendername" type="text" default="" label="COM_CWHIRE_PARAMS_LABEL_SENDER_NAME" description="COM_CWHIRE_PARAMS_DESC_SENDER_NAME" />
		<field name="recipient" type="email" default="" label="COM_CWHIRE_PARAMS_LABEL_RECIPIENT" description="COM_CWHIRE_PARAMS_DESC_RECIPIENT" />
		<field name="attachment-types" type="Mimetypes" default="pdf, doc, docx, txt, jpg, png, gif" class="inputbox span6" label="COM_CWHIRE_PARAMS_LABEL_ALLOWED_FILETYPES" multiple="multiple" description="COM_CWHIRE_PARAMS_DESC_ALLOWED_FILETYPES" />

		<field name="send_copy" type="radio" default="0" label="COM_CWHIRE_PARAMS_LABEL_SENDCOPY" description="COM_CWHIRE_PARAMS_LABEL_SENDCOPY_DESC"
		class="btn-group btn-group-yesno radio">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>

		<!-- <field type="spacer" name="captchaspacer" label="COM_CWHIRE_PARAMS_MAIL_LABEL_CAPTCHA_SPACER" /> -->

		<field name="use_captcha" type="radio" default="0" label="COM_CWHIRE_PARAMS_LABEL_USE_CAPTCHA" description="COM_CWHIRE_PARAMS_LABEL_USE_CAPTCHA_DESC"
		class="btn-group btn-group-yesno radio">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>

		<!-- <field type="spacer" name="sslspacer" label="COM_CWHIRE_PARAMS_MAIL_LABEL_SSL_SPACER" /> -->

		<field name="allcerts" type="radio" default="0" class="btn-group btn-group-yesno radio" label="COM_CWHIRE_PARAMS_LABEL_ALL_SSL" description="COM_CWHIRE_PARAMS_DESC_ALL_SSL">
			<option value="1">JYES</option>
			<option value="0">JNO</option>
		</field>
	</fieldset>

	<fieldset name="application_form"
		label="COM_CWHIRE_PARAMS_MAILFIELDS_GROUP"
		description="COM_CWHIRE_PARAMS_MAILFIELDS_GROUP_DESC" addfieldpath="administrator/components/com_cwhire/models/forms">

		<field type="spacer" name="select_fields_spacer" label="COM_CWHIRE_PARAMS_MAILFIELDS_LABEL" description="" />

		<field name="appliform_title" type="radio" default="1" label="COM_CWHIRE_PARAMS_USEFIELD_TITLE" description=""
		class="btn-group btn-group-yesno radio">
		<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
		<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
		<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>

		<field name="appliform_fname" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_FNAME" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_sname" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_SNAME" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_street" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_STREET" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_country" type="radio" default="1" label="COM_CWHIRE_PARAMS_USEFIELD_COUNTRY" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_plz" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_ZIP" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_address" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_CITY" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_phone" type="radio" default="1" label="COM_CWHIRE_PARAMS_USEFIELD_PHONE" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_mail" type="radio" default="2" label="COM_CWHIRE_PARAMS_USEFIELD_EMAIL" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option>
		</field>
		<field name="appliform_attachments" type="radio" default="1" label="COM_CWHIRE_PARAMS_USE_ATTACHMENTS" description="" class="btn-group btn-group-yesno radio">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<!-- <option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option> -->
		</field>
		<field name="appliform_atype" type="radio" default="3" label="COM_CWHIRE_PARAMS_ATTACHMENT_TYPE" description="" class="btn-group btn-group-yesno radio" showon="appliform_attachments:1">
			<option value="1">COM_CWHIRE_PARAMS_ATTACHMENT_UPLOAD</option>
			<option value="2">COM_CWHIRE_PARAMS_ATTACHMENT_LINK</option>
			<option value="3">COM_CWHIRE_PARAMS_ATTACHMENT_BOTH</option>
		</field>
		<field name="appliform_vita" type="radio" default="1" label="COM_CWHIRE_PARAMS_USEFIELD_VITA" description="" class="btn-group btn-group-yesno radio" showon="appliform_attachments:1">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<!-- <option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option> -->
		</field>
		<field name="appliform_testi" type="radio" default="1" label="COM_CWHIRE_PARAMS_USEFIELD_TESTIMONIAL" description="" class="btn-group btn-group-yesno radio" showon="appliform_attachments:1">
			<option value="0">COM_CWHIRE_PARAMS_USEFIELD_HIDE</option>
			<option value="1">COM_CWHIRE_PARAMS_USEFIELD_USE</option>
			<!-- <option value="2">COM_CWHIRE_PARAMS_USEFIELD_REQUIRED</option> -->
		</field>

		<field name="use_custom" type="radio" default="0" label="COM_CWHIRE_PARAMS_USECUSTOM" description="COM_CWHIRE_PARAMS_USECUSTOM_DESC" class="btn-group btn-group-yesno radio">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>

		<field type="spacer" name="custom_fields_spacer" label="COM_CWHIRE_PARAMS_CUSTOMFIELDS_SPACER" description="" showon="use_custom:1" />

		<field name="custom_fields" type="subform" formsource="administrator/components/com_cwhire/models/forms/customfields.xml" min="1" max="100" multiple="true" layout="joomla.form.field.subform.repeatable-table" groupByFieldset="false" showon="use_custom:1" label="COM_CWHIRE_PARAMS_CUSTOMFIELDS_ADD" description="COM_CWHIRE_PARAMS_CUSTOMFIELDS_ADD_DESC" />
	</fieldset>
	<fieldset name="permissions"
		description="JCONFIG_PERMISSIONS_DESC"
		label="JCONFIG_PERMISSIONS_LABEL"
	>

		<field
            name="rules"
            type="rules"
			component="com_cwhire"
            class="inputbox"
			filter="rules"
			validate="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			section="component" />
	</fieldset>

</config>
