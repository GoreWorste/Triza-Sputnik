<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields>
      <fieldset class="headset" name="CustomFields" label="Add custom fields" description="Note: Custom fields can not be translated!">
        <field
          class="inputbox validate-fieldname"
          default=""
          description="A unique name for the field. Only letters are allowed. No special characters or spaces!"
          label="Field Name"
          name="fieldname"
          required="false"
          size="200"
          type="text"
          validate="fieldname"
          filter="STRING"
        />
        <field
          class="inputbox validate-title"
          default=""
          description="A human readable field label."
          label="Title"
          name="title"
          required="false"
          size="200"
          type="text"
          validate="title"
        />
        <!-- <field name="use_field" type="radio" default="0" label="COM_CWHIRE_PARAMS_USEFIELD" description="COM_CWHIRE_PARAMS_USEFIELD_DESC" class="btn-group btn-group-yesno radio">
          <option class="btn" value="0">JNO</option>
          <option class="btn success" value="1">JYES</option>
        </field> -->
        <field name="use_field" type="checkbox" label="COM_CWHIRE_PARAMS_USEFIELD" description="COM_CWHIRE_PARAMS_USEFIELD_DESC" value="1" default="0" />
        <field name="must_field" type="checkbox" label="COM_CWHIRE_PARAMS_MUSTFIELD" description="COM_CWHIRE_PARAMS_MUSTFIELD_DESC" value="1" default="0" />
      </fieldset>
    </fields>
</form>
