/**ABDB**/CREATE TABLE `#__cwhire_` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `jobcategory` int(11) unsigned NOT NULL,
  `refname` varchar(255) NOT NULL,
  `title` varchar(255) NOT NULL,
  `location` varchar(255) NOT NULL,
  `contract` varchar(255) NOT NULL,
  `start_date` date NOT NULL,
  `image` varchar(255) NOT NULL,
  `shortdesc` text NOT NULL,
  `description` text NOT NULL,
  `tasks` text NOT NULL,
  `profile` text NOT NULL,
  `perspective` text NOT NULL,
  `contactinfo` text NOT NULL,
  `homepage` tinyint(1) NOT NULL DEFAULT '0',
  `onfacebook` tinyint(1) NOT NULL DEFAULT '0',
  `facebook_id` varchar(255) NOT NULL,
  `facebook_text` text NOT NULL,
  `facebook_image` varchar(255) NOT NULL,
  `state` tinyint(1) NOT NULL DEFAULT '1',
  `ordering` int(11) NOT NULL,
  `language` varchar(7) NOT NULL DEFAULT '*',
  `checked_out` int(11) NOT NULL,
  `checked_out_time` datetime NOT NULL DEFAULT '1000-01-01 00:00:00',
  `created_by` int(11) NOT NULL,
  `created` datetime NOT NULL,
  PRIMARY KEY (`id`),
  KEY `jobcategory` (`jobcategory`),
  CONSTRAINT `#__cwhire__ibfk_1` FOREIGN KEY (`jobcategory`) REFERENCES `#__cwhire_categories` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=599 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('1', '1', 'Специалист по корпоративной коммуникации', 'Специалист по корпоративной коммуникации', 'Зеленоград', '0', '2018-08-03', '', 'Job offer as Специалист по корпоративной коммуникации in Зеленоград for 100000', '<p>Компания \"Компания\"</p>', '<p>Опыт от 1-2 лет в планировании практической связи и разработке ключевых сообщений; • Понимание использования коммуникации как стратегического инструмента для достижения бизнес целей; • Опыт использования соответствующих инструментов, приложений и каналов. Базовые навыки верстки. • Знание инструментов Microsoft Office (PPT, Word&amp;Excel); • Свободное владение английским и русским языками (письменно и устно); • Проведение тренингов по связи для лидеров подразделений; • Способность интерпретировать сложные бизнес-направления и решения и преподносить их простыми словами; • Способность сочетать стратегическую и оперативную работу; • Понимание потребностей аудитории/целевых групп; • Умение работать самостоятельно и активно искать информацию и быть в курсе того, что происходит в организации; • Прирожденный коммуникатор; хорошая устная и письменная речь, способность изъясняться простым языком, понятным для неподготовленного слушателя; • Построение прочных и доверительных отношений как с руководителями, так и с коллегами; • Сильные межличностные качества, навык влияния на людей; • Разделять культуру и ценности Компании; • Заинтересованность в ассортименте мебели для дома и понимание повседневной жизни людей; • Хорошее общее знание Компании является преимуществом; • Понимание \"силы\" слова и руководства через коммуникацию; • Заинтересованность в коммуникационных тенденциях и их применении; • Клиентоориентированность; • Опыт выступления перед публикой.</p>', '<p>• Обеспечение эффективной двусторонней связи всех сотрудников Компании; • Вы будете являться частью команды по управлению сайтом, вносить вклад в план развития местного бизнеса; • Обеспечение менеджеров, руководителей групп и сотрудников средствами связи и информацией по внесенным изменениям. Работа по развитию коммуникационной компетенции и компетенции по управлению изменениями. • Планирование, координирование, производство и слежение за передачей связи по местному Календарю и Плану Связи; • Убедиться, что все товары представлены на сайте; • 20% времени будет уходить на разработку проектов местной связи и ее передачи; • Участие в создании местного плана действий на уровне подразделения; • Обеспечение эффективной информационной передачи со свободными каналами связи в подразделении (например, ТВ, местные информационные бюллетени, плакаты и доски объявлений); • Активное участие в местных, региональных и национальных сетях и развитие отношений между другими местными организациями; • Уважать и делиться культурой и ценностями компании, а также стараться отразить это в материалах связи; • Распространение ценностей компании и создание открытого и доброжелательного климат внутри сегмента.</p>', '<p>В подразделение крупной корпорации требуется специалист корпоративной коммуникации, способный выполнять роль \"рассказчика\" внутри компании, обеспечивать связь и общение между отделами и сотрудниками разного звена. Мы рады принять в дружный коллектив энергичного, доброжелательного и готового к работе с людьми специалиста. График работы: 5/2 с 9 до 18 (возможен ненормированный рабочий день) Заработная плата от 100 000 рублей - обсуждается индивидуально Место работы: Есипово (Солнечногорский район)</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '1', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:07:05'),
('2', '1', 'Менеджер по развитию бизнеса', 'Менеджер по развитию бизнеса', 'Зеленоград', '0', '1970-01-01', '', 'Job offer as Менеджер по развитию бизнеса in  for 0', 'от 70 000 рублей', 'Образование: высшее - электронная техника, электроника, электротехника\r\nОбязателен опыт работы в активных продажах (либо снабжении) радиоэлектронных или электротехнических компаний сегмента b2b, а также самостоятельного поиска и привлечения клиентов не менее 3х лет\r\nОбязательно знание электронных (электротехнических) компонентов, рынка ЭК.\r\nОбязательны знания технологий и принципов продаж.\r\nЗнание языков: приветствуется\r\nПК: Офисный пакет Microsoft, 1С торговля, эл почта \r\n\r\n\r\nЛичностные качества:\r\n• Активная жизненная позиция, умение работать на результат, высокая степень самомотивации, энергичность, умение находить решение в сложных ситуациях \r\n• Ответственность, честность. \r\n• Высокоразвитые навыки общения, умение налаживать и поддерживать конструктивные отношения, коммуникабельность, грамотная речь\r\n• Стремление к профессиональному росту.', 'Основные задачи:\r\nАктивная системная работа над развитием бизнеса в краткосрочной (квартал), среднесрочной (до к.г.) и долгосрочной (3-5 лет) перспективах развития по всему спектру продукции компании у ключевых игроков фокусных сегментов рынка, выполнение годового плана развития и продаж\r\n1. Развитие и увеличение объемов продаж широкого спектра электронных компонентов и решений (групп продуктов) предприятиям-изготовителям электронного и электротехнического промышленного оборудования, приборов и др. технически сложной продукции, согласно установленным планам.\r\n2. Активный поиск, сбор и анализ информации о клиентах, формирование стратегии работы с ними. Активная работа, поиск и реализация точек роста бизнеса, достижение коммерческого результата, используя все ресурсы фирмы:\r\n• Взаимодействие с отделом маркетинга, поиск целевых клиентов для продвижения поставляемой продукции, совместное ведение проектов по внедрению решений в существующие и новые разработки клиентов.\r\n• Сбор информации из открытых источников, мониторинг существующей клиентской базы\r\n• Подготовка коммерческих предложений, ведение переговоров, договорная работа, заключение сделок и их отслеживание.\r\n• Планирование закупок ЭК, контроль размещения и отслеживания заказов;\r\n• Организация отгрузок клиентам, контроль баланса платежей и дебиторской задолженности, корректное (безошибочное) ведение баз данных. \r\n3. Взаимодействие с менеджерами по работе с клиентами и другими отделами компании Ежемесячные и ежеквартальные отчеты о проделанной работе \r\n4. Постоянное изучение линеек и ресурсов фирмы, самообразование.', 'Заработная плата: на время испытательного срока оклад 60000-80000, после испытательного срока 70000-90000 плюс % от валовой прибыли по сделкам и годовая премия за выполнение плана продаж\r\nИспытательный срок: 3 месяца\r\nГрафик работы: 5/2 с 9 до 18 с перерывом на обед (гибкий график)\r\nСоц. льготы: бесплатное питание, оплата бензина\r\nОформление по ТК РФ по бессрочному договору\r\nКомандировки: 2-3 посещения клиентов в неделю (Центральный регион)', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '2', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:40:52'),
('3', '1', 'Менеджер по развитию продукта', 'Менеджер по развитию продукта', 'Зеленоград', '0', '1970-01-01', '', 'Job offer as Менеджер по развитию продукта in Зеленоград for 0', '<p>от 100 000 рублей</p>', '<p>Требования к кандидату: • Минимум 3 года работы в полноценном продуктовом маркетинге, или менеджером по развитию бизнеса в области микроэлектроники и электронных компонентов. • Способность сделать убедительную презентацию и «защитить» свой проект / предложение у руководства. • Знание и понимание основ финансового планирования, систем управления проектами. • Сильные коммуникативные навыки, включая опыт ведение презентаций перед большой аудиторией • Опыт в управлении конфликтами как внутри организации, так и снаружи. • Опыт работы в матричной системе управления и способность организовать совместную работу межфункциональных команд для достижения максимального результата • Знание рынка радиоэлектронных компонентов • Готовность к командировкам. • Высшее образование в области электроники / микроэлектроники. Дополнительно – маркетинг – приветствуется. • Русский язык – свободный, Английский - разговорный</p>', '<p>Обязанности: • Проактивный поиск и анализ трендов на рынке цифровых микросхем и микросхем смешанных сигналов. • Посещение клиентов для понимания их требований, развитие отношений с ключевыми клиентами и партнерами, развитие отношений на всех уровнях внутри их организаций • Анализ позиционирования конкурентов • Поиск и развитие новых областей применения для продуктов • Перевод требований рынка в ценные активы для наших продуктов и определение глобальной стратегии по продуктовому портфелю, создание дорожной карты • Ответственность за объем продаж и прибыльность каждого продукта и продуктовой линейки в целом. • Определение и создание нового продукта, запуск и вывод продуктов на рынок • Координация работы R&amp;D и производства, выступая в роли их заказчика. • Планирование и реализация полноценной стратегии выхода на рынок, включая позиционирование, ценообразование, проникновение на рынок и маркетинговые коммуникации. • Создание и развитие полного набора инструментов для активного продвижения продуктов на рынке • Прогнозирование спроса продукции</p>', '<p>Условия: • Трудоустройство в соответствии с ТК. • Заработная плата: от 100 тыс. руб. • Особые условия в индивидуальном порядке</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '3', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:44:05'),
('4', '1', 'Менеджер отдела качества (система менеджмента качества)', 'Менеджер отдела качества (система менеджмента качества)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 45 000</p>', '<p>Образование: Высшее Опыт работы от 1 года в одной из областей: сертификация продукции на соответствие ТР ТС, контроль качества продукции, система менеджмента качества, технология производства продукции. Знание английского языка на уровне Intermediate Наличие водительских прав и личного авто (как плюс).</p>', '<p>1) Участие в подготовке сертификации продукции на соответствие ТР ТС. 2) Управление документацией СМК в электронной сети организации. 3) Участие в работе по управлению несоответствующей продукцией. 4) Ознакомление сотрудников с документами СМК и изменениями к ним. 5) Проведение внутренних аудитов, оформление записей по проведению внутренних аудитов и рассылка их в подразделения. 6) Подготовка Планов мероприятий по выявленным замечаниям внешних аудитов (органов по сертификации, потребителей). 7) Участие в проведении рекламационной работе с зарубежными поставщиками.</p>', '<p>Бесплатный обед, корпоративные праздники, оформление по ТК, оплачиваемый отпуск, спортивная секция по волейболу;</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '4', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:45:34'),
('5', '18', 'Начальник отдела закупок и логистики', 'Начальник отдела закупок и логистики', 'Зеленоград', '0', '1970-01-01', '', '', '<p>80000</p>', '<p>1. Высшее образование (техническое (как плюс) 2. Знания Таможенного кодекса, внутренних и международных грузоперевозок, кодов ТН ВЭД 3. Опыт работы в 1с,(знание на уровне «Продвинутый пользователь» (как плюс) 4. Управленческий опыт от 5 лет 5. Уверенный пользователь ПК, работа с большим объемом информации, внимательность, общительность, аналитические способности, стратегическое мышление, умение налаживать отношения с руководством, опыт ведения переговоров. 6. Знание элементной базы, электронных приборов, особенностей работы и требований таможни при таможенной очистке данных позиций (как плюс) 7. Практический опыт работы в отделе логистики и закупок от 3 лет в качестве специалиста ВЭД или таможенного брокера или выполнение аналогичных обязанностей (обязательно), 8. Глубокое понимание процессов и схем работы отдела с учетом специфики компании (дистрибьюция микроэлектронных компонентов) 9. Анг.язык на уровне Intermediate</p>', '<p>1.совмещение должности руководителя с должностью старшего специалиста ВЭД (сейчас есть 1 специалист,будет разделение обязанностей на 2 человек): 1.Часто задаваемые вопросы от менеджеров по специфике работы с определенными позициями (ежедневно) 2.Корректировка на предмет сертификации, EAC, дозаполнение заявок, визирование заявок в 1С (ежедневно) 3.Проверка и правка кодов, справочники в 1с: 4.Подготовка документов для таможенного оформления через брокеров, включая документы с описанием качеств продукции, условий отгрузки, постановки на оплату, создание инвойсов: • автоматическая выгрузка из 1с) плюс в ручную описанием качеств продукции, условий отгрузки, постановки • создание и печать документов в ручную (авиапочта) , последущая регистрация в 1с 8.Отправка посылок (рекламация, брак) 9. Описание каждой технических характеристик каждой позиции для таможни в файле Word для оптимизации расходов на таможню 2.замещение сотрудника по направлению: Документооборот и регистрация процесса закупок и логистики (на время болезни и отпуска): работа с заявками, отгрузками, контроль оплат, приход товара в 1С и внутренней базе, логистика и транспортное обслуживание по наработанным схемам 3. Единая управленческая аналитика, отчетность по закупкам и логистике для руководства, разработка новых схем логистики (3% от всей работы) 4. Стратегическая координация работы отдела с учетом срочных дел (5% от всей работы) 5. Лидер проекта по автоматизации части процессов отдела в 1С</p>', '<p>Штат Отдела закупок и логистики: 5 человек, где 2 специалиста по направлениям + 2 водителя и 1 курьер Совокупный доход: оклад плюс ежеквартальная премия плюс соц. пакет: обеды,мед.страховка в Детство Плюс,баскетбол.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '5', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:47:02'),
('7', '14', 'Менеджер по продажам (приводной техники)', 'Менеджер по продажам (приводной техники)', 'Санкт-Петербург', '0', '1970-01-01', '', '', '<p>40000-45000</p>', '<p>- опыт работы от года по продаже промышленного оборудования в секторе В2В;</p>\r\n<p>- опытный пользователь ПК (MS Office, знание 1С как плюс);</p>\r\n<p>- готовность к командировкам (по области);</p>\r\n<p>- активная жизненная позиция.</p>', '<p>- консультирование клиента по продукции;</p>\r\n<p>- подбор оборудования, тех.консультации;</p>\r\n<p>- поиск заказчиков;</p>\r\n<p>- выезд на предприятия;</p>\r\n<p>- участие в выставках;</p>\r\n<p>- работа в 1С.</p>', '<p>Стандартный соц. пакет;</p>\r\n<p>С 9-00 до 18-00;</p>\r\n<p>Командировки до 30% рабочего времени (по Ленинградской области).</p>\r\n<p>Работа в Санкт-Петербурге.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '7', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:48:51'),
('9', '2', 'Архивариус', 'Архивариус', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>-высшее образование, профильное или техническое -уверенный пользователь ПК -желательно без вредных привычек -знание свода правил РФ по архивному делу -знание СИБИД -опыт не менее 3х лет</p>', '<ul>\r\n<li>работа с конструкторской технологической документацией</li>\r\n<li>работа с документами ОУД -составление описи дел</li>\r\n<li>ведение баз данных</li>\r\n<li>формирование каталогов</li>\r\n<li>работа с нормативными документами, для служебного пользования</li>\r\n<li>работа с документацией по военным заказам</li>\r\n<li>взаимодействие с конструкторами, начальниками производства</li>\r\n</ul>', '<ul>\r\n<li>5/2 с 9:00 до 18:00, перерыв на обед</li>\r\n<li>официальное оформление</li>\r\n</ul>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '9', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 05:51:04'),
('10', '2', 'Секретарь/ офис-менеджер со знанием английского языка', 'Секретарь/ офис-менеджер со знанием английского языка', 'Шереметьево', '0', '1970-01-01', '', '', '<p>40 000 - 50 000 руб.</p>', '<p>Высшее образование</p>\r\n<p>Опыт работы от 1 года</p>\r\n<p>Презентабельная внешность, грамотная речь</p>\r\n<p>Компьютерная грамотность, знание MS Office (Word, Excel, PowerPoint; знание Adobe Photoshop / Illustrator / CorelDraw будет являться преимуществом)</p>\r\n<p>Знание основ делопроизводства</p>\r\n<p>Опыт работы не менее 1 года</p>\r\n<p>Ответственность, пунктуальность, прекрасные коммуникативные навыки</p>\r\n<p>Знание английского языка (письменный и устный, на разговорном уровне)</p>', '<p>Принимать посетителей (заказ пропусков, встреча, чай/кофе)</p>\r\n<p>Отвечать на звонки Заказывать канцтовары, воду и т.д.</p>\r\n<p>Бронировать отели и билеты для сотрудников</p>\r\n<p>Оформлять визы для иностранных партнеров Контролировать рабочее время сотрудников</p>\r\n<p>Оформлять рабочие документы Заказывать этикетки для продукции</p>\r\n<p>При необходимости организовывать деловые встречи, совещания, конференции Выполнять поручения руководителя и топ-менеджеров</p>', '<p>Оклад 40.000-50.000 рублей на испытательный срок (3 мес.), далее возможно повышение заработной платы по результатам работы</p>\r\n<p>Работа в дружном коллективе</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Корпоративный транспорт от м. Речной вокзал</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '10', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:10:49'),
('11', '4', 'Заместитель Генерального Директора по продажам и развитию', 'Заместитель Генерального Директора по продажам и развитию', 'Зеленоград', '0', '1970-01-01', '', '', '<p>120 000 - 150 000 рублей</p>', '<p>- знание порядка разработки (проведение ОКР) военной и/или авиационной техники и постановки ее на производство; - знание порядка сертификации авиационного оборудования и условий его применения на военных и гражданских воздушных судах (самолетах и вертолетах); - знание основ конструирования и технических требований к радиоэлектронной аппаратуре (желательно авиационного бортового радиоэлектронного оборудования); - умение читать конструкторскую и эксплуатационную документацию (чертежи, ТУ, ТЗ, РЭ), знание структуры (или основ оформления) РКД, ТЗ, ТУ, РЭ; - способность запоминать большой объем данных (в том числе технические характеристики изделий, функциональное назначение изделий, особенности их применения и т.д.); - навыки проведения презентаций; - опыт продаж сложного технического оборудования; - желателен опыт работы с авиационными конструкторскими бюро и/или авиастроительными предприятиями (ПАО \"Туполев\", ПАО \"Ил\", Иркут, МИГ, Сухой, Миль, Камов, ОКБ \"Яковлева\", Объединенная Авиастроительная Корпорация, ПАО \"Вертолеты России\"); - желателен опыт работы с Управлением авиационной техники ДОГОЗ МО РФ; - желателен опыт работы на предприятии, разрабатывающем и производящем, военную или авиационную технику - умение грамотно вести деловую переписку; - грамотная речь; - готовность к командировкам, в том числе за границу; - хорошее знание ПС (Microsoft office, в том числе PowerPoint); - владение английским языком (чтение технической литературы и разговорный английский); - наличие автомобиля.</p>', '<p>Научно-производственная. Разработка и производство светотехнического оборудования на основе светодиодов и РЭА (гражданского, специального и военного назначения). - продвижение продукции предприятия; - ведение переговоров с существующими и новыми заказчиками; - подготовка и проведение презентаций / демонстраций продукции; - подготовка материалов для обоснования конкурентных преимуществ продукции с точки зрения ее технических, эксплуатационных, коммерческих характеристик, в том числе сравнительный технический анализ с аналогами предприятий-конкурентов; - проведение переговоров с Заказчиками по условиям заключения договоров на поставку серийной продукции и/или проведение ОКР; - согласование с Заказчиками технических требований, технических заданий на вновь разрабатываемые изделия; - анализ рынка, определение потребностей рынка и участие в подготовке технических требований (технических заданий) на разработку новых изделий; - техническая и коммерческая переписка с Заказчиками; - контроль за процессом разработки (проведением ОКР) новых изделий на предприятии; - организация подготовки документов для участия в тендерах / конкурсах; - консультирование Заказчиков по техническим вопросам, по вопросам подбора оборудования, обеспечение Заказчиков технической документацией (ТУ, ГЧ, РЭ, схемы подключений и т.д.); - организация разработки каталогов, технических описаний и рекламных материалов на изготавливаемую продукцию;</p>', '<p>На период испытательного срока: 90 000 - 110 000 рублей (gross) в зависимости от квалификации по результатам собеседования После испытательного срока: 100 000 - 130 000 (gross) рублей в зависимости от квалификации по результатам собеседования. Примерный штат: 60 человек Испытательный срок: 3 месяца График работы: 5/2 с 9 до 18 Социальные льготы: в соответствии с ТК РФ</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '11', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:12:14'),
('13', '11', 'Отоларинголог (ЛОР)', 'Отоларинголог (ЛОР)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Медицинское образование в данной области Опыт работы (или ординатуры) от 2 лет Уверенный пользователь ПК Желательно без вредных привычек</p>', '<p>Проведение простых амбулаторно-поликлинических приемов и процедур</p>', '<p>Испытательный срок: 1 месяц Соц. льготы: - 50% на медицинское обслуживание В клинике есть все условия для отдыха персонала Помощь в предоставлении жилья специалистам из регионов Возможность оплачиваемых переработок Если Вы молодой специалист, Вас научат и помогут в начале работы</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '13', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:14:09'),
('14', '22', 'Менеджер по закупкам (направление: овощи Fresh)', 'Менеджер по закупкам (направление: овощи Fresh)', 'Зеленоград', '0', '1970-01-01', '', '', 'по договорённости', 'Образование высшее.\r\nОпыт работы по специальности: от 3 лет.\r\nНеобходимые навыки: опыт работы в сфере закупок продуктов питания (направление: овощи Fresh предпочтительно).\r\nОпыт ведения переговоров с поставщиками.\r\nЗнание MS Office (Excel, Word)\r\nЖелательно наличие прав кат. \"В\" и собственного автомобиля.', 'Обеспечение бесперебойного снабжения овощами розничных сетей, холдингов.\r\nФормирование ассортиментной матрицы. Поиск и выбор поставщиков.\r\nПроведение переговоров с потенциальными поставщиками, заключение договоров.\r\nПланирование объемов закупок. Ценообразование.\r\n\r\n', 'Место работы: Солнечногорский р-н\r\nГрафик работы: понедельник-пятница 09:00-18:00, суббота - по необходимости\r\nСоциальные льготы: оформление по ТК РФ.\r\nЗаработная плата: окладная часть по договоренности + бонусы за хорошие закупки\r\nВзаимодействие с отделом продаж и мастером цеха', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '14', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:15:05'),
('15', '22', 'Инженер по гарантии', 'Инженер по гарантии', 'Зеленоград', '0', '1970-01-01', '', '', 'от 60000 рублей', 'Опыт работы инженером по гарантии в области дорожно-строительной или карьерной техники и дизельных двигателей не менее года. \r\n\r\nПриоритет: опыт работы сервисным инженером на выездах по ремонту ДСТ.\r\n\r\nТехнический уровень английского языка.\r\n\r\nПрава: категория В и личный автомобиль.\r\n\r\n', '- изучение-знание гарантийной политики завода изготовителя\r\n- прием гарантийных заявок от клиентов и дилеров\r\n- регистрация и оформление гарантийных актов рекламаций на портале завода изготовителя техники\r\n- проведение PDI на новой технике пришедшей с завода\r\n- оформление сервисных (отзывных) компаний завода изготовителя\r\n- сопровождение гарантии через дилеров в регионах\r\n- заполнение и отправка на завод полевых актов осмотра техники\r\n- заказ запасных частей под гарантийный ремонт\r\n- ежеквартальная отчетность по проведенным гарантийным ремонтам\r\n- контроль проведения предпродажной подготовки техники на новых машинах\r\n- постановка новой техники на гарантию на портале завода изготовителя\r\n- закупка запасных частей.\r\n- редкие командировки по сложным гарантийным ремонтам\r\n- контроль возврата денежных средств от завода изготовителя по гарантийным ремонтам', 'График: 5/2 с 9 до 18.\r\nЗаработная плата: от 60 000 руб. + бонусы.\r\n', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '15', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:16:02'),
('16', '18', 'Диспетчер склада', 'Диспетчер склада', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 60 000 руб.</p>', '<p>Желательно понимание логистики Желательно наличие собственного автомобиля Умение работать с большими объемами информации, мультизадачность Желательно умение ездить на погрузчике (наличие прав не обязательно) Наличие собственного автомобиля</p>', '<p>Обеспечение бесперебойной работы автопарка Контроль и обеспечение мойки а/м. Заключение договоров с мойкой, контроль выполнения договора, обеспечение выдачи талонов. Заключение договоров с АЗС, выдача пластиковых карточек водителям, контроль остатка средств на карточках. Составление и контроль соблюдения графика прохождения ТО. Заключение договоров с автосервисами. Отслеживание и обеспечение необходимыми документами для гос регистрации а/м, обеспечение и контроль сроков гостехосмотра и необходимых для этого документов. Организация ремонта неисправного а/м в случае поломки, организация перегрузки и эвакуации. Составление отчетов по использованию топлива по запросу бухгалтерии. Контроль заполнения путевых документов водителями-экспедиторами. Контроль расхода топлива Учет документов, контроль оплаты счетов, предоставление отчетов в бухгалтерию.</p>', '<p>Заработная плата: от 60 000 р. График работы: 5/2 (суббота и воскресенье - выходные) с 8 до 17 Возможны переработки и задержки - все оплачивается Работа в чистом, отапливаемом офисе. При трудоустройстве все сотрудники проходят полиграф. Есть место для отдыха и обеда, холодильник, СВЧ.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '16', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:16:41'),
('17', '18', 'Начальник отдела закупок и логистики', 'Начальник отдела закупок и логистики', 'Зеленоград', '0', '1970-01-01', '', '', '<p>80000</p>', '<p>1. Высшее образование (техническое (как плюс) 2. Знания Таможенного кодекса, внутренних и международных грузоперевозок, кодов ТН ВЭД 3. Опыт работы в 1с,(знание на уровне «Продвинутый пользователь» (как плюс) 4. Управленческий опыт от 5 лет 5. Уверенный пользователь ПК, работа с большим объемом информации, внимательность, общительность, аналитические способности, стратегическое мышление, умение налаживать отношения с руководством, опыт ведения переговоров. 6. Знание элементной базы, электронных приборов, особенностей работы и требований таможни при таможенной очистке данных позиций (как плюс) 7. Практический опыт работы в отделе логистики и закупок от 3 лет в качестве специалиста ВЭД или таможенного брокера или выполнение аналогичных обязанностей (обязательно), 8. Глубокое понимание процессов и схем работы отдела с учетом специфики компании (дистрибьюция микроэлектронных компонентов) 9. Анг.язык на уровне Intermediate</p>', '<p>1.совмещение должности руководителя с должностью старшего специалиста ВЭД (сейчас есть 1 специалист,будет разделение обязанностей на 2 человек): 1.Часто задаваемые вопросы от менеджеров по специфике работы с определенными позициями (ежедневно) 2.Корректировка на предмет сертификации, EAC, дозаполнение заявок, визирование заявок в 1С (ежедневно) 3.Проверка и правка кодов, справочники в 1с: 4.Подготовка документов для таможенного оформления через брокеров, включая документы с описанием качеств продукции, условий отгрузки, постановки на оплату, создание инвойсов: • автоматическая выгрузка из 1с) плюс в ручную описанием качеств продукции, условий отгрузки, постановки • создание и печать документов в ручную (авиапочта) , последущая регистрация в 1с 8.Отправка посылок (рекламация, брак) 9. Описание каждой технических характеристик каждой позиции для таможни в файле Word для оптимизации расходов на таможню 2.замещение сотрудника по направлению: Документооборот и регистрация процесса закупок и логистики (на время болезни и отпуска): работа с заявками, отгрузками, контроль оплат, приход товара в 1С и внутренней базе, логистика и транспортное обслуживание по наработанным схемам 3. Единая управленческая аналитика, отчетность по закупкам и логистике для руководства, разработка новых схем логистики (3% от всей работы) 4. Стратегическая координация работы отдела с учетом срочных дел (5% от всей работы) 5. Лидер проекта по автоматизации части процессов отдела в 1С</p>', '<p>Штат Отдела закупок и логистики: 5 человек, где 2 специалиста по направлениям + 2 водителя и 1 курьер Совокупный доход: оклад плюс ежеквартальная премия плюс соц. пакет: обеды,мед.страховка в Детство Плюс,баскетбол.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '17', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:18:06'),
('18', '14', 'Менеджер по продажам B2B', 'Менеджер по продажам B2B', 'Москва', '0', '1970-01-01', '', '', '<p>от 50 000 до 200 000</p>', '<p>Опыт работы в сегменте активных продаж услуг, на рынке B2B от 2 лет. Хорошие навыки ведения переговоров; Высокий уровень коммуникационных навыков и навыков ведения презентаций; Базовые знания ценообразования, планирования и бюджетирования; Умение координировать работу в рамках проектной команды; Способность объяснить и при необходимости отстоять свою точку зрения</p>', '<p>Прямые продажи мотивационных программ; Привлечение новых клиентов; Вклад в развитие продуктовой линейки, исходя из оценки потребностей клиентов; Участие в планировании локальных рекламных компаний, определение целей и аудитории; Взаимодействие с клиентами по вопросу погашения дебиторской задолженности; Мониторинг активностей конкурентов; Предоставление отчетов.</p>', '<p>Заработная плата (размер и форма оплаты): оклад от 30 000 рублей, бонусная часть %. Прогрессивный рост оклада, в зависимости от стажа. Совокупный доход порядка 100 000 рублей. Социальные льготы: соц.пакет Режим работы: 5/2 с 9 до 18. Комфортабельный офис рядом с ВДНХ. Командировки: проведение встреч Москва и МО Испытательный срок: 1 месяц</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '18', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:18:44'),
('19', '16', 'Руководитель направления по инжинирингу продуктов, инженер-электронщик', 'Руководитель направления по инжинирингу продуктов, инженер-электронщик', 'Москва', '0', '1970-01-01', '', '', 'по договорённости', 'Образование высшее (инженер-электронщик)\r\n\r\n', 'В Ваш круг обязанностей будет входить управление процессом, включающее две составляющие, как инженера и менеджера:\r\n1. Как инженер, Вы будете создавать спецификации для компонентов продуктов на основе тех задач. которые получите от технологов и и департамента по бизнесу.\r\n2. Как менеджер, Вы будете создавать и поддерживать собственную библиотеку DRM и PDK.\r\nЭта вакансия предопределяет постоянное сотрудничество и выбор CMOS фабрик по всему миру, это сложная, нестандартная модель сотрудничества. Вы будете вести детальные переговоры и выезжать на эти фабрики для ознакомления с условиями производства.\r\nПодчинение Генеральному директору, а команда Ваших помощников будет формироваться под развитие задач.\r\nЭто новое направление, с большими возможностями профессионального и личностного роста, которое дает широкие возможности концерна.\r\nОт Вас потребуется около практического опыта, управления цифровыми/ смешанными сигналами/ аналоговыми VLSI, ASIC, SoC', 'Вы будете работать в Франко-американской компании, ее Российское подразделение в Москве.\r\nКомпания - технологический лидер в области производства и разработки электронных компонентов и проектов по созданию устройств ИС.\r\nКомпания расположена в удобной транспортной доступности (5мин от метро).\r\nОформление по ТК РФ.\r\nГрафик 5/2 с 9 до 18\r\nЗаработная плата по договоренности.\r\nСоциальные льготы: ДМС, компенсация питания, компенсация фитнес, доплаты к больничным и т.д.\r\nКарьерный рост и интересные проекты', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '19', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:19:58'),
('20', '16', 'Руководитель отдела LTL сборных грузов', 'Руководитель отдела LTL сборных грузов', 'Зеленоград', '0', '1970-01-01', '', '', 'По договоренности', 'Обязателен опыт на аналогичной должности в сильной, системной компании-экспедиторе.\r\n\r\nСвободное владение английским языком. Предполагаются стажировки за рубежом.', 'Руководство отделом сборных грузов LTL', 'Официальное оформление, белая з/п + KPI, дополнительные условия и страховые обязательства соответствующие крупным иностранным компаниям.\r\n\r\n', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '20', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:22:04'),
('21', '5', 'Семейная пара', 'Семейная пара', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 60 000 руб.</p>', '<p>Муж должен быть исполнительным, со знаниями работы по дому, чтобы смог произвести мелкий ремонт (сантехника, электрика). Жена должна любить готовить. Спокойные, ответственные, доброжелательные, внимательные к деталям люди. Водительские права категории В. Опыт работы от 3 лет.</p>', '<p>В мужские обязанности входит: работа по дому, работа по участку (уборка снега, стрижка газона и растительности), уход за территорией и растительностью, закупки продуктов, мелкий ремонт по дому; В женские обязанности входит: сухая и влажная уборка, знание бытовой химии и бытовой техники, уход за одеждой и обувью, стирка, готовка (умение готовить постную еду), глажка. Пара должна взаимодополнять друг друга.</p>', '<p>Требуется семейная пара с проживанием в частный дом (500 м2), участок 30 соток, половину занимают мощеные парковочные места, остальная часть газон - из деревьев: ели, сосны, немного плодовых деревьев. Проживание и питание за счет работодателя. Участок на берегу озера. График 6/1 - есть возможность накопления выходных. Не нормированный рабочий день, есть возможность отдохнуть днем.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '21', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:22:47'),
('22', '5', 'Няня', 'Няня', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 30000 рублей</p>', '<p>Ответственность, внимательность, любовь к детям, опыт работы с маленькими детьми</p>', '<p>Присмотр за девочкой (2 года) - прогулки, кормление, развлечение, гигиенический уход</p>', '<p>График работы: 5/2 с 8 (8:30) до 19 (19:30) Заработная плата: от 30 000 рублей Место работы: Солнечногорский район, д. Обухово</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '22', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:32:48'),
('23', '5', 'Гувернантка', 'Гувернантка', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Высшее образование Обязателен опыт работы в семьях с детьми от 3 лет Ответственность, внимательность, любовь к детям Способность успокоить и заинтересовать ребенка какой-либо полезной деятельностью Наличие медицинской книжки</p>', '<p>Уход за двумя детьми (девочки - 5 лет и 2 годика), есть третий ребенок, за ним уход не требуется Играть, гулять, кормить, заниматься развивающей активностью, готовить к школе старшего ребенка</p>', '<p>Место работы: деревня Пятница График работы: пятница, суббота, воскресенье с 8:00 до 22:00 Заработная плата: от 3000 рублей за выход</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '23', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:33:30'),
('24', '15', 'Электромонтажник', 'Электромонтажник', 'Зеленоград', '0', '1970-01-01', '', '', 'до 70000', '\r\nОбразование\r\n\r\nВысшее\r\n\r\nОпыт работы\r\n\r\nОт 3 лет\r\n\r\nТребования\r\n\r\n1. Высшее и среднее специальное образование (Электромонтажник).\r\n2. Опыт работы аналогичный более 3-х лет.\r\n- Необходимо умение читать электросхемы.\r\n- Навыки сборки электрических шкафов управления, силовых распределительных щитов.\r\n3. Знание ПК.', '1. Знать технологию изготовления готовых изделий и требования по качеству к производимым изделиям.\r\n2. При получении комплектующих перед сборкой проверить их соответствие конструкторской документации и визуально проверить их качество на отсутствие повреждений\r\n3. Выполнять работы, связанные с производством готовых изделий и полуфабрикатов, по заданию Мастера участка, руководствуясь технологическим процессом изготовления изделий, соблюдая все правила техники безопасности.\r\n4. Выполнять нормы времени, установленные для выполнения операций.\r\n5. Выполнять функции дублера (backup) на время отсутствия электромонтажника-контролера и мастера участка.\r\n6. Выполнять распоряжения и приказы ДРП, относящиеся к деятельности производства и соответствующие квалификации. По мере необходимости, выполнять работы на других производственных участках, выезжать на объекты для доработки продукции.', '\r\nОформление в штат компании.\r\nГрафик работы с 7.00 до 15.45.\r\nЗаработная плата до 70 000 руб. (gross) + годовой бонус (по результатам работы).\r\nДМС, страхование жизни и от несчастных случаев (после испытательного срока).', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '24', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:34:05'),
('25', '15', 'Менеджер отдела качества (система менеджмента качества)', 'Менеджер отдела качества (система менеджмента качества)', 'Зеленоград', '0', '1970-01-01', '', '', 'от 45 000', 'Образование: Высшее\r\n\r\nОпыт работы от 1 года в одной из областей: сертификация продукции на соответствие ТР ТС, контроль качества продукции, система менеджмента качества, технология производства продукции.\r\nЗнание английского языка на уровне Intermediate\r\nНаличие водительских прав и личного авто (как плюс).', '1) Участие в подготовке сертификации продукции на соответствие ТР ТС.\r\n2) Управление документацией СМК в электронной сети организации.\r\n3) Участие в работе по управлению несоответствующей продукцией.\r\n4) Ознакомление сотрудников с документами СМК и изменениями к ним.\r\n5) Проведение внутренних аудитов, оформление записей по проведению внутренних аудитов и рассылка их в подразделения.\r\n6) Подготовка Планов мероприятий по выявленным замечаниям внешних аудитов (органов по сертификации, потребителей).\r\n7) Участие в проведении рекламационной работе с зарубежными поставщиками.', 'Бесплатный обед, корпоративные праздники, оформление по ТК, оплачиваемый отпуск, спортивная секция по волейболу;', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '25', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:35:23'),
('26', '6', 'Техник по ремонту Крупно-Бытовой Техники', 'Техник по ремонту Крупно-Бытовой Техники', 'Москва', '0', '1970-01-01', '', '', '<p>50000</p>', '<p>- Практический опыт осуществления ремонтных работ КБТ; - Водительское удостоверение категории В; - Коммуникабельность, стрессоустойчивость, внимание к мелочам, аккуратность, организованность.</p>', '<p>- Осуществлять монтаж/демонтаж, диагностику, пуско-наладочные работы, техническое обслуживание и ремонт КБТ; - Самостоятельно производить сложные ремонты бытовой техники Компании; - Оформление заказов; - Выезд к клиенту; - Осуществлять наличные расчеты с клиентами за выполненные работы; - Предоставлять отчет руководителю.</p>', '<p>- Офис компании находится в районе станции метро \"Динамо\"; - Выдача автомобиля и оплата моб. связи.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '26', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:36:06'),
('27', '9', 'Торговый представитель', 'Торговый представитель', 'Уфа', '0', '1970-01-01', '', '', 'по договоренности', 'Умение вести переговоры, базовые знания документооборота, права, грамотно поставленная речь, умение убеждать и работать с возражениями.\r\n\r\nЛичностные характеристики: трудолюбие, коммуникабельность, честность, творческий подход к работе, адекватность, дисциплинированность, грамотно поставленная речь, умение убеждать и работать с возражениями.\r\n\r\n', 'ОСНОВНЫЕ ОБЯЗАННОСТИ:    \r\n\r\nПрезентация бренда в салонах красоты, проведение обучающих семинаров, консультация клиентов по техническим вопросам, ведение переговоров и заключение договоров, прием заказов, контроль отгрузки продукции, контроль оплаты, составление отчетов.\r\n\r\nСОТРУДНИК ОТВЕЧАЕТ ЗА:  составление заказов, контроль отгрузки и доставки, контроль оплаты.               \r\n\r\n', 'График работы: Свободный график работы, возможна работа по совместительству, удаленное взаимодействие с офисом в Казани.\r\n\r\nСоц. пакет и система компенсаций: соц. пакет согласно ТК РФ + компенсация за проезд + оплаченная мобильная связь и интернет на рабочем планшете (после испытательного срока).\r\n\r\nИспытательный срок  3 месяца.\r\n\r\nОсобенности работы: основная работа в «Полях» + работа в офисе. Возможно обучение и развитие. Как перспектива – рост до Регионального Директора по продажам по Республике Башкортостан.', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '27', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:36:42'),
('28', '9', 'Менеджер активных продаж', 'Менеджер активных продаж', 'Зеленоград', '0', '1970-01-01', '', '', 'от 50000 рублей', 'Обязателен опыт работы менеджером отдела продаж (предпочтительно промышленного оборудования, сегмент В2В) от 2-х лет.\r\nОбязателен опыт сопровождения продаж в базе 1С.\r\nОпыт поиска и привлечения потенциальных клиентов, ведения переговоров.\r\nЖелателен опыт участия в тендерах. Технический уровень английского языка', '\r\n•Активный поиск новых заказчиков;\r\n•Холодные звонки, проведение встреч и переговоров с клиентами (командировки - 25% рабочего времени);\r\n•Консультирование клиентов по ассортименту и решениям компании - производителя;\r\n•Технико-коммерческое сопровождение сделок (подготовка КП и оформление заказов в базе 1C, контроль сроков поставок и отгрузок товара со склада в Москве);\r\n•Участие в проведении маркетинговых мероприятий с целью продвижения оборудования на рынке;\r\n•Выполнение плановых показателей по объемам продаж, установленных руководителем;\r\n•Ведение и предоставление отчетности и презентаций по результатам работы генеральному директору', '\r\nРабота в Зеленограде\r\nОформление по ТК РФ. \r\nГрафик 5/2.\r\nКомандировки: 25% от общего рабочего времени', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '28', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:38:10'),
('29', '14', 'Менеджер по продажам электронных компонентов', 'Менеджер по продажам электронных компонентов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 100 000 рублей</p>', '<p>Обязателен опыт работы в активных продажах, в т.ч. радиоэлектронных компонентов от 3 лет. Знание радиоэлектроники и электронных компонентов. Знание технологий и принципов продаж. Аналитический склад ума, системный подход. Стремление к профессиональному росту, активная жизненная позиция, нацеленность на результат, высокая степень самомотивации, ответственности. Энергичность, коммуникабельность, развитые навыки общения.</p>', '<p>Развитие и увеличение объемов продаж согласно установленным планам. Активный поиск сбор и анализ информации о клиентах, формирование стратегии работы с ними. Подготовка коммерческих предложений, ведение переговоров. Постоянное изучение линеек и ресурсов фирмы. Взаимодействие с другими отделами компании. Знание ПК: MS Office (Excel, Word), The Bat!, Internet, 1C: Предприятие.</p>', '<p>Совокупная з/п от 100 000 - 120 000 рублей График работы: 5/2 с 9 до 18 Офомление по ТК РФ</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '29', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:38:52'),
('30', '14', 'Senior sales manager / менеджер по продажам логистических услуг', 'Senior sales manager / менеджер по продажам логистических услуг', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Требуется сильный англоязычный продавец, знающий рынок логистических услуг.</p>\r\n<p>Ему в помощь будет выделен ассистент, делающий работу внутри. Опытный переговорщик.</p>', '<p>Задача менеджера — встречи с заказчиками, договариваться.</p>', '<p>Официальное оформление, белая з/п + KPI, дополнительные условия и страховые обязательства соответствующие крупным иностранным компаниям.</p>', '<p>У вас появились вопросы?</p>\r\n<p>Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '30', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:40:36'),
('31', '14', 'Менеджер по продажам (приводной техники)', 'Менеджер по продажам (приводной техники)', 'Санкт-Петербург', '0', '1970-01-01', '', '', '<p>40000-45000</p>', '<p>- опыт работы от года по продаже промышленного оборудования в секторе В2В; - опытный пользователь ПК (MS Office, знание 1С как плюс); - готовность к командировкам (по области); - активная жизненная позиция.</p>', '<p>- консультирование клиента по продукции; - подбор оборудования, тех.консультации; - поиск заказчиков; - выезд на предприятия; - участие в выставках; - работа 1С.</p>', '<p>Стандартный соц. пакет; С 9-00 до 18-00; Командировки до 30% рабочего времени (по Ленинградской области). Работа в Санкт-Петербурге.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '31', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:41:19'),
('32', '14', 'Менеджер отдела продаж', 'Менеджер отдела продаж', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50000 руб.</p>', '<p>ПК - опытный пользователь (пакет MS Office (Excel, Word), 1C Предприятие, эл.почта). Опыт работы в продажах корпоративным заказчикам. Желательно высшее техническое образование. Знание первичной бухгалтерской документации. Активная жизненная позиция, умение работать на результат, высокая степень самомотивации. Энергичность, умение находить решение в сложных ситуациях. Ответственность, честность. Высокоразвитые навыки общения, умение налаживать и поддерживать конструктивные отношения, коммуникабельность, грамотная речь Стремление к профессиональному росту. Умение работать в команде</p>', '<p>Развитие бизнеса с клиентами по активным линейкам компании МикроЭМ Выполнение плана продаж при сохранении заданного уровня прибыльности и оборачиваемости склада Обсуждение условий сотрудничества с клиентами, принятие решения о сделке, управление рисками, оформление коммерческих предложений, договоров. Оформление счетов и отгрузочных документов в 1С7. Размещение заявок на закупку продукции, и их мониторинг в 1С8. Контроль дебиторской задолженности клиентов. Заполнение отчетов о своей работе. Обучение/постановка задач помощнику менеджера.</p>', '<p>Работа в офисе: г.Зеленоград, 5дн.раб.неделя с 9.00 – 18.00ч. (с перерывом на обед). Заработная плата: оклад + % с продаж. Оклад на испытательный срок в 2 месяца фиксированный: 50 000 руб. Оформление в соответствии с Трудовым кодексом РФ. Бесплатные обеды.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '32', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:42:21'),
('33', '14', 'Менеджер по продажам услуг контрактного производства электроники', 'Менеджер по продажам услуг контрактного производства электроники', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Высшее техническое образование (профильное инженерное) Обязателен опыт в продажах услуг контрактного производства от 2 лет Знание программ: Excel, MS Office, 1C (на базе 8-ки), желательно знать P-Cad Желательно умение работать с технической документацией на английском языке Коммуникативность, внимательность, умение находить общий язык с клиентами, неконфликтность, готовность к большому объему информации и работы</p>', '<p>Поддержка и ведение существующих клиентов холдинга Обработка запросов Сопровождение заявок Холодных звонков почти нет</p>', '<p>График работы 5/2 с 9 до 18 Заработная плата: оклад 35 000 - 40 000 на руки + бонусы от продаж Испытательный срок: 2-3 месяца Бесплатные обеды Волейбол и баскетбол в Орбите (пн и ср)</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '33', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:42:56'),
('34', '15', 'Инженер-конструктор (НКУ)', 'Инженер-конструктор (НКУ)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50000 рублей</p>', '<p>Электрические аппараты и устройства: • Основные принципы построения эл. схем защиты, распределения, коммутации и управления; • Принц. действия, констр. особенности, особен. использования и эксплуатации основ-ных эл. аппаратов низковольтных сетей. Графические программы: • AutoCAD или E-Plan. Нормативно - технической документация (НТД): • Основные требования безопасности для проектируемых НКУ, ВРУ, щит. для произв. и общ. зданий, щит. для жилых зданий. Уметь: Электрические аппараты и устройства: • Разрабатывать эл. схемы защиты, распределения, коммутации и управления низковольтных сетей. Графические программы: • Уверенно пользоваться основными инструментами AutoCAD или E-Plan Быть знакомым: Электрические аппараты и устройства: • С основными типами отечественных и импортных (Шнейдер Электрик, ABB, LEG, SIM) аппаратов защиты, распределения, коммутации и управления низковольтных сетей (до 1000В). Опыт разработки внешнего вида и электрических схем НКУ и шкафов управления на оболочках Schneider Electric, АВВ, Rittal. Графические программы: • С граф. прогр., аналогичными AutoCAD;E-Plan; • С САПР (желательно). Нормативно - технической документация (НТД): • С основными разделами ПУЭ; • С ГОСТ по НКУ, ВРУ, щит. для произв. и общ. зданий, щит. для жил. зданий. Иметь представление: Электрические аппараты и устройства: • Об элект. аппар. и устройс. сетей 6-10кВ. Графические программы: • О САПР. Нормативно - технической документация (НТД): • Обо всей гамме НТД в области соискания должности.</p>', '<p>Расчет низковольтных сетей 0, 4 и разработка технической документации на электротехнические шкафы НКУ.</p>', '<p>Работа в Зеленограде Оформление по ТК РФ. График 5/2. Командировки: 25% от общего рабочего времени</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '34', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:43:39'),
('35', '15', 'Инженер-конструктор', 'Инженер-конструктор', 'Зеленоград', '0', '1970-01-01', '', '', '<p>80000-90000</p>', '<p>Высшее техническое образование (инженер-конструктор). Опыт работы от 3-х лет (преимущественно, опыт работы с металлообрабатывающими станками с ЧПУ, тяжелое оборудование). Умение работать в AutoCad, SolidWorks, SAP или Scala. Английский язык на базовом уровне.</p>', '<p>Анализ размещенного на производстве проекта с точки зрения технологичности изготовления, ремонтопригодности, удобства обслуживания конструкции. Согласование с Руководителем по обеспечению производства технических и технологических особенностей заказа. Составление карты изделия - БОМ. Корректирование списка материалов с целью автоматического списания в Scala и минимизации актов на списание материалов вручную. Коррекция заказа на комплектующие в соответствие с очередностью сборки Согласование списков материалов с инженером по обеспечению производства в случае отклонений в процессе автоматического списания. Размещение заказа на комплектующие у инженера по обеспечению производства Координация заказов на комплектующие и расходные материалы с инженером по обеспечению производства, с целью минимизации складских остатков. Генерирование чертежей панелей в формате .dxf Распечатка спецификаций по панелям и на профиль. Передача спецификаций на изготовление ППР (проставки, поддоны, рамы) Начальнику станочного участка Внесение необходимых изменений в соответствующую программу по принципам и нормативам списания расходных материалов. Разделение панелей и ППР (проставки, поддоны, рамы) в соответствие с типом материала и его толщиной. Участие в разработке новых видов продукции. Разработка конструкторской документации и чертежей, крепежных узлов комплектующих. Подготовка технических спецификаций на новые изделия для создания заявок на закупку новых комплектующих. Передача спецификаций инженеру по обеспечению производства для заказа. Участие в обработке дефектных актов. Присвоение каждому акту кода дефекта и передача ответственному конструктору для занесения в таблицу дефектов. Back up начальников участков.</p>', '<p>Оформление по ТК РФ. Заработная плата 80 000-90 000 руб. gross Медицинское страхование и страхование жизни (после испытательного срока). Корпоративный мобильных телефон. График работы 8.00-17.00.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '35', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:44:26'),
('36', '15', 'Инженер-конструктор цифровых схем', 'Инженер-конструктор цифровых схем', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 рублей</p>', '<p>Образование: высшее профессиональное (техническое) Необходимый стаж работы по специальности: стаж конструкторской работы на инженерно-технических должностях в соответствующей профилю предприятия отрасли не менее 3 лет Знание английского языка (технический) ПК: Опытный пользователь Дополнительные требования: владение САПР Cadence, знание FRONT-END маршрута разработки заказных (ASIC) микросхем, знание принципов и методологии разработки аналоговых схем.</p>', '<p>Разработка схем электрических принципиальных цифровых интегральных микросхем</p>', '<p>Заработная плата (размер и форма оплаты): 40 000 руб. В зависимости от опыта и объема участков работы установлена система премирования, доплат и надбавок. Испытательный срок: 3 месяца Режим работы: 5/2 с 9:00 до 18:00. Перерыв на обед с 13.00 до 13.45. Время окончания работы в пятницу: 16.45. Командировки: нет</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '36', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:44:59'),
('37', '15', 'Инженер-конструктор аналоговых схем', 'Инженер-конструктор аналоговых схем', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 рублей</p>', '<p>Образование: высшее профессиональное (техническое) Необходимый стаж работы по специальности: стаж конструкторской работы на инженерно-технических должностях в соответствующей профилю предприятия отрасли не менее 3 лет Необходимые навыки: владение САПР Cadence, знание FRONT-END маршрута разработки заказных (ASIC) микросхем, знание принципов и методологии разработки аналоговых схем. Знание иностранного языка: Английский технический ПК: Опытный пользователь</p>', '<p>Разработка схем электрических принципиальных аналоговых интегральных микросхем</p>', '<p>Заработная плата (размер и форма оплаты): 40 000 руб. В зависимости от опыта и объема участков работы установлена система премирования, доплат и надбавок. Испытательный срок: 3 месяца Режим работы: 5/2 с 9:00 до 18:00. Перерыв на обед с 13.00 до 13.45. Время окончания работы в пятницу: 16.45. Командировки: нет</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '37', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:45:45'),
('38', '7', 'Инженер-Схемотехник', 'Инженер-Схемотехник', 'Зеленоград', '0', '1970-01-01', '', '', '<p>60000 рублей</p>', '<p>Опыт разработки устройств электропитания. Хорошее знание современных топологий сетевых источников питания (LLC, forward, flyback, в том числе и квазирезонансных). Хорошие знания и опыт разработки сетевых корректоров мощности. Хорошие знания в области неизолированных источников питания и опыт их практической реализации. Хорошие знания основ работы магнитных материалов. Умение рассчитывать магнитные элементы источников питания, в том числе проектировать планарные трансформаторы. Знание современной элементной базы в области источников питания, аналоговой, цифровой и микропроцессорной техники. Опыт разработки устройств с использованием микроконтроллеров на языке С, С++; Знание среды IAR/KEIL; Опыт работы с микроконтроллерами SMT32/STM8 Atmel (или другими 32-битными); Опыт в написании ПО для Windows, в том числе управляющего внешними устройствами по протоколам RS232 и USB; Опыт работы с интерфейсами CAN, RS232/RS485, USB, SPI, I2C, ТLIN; Знание языков VERILOG/VHDL Опыт работы с ПЛИС ALTERA серии CYCLONE в среде Quartus. Уверенное владение ПК (прикладные программы по специализации и CAD пакеты); Опыт разработки схем и печатных плат в среде PCAD/Altium; Английский язык - чтение профессиональной литературы.</p>', '<p>Разработка радиоэлектронной аппаратуры, импульсных источников питания. • Разработка систем управления и питания светодиодным и светотехническим оборудованием. • Макетирование и испытание опытных образцов. • Разводка печатных плат (PCAD). • Оформление документации.</p>', '<p>Полное соблюдение ТК РФ. Социальный пакет. График работы: 5/2, 9:00 - 18:00.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '38', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:46:19'),
('39', '7', 'Инженер-программист микроконтроллеров', 'Инженер-программист микроконтроллеров', 'Зеленоград', '0', '1970-01-01', '', '', '<p>60 000 - 80 000</p>', '<p>- Схемотехника (знание PCad или Altium). - Английский язык (уровень чтения технической документации). - Образование высшее - радиотехника. Опыт работы - не менее 3 лет в качестве разработчика РЭА (в областях GSM, GPS/ГЛОНАСС, RFID).</p>', '<p>- Программирование микроконтроллеров. - Умение самостоятельно вести проекты.</p>', '<p>Полное соблюдение ТК РФ. Социальный пакет. График работы: 5/2, 9:00 - 18:00.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '39', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:47:08'),
('40', '15', 'Инженер-конструктор/ Приборист', 'Инженер-конструктор/ Приборист', 'Зеленоград', '0', '1970-01-01', '', '', '<p>60 000 - 80 000</p>', '<p>Знание единой системы конструкторской документации (ЕСКД); Знание программ Компас (2d и 3d моделирование), AutoCAD, Solid Works; Желателен опыт проектирования печатных плат и знание P-CAD ПК: ЕСКД, AutoCAD, Компас, Solid Works, P-CAD (желательно)</p>', '<p>Разработка конструкции радиоэлектронной аппаратуры и светотехнических изделий на основе светодиодов. Оформление конструкторской документации согласно ЕСКД. Желательно опыт разработки деталей изготовленных методом вакуумного формирования и литья.</p>', '<p>Вы будете работать в компании которая занимается производственно-научной деятельностью. Заработная плата: 60000-80000 рублей по результатам собеседования. Испытательный срок: до 3-х месяцев. Оформление по ТК РФ. Режим работы: 5/2 с 9 до 18.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '40', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:47:48'),
('41', '15', 'Главный инженер', 'Главный инженер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Высокая (по договоренности)</p>', '<p>Навыки модернизации производства, опыт работы с КД, очень глубокие знания технологии производства, обязательный опыт работы именно с холодильным оборудованием. Опыт работы от 5 лет.</p>', '<p>Руководство службой главного инженера, включая ремонтный, экспериментальный и испытательный участок и технологическое подразделение. Организует работу по улучшению ассортимента и качества, совершенствованию и обновлению выпускаемой продукции. Осуществляет контроль над соблюдением проектной, конструкторской и технологической дисциплины, правил и норм по охране труда, технике безопасности, производственной санитарии и пожарной безопасности, требований природоохранных, санитарных органов, а также органов, осуществляющих технический надзор. Обеспечивает своевременную подготовку технической документации, в том числе разработку конструкторской документации и документации по сертификации продукции. Претензионная работа с поставщиками, а также работа по согласованию условий и технических требований. Представление с технической позиции интересов организации при заключении контрактов, договоров и других соглашений с другими организациями, предприятиями, представителями государственных органов. Повышение квалификации рабочих, инженерно-технических работников. Разработка и проверка инструкций, приказов, и документации, которая регламентирует деятельность организации. Инструментообеспечение и подбор оборудования. Реконструкция и переоснащение производства.</p>', '<p>Заработная плата по договоренности (высокая). График работы 5/2 с 9 до 18. Испытательный срок 3 месяца.</p>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '41', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:48:25'),
('42', '15', 'Заместитель начальника Конструкторского Бюро', 'Заместитель начальника Конструкторского Бюро', 'Зеленоград', '0', '1970-01-01', '', '', '<p>100 000 - 130 000</p>', '<p>• знание ГОСТов, порядка, процедур разработки (проведение ОКР) военной и/или авиационной техники и постановки ее на производство; • значительный опыт разработки и конструирования радиоэлектронной аппаратуры (желательно бортового авиационного радиоэлектронного оборудования); • опыт разработки светотехнических изделий, в том числе на основе светодиодов; знание основ светотехники и фотометрии; • знание современной аналоговой и цифровой схемотехники (желательно импульсных блоков питания); • хорошее знание ЕСКД и правил оформления РКД, ТЗ, ТУ, РЭ и пр; • руководство коллективом разработчиков от 10 человек; • желательно знание порядка сертификации авиационного оборудования и условий его применения на военных и гражданских воздушных судах (самолетах и вертолетах); • желателен опыт работы с авиационными конструкторскими бюро и/или авиастроительными предприятиями (ПАО \"Туполев\", ПАО \"Ил\", Иркут, МИГ, Сухой, Миль, Камов, ОКБ \"Яковлева\", Объединенная Авиастроительная Корпорация, ПАО \"Вертолеты России\"); • желателен опыт работы на предприятии, разрабатывающем и производящем военную или авиационную технику; • желательно знание основ оптики; • умение грамотно вести деловую переписку; • грамотная речь; • готовность к командировкам; • хорошее знание ПС; • владение английским языком (чтение технической литературы и разговорный английский)</p>', '<p>• организация, руководство и контроль за процессом разработки новых изделий - радиоэлектронной аппаратуры и светодиодного светотехнического оборудования военного и специального назначения; • руководство коллективом конструкторов, схемотехников, программистов, а также архивом предприятия и испытательной лабораторией: постановка задач, контроль за выполнением работы; • проведение переговоров с Заказчиками для определения потребности рынка в новых изделиях; согласование с Заказчиками технических требований и технических заданий на разработку новых изделий; • участие в разработке технических требований и технических заданий; • разработка облика (принципов построения) новых изделий; • консультирование Заказчиков по техническим вопросам, по вопросам подбора оборудования, обеспечение Заказчиков технической документацией (ТУ, ГЧ, РЭ, схемы подключений и т.д.); • обеспечение выполнения ОКР в заданные сроки; • выбор наилучших конструктивных, схемотехнических, оптических решений при разработке новых изделий; • планирование работы подчиненных сотрудников и подразделений; • участие в подборе новых сотрудников.</p>', '<p>Испытательный срок: 3 месяца Социальные льготы: в соответствии с ТК РФ Режим работы: 5/2 с 9 до 18.</p>', 'У вас появились вопросы?\r\nЗадайте их нашим менеджерам\r\nпо телефону:\r\n8 (499) 736-69-87\r\n8 (499) 735-85-46\r\nили на Email:\r\njob@jobcv.ru', '0', '0', '', '', '', '2', '42', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-02 06:49:00'),
('43', '18', 'Водитель погрузчика', 'Водитель погрузчика', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35000 руб</p>', '<p>Образование: Среднее специальное</p>\r\n<p>Опыт работы от 1 года. Водительские права категории С.</p>\r\n<p>Наличие удостоверение на управление погрузчиком. Исполнительность, ответственность.</p>', '<p>Разгрузочно-погрузочные работы на погрузчике (Газ). Перемещение груза</p>', '<p>График 5/2 с 8:00 до 17:00, перерыв на обед с 12:00 до 13:00.</p>\r\n<p>Оплачиваемый отпуск 28 календарных дней.</p>\r\n<p>Оформление по ТК. З/п оклад 35000 + премия 8820.</p>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '43', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-21 19:18:09');/**ABDB**/
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('44', '18', 'Кладовщик', 'Кладовщик', 'Зеленоград', '0', '1970-01-01', '', '', '<p data-select-like-a-boss=\"1\">45000 руб</p>', '<p>Образование Среднее специальное. Опыт работы от 1 года. Знание 1С Склад 8.2 <strong>ОБЯЗАТЕЛЬНО</strong>!!!!</p>\r\n<p>ЗНАНИЕ:</p>\r\n<ul>\r\n<li>организации учета складских операций, правила складского учета;</li>\r\n<li>условия приема, хранения, отпуска складируемых товарно-материальных ценностей;</li>\r\n<li>виды, размеры, марки, сортность и другие качественные характеристики ТМЦ и нормы их расхода;</li>\r\n<li>порядок и сроки составления отчетности;</li>\r\n<li>порядок приобретения, хранения ТМЦ и оформление их списания.</li>\r\n</ul>', '<p>Ведение учета по приему, хранению и отпуску товарно-материальных ценностей (ТМЦ) на складах, по их размещению с учетом наиболее рационального использования складских площадей. Обеспечение сохранности складируемых ТМЦ, соблюдение режимов хранения, ведение учета складских операций.</p>\r\n<p>Обеспечение соблюдения правил оформления и сдачи приходно-расходных документов, составление установленной отчетности. Организация проведение приема, отпуска ТМЦ, погрузочно-разгрузочных работ на складах с соблюдением правил охраны труда, производственной санитарии и противопожарной защиты.</p>\r\n<p>Обеспечение сбора, хранения и своевременного возврат поставщикам многооборотной тары. Проведение инвентаризаций ТМЦ.</p>', '<p>График 5/2 с 8:00 до 17:00, перерыв на обед с 12:00 до 13:00.</p>\r\n<p>Оплачиваемый отпуск 28 календарных дней.</p>\r\n<p>Оформление по ТК. З/п оклад 45000+ премия 11340</p>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '44', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-21 19:19:53'),
('45', '15', 'Оператор линии по обработке цветных металлов', 'Оператор линии по обработке цветных металлов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>40000 руб.</p>', '<p>Образование среднее специальное. Опыт работы от 1 года. Техническое образование. Приветствуется опыт работы на станках ЧПУ</p>', '<p>Работа на линии по переработке лома кабеля. Контроль технического состояния линии. Настройка линии на выход качественного сырья. Техническое обслуживание линии (замена ножей, настройка зазоров ножей и т.д.) Контроль за качеством входящего сырья и готовой продукцией.</p>', '<p>График 5/2 с 8:00 до 17:00, перерыв на обед с 12:00 до 13:00.</p>\r\n<p>Оплачиваемый отпуск 28 календарных дней.</p>\r\n<p>Оформление по ТК. З/п оклад 40000.</p>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '45', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-21 19:22:13'),
('46', '15', 'Резчик лома и отходов металла', 'Резчик лома и отходов металла', 'Зеленоград', '2', '1970-01-01', '', '', '<p>30000 руб.</p>', '<p>Образование Среднее. Исполнительность, ответственность.</p>', '<p>Разгрузка лома кабеля. Работа на разделочном станке по снятию кабельной брони. Сортировка лома кабеля.</p>', '<p>График сменный: дневная смена с 8:00 до 20:00; ночная смена с 20:00 до 8:00.</p>\r\n<p>Перерыв на отдых по 30 минут.</p>\r\n<p>Оплачиваемый отпуск 28 календарных дней.</p>\r\n<p>Оформление по ТК. З/п оклад 30000+ премия 7560</p>', '<p>У вас появились вопросы? Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: job@jobcv.ru</p>', '0', '0', '', '', '', '2', '46', '*', '0', '0000-00-00 00:00:00', '478', '2018-08-21 19:24:03'),
('47', '6', 'Аппаратчик химической чистки', 'Аппаратчик химической чистки', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 35000 рублей</p>', '<p>В сеть французских химчисток требуется работник на позицию Аппаратчик химчистки.</p>\r\n<p>Образование: среднее и выше<br />Необходимый стаж работы по специальности: не обязателен<br />Необходимые навыки:<br />- желателен опыт работы с кассой;<br />- приветствуются знания работы с тканью.<br />Без вредных привычек.</p>', '<p>Прием заказов, глажка, зачистка, выдача, работа с оборудованием, химией, с кассовым оборудованием.<br />Работа ведется по евростандарту, экологическая химчистка.</p>', '<p>График сменный - 2/2. Химчистка работает с 8.00-22.00, предполагаются перерывы на отдых, рабочий день 11, 5 часов.<br />Место работы: пос. Андреевка.<br />Заработная плата: 35 000 руб. на время обучения и испытательного срока, после испытательного срока - 38 000 - 40 000 руб.<br />Испытательный срок - 3 месяца.</p>', '<p>У вас появились вопросы?</p>\r\n<p>Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: <a href=\"mailto:job@jobcv.ru\">job@jobcv.ru</a></p>', '0', '0', '', '', '', '2', '47', '*', '0', '0000-00-00 00:00:00', '478', '2018-09-10 07:10:50'),
('48', '16', 'Парикмахер универсал', 'Парикмахер универсал', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Рассматриваем кандидатов с минимальной практикой. Обучение берем на себя.</p>', '<p>Осуществление женских/мужских/детских стрижек, укладка, окрашивание.</p>', '<p>График работы и уровень заработка обсуждается индивидуально. В нашей Студии красоты «Апрель» оборудована удобная комната отдыха для мастеров. Организовываем обучающие мероприятия для сотрудников, повышения квалификации, освоения новых техник в работе. Все материалы предоставляются студией.</p>', '<p>У вас появились вопросы?</p>\r\n<p>Задайте их нашим менеджерам по телефону: 8 (499) 736-69-87 8 (499) 735-85-46 или на Email: <a href=\"mailto:job@jobcv.ru\">job@jobcv.ru</a></p>', '0', '0', '', '', '', '2', '48', '*', '0', '0000-00-00 00:00:00', '478', '2018-09-10 07:14:49'),
('51', '10', 'Бренд-менеджер', 'Бренд-менеджер', 'Москва, м. Белорусская', '0', '1970-01-01', '', '', '<p>от 90 000 руб.</p>', '<ul>\r\n<li>Профильное высшее образование по маркетингу</li>\r\n<li>Опыт работы бренд-менеджером от 2 лет</li>\r\n<li>Грамотная русская речь</li>\r\n<li>Хороший уровень знания английского языка</li>\r\n<li>Наличие успешно реализованных проектов (портфолио, кейсы)</li>\r\n<li>Желательны навыки графического дизайна (Corel Draw, Adobe Illustrator, Photoshop) и монтажа видеороликов</li>\r\n<li>Прекрасные аналитические навыки, высокий уровень самоорганизации и ответственности</li>\r\n</ul>', '<ul>\r\n<li>Бренд-менеджмент категорий продуктов \"уход\" и \"стайлинг\"</li>\r\n<li>Разработка стратегии продвижения категорий</li>\r\n<li>Планирование и анализ продаж вверенных категорий</li>\r\n<li>Планирование, проведение и анализ эффективности промо-акций и маркетинговых кампаний по категориям</li>\r\n<li>Анализ рынка и деятельности конкурентов (ценообразование, запуски, рекламные кампании, промо-акции)</li>\r\n<li>Адаптация и разработка рекламных материалов, заказ сувенирной продукции, заказ FMOT и POSM для партнерских салонов</li>\r\n<li>Участие в подготовке обучающих мероприятий для отдела продаж</li>\r\n<li>Участие в планировании и контроле маркетингового бюджета</li>\r\n<li>Тесное взаимодействие с отделами продаж и обучения</li>\r\n<li>Участие в создании заказов продукции у поставщика</li>\r\n</ul>', '<ul>\r\n<li>Размер заработной платы обсуждается на собеседовании</li>\r\n<li>Работа в дружном коллективе очень перспективной компании в центре Москвы (м. Белорусская)</li>\r\n<li>Корпоративная скидка на приобретение продукции компании</li>\r\n<li>Компания оплачивает 50% стоимости медицинской страховки (после прохождения испытательного срока)</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '51', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 14:01:01'),
('52', '15', ' Менеджер по продажам', ' Менеджер по продажам', 'Москва, м. Белорусская', '0', '2021-04-19', '', '', '<p>от 70 000 руб.</p>', '<ul>\r\n<li>Среднее специальное или высшее образование.</li>\r\n<li>Опыт работы от 1 года.</li>\r\n<li>Грамотная речь, приятный внешний вид. </li>\r\n<li>Высокие коммуникативные навыки, организованность, ответственность. </li>\r\n<li>Опыт личных продаж брендовой косметики, сопровождения сделок, подготовки и ведения переговоров. </li>\r\n<li>Ориентация на результат. </li>\r\n<li>Желание продавать.</li>\r\n<li>Приветствуется опыт работы с салонами красоты.</li>\r\n</ul>', '<ul>\r\n<li>Ведение переговоров, заключение договоров. </li>\r\n<li>Поиск и привлечение новых клиентов. </li>\r\n<li>Продвижение продукции. </li>\r\n<li>Работа в офисе и с клиентами в салонах.</li>\r\n<li>Ведение текущей работы с имеющимися клиентами: консультирование, обеспечение информацией о продукции, условиях продаж и оплаты. </li>\r\n<li>Оформление заказа на фирменном бланке, контроль отгрузки и оплаты. </li>\r\n<li>Организация обучения клиентов.</li>\r\n</ul>', '<ul>\r\n<li>Работа в компании, которая является эксклюзивным дистрибьютором итальянской косметики в России. </li>\r\n<li>Дружный молодой коллектив. </li>\r\n<li>Компенсация проезда/бензина, сотовой связи. Есть возможность предоставить корпоративный транспорт.</li>\r\n<li>График работы: с 10 до 18. </li>\r\n<li>Заработная плата: 70000 оклад + %.</li>\r\n<li>Тип занятости: полная занятость, полный день</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '52', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 14:13:16'),
('53', '17', 'Ведущий инженер-конструктор', 'Ведущий инженер-конструктор', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>90 000 - 140 000 руб.</p>', '<ul>\r\n<li>Образование: высшее. </li>\r\n<li>Необходимый стаж работы по специальности: опыт работы с алюминиевыми конструкциями не менее 2х лет. </li>\r\n<li>Необходимые навыки: знание профильных систем Alutech, Schuco и др., фурнитуры, комплектации. </li>\r\n<li>ПК: MS Word, MS Excel, MS PowerPoint, AutoCAD, SCAD, Лира.</li>\r\n</ul>', '<ul>\r\n<li>проектирование светопрозрачных конструкций; </li>\r\n<li>выполнение документации (КМ и КМД); </li>\r\n<li>согласование документации с заказчиками; </li>\r\n<li>выезды на объекты.</li>\r\n</ul>', '<p>График работы: 5/2, 8:00-17:00 (пн-чт), 8:00-16:00 (пт), <br />обед - 45 мин. <br />Командировки: возможны.</p>', '', '0', '0', '', '', '', '2', '53', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 14:22:40'),
('54', '17', 'Инженер службы заказчика', 'Инженер службы заказчика', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 70 000 руб.</p>', '<ul>\r\n<li>Образование: высшее (техническое или строительное). </li>\r\n<li>Необходимый стаж работы по специальности: опыт работы в службе заказчика от 2х лет. </li>\r\n<li>Необходимые навыки: практический опыт выполнения проектной и рабочей документации по объектам. </li>\r\n<li>ПК: MS Word, MS Excel, AutoCAD (чтение чертежей). </li>\r\n<li>Дополнительные требования: опыт работы и знание распорядительных документов г. Москвы и МО в области градостроительного регулирования.</li>\r\n</ul>', '<ul>\r\n<li>составление и контроль соблюдения графика проектных работ; </li>\r\n<li>контроль соответствия разработанной проектно-сметной документации государственным стандартам, нормам, правилам и инструкциям; </li>\r\n<li>разработка технических заданий, графиков, расчетов стоимости на проектные и строительные работы. Контроль качества и полноты разработки проектной документации; </li>\r\n<li>взаимодействие с контролирующими государственными, надзорными органами; </li>\r\n<li>отчетность.</li>\r\n</ul>', '<p>З/п: 70 000 рублей. <br />Режим работы: 5/2, 8:00-17:00 (пн-чт), 8:00-16:00 (пт), <br />обед - 45 мин. <br />Командировки: возможны.</p>', '', '0', '0', '', '', '', '2', '54', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 14:26:28'),
('55', '14', 'Менеджер активных продаж', 'Менеджер активных продаж', 'Москва, Химки, Шереметьево-1', '0', '1970-01-01', '', '', '<p>по результатам собеседования</p>', '<ul>\r\n<li><strong>Cвободный английский</strong></li>\r\n<li><strong>Наличие опыта продаж и опыта работы в компаниях международных контейнерных перевозок или логистических услуг - от 1го года</strong></li>\r\n<li>Высшее образование</li>\r\n<li>Уверенное пользование ПК (MS Office – Word, Excel, PowerPoint)</li>\r\n<li>Навыки выстраивания отношений и ориентированность на результат</li>\r\n</ul>', '<ul>\r\n<li>Поиск и привлечение клиентов</li>\r\n<li>Подготовка презентация услуг компании</li>\r\n<li>Установление прочных взаимоотношений с клиентами</li>\r\n<li>Организация встреч и переговоров с клиентами</li>\r\n<li>Работа с клиентской базой данных</li>\r\n<li>Работа с внутренним коммерческим отделом для обеспечения должного уровня сервиса клиенту по его потребностям, запросам и жалобам</li>\r\n<li>Анализ и понимание рынка международных контейнерных перевозок</li>\r\n<li>Посещение выставок, мероприятий</li>\r\n</ul>', '<p>Место работы: Шереметьево-1, Солнечногорский район, д. Дубровки; с конца ноября - г. Химки, Бизнес-центр Кантри Парк (корпоративный транспорт от м. Планерная)</p>\r\n<p>График работы: 5/2 с 9-00 до 18-00</p>\r\n<p>Оформление по ТК РФ</p>\r\n<p>Возможны командировки</p>', '', '0', '0', '', '', '', '2', '55', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 16:25:51'),
('56', '14', 'Менеджер по оптовым продажам и по работе с клиентами', 'Менеджер по оптовым продажам и по работе с клиентами', 'Москва, м. Парк Победы', '0', '1970-01-01', '', '', '<p>от 55 000 руб.</p>', '<ul>\r\n<li>Хорошее знание офисного пакета программ Word, Excel, (1C: 8.2 Торговля и Склад, 1C: 8.3 Управление Торговлей - желательно).</li>\r\n<li>Прием, обработка и ведение деловой переписки, заказов, звонков и презентаций с клиентами!</li>\r\n<li>Образование: среднее специальное, высшее.</li>\r\n<li>Опыт работы от 1 года.</li>\r\n<li>Отличные коммуникативные способности, грамотная устная и письменная речь, толерантность, исполнительность, мобильность, энергичность, аккуратность, внимательность, самоконтроль, дисциплинированность.</li>\r\n</ul>', '<ul>\r\n<li>Консультирование и мотивация клиентов к формированию заказов;</li>\r\n<li>Работа с образцами коллекций;</li>\r\n<li>Оформление заказов в Excel, работа с номенклатурой;</li>\r\n<li>Документоведение (архивация файлов, оформление, ведение и отправка договоров и прочей документации);</li>\r\n<li>Изучение и анализ продаж клиентов;</li>\r\n<li>Контроль продаж и отгрузок;</li>\r\n<li>Взаимодействие с транспортными компаниями;</li>\r\n<li>Работа с возвратами и браком (прием и проверка, проведение документов в программе), урегулирование претензий клиентов;</li>\r\n<li>Работа с рекламными материалами, фото и видео;</li>\r\n<li>Подготовка и участие в выставках, проведение презентаций.</li>\r\n</ul>', '<p>Режим работы: 5/2, с 11-00 до 20-00.<br />Устройство по ТК.<br />З/п: от 55 000 руб. + премии по результатам работы.<br />О нас: Оптовая/розничная торговля обувью и аксессуарами.</p>', '', '0', '0', '', '', '', '2', '56', '*', '0', '0000-00-00 00:00:00', '479', '2018-09-20 17:55:27'),
('57', '18', 'Рабочий склада/Грузчик', 'Рабочий склада/Грузчик', 'Шереметьево', '2', '1970-01-01', '', '', '<p>от 35 000 руб.</p>', '<p>Образование: среднее.</p>\r\n<p>Опыт работы по профессии: от полугода.</p>\r\n<p>Готовность к физическим нагрузкам.</p>\r\n<p>Наличие военного билета.</p>', '<p>Погрузка/разгрузка, перемещение по складу, сборка заказов с помощью радиотерминала и WMS.</p>', '<p>Заработная плата: окладно-премиальная, от 35 000 рублей. Премии по итогам года.<br />Испытательный срок: 3 месяца.<br />Социальные льготы: оформление в штат, соцпакет (оплата б/листа, оплачиваемый отпуск 28 календарных дней).<br />Охраняемая стоянка для личного транспорта.<br />Возможность получения прав на электропогрузочную технику без отрыва от работы<br />Режим: сменный по схеме (2/2, дневные и ночные смены по 12 часов).<br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '57', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-08 10:03:17'),
('58', '14', 'Продавец-кассир', 'Продавец-кассир', 'Черная Грязь', '0', '1970-01-01', '', '', '<p>от 40 000 руб.</p>', '<p>Образование: среднее и выше.</p>\r\n<p>Опыт работы: от 1го года.</p>\r\n<p>Коммуникабельность. Опыт работы с кассой и в торговом зале.</p>', '<p>- консультирование покупателей по ассортименту продукции;</p>\r\n<p>- активные продажи;</p>\r\n<p>- работа на кассе;</p>\r\n<p>- прием и выкладка товара;</p>\r\n<p>- участие в инвентаризации.</p>', '<p>Работа в фирменном магазине высококачественной европейской обуви сегмента комфорт плюс.</p>\r\n<p>График работы: с 10 до 22.00.</p>\r\n<p>Корпоративный транспорт от ст. Крюково (Зеленоград) и от Сходни.</p>\r\n<p>Социальные льготы: оформление по ТК РФ.</p>\r\n<p>Испытательный срок: 3 месяца.</p>\r\n<p>З/п: оклад + премии по итогам месяца</p>', '', '0', '0', '', '', '', '2', '58', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-10 17:25:28'),
('59', '2', 'Секретарь/Ресепшионист со знанием английского языка', 'Секретарь/Ресепшионист со знанием английского языка', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Разговорный и письменный английский язык (свободное владение). </p>\r\n<p>Заочная форма обучения в ВУЗЕ или оконченное высшее образование. </p>\r\n<p><span style=\"font-size: 12.16px;\">Опыт работы желателен, но не обязателен. </span>Мы готовы взять без опыта работы, но с огромным желанием развиваться и расти.</p>\r\n<p>Кандидат должен быть открытым, дружелюбным и приветливым. </p>\r\n<p>Внимательность, Ответственность, Пунктуальность.</p>', '<p>- Встреча гостей.</p>\r\n<p>- Прием курьеров. </p>\r\n<p>- Администрирование пропускного режима.</p>\r\n<p>- Прием/распределение входящих звонков.</p>\r\n<p>- Ведение базы данных сотрудников и оформление пропусков.</p>\r\n<p>- Обзвон, получение обратной связи от клиентов.</p>\r\n<p>- Работа с арендаторами (документооборот, получение обратной связи, помощь во взаимодействии с внутренними службами).</p>\r\n<p>- Помощь руководителю по поручениям.</p>', '<p>Заработная плата: оклад + премии и бонусы</p>\r\n<p>Официальное трудоустройство по ТК РФ</p>\r\n<p>Возможность карьерного роста </p>\r\n<p>График работы: 5/2 (пн-пт) c 9:00 до 18:00</p>', '', '0', '0', '', '', '', '2', '59', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-11 14:21:46'),
('60', '22', 'Инженер по снабжению и кооперации', 'Инженер по снабжению и кооперации', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50 000 рублей</p>', '<p>Образование: среднее специальное</p>\r\n<p><strong>Опыт работы в отделе снабжения в приборостроении или смежных отраслях</strong> от 1 года обязателен </p>\r\n<p>Знание основ механообработки</p>\r\n<p>Опыт работы на производстве РЭА</p>', '<p>Закупки.</p>', '<p>Оформление в соответствии с ТК РФ</p>\r\n<p>График работы: 5/2 с 9-00 до 18-00</p>\r\n<p>З/п по результатам собеседования, выплаты без задержек</p>', '', '0', '0', '', '', '', '2', '60', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-18 14:58:58'),
('61', '22', 'Инженер по снабжению ЭРИ', 'Инженер по снабжению ЭРИ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 45 000 рублей</p>', '<p>Образование: среднее специальное</p>\r\n<p><strong>Опыт работы в отделе снабжения в приборостроении или смежных отраслях</strong> от 1 года обязателен</p>\r\n<p>Опыт работы с ЭРИ</p>', '<p>Закупки</p>', '<p>Оформление в соответствии с ТК РФ</p>\r\n<p>График работы: 5/2 с 9-00 до 18-00</p>\r\n<p>З/п по результатам собеседования, выплаты без задержек.</p>', '', '0', '0', '', '', '', '2', '61', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-18 15:09:06'),
('62', '15', 'Ведущий инженер электронщик', 'Ведущий инженер электронщик', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50 000 рублей</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 2 лет</p>\r\n<p>Требования:</p>\r\n<ul>\r\n<li>Знание ЕСКД</li>\r\n<li>Опыт ведения переговоров с заказчиками и деловой переписки</li>\r\n<li>Знание компьютерных программ: Microsoft Office, OrCad</li>\r\n<li>Готовность и умение работать в команде</li>\r\n</ul>', '<p>Ведение работ по изготовлению и отгрузке серийных автоматизированных измерительных комплексов, включая:</p>\r\n<ul>\r\n<li>проработку и согласование технического задания с заказчиком;</li>\r\n<li>общение с заказчиком и оперативное решение возникающих вопросов;</li>\r\n<li>координацию всех отделов в процессе разработки и изготовления изделия;</li>\r\n<li>контроль сроков и техническое сопровождение производства;</li>\r\n<li>разработку электрических схем и эксплуатационной документации в соответствии с требованиями ЕСКД;</li>\r\n<li>отладку и проведение испытаний изделия;</li>\r\n<li>организацию отгрузки изделия;</li>\r\n<li>проведение пуско-наладочных работ</li>\r\n</ul>', '<p>Заработная плата: по результатам собеседования, премии по отгрузке товаров заказчику.</p>\r\n<p>Социальные льготы: трудоустройство по ТК РФ, полный соц. пакет</p>\r\n<p>Режим работы: 5/2, с 9:00 до 18:00 или с 8:00 до 17:00</p>\r\n<p>Возможны краткосрочные командировки</p>', '', '0', '0', '', '', '', '2', '62', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-18 15:13:44'),
('63', '15', 'Инженер-конструктор (электронных приборов)', 'Инженер-конструктор (электронных приборов)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 60 000 рублей</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 2 лет</p>\r\n<p>Знание SolidWorks, ЕСКД</p>\r\n<p>Желательно наличие опыта проектирования кабелей и жгутов</p>', '<p>Разработка конструкторской документации для электронных приборов (сборки приборов, корпуса, кронштейны для крепления приборов, кабели, жгуты)</p>\r\n<p>Проверка исполнителей</p>\r\n<p>Конструкторское сопровождение своих разработок в производстве</p>', '<p>Заработная плата: по результатам собеседования + премии по итогам работы</p>\r\n<p>Возможны подработки</p>\r\n<p>Социальные льготы: трудоустройство по ТК РФ, полный соц. пакет</p>\r\n<p>Режим работы: 5/2, с 9:00 до 18:00 или с 8:00 до 17:00</p>', '', '0', '0', '', '', '', '2', '63', '*', '0', '0000-00-00 00:00:00', '479', '2018-10-18 15:21:00'),
('64', '14', 'Менеджер по продажам (салон мебели)', 'Менеджер по продажам (салон мебели)', 'Химки', '0', '1970-01-01', '', '', '<p>от 30 000 рублей</p>', '<p>Образование: среднее и выше</p>\r\n<p>Опыт работы в продажах - от 1го года.</p>\r\n<p>Коммуникабельность.</p>\r\n<p>Опыт презентации продукции и компании.</p>\r\n<p>Желателен опыт работы в графических редакторах, хороший вкус в дизайне интерьеров.</p>', '<p>- Работа с клиентами в салоне, выявление потребностей клиента, работа с возражениями.</p>\r\n<p>- Презентация продукции (кухонная мебель, сопутствующие товары).</p>\r\n<p>- Разработка дизайн-проектов и просчет стоимости кухонных гарнитуров.</p>\r\n<p>- Оформление договоров.</p>\r\n<p>- Координация процессов до момента поставки продукции покупателю.</p>\r\n<p>- Фиксирование клиентов в программах фабрики.</p>', '<p>З/п: оклад + % с продаж и премии</p>\r\n<p>График работы: 2/2, с 11-00 до 21-00</p>', '', '0', '0', '', '', '', '2', '64', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-21 12:49:07'),
('65', '6', 'Сервисный инженер (техник)', 'Сервисный инженер (техник)', 'Москва, м. Текстильщики', '0', '1970-01-01', '', '', '<p>по договоренности</p>', '<ul>\r\n<li>Образование: среднее специальное;</li>\r\n<li>Навыки проведения ремонтных и наладочных работ компрессорной техники;</li>\r\n<li>Знание основных принципов ремонта механических узлов, основ электрики и автоматики;</li>\r\n<li>Умение читать чертежи оборудования и электрические схемы;</li>\r\n<li>Работа с ПК в качестве пользователя;</li>\r\n<li>Знание работы частотных преобразователей в системах электродвигателя или холодильной техники - является преимуществом;</li>\r\n<li>Наличие навыков работы с ЧП и системами управления;</li>\r\n<li>Опыт работы в ремонте и ТО холодильной или компрессорной техники от 2х лет - преимущество;</li>\r\n<li>Наличие водительского удостоверения категории В и стаж вождения от 2 лет;</li>\r\n<li>Готовность к разъездному характеру работы.</li>\r\n</ul>', '<ul>\r\n<li>Выезд в компанию в целях ТО и ремонта компрессорной техники;</li>\r\n<li>Качественный ремонт и ТО промышленной компрессорной техники;</li>\r\n<li>Отчет по результатам выполнения работы.</li>\r\n</ul>', '<ul>\r\n<li>Оформление согласно ТК РФ;</li>\r\n<li>График работы 5/2, 8-17;</li>\r\n<li>Разъездная работа по Москве и югу МО (в офис приезжать 1-2 раза в неделю по необходимости);</li>\r\n<li>ДМС включая стоматологию и госпитализацию;</li>\r\n<li>Мобильная связь;</li>\r\n<li>Компенсация занятий спортом;</li>\r\n<li>Обучение и возможность развития в рамках международной компании;</li>\r\n<li>Пенсионная программа;</li>\r\n<li>Бесплатные обеды в офисе компании.</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '65', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-21 12:59:34'),
('66', '18', 'Кладовщик', 'Кладовщик', 'Шереметьево', '0', '1970-01-01', '', '', '<p>от 45 000 рублей</p>', '<ul>\r\n<li>Опыт работы на складе - от 2х лет</li>\r\n<li>Опыт работы с ТСД (терминалом сбора данных) - обязателен!</li>\r\n<li>Образование: не ниже среднего специального</li>\r\n<li>Уверенный пользователь ПК</li>\r\n<li>Опыт работы с запчастями</li>\r\n<li>Опыт учета и погрузки товара</li>\r\n<li>Физическая выносливость</li>\r\n<li>Ответственность, внимательность</li>\r\n<li>Сосредоточенность, аккуратность, пунктуальность, честность</li>\r\n</ul>', '<p>- Погрузо-разгрузочные работы (вручную).<br />- Сборка накладных на складе, подбор продукции под заказ.<br />- Оформление документов.<br />- Распределение товара по местам хранения.<br />- Работа с б/у запчастями.<br />- Обеспечение сохранности материалов.<br />- Участие в инвентаризации.<br />- Текущие складские работы.<br />- Материальная ответственность.</p>', '<p>Работа в американской компании с перспективой долгосрочного сотрудничества<br />График работы: 5/2, с 9-00 до 18-00 (пн-чт), с 9-00 до 17-00 (пт)<br />Стабильность<br />Оформление по ТК<br />Есть корпоративный транспорт от Зеленограда и от м. Войковская</p>', '', '0', '0', '', '', '', '2', '66', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-21 13:20:16'),
('67', '16', 'Парикмахер', 'Парикмахер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 30 000 рублей</p>', '<table class=\"table-to-div\" style=\"height: 135px; width: 544px;\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr style=\"height: 33px;\">\r\n<td style=\"width: 117px; height: 33px;\">\r\n<p>Образование</p>\r\n</td>\r\n<td style=\"width: 425px; height: 33px;\">\r\n<p>Среднее специальное</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 33px;\">\r\n<td style=\"width: 117px; height: 33px;\">\r\n<p>Опыт работы</p>\r\n</td>\r\n<td style=\"width: 425px; height: 33px;\">\r\n<p>От 2 лет</p>\r\n</td>\r\n</tr>\r\n<tr style=\"height: 43px;\">\r\n<td style=\"width: 117px; height: 43px;\" valign=\"top\">\r\n<p>Требования</p>\r\n</td>\r\n<td style=\"width: 425px; height: 43px;\">\r\n<p>Трудолюбие, пунктуальность, аккуратность, честность</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>', '<ul>\r\n<li>Стрижки</li>\r\n<li>Укладки</li>\r\n<li>Окрашивания</li>\r\n</ul>', '<p>Заработная плата (размер и форма оплаты): от 30000</p>\r\n<p>Режим работы: сменный график</p>', '', '0', '0', '', '', '', '2', '67', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-21 15:21:40'),
('68', '10', 'Менеджер по связям с общественностью (PR-менеджер)', 'Менеджер по связям с общественностью (PR-менеджер)', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<ul>\r\n<li>Образование: высшее</li>\r\n<li>Опыт работы в аналогичной должности/сфере: от 2-х лет</li>\r\n<li>Безупречный русский язык - письменный и устный, чувство стиля и гармонии текста</li>\r\n<li>Коммуникабельность, в том числе умение работать с негативом</li>\r\n<li>Творческий подход</li>\r\n<li>Отличный навык поиска информации</li>\r\n<li>Активный пользователь социальных сетей</li>\r\n<li>Большим плюсом будет умение фотографировать, знание Photoshop или др. графических программ</li>\r\n<li>Наличие собственных контактов по базе СМИ как плюс</li>\r\n<li>Английский язык не ниже уровня - Intermediate (письменный обязателен)</li>\r\n<li>Опытный пользователь MS Office: Word, Excel, Power Point</li>\r\n<li>Личностные качества: высокий уровень самоорганизации, ответственность, коммуникабельность, инициативность.</li>\r\n</ul>', '<ul>\r\n<li>Написание пресс-релизов, комментариев, текстов для сайта группы компаний, составление пресс-китов.</li>\r\n<li>Поддержка сайтов стартапов группы компаний (менеджмент, обновление контента и т.п.).</li>\r\n<li>Поддержание актуальной информации о проектах компании в интернете, своевременное обновление.</li>\r\n<li>Ведение страниц в соцсетях (Facebook, Twitter, Instagram).</li>\r\n<li>Мониторинг отраслевых событий и сообществ.</li>\r\n<li>Участие в организации выставок и корпоративных мероприятий.</li>\r\n<li>Контроль наличия и надлежащего качества POS-материалов.</li>\r\n<li>Разработка корпоративной полиграфической продукции/POSM, рекламы, баннеров на сайт, упаковки и т.п.</li>\r\n<li>Сбор информации и постановка ТЗ дизайнерам, отслеживание сроков исполнения заданий.</li>\r\n<li>Разработка и заказ корпоративной сувенирной продукции.</li>\r\n</ul>', '<ul>\r\n<li>Место работы находится в Химках, график работы: 5/2, с 9-00 до 18-00 или с 10-00 до 19-00.</li>\r\n<li>Должностные командировки: бывают не часто.</li>\r\n<li>Трудоустройство по ТК РФ; Оплачиваемый отпуск.</li>\r\n<li>Карьерный рост в высокотехнологичной компании.</li>\r\n<li>З/п по результатам собеседования.</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '68', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-23 10:12:50'),
('69', '14', 'Продавец-консультант (Шереметьево)', 'Продавец-консультант (Шереметьево)', 'Шереметьево', '0', '1970-01-01', '', '', '<p>от 40000 рублей</p>', '<p>Опыт работы в сегменте мужской брендовой одежды: от 2х лет.</p>', '<ul>\r\n<li>Консультирование покупателей в зале.</li>\r\n<li>Работа с кассой.</li>\r\n<li>Поддержание чистоты на рабочем месте.</li>\r\n</ul>', '<ul>\r\n<li>График работы: 2/2.</li>\r\n<li>Отпуск по ТК РФ, дробится на 2 недели.</li>\r\n<li>Оформление по трудовой книжке.</li>\r\n<li>Есть возможность организации корпоративного транспорта.</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '69', '*', '0', '0000-00-00 00:00:00', '479', '2018-11-27 10:22:21'),
('70', '14', 'Менеджер по продажам (luxury segment / лакшери сегмент)', 'Менеджер по продажам (luxury segment / лакшери сегмент)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>по договоренности</p>', '<p>Опыт продаж в лакшери сегменте (luxury segment) - от 1го года.</p>\r\n<p>Обязательно наличие личного автомобиля. Водительские права категории B.</p>\r\n<p> </p>', '<p>Продажа тюнингованных VIP-автомобилей, услуг тюнинга.</p>\r\n<p>Взаимодействие с клиентами, ведение переговоров, сопровождение сделок.</p>\r\n<p>Презентация компании и ее продукции.</p>', '<p>Современной зеленоградской компании, занимающейся тюнингом салонов автомобилей класса премиум по индивидуальным заказам, требуются менеджеры по продажам с опытом работы в сегменте лакшери.</p>\r\n<p>Заработная плата: оклад + проценты</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '70', '*', '0', '0000-00-00 00:00:00', '479', '2018-12-06 10:10:26'),
('71', '15', 'Водитель погрузчика / электроштабелера', 'Водитель погрузчика / электроштабелера', 'Есипово', '0', '1970-01-01', '', '', '<p>47000 рублей gross</p>', '<ul>\r\n<li>Образование: среднее и выше</li>\r\n<li>Права категории B или C</li>\r\n<li>Права тракториста-машиниста</li>\r\n<li>Необходимый стаж работы по специальности: от 0, 5 года на складах ответ. хранения</li>\r\n<li>Опыт работы с радиотерминалом, на погрузочной технике</li>\r\n<li>Исполнительность, ответственность</li>\r\n</ul>', '<ul>\r\n<li>Разгрузочно-погрузочные работы на погрузчике </li>\r\n<li>Перемещение груза</li>\r\n</ul>', '<p>Современный завод по производству новейшей техники заинтересован в квалифицированных специалистах: водителей погрузчика / электроштабелера категории B или С.<br />Вы будете работать в ультрасовременном теплом производственном здании на самом современном литий-ионном электропогрузчике.<br />Работодатель гарантирует соблюдение всех Ваших прав по ТК РФ, медицинскую страховку, питание, отпуск, рабочую форму и другие льготы, установленные законодательством РФ.</p>', '', '0', '0', '', '', '', '2', '71', '*', '0', '0000-00-00 00:00:00', '479', '2018-12-24 16:34:15'),
('72', '15', 'Кладовщик-комплектовщик', 'Кладовщик-комплектовщик', 'Есипово', '0', '1970-01-01', '', '', '<p>40000 рублей gross</p>', '<ul>\r\n<li>Образование: среднее и выше</li>\r\n<li>Необходимый стаж работы по специальности: от 0,5 года на складах ответ. хранения</li>\r\n<li>Опыт работы со сканером</li>\r\n<li>Исполнительность, ответственность</li>\r\n</ul>', '<ul>\r\n<li>Распаковка</li>\r\n<li>Подбор комплектующих </li>\r\n<li>Работа со сканером</li>\r\n</ul>', '<p>Современный завод по производству новейшей техники заинтересован в квалифицированных кладовщиках-комплектовщиках.<br />Вы будете работать в ультрасовременном теплом производственном здании, участвовать в комплектации рабочих мест по сборке.<br />Работодатель гарантирует соблюдение всех Ваших прав по ТК РФ, медицинскую страховку, питание, отпуск, рабочую форму и другие льготы, установленные законодательством РФ.</p>', '', '0', '0', '', '', '', '2', '72', '*', '0', '0000-00-00 00:00:00', '479', '2018-12-24 16:38:54'),
('73', '14', 'Менеджер по продажам запчастей (промышленное оборудование)', 'Менеджер по продажам запчастей (промышленное оборудование)', 'Москва, м. Водный Стадион', '0', '1970-01-01', '', '', '<p>до 135 000 руб.</p>', '<p>- Техническое высшее образование;</p>\r\n<p>- Водительские права категории B;</p>\r\n<p>- <strong>Наличие личного автомобиля.</strong> Гарантируем компенсацию расходов и ГСМ;</p>\r\n<p>- <strong>Опыт продаж запчастей / комплектующих для промышленного / индустриального оборудования, техники - от 3х лет;</strong></p>\r\n<p>- Коммуникабельность, навык устанавливать и поддерживать долгосрочные отношения с клиентом;</p>\r\n<p>- Целеустремленность.</p>', '<ul>\r\n<li>Активные продажи комплектующих для промышленного оборудования.</li>\r\n<li>Работа с клиентами.</li>\r\n<li>Контроль просроченной дебиторской задолженности.</li>\r\n<li>Презентация продукции. Техническое консультирование клиентов по особенностям продукции, выявление и описание ее конкурентных преимуществ.</li>\r\n<li>Выезд на предприятие заказчика, в т. ч. командировки, проведение переговоров.</li>\r\n<li>Представление компании на выставках и других мероприятиях.</li>\r\n</ul>', '<p>Преимущественно разъездной характер работы.</p>\r\n<p>График работы 5/2, с 9-00 до 18-00.</p>\r\n<p>Оплачиваемый отпуск и больничный.</p>\r\n<p>Оплачиваемая корпоративная сотовая связь.</p>\r\n<p>Компенсация командировочных расходов, ГСМ.</p>\r\n<p>Возможность профессионального обучения и развития.</p>\r\n<p>Перспектива карьерного роста.</p>\r\n<p>Испытательный срок: 3 месяца.</p>\r\n<p>Заработная плата: на испытательный срок - оклад, после - оклад + премия от продаж.</p>', '', '0', '0', '', '', '', '2', '73', '*', '0', '0000-00-00 00:00:00', '479', '2019-01-09 12:31:40'),
('74', '17', 'Сметчик по инженерно-коммуникационным сетям', 'Сметчик по инженерно-коммуникационным сетям', 'Москва, м. Беговая', '0', '1970-01-01', '', '', '<p><b>от 50 000 руб.</b></p>', '<ul>\r\n<li>Образование: среднее и выше</li>\r\n<li>Опыт работы с инженерно-коммуникационными сетями - от 2х лет</li>\r\n<li>Внимательность, аккуратность</li>\r\n</ul>', '<p>- работа со сметной документацией<br />- анализ сметного ценообразования<br />- работа с соответствующим программным обеспечением</p>', '<p>- график работы: 5/2, с 8-00 до 17-00<br />- оформление по ТК<br />- оплачиваемые отпуска, больничный</p>', '', '0', '0', '', '', '', '2', '74', '*', '0', '0000-00-00 00:00:00', '479', '2019-01-16 14:26:48'),
('76', '17', 'Машинист-экскаваторщик на полноповоротный экскаватор', 'Машинист-экскаваторщик на полноповоротный экскаватор', 'Москва, м. Беговая', '0', '1970-01-01', '', '', '<p>60 000 руб.</p>', '<p>Образование: среднее и выше.</p>\r\n<p>Опыт работы: от 3х лет.</p>\r\n<p>Водительские права на экскаватор</p>\r\n<p>Опыт работы в сфере тепло-коммуникационных сетей - от 3х лет</p>', '<p>Управление полноповоротным экскаватором во время работы на проектах.</p>', '<p>- график работы: 5/2, с 8-00 до 17-00<br />- оформление по ТК<br />- оплачиваемые отпуска, больничные<br />- корпоративный транспорт от метро Беговая (5 мин)</p>', '', '0', '0', '', '', '', '2', '76', '*', '0', '0000-00-00 00:00:00', '479', '2019-01-16 14:31:24'),
('77', '14', 'Менеджер отдела продаж инженерных систем для загородных домов', 'Менеджер отдела продаж инженерных систем для загородных домов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50 000 руб.</p>', '<p>Образование: Высшее</p>\r\n<p>Опыт работы: От 3 лет в сфере продаж загородных домов и/или инженерных систем</p>\r\n<p>Необходимые навыки: коммуникабельность, внимательность, ответственность</p>\r\n<p>ПК: уверенный пользователь (знание пакета программ MS Office), 1C Предприятия версии 8.3, AMOCRM</p>', '<p>- продажи,</p>\r\n<p>- ведение базы CRM,</p>\r\n<p>- без холодных звонков, работа с заказчиками, ранее обращавшимися в компанию</p>', '<p>Заработная плата: от 50000 рублей на руки, система: оклад + бонус</p>\r\n<p>Социальные льготы: испытательный срок - 3 месяца, работа по договору, трудовая книжка после испытательного срока</p>\r\n<p>Режим работы: 5/2, с 9-00 до 18-00 с плавающими выходными (при выходе на работу в выходной день предоставляется отгул)</p>\r\n<p>Командировки: возможны.</p>', '', '0', '0', '', '', '', '2', '77', '*', '0', '0000-00-00 00:00:00', '479', '2019-01-24 18:14:26'),
('78', '3', 'Главный бухгалтер (оптовая торговля)', 'Главный бухгалтер (оптовая торговля)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт работы: от 5-ти лет</p>\r\n<p>Образование: высшее (экономика, бухгалтерия)</p>\r\n<p>Опыт работы руководителем, главным бухгалтером</p>\r\n<p>Опыт работы на предприятии оптовой торговли схожей направленности (приборы, компоненты, электротехнические изделия и т.д.)</p>', '<p>Ведение бухгалтерии, руководство линейными бухгалтерами и двумя главными бухгалтерами соподчиненных структур в группе компаний, занимающейся оптовыми продажами электронными компонентами на российском рынке.</p>\r\n<p>Работа с большой номенклатурой.</p>', '<p>Заработная плата: по договоренности</p>\r\n<p>Характер работы: на территории работодателя</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Полный соц. пакет.</p>', '', '0', '0', '', '', '', '2', '78', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 11:14:03'),
('79', '3', 'Главный бухгалтер (в единственном лице)', 'Главный бухгалтер (в единственном лице)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>60 000 рублей</p>', '<p> </p>\r\n<p>Необходимый стаж работы по специальности: от 3х лет</p>\r\n<p>Образование - высшее (бухгалтерское, экономическое, финансовое).</p>\r\n<p>Знание: ОСН, 1С 8.3, MS Office, Систем Банк-Клиент, Гарант, Консультант. Законодательства по БУ, НК РФ, законодательства РФ по МФО, ТК и кадрового делопроизводства</p>\r\n<p>ПК: Уверенный пользователь (1С версии 8, MS Office)</p>', '<p>Ведение бухгалтерского, налогового учета в полном объеме.</p>\r\n<p>Сдача бухгалтерской и налоговой отчетности.</p>\r\n<p>Взаимодействие с финансово-кредитными организациями</p>\r\n<p>Подготовка документов по запросам гос. органов (ФНС, ФТС, и т.п.).</p>\r\n<p>Расчет и начисление заработной платы персонала компании.</p>\r\n<p>Ведение расчетных/кредитных/депозитных счетов в разных валютах.</p>\r\n<p>Оформление авансовых отчетов и командировочных документов</p>\r\n<p>Составление финансовых отчетов для руководства</p>', '<p>В небольшую компанию в сфере дорожного строительства требуется главный бухгалтер.</p>\r\n<p>Оформление по ТК РФ.</p>\r\n<p>График работы 5/2 с 9:00 до 18:00.</p>', '', '0', '0', '', '', '', '2', '79', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 11:16:47'),
('80', '3', 'Начальник договорного экономического отдела', 'Начальник договорного экономического отдела', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 70 000 до 100 000 рублей </p>', '<p>Опыт работы: от 3 лет</p>\r\n<p>Образование: высшее (финансы, экономика, менеджмент)</p>\r\n<p>Опыт работы с НИОКР</p>\r\n<p>Опыт руководства коллективом (от 3х человек)</p>\r\n<p>Грамотная речь и письмо</p>\r\n<p>Уверенное пользование ПК. Хорошее знание Excel, Word, Outlook</p>\r\n<p>Ответственность, внимательность, организаторские навыки, коммуникабельность</p>', '<p>Организация работы отдела</p>\r\n<p>Работа по составлению договоров, спецификаций и других приложений к договорным документам</p>\r\n<p>Работа с расчетно-калькуляционными материалами по договорам</p>\r\n<p>Работа с плановой и отчетной калькуляцией по составляемой продукции</p>\r\n<p>Общение с заказчиками по различным вопросам</p>\r\n<p>Учет заявок и ведение базы данных договоров</p>', '<p>Работа в крупной и растущей компании в Зеленограде</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Оформление по ТК</p>\r\n<p>Белая заработная плата</p>', '', '0', '0', '', '', '', '2', '80', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 11:19:57'),
('81', '3', 'Заместитель главного бухгалтера', 'Заместитель главного бухгалтера', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 70 000 до 100 000 рублей</p>', '<p> </p>\r\n<p>Опыт работы: от 3 лет</p>\r\n<p>Образование: высшее (финансы, экономика, менеджмент)</p>\r\n<p>Опыт работы с НИОКР, с госзаказом</p>\r\n<p>Знание порядка ведения всех участков бухгалтерии</p>\r\n<p>Знание порядка работы с казначейскими обязательствами</p>\r\n<p>Грамотная речь и письмо</p>\r\n<p>Уверенное пользование ПК. Хорошее знание Excel, Word, Outlook</p>\r\n<p>Ответственность, внимательность</p>', '<p>Ведение всех участков бухгалтерии компании</p>\r\n<p>Работа с казначейскими обязательствами</p>\r\n<p>Учет/списание затрат</p>\r\n<p>Работа с госзаказом</p>', '<p>Работа в крупной и растущей компании в Зеленограде</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Оформление по ТК</p>\r\n<p>Белая заработная плата</p>', '', '0', '0', '', '', '', '2', '81', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 11:37:33'),
('82', '3', 'Финансовый директор / контролер / CFO', 'Финансовый директор / контролер / CFO', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>До 150 000 рублей</p>', '<p><strong>Знание английского языка: разговорный уровень.</strong></p>\r\n<p>Опыт работы в аналогичной должности: от 3-х лет.</p>\r\n<p>Владение инструментами международной финансовой отчетности (<strong>МФСО / IRFS, US GAAP</strong>).</p>\r\n<p>Опыт работы с иностранными аудиторами.</p>\r\n<p>Знание ПК: на уровне уверенного пользователя (1С Предприятие).</p>\r\n<p>Понимание бухгалтерии в производстве, желателен опыт работы главным бухгалтером.</p>', '<p>В обязанности будут входить:</p>\r\n<ul>\r\n<li>Контроль бухгалтерии</li>\r\n<li>Трансформация финансовой отчетности из РСБУ в МСФО</li>\r\n<li>Работа с иностранными аудиторами</li>\r\n<li>Предоставление финансовой отчетности иностранным учредителям, общение с ними на английском языке.</li>\r\n</ul>', '<p>В иностранную производственную компанию, занимающуюся изготовлением светопрозрачных конструкций, требуется Финансовый контролер (CFO), офис подразделения компании располагается в г. Солнечногорск.</p>\r\n<p>График работы: 5/2.<br />Заработная плата: до 150 000 рублей.<br />Возможны командировки.</p>', '', '0', '0', '', '', '', '2', '82', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 11:42:46'),
('83', '18', 'Менеджер по логистике (на удаленном доступе)', 'Менеджер по логистике (на удаленном доступе)', 'Москва', '0', '1970-01-01', '', '', '<p>от 40 000 рублей</p>', '<p>Образование: среднее и выше</p>\r\n<p>Необходимый стаж работы по специальности: от 1 года</p>\r\n<p>Необходимые навыки: коммуникабельность, грамотная речь, целеустремленность, умение продавать, желателен опыт работы с сайтами АТИ и DELLA.</p>\r\n<p>ПК: знание программ 1С, MS Office, AmoCRM</p>', '<p>- Обработка входящих заявок.</p>\r\n<p>- Работа с площадками (АТИ, DELLA).</p>\r\n<p>- Теплые звонки, работа с постоянными клиентами.</p>\r\n<p>- Ведение документооборота.</p>', '<p>Работа в компании, специализирующейся на предоставлении услуг по перевозке грузов.</p>\r\n<p>Заработная плата (форма оплаты): первые 2 месяца - фиксированный оклад, после - перевод на систему оплаты по процентам.</p>\r\n<p>Режим работы: 5/2, с 9-00 до 18-00, на удаленном доступе.</p>', '', '0', '0', '', '', '', '2', '83', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-18 12:12:45'),
('84', '4', 'Руководитель отдела продаж (промышленное маркировочное оборудование)', 'Руководитель отдела продаж (промышленное маркировочное оборудование)', 'Москва, м. Савеловская', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 3 лет</p>\r\n<p>- Практический опыт организации и развития товарного (!) направления (сегмент В2В)</p>\r\n<p>- Практический опыт управления трудовым коллективом (подбор, обучение, мотивация, персонала)</p>\r\n<p>- Свободное владение английским языком (коммуникации с зарубежными бизнес-партнерами)</p>\r\n<p>- Яркие административные и коммуникационные навыки</p>', '<p>- Разработка стратегии развития направления \"Промышленная Маркировка\"</p>\r\n<p>- Оперативное управление работой отдела (4 человека)</p>\r\n<p>- Определение ассортиментной политики направления (ввод/вывод на рынок, ценообразование)</p>\r\n<p>- Определение дилерской политики (российские регионы и страны СНГ)</p>\r\n<p>- Взаимодействие с поставщиками оборудования и расходных материалов</p>\r\n<p>- Взаимодействие с сервисным подразделением (установка, ремонт, сопровождение оборудования)</p>\r\n<p>- Активная работа с корпоративным сайтом компании - создание и актуализация контента, постановка задач по его продвижению в интернете</p>\r\n<p>- Планирование закупок оборудования и расходных материалов в четкой связке с планами продаж и складскими остатками</p>\r\n<p>- Взаимодействие с отделом закупок по размещению заказов, оптимизации сроков и себестоимости заказываемого ассортимента</p>', '<p>Мы находимся в поисках кандидатов на позицию Руководитель отдела продаж промышленного маркировочного оборудования и расходных материалов в компанию, которая является известным трейдером оборудования и расходных материалов для производства сувенирной продукции.</p>\r\n<p>Офис компании располагается в районе станции метро \"Савеловская\".</p>\r\n<p>Заработная плата обсуждается индивидуально (размер и структура оплаты).</p>', '', '0', '0', '', '', '', '2', '84', '*', '0', '0000-00-00 00:00:00', '479', '2019-02-27 11:20:46'),
('85', '5', 'Семейная пара с проживанием', 'Семейная пара с проживанием', 'Истра', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: среднее специальное и выше</p>\r\n<p>Опыт работы: от 3 лет</p>\r\n<p>Водительские права: категория B</p>\r\n<p>Муж должен быть исполнительным, со знаниями работы по дому, чтобы смог произвести мелкий ремонт (сантехника, электрика).<br />Жена должна любить готовить.<br />Спокойные, ответственные, доброжелательные, внимательные к деталям люди.</p>', '<p>В мужские обязанности входит:</p>\r\n<ul>\r\n<li>работа по дому (мелкий ремонт, камин и др.),</li>\r\n<li>работа по участку (уборка снега, стрижка газона и растительности),</li>\r\n<li>уход за территорией и растительностью,</li>\r\n<li>закупки продуктов,</li>\r\n<li>периодически обязанности водителя (например, довезти ребенка в сад и обратно);</li>\r\n</ul>\r\n<p>В женские обязанности входит:</p>\r\n<ul>\r\n<li>готовка (умение готовить постную еду), сервировка стола,</li>\r\n<li>сухая и влажная уборка,</li>\r\n<li>знание бытовой химии и бытовой техники,</li>\r\n<li>уход за одеждой и обувью,</li>\r\n<li>стирка, глажка.</li>\r\n</ul>', '<p>Место работы: в окрестностях Истры</p>\r\n<p>Заработная плата: по договоренности</p>\r\n<p>Характер работы: на территории работодателя</p>\r\n<p>График работы: полный рабочий день</p>\r\n<p>Требуется семейная пара с проживанием в частный дом (500 м<sup>2</sup>), участок 30 соток, половину занимают мощеные парковочные места, остальная часть газон - из деревьев: ели, сосны, немного плодовых деревьев. <br />График 6/1 - есть возможность накопления выходных.<br />Не нормированный рабочий день, есть возможность отдохнуть днем.<br />Проживание и питание за счет работодателя.</p>', '', '0', '0', '', '', '', '2', '85', '*', '0', '0000-00-00 00:00:00', '479', '2019-03-06 09:29:17'),
('86', '5', 'Няня-гувернантка', 'Няня-гувернантка', 'Истра (деревня Павловское)', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт работы с детьми от 2 лет.<br />Коммуникабельность, организованность, внимательность, ответственность, активная жизненная позиция.<br />Действующий загранпаспорт на срок с 06.2020 по 08.2020 включительно. <br />Решимость проработать на одном месте как минимум до сентября 2020 года.</p>', '<p>Мы находимся в поисках няни для мальчиков 8-ми и 1,5 лет.</p>\r\n<p><br />В обязанности будут входить:<br />- помощь родителям (\"вторые руки\") в виде занятий с одним из детей (настольные игры, прогулка 1 раз в день, общение, чтение со старшим), присмотр, работа параллельно с мамой. Старший ребенок находится на семейном обучении.<br />- помощь в поддержании порядка в доме (загрузить посудомойку после обеда, вытереть со стола, организовать детей собрать игрушки).<br />- в перспективе - выезд за границу на 2 месяца (по работе одного из родителей - с середины июня по середину августа) летом 2020 года (с выполнением там уборки и приготовления еды). Летние 2 месяца оплачиваются по отдельному тарифу. Соответственно, необходимы действующий загранпаспорт на этот срок и возможность без обременения уехать на 2 месяца.</p>', '<p>Загородный дом в Подмосковье, деревня Павловское (ближайшие города - Истра, Дедовск). <br />Проезд до места работы оплачивается. <br />Начало работы - 10:00, завершение работы - 18:00. <br />Дни работы: пятница, суббота, понедельник. Возможны варианты: пт, сб, вс или сб, вс, пн, если изначально указанные дни не подходят.</p>', '', '0', '0', '', '', '', '2', '86', '*', '0', '0000-00-00 00:00:00', '479', '2019-03-12 13:06:31');
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('87', '5', 'Няня (Зеленоград)', 'Няня (Зеленоград)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 рублей</p>', '<p>Шустрая, опытная женщина</p>\r\n<p>Наличие личного автомобиля крайне приветствуется, чтобы отвозить ребенка в бассейн</p>\r\n<p> </p>', '<p>Помощь родителям, уход за ребенком (мальчиком) в возрасте 1,5 лет, прогулки, готовка еды, уборка за ребенком, стирка за ребенком, глажка.<br />2 раза в неделю необходимо отвозить ребенка в бассейн.</p>', '<p>График работы: 5/2, с 8-30 до 19-30<br />Место работы: Зеленоград, 20 мкр.<br />Заработная плата: от 40000 рублей в месяц</p>', '', '0', '0', '', '', '', '2', '87', '*', '0', '0000-00-00 00:00:00', '479', '2019-03-12 13:20:30'),
('88', '15', 'Слесарь МСР', 'Слесарь МСР', 'Шереметьево', '0', '1970-01-01', '', '', '<p>от 50 000 руб.</p>', '<p>Образование: среднее специальное</p>\r\n<p>Опыт работы: от 1 года</p>\r\n<p>Обратите внимание!<br />Спецодежда с длинным рукавом куртка и брюки у Вас должны быть свои. <br />А вот спецочки и спецобувь компания Вам покупает (эти вещи достаточно специфические и дорогие, соответствующие определенному стандарту). <br />Перчатки также выдают. Они тоже стандартизированы.</p>', '<p>В крупную американскую компанию требуется слесарь Механо-сборочных Работ.<br />Компания занимается производством климатического оборудования.</p>', '<p>Место работы в районе Шереметьево, квартал Клязьма. <br />Заработная плата: 50 000 до вычета налогов, можно брать переработки, что удобно с учетом графика. <br />График работы: 5/2 с 7:00 до 15:45. <br />Качественный инструментарий.<br />Вкусная столовая.<br />Корпоративный транспорт из Зеленограда от станции Крюково, автобус отходит в 6:00. <br />С Химок - 62 автобус.<br />После окончания рабочего дня, корпоративный транспорт возвращает работников в Зеленоград.</p>', '', '0', '0', '', '', '', '2', '88', '*', '0', '0000-00-00 00:00:00', '479', '2019-03-20 17:23:22'),
('89', '14', 'Менеджер по продажам (шпон, древесина)', 'Менеджер по продажам (шпон, древесина)', 'Химки', '0', '1970-01-01', '', '', '<p>от 45 000 рублей + премии </p>', '<p>Активность, коммуникабельность, целеустремленность и желание зарабатывать.</p>\r\n<p>Высшее образование</p>\r\n<p>Опыт в продажах от 2-х лет</p>\r\n<p>Водительское удостоверение категории В</p>', '<p>В компании-лидере в продажах натурального шпона и древесины открыт набор менеджеров по продажам.</p>\r\n<p>Есть возможность обучения, перспективы развития и роста заработка.</p>\r\n<p>Стабильная работа. </p>\r\n<p>Молодой и амбициозный коллектив.</p>', '<p>График работы 5/2 с 9 до 18:00</p>\r\n<p>Оклад 45 000 р. + премии</p>\r\n<p>Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '89', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-02 10:18:24'),
('90', '2', 'Администратор офиса, офис-менеджер', 'Администратор офиса, офис-менеджер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 до 50000 рублей</p>', '<p>В компанию, специализирующуюся на предоставлении услуг по нанесению защитных покрытий на металлоконструкции и по промышленной очистке, требуется специалист на позицию Администратор офиса.</p>\r\n<p>Образование: высшее</p>\r\n<p>Опыт работы: от 3 лет</p>\r\n<p>Опыт работы в административной сфере (офис-менеджер, секретарь, помощника руководителя отдела кадров, помощника руководителя).</p>\r\n<p>Грамотная устная и письменная речь.</p>\r\n<p>Пунктуальность, исполнительность, внимательность, аккуратность, умение работать в режиме многозадачности.</p>\r\n<p>ПК: Уверенный пользователь ПК (Excel; Word) и офисной оргтехники.</p>', '<p>Регистрация входящей и исходящей корреспонденции;<br />Регистрация и передача на исполнение первичных бухгалтерских документов;<br />Ведение реестра договоров;<br />Отправка корреспонденции;<br />Прием и распределение входящих звонков;<br />Прием посетителей;<br />Обеспечение офиса канцтоварами, водой и т.п.;<br />Подача заявок на ремонт, уборку;<br />Размещение, обновление вакансий по заданию руководителя;<br />Работа по планам руководителя отдела кадров, бухгалтерии и штатного юриста, работа с документацией.</p>', '<p>Заработная плата (размер и форма оплаты): от 40 000 до 50 000 руб., обсуждается на собеседовании;<br />Социальные льготы: Оформление в соответствии с ТК РФ;<br />Бесплатная парковка на территории Бизнес-центра;<br />Режим работы: 5/2, с 9:30 до 18:00.</p>', '', '0', '0', '', '', '', '2', '90', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-11 17:41:28'),
('91', '5', 'Няня (вахта 30/30)', 'Няня (вахта 30/30)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>70 000 руб.</p>', '<p>Опыт работы в семьях.<br />Коммуникабельность, активная жизненная позиция.</p>', '<p>Уход за детьми.</p>', '<p>Требуется с няня в коттедж, с опытом работы в семьях, для двух мальчиков (1 год и 3 года); <br />График работы 5/2 с 9.00 до 21.00. Вахта 30 дней; <br />Проживание в отдельном доме. Начало работы: 22.04.2019 г.</p>', '', '0', '0', '', '', '', '2', '91', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-12 15:40:26'),
('93', '21', 'Юрист', 'Юрист', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее;</p>\r\n<p>Необходим опыт работы по специальности, желательно в производственной компании;</p>\r\n<p>Необходимые навыки: высокое чувство ответственности, исполнительность, обучаемость, коммуникабельность, порядочность;</p>\r\n<p>ПК: Уверенный пользователь (Excel; Word).</p>\r\n<p> </p>', '<p>- Ведение 5ти юридических лиц. <br />- Оформление, юридическая экспертиза, согласование, учет договоров подряда с Заказчиками;<br />- Оформление, юридическая экспертиза, согласование, учет договоров подряда с Подрядчиками;<br />- Оформление, юридическая экспертиза, согласование, учет договоров подряда с Поставщиками;<br />- Ведение электронных реестров договоров;<br />- Составление трудовых договоров с сотрудниками, кадровый учет;<br />- Подготовка претензий, ведение переговоров по досудебному урегулированию споров;<br />- Подготовка тендерной документации для участия в конкурсах и аукционах процедурах;<br />- Внесение изменений в ЕГРЮЛ по юридическим лицам компании; <br />- Представительство интересов компании в судах и других госучреждениях.</p>', '<p>Оформление в соответствии с ТК РФ;<br />Бесплатная парковка на территории Бизнес-центра;<br />Перспективы профессионального развития и карьерного роста;<br />Режим работы: 5/2, с 9:00 до 18:00;<br />Командировки: возможны.</p>', '', '0', '0', '', '', '', '2', '93', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-17 17:23:14'),
('94', '4', 'Коммерческий директор (системы безопасности, бизнес-мониторинг)', 'Коммерческий директор (системы безопасности, бизнес-мониторинг)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 250 000 рублей</p>', '<p>Образование: Высшее</p>\r\n<p>Опыт работы: От 3 лет</p>\r\n<p>Требования</p>\r\n<p>- Успешный опыт работы от 3-х лет на ИТ рынке с продажами высокотехнологического оборудования, ведение ИТ-проектов, продажи проектных решений - будет являться конкурентным преимуществом;<br />- Опыт успешной работы на должности руководителя отдела продаж не менее 3 лет;<br />- Успешный опыт личных продаж;<br />- Опыт участия в тренингах;<br />- Навыки ведения переговоров, в т.ч. с первыми лицами компаний;<br />- Высокая работоспособность;<br />- Приверженность в профессиональной деятельности принципам клиентоориентированности, системному подходу, командной работе на общие цели;<br />- Открытый, аналитический склад ума, выраженные творческие способности.<br />Знание иностранного языка: знание английского языка на уровне upper-intermediate - приветствуется <br />ПК: Уверенный пользователь</p>', '<p>- Управление коммерческой деятельностью: организация продаж, расширение и развитие клиентской базы, управление качеством услуг, маркетинговые исследования и анализ рынков, оценка ресурсов и возможностей компании на рынке в отношении оказываемых услуг, обеспечение выполнения планов продаж;<br />- Взаимодействие со смежными отделами Компании;<br />- Контроль дебиторской задолженности;<br />- Анализ рынка систем видеонаблюдения и фото/видео фиксации, оценка ресурсов и возможностей компании на рынке в отношении оказываемых услуг и обеспечения планов продаж;<br />- Обеспечение участия решений компании в конкурсных процедурах и тендерах;<br />- Контроль дебиторской задолженности;<br />- Взаимодействие со смежными отделами компании;<br />- Формирование и предоставление отчетности руководству.</p>', '<p>Заработная плата: 250 000 рублей (предусмотрены бонусы)<br />Социальные льготы: полное соблюдение ТК РФ<br />Режим работы: пятидневная рабочая неделя<br />Командировки: да</p>', '', '0', '0', '', '', '', '2', '94', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-30 16:59:38'),
('95', '4', 'Директор по развитию бизнеса (системы безопасности, бизнес-мониторинг)', 'Директор по развитию бизнеса (системы безопасности, бизнес-мониторинг)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: Высшее</p>\r\n<p>Опыт работы: От 3 лет</p>\r\n<p>Требования</p>\r\n<p>- Высшее (желательно, техническое) образование;<br />- Хорошие коммуникативные навыки;<br />- Опыт управления отделом продаж;<br />- Наличие деловых контактов с интеграторами оборудования систем безопасности и видеонаблюдения, а также с потенциальными заказчиками;<br />- Опыт установления контактов с потенциальными заказчиками - по телефону, на выставках, на партнерских мероприятиях и т.п. (выявление реальной потребности, получение информации о сроках принятия решения, типе принятия решений по теме);<br />- Факт прохождения курсов и тренингов по продажам и наличие профильных сертификатов приветствуется;<br />- Опыт работы не менее 3 лет в области комплексных продаж с обязательным пониманием состава высокотехнологичного оборудования, ведение ИТ-проектов - будет являться конкурентным преимуществом;<br />- Знание английского языка на уровне upper-intermediate - приветствуется</p>', '<p>- Генерация ЛИДов;<br />- Работа, как с существующей, так и с приобретенной (ЛИД-менеджмент) базой потенциальных клиентов;<br />- Управление проектами и продажами во вверенном секторе бизнеса, развитие и сопровождение ключевых клиентов;<br />- Выстраивание модели эффективного взаимодействия, личных взаимоотношений с ключевыми заказчиками;<br />- Анализ IT-рынка, оценка ресурсов и возможностей компании на рынке в отношении оказываемых услуг и обеспечения планов продаж;<br />- Обеспечение участия решений компании в конкурсных процедурах и тендерах.</p>', '<p>Город: Зеленоград<br />Заработная плата: обсуждается индивидуально на собеседовании<br />Социальные льготы: полное соблюдение ТК РФ<br />Режим работы: пятидневная рабочая неделя (5/2), с 9-00 до 18-00<br />Командировки: да</p>', '', '0', '0', '', '', '', '2', '95', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-30 17:11:22'),
('96', '4', 'Коммерческий директор (производство светопрозрачных металлоконструкций)', 'Коммерческий директор (производство светопрозрачных металлоконструкций)', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее<br />Опыт работы в производстве / строительных компаниях / компаниях, занимающихся производством светопрозрачных конструкций, окон, подоконников, витражей, стеклянных фасадов, соответствующих стройматериалов и т.п.<br />Опыт работы в сфере продаж от 3-х лет.<br />Понимание процесса продвижения и реализации продукции в вышеперечисленных сферах.</p>', '<p>В солнечногорский филиал международной производственной компании, занимающейся изготовлением светопрозрачных металлоконструкций требуется специалист на позицию Коммерческий директор.</p>', '<p>Заработная плата: обсуждается на собеседовании.<br />График работы: полный рабочий день.<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '96', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-30 17:14:38'),
('97', '10', 'Маркетолог (светопрозрачные металлоконструкции)', 'Маркетолог (светопрозрачные металлоконструкции)', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее<br />Опыт работы в производстве.<br />Опыт работы в сфере маркетинга от 3-х лет.<br />Уровень знания английского языка: средний (Intermediate) и выше.</p>\r\n<p><strong></strong>Водительские права: Категория B</p>', '<p>В солнечногорский филиал международной производственной компании, занимающейся изготовлением светопрозрачных металлоконструкций требуется специалист на позицию Маркетолог.</p>\r\n<p>В обязанности специалиста будут входить преимущественно: <br />- аналитика рынка, возможностей продвижения товара, <br />- организация мероприятий по продвижению товара, <br />- общение с представителями головного офиса, предоставление отчетов о проделанной работе</p>', '<p>Заработная плата: обсуждается на собеседовании.<br />График работы: полный рабочий день.<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '97', '*', '0', '0000-00-00 00:00:00', '479', '2019-04-30 17:19:42'),
('98', '15', 'Инженер ПТО (производственно-технический отдел) (инженерные коммуникации)', 'Инженер ПТО (производственно-технический отдел) (инженерные коммуникации)', 'Москва, м. Беговая', '0', '1970-01-01', '', '', '<p>от 50 000 рублей</p>', '<ul>\r\n<li>Образование: Среднее и выше</li>\r\n<li>Крайне желателен минимальный опыт выполнения исполнительной документации по инженерным сетям.</li>\r\n<li>Опыт списания материалов по форме М29 (желательно).</li>\r\n<li>Знание AutoCad, Excel.</li>\r\n</ul>', '<p>- Составление исполнительной документации (Акты скрытых работ, ТК, папка ЗОС)<br />- Подготовка документов для сдачи объектов в эксплуатацию, получение ЗОС, разрешения на ввод.<br />- Контроль за составлением формы КС -2, КС-3, Проверка М-29 по объектам<br />- Подсчет объемов работ и ведение накопительных таблиц<br />- Проверка выполненных работ сметной документации<br />- Разработка и согласование с Заказчиком ТК и ППР</p>', '<p>Мы находимся в поисках начинающих специалистов на позицию Инженер ПТО с минимальным опытом работы в сфере инженерных коммуникаций. Предоставляется обучение.<br />- Город: Москва, м. Беговая,<br />- Заработная плата: по договоренности (от 50 000 рублей), <br />- Трудоустройство по ТК РФ,<br />- Оплачиваемые отпуска, больничные, <br />- График работы - пн-пт с 8-00 ч. до 17-00 ч.<br />- От метро до офиса ходит корпоративный автобус (7 мин.)</p>', '', '0', '0', '', '', '', '2', '98', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-07 17:34:16'),
('99', '15', 'Технический писатель', 'Технический писатель ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата по результатам собеседования с успешным кандидатом.</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Технический писатель.</p>\r\n<p>Образование: высшее техническое (желательно микроэлектроника);<br />Необходимый стаж работы по специальности: от 5 лет;<br />ПК: уверенный пользователь, умение работать с графическими редакторами (Компас, SolidWorks и т.д);<br />Дополнительные требования:<br />- Желательно: знание стандарта S1000D;<br />- Опыт работы в TG BUILDER (желательно);<br />- Опыт работы с измерительной и испытательной аппаратурой.</p>', '<p>Разработка текстовой конструкторской документации (ТУ, РЭ, ПС, ЭТ) согласно ЕСКД (ГОСТ 2.106, 2.114, 2.601 и прочие).</p>', '<p>Работа в соответствие с ТК РФ;<br />График работы: с понедельника по пятницу, с 08:00 до 17:00;<br />Заработная плата по результатам собеседования с успешным кандидатом.</p>', '', '0', '0', '', '', '', '2', '99', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-07 17:38:01'),
('100', '15', 'Инженер-технолог РЭА', 'Инженер-технолог РЭА', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Инженер-технолог РЭА.</p>\r\n<p>Высшее техническое образование;<br />Опыт работы в аналогичной должности - от 3х лет;<br />Необходимо знать:<br />- Типовые технологические процессы и режимы производства РЭА и П;<br />- Основное технологическое оборудование и принципы его работы;<br />- Виды брака и способы его предупреждения;<br />- Правила и нормы охраны труда, техники безопасности, производственной санитарии и противопожарной защиты.</p>', '<p>• Установление порядка выполнения работ по производству изделий;<br />• Разработка технологических нормативов, инструкций, схем сборки, маршрутных карт и другой технологической документации, вносит изменений и корректировок;<br />• Анализ причин брака, разработка мероприятий по предупреждению и устранению, рассмотрение поступающих рекламаций на выпускаемую предприятием продукцию.</p>', '<p>Заработная плата: белая, обсуждается индивидуально;<br />Оформление по ТК РФ;<br />Испытательный срок: 3 месяца;<br />График работы: 5/2.</p>', '', '0', '0', '', '', '', '2', '100', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-07 17:43:30'),
('101', '3', 'Экономист (электронная промышленность)', 'Экономист (электронная промышленность)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 75 000 руб.</p>', '<p>Образование: Высшее</p>\r\n<p>Опыт работы: От 5 лет</p>\r\n<p>Требования</p>\r\n<p>- опыт работы в аналогичной должности в близкой сфере;<br />- опыт работы с ГОЗ;<br />- опыт работы с военной приемкой;<br />- знание пакета компьютерных программ MS Office (Word, Excel);<br />- внимательность, ответственность.</p>', '<ul>\r\n<li>Подготовка расчетно-калькуляционных материалов,</li>\r\n<li>Защита цен, ценообразование,</li>\r\n<li>Работа с ГОЗ и военной приемкой в области электронной промышленности.</li>\r\n</ul>', '<p>Заработная плата (размер и форма оплаты): от 75000 рублей до вычета налога на испытательный срок.</p>\r\n<p>Социальные льготы: трудоустройство по ТК РФ.</p>\r\n<p>Режим работы: 5/2, с 9:00 до 18:00, обед с 13:00 до 14:00.</p>', '', '0', '0', '', '', '', '2', '101', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-13 10:28:12'),
('102', '5', 'Горничная (помощница по хозяйству)', 'Горничная (помощница по хозяйству)', 'Зеленоград', '0', '0000-00-00', '', '', '<p>3500 руб. за выход</p>', '<p>Опыт работы горничной (помощницей по хозяйству);<br />Наличие рекомендаций с прошлых мест работы.</p>', '<p>Уборка и глажка белья на территории коттеджа (450 кв.м.).</p>', '<p>Семейной паре в коттедж требуется горничная (помощница по хозяйству). <br />Коттедж (450 кв.м.) расположен недалеко от Зеленограда, рядом с д. Клушино.<br />Работа один раз в неделю (понедельник), около 6-7 часов в день.<br />Оплата 3500 руб. за выход.<br />Есть транспорт до места работы и обратно (персональный водитель).</p>', '', '0', '0', '', '', '', '2', '102', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-13 12:02:35'),
('103', '15', 'Инспектор / Аудитор по техническому надзору АКЗ, специалист по АКЗ', 'Инспектор / Аудитор по техническому надзору АКЗ, специалист по АКЗ', 'Зеленоград', '0', '0000-00-00', '', '', '<p>80 000 рублей</p>', '<p>Опыт работы в сфере антикоррозионной защиты, огнезащиты, покрытий металлоконструкций.<br />Требуется наличие водительских прав категории B.<br />Наличие сертификата Frosio или сертификата учебного центра Прометей соответствующей направленности будет конкурентным преимуществом.</p>', '<p>- надзор за правильностью применения технологий АКЗ, проведения работ по защите на объектах компании (Центральный округ РФ)<br />- проверка соответствующей документации<br />- выезд на объекты по заказу других компаний (проверка конструкций)</p>', '<p>- заработная плата - от 80 000 рублей <br />- выдается служебный автомобиль<br />- подчинение непосредственно администрации фирмы</p>', '', '0', '0', '', '', '', '2', '103', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 11:54:47'),
('104', '15', 'Специалист в коммерческий отдел, инженер по продажам, коммерческий инженер АКЗ', 'Специалист в коммерческий отдел, инженер по продажам, коммерческий инженер АКЗ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 70000 рублей</p>', '<p>Знание и опыт работы с АКЗ (антикоррозионной защитой) или в компании, занимающейся производством и/или продажей профессиональных лакокрасочных материалов (ЛКМ) для производства (B2B).<br />Опыт продаж от 3-х лет (металлических изделий, металлических конструкций под покраску, покрытий)<br />Навык разработки смет<br />Коммуникабельность<br />Желательно наличие своего автомобиля<br />Желательно знание AutoCAD</p>', '<ul>\r\n<li>Продажа услуг АКЗ, огнезащиты, покраски.</li>\r\n<li>Калькулирование стоимости, возможно, выезды на объекты, осмечивание объектов.</li>\r\n<li>Консультация клиентов.</li>\r\n</ul>', '<p>Заработная плата - обсуждается на собеседовании.<br />Работа из зеленоградского офиса, обслуживание завода под Королевом.<br />Компенсация ГСМ и мобильной связи.<br />В подчинении руководителя отдела продаж, администрации фирмы.</p>', '', '0', '0', '', '', '', '2', '104', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 12:09:19'),
('105', '15', 'Прораб / Производитель работ направления промышленной очистки', 'Прораб / Производитель работ направления промышленной очистки', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 90 000 рублей</p>', '<p>- Образование: среднее или высшее строительное (техническое);<br />- опыт работы по специальности от 2х лет;<br />- ПК: Уверенный пользователь ПК (Excel; Word).</p>', '<p>- организация и руководство работами на объекте;<br />- управление персоналом на объекте;<br />- управление эксплуатацией техникой и оборудованием;<br />- управление качеством, сдача работ заказчику.</p>', '<p>- зеленоградский офис, выезды на объекты;<br />- средняя заработная плата: обсуждается на собеседовании;<br />- оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '105', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 12:18:14'),
('106', '15', 'Менеджер (инженер) по продажам в сфере промышленной очистки (B2B)', 'Менеджер (инженер) по продажам в сфере промышленной очистки (B2B)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 70 000 рублей </p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 2 лет</p>\r\n<p>Опыт работы с промышленной очисткой или понимание с инженерной точки зрения происходящих при этом процессов.<br />Опыт осмечивания, калькулирования стоимости работ.<br />Коммуникабельность.<br />Желательно наличие прав категории B.</p>', '<p>Продажи профессиональной промышленной очистки.<br />Калькулирование стоимости работ, осмечивание.<br />Консультация клиентов.</p>', '<p>Заработная плата: обсуждается индивидуально.<br />Работа из зеленоградского офиса, обслуживание завода под Королевом.</p>', '', '0', '0', '', '', '', '2', '106', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 12:23:37'),
('107', '15', 'Начальник производства (АКЗ, огнезащита металлоконструкций)', 'Начальник производства (АКЗ, огнезащита металлоконструкций)', 'Королев', '0', '1970-01-01', '', '', '<p>От 70 000 до 90 000 рублей</p>', '<p> </p>\r\n<p>Образование: среднее специальное или высшее строительное (техническое).<br />Необходимый стаж работы по специальности: от 2х лет<br />Необходимые навыки: <br />Опыт работ в области организации антикоррозионной защиты и огнезащиты металлоконструкций либо работ в области изготовления и монтажа металлоконструкций. <br />ПК: Уверенный пользователь ПК (Excel; Word), знание основных программ.<br />Дополнительные требования: Без вредных привычек!</p>', '<p>• Организация и руководство работами на производстве.<br />• Управление персоналом на производстве.<br />• Управление эксплуатацией техникой и оборудованием на производстве.<br />• Управление качеством на производстве<br />• Приемка заказов и сдача заказов заказчику.<br />- Организация складского хозяйства на производстве.<br /><br /><br /></p>', '<p>Заработная плата: 70-90 тысяч рублей на руки.<br />Оплачиваемый проезд и телефон. <br />Предоставляется компенсация оплаты проживания для не местных (по договоренности). <br />Слаженный и ответственный коллектив, развивающаяся компания.<br />Режим работы: Полный рабочий день 5 или 6 дней в неделю в зависимости от производственной необходимости</p>', '', '0', '0', '', '', '', '2', '107', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 13:11:02'),
('108', '15', 'Производитель работ / Начальник участка (АКЗ, огнезащита металлоконструкций)', 'Производитель работ / Начальник участка (АКЗ, огнезащита металлоконструкций)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 70 000 до 110 000 рублей</p>', '<p>Образование: среднее специальное или высшее строительное (техническое).<br />Необходимый стаж работы по специальности: от 2х лет<br />Необходимые навыки: <br />Опыт работ в области организации антикоррозионной защиты и огнезащиты металлоконструкций либо работ в области изготовления и монтажа металлоконструкций. <br />ПК: Уверенный пользователь ПК (Excel; Word), знание основных программ.<br />Дополнительные требования: С ОПЫТОМ ОРГАНИЗАЦИИ РАБОТ ПО АНТИКОРРОЗИОННОЙ ЗАЩИТЕ И ОГНЕЗАЩИТЕ МЕТАЛЛОКОНСТРУКЦИЙ<br />Без вредных привычек!</p>', '<p>• Организация и руководство работами на объекте.<br />• Управление персоналом на объекте.<br />• Управление эксплуатацией техникой и оборудованием.<br />• Управление качеством.<br />• Сдача работ заказчику.</p>', '<p>Заработная плата: обсуждается на собеседовании, 70-110 тысяч рублей в зависимости от нагрузки на производстве, а также от квалификационных характеристик кандидата.<br />Оплачиваемый проезд и телефон. <br />Предоставляется компенсация оплаты проживания для не местных (по договоренности). Слаженный и ответственный коллектив, развивающаяся компания.<br />Режим работы: полный рабочий день.</p>', '', '0', '0', '', '', '', '2', '108', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-16 13:15:36'),
('109', '2', 'Секретарь со знанием английского языка', 'Секретарь со знанием английского языка', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35 000 руб.</p>', '<p>Опыт работы по специальности 3-5 лет;<br />Опытный пользователь ПК;<br />Знание английского языка.</p>', '<p>Ведение делопроизводства;<br />Контроль выполнения работниками организации изданных приказов и распоряжений, взятых на контроль;<br />Организация приема посетителей;<br />Организация проведения телефонных переговоров руководителя;<br />Организационная подготовка заседаний и совещаний.</p>', '<p>Трудоустройство по ТК РФ;<br />Режим работы: 5/2.</p>', '', '0', '0', '', '', '', '2', '109', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 10:15:19'),
('110', '3', 'Бухгалтер', 'Бухгалтер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 55 000 руб.</p>', '<p>Образование: высшее (финансы, экономика, бухгалтерия).<br />Необходимый стаж работы по специальности: от 3-х лет в производственной компании.<br />Знание порядка ведения всех участков бухгалтерии.<br />Знание программы 1C ЗУП 8.3, а также пакета программ MS Office: Excel, Word, Outlook.<br />Знание системы Клиент-Банк.<br />Грамотная речь и письмо.<br />Ответственность, внимательность.</p>', '<p>Ведение участков бухгалтерии компании (возможна специализация на одном конкретном участке).<br />Работа с первичной документацией.</p>', '<p>Работа в крупной и растущей производственной компании в Зеленограде.<br />Оформление по ТК. <br />Заработная плата: от 55 000 рублей на испытательном сроке. Белая заработная плата.<br />Ежегодная индексация заработных плат.<br />Полный соц. пакет. ДМС. <br />Режим работы: 5/2, с 9-00 до 18-00.<br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '110', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 15:32:22'),
('111', '15', 'Заместитель Генерального директора по продажам и развитию', 'Заместитель Генерального директора по продажам и развитию', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 90 000 до 130 000 руб.</p>', '<p>Образование: высшее;</p>\r\n<p>Водительские права: категория В;</p>\r\n<p>Знание основ конструирования и технических требований к радиоэлектронной аппаратуре (желательно авиационного бортового радиоэлектронного оборудования);<br />Умение читать конструкторскую и эксплуатационную документацию (чертежи, ТУ, ТЗ, РЭ), знание структуры (или основ оформления) РКД, ТЗ, ТУ, РЭ;<br />Способность запоминать большой объем данных (в том числе технические характеристики изделий, функциональное назначение изделий, особенности их применения и т.д.);<br />Навыки проведения презентаций;<br />Опыт продаж сложного технического оборудования;<br />Умение грамотно вести деловую переписку;<br />Грамотная речь;<br />Готовность к командировкам, в том числе за границу;<br />Хорошее знание ПС (Microsoft office, в том числе PowerPoint);<br />Владение английским языком (чтение технической литературы и разговорный английский);<br />Наличие автомобиля.</p>', '<p>Научно-производственная компания. Разработка и производство светотехнического оборудования на основе светодиодов и РЭА (гражданского, специального и военного назначения).</p>\r\n<p>- продвижение продукции предприятия;<br />- ведение переговоров с существующими и новыми заказчиками;<br />- подготовка и проведение презентаций / демонстраций продукции;<br />- подготовка материалов для обоснования конкурентных преимуществ продукции с точки зрения ее технических, эксплуатационных, коммерческих характеристик, в том числе сравнительный технический анализ с аналогами предприятий-конкурентов;<br />- проведение переговоров с Заказчиками по условиям заключения договоров на поставку серийной продукции и/или проведение ОКР;<br />- согласование с Заказчиками технических требований, технических заданий на вновь разрабатываемые изделия;<br />- анализ рынка, определение потребностей рынка и участие в подготовке технических требований (технических заданий) на разработку новых изделий;<br />- техническая и коммерческая переписка с Заказчиками;<br />- контроль за процессом разработки (проведением ОКР) новых изделий на предприятии;<br />- организация подготовки документов для участия в тендерах / конкурсах;<br />- консультирование Заказчиков по техническим вопросам, по вопросам подбора оборудования, обеспечение Заказчиков технической документацией (ТУ, ГЧ, РЭ, схемы подключений и т.д.);<br />- организация разработки каталогов, технических описаний и рекламных материалов на изготавливаемую продукцию.</p>', '<p>Испытательный срок: 3 месяца<br />График работы: 5/2 с 9 до 18<br />Социальные льготы: в соответствии с ТК РФ.</p>', '', '0', '0', '', '', '', '2', '111', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 15:56:53'),
('112', '15', 'Ведущий инженер-конструктор ', 'Ведущий инженер-конструктор ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности.</p>', '<p>Образование: высшее техническое;<br />Необходимый стаж работы с аналогичными функциональными обязанностями: от 3х лет;</p>\r\n<p>Необходимые и желательные навыки/опыт: <br />• опыт разработки и конструирования радиоэлектронной аппаратуры;<br />• опыт разработки светотехнических изделий, в том числе на основе светодиодов; знание основ светотехники и фотометрии;<br />• хорошее знание ЕСКД и правил оформления РКД, ТЗ, ТУ, РЭ и пр;<br />• желателен опыт работы на предприятии, разрабатывающем и производящем военную или авиационную технику;<br />• желательно знание основ схемотехники и оптики;<br />• умение грамотно вести деловую переписку;<br />• грамотная речь;<br />• желательно владение английским языком (чтение технической литературы и разговорный английский).</p>', '<p>Разработка эскизных, технических и рабочих проектов (конструкций), используя средства автоматизации проектирования, в соответствии с ТЗ, стандартами, нормам охраны труда и техники безопасности;<br />Составление кинематических схем, общей компоновки и теоретической увязки отдельных элементов конструкций;<br />Согласование разработок с другими подразделениями предприятия, представителями заказчиков и органов надзора, экономически обосновывать разрабатываемые конструкции.<br />Участие в монтаже, наладке, испытаниях и сдаче в эксплуатацию опытных образцов конструкций и их компонентов, составление заявок на изобретения и промышленные образцы;<br />При необходимости, участие в монтаже и наладке разработанных изделий на объектах заказчика;<br />Сопровождение разработанного изделия при постановке его на производство;<br />Оформление, утверждение, внесение изменений, согласование документации на изделия.</p>', '<p>График работы: полный рабочий день, 5/2, с 9-00 до 18-00<br />Оформление по ТК.</p>', '', '0', '0', '', '', '', '2', '112', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 16:40:41'),
('113', '15', 'Заместитель начальника производства', 'Заместитель начальника производства', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности.</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Заместитель начальника производства (с опытом работы в приборостроении).</p>\r\n<p>Высшее образование;<br />Опыт руководства приборостроительным производством от 5 лет;<br />Отличное знание всех участков производства, понимание внутрипроизводственной логистики;<br />СТРОГО: Опыт руководства сборочным цехом от 20 человек в области микроэлектроники;<br />Опыт работы с военной приемкой.</p>', '<p>- Организация и управление производственными процессами;<br />- Планирование и контроль производства, планирование загрузки цеха, графиков производства продукции;<br />- Ведение документации, отчетность;<br />- Обеспечение технологических потребностей цеха, технологии производства и качества продукции;<br />- Контроль работы персонала, распределение заданий на день/месяц/неделю.</p>', '<p>Работа в соответствие с ТК РФ;<br />График работы: с понедельника по пятницу, с 08:00 до 17:00;<br />Белая зарплата, премия по итогам года (13-я зарплата).</p>', '', '0', '0', '', '', '', '2', '113', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 16:58:30'),
('114', '15', 'Регулировщик РЭА', 'Регулировщик РЭА', 'Зеленоград', '0', '1970-01-01', '', '', '<p>до 70 000 руб.</p>', '<p>Опыт работы от 3 лет;</p>\r\n<p>Знание импульсных блоков питания и источников тока.<br />Опыт работы с контрольно-измерительной аппаратурой.<br />Знание современной электронной базы, умение читать электрические схемы.<br />Умение программировать будет существенным плюсом.</p>', '<p>Проверка, наладка, диагностика и ремонт импульсных блоков питания и источников тока.<br />Знание современной электронной базы, умение читать электрические схемы.</p>', '<p>Заработная плата: до 70000 рублей (в зависимости от квалификации соискателя)<br />Испытательный срок: до 3-х месяцев<br />Социальные льготы: в соответствии с ТК <br />График работы: 5/2 с 9-00 до 18-00.</p>', '', '0', '0', '', '', '', '2', '114', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 17:41:07'),
('115', '15', 'Заместитель начальника конструкторского бюро', 'Заместитель начальника конструкторского бюро', 'Зеленоград', '0', '1970-01-01', '', '', '<p>100 000 — 130 000 руб.</p>', '<p>Высшее образование;</p>\r\n<p>Опыт работы от 5 лет;</p>\r\n<p>Знание ГОСТов, порядка, процедур разработки (проведение ОКР) военной и/или авиационной техники и постановки ее на производство;<br />Значительный опыт разработки и конструирования радиоэлектронной аппаратуры (желательно бортового авиационного радиоэлектронного оборудования);<br />Опыт разработки светотехнических изделий, в том числе на основе светодиодов; знание основ светотехники и фотометрии;<br />Знание современной аналоговой и цифровой схемотехники (желательно импульсных блоков питания);<br />Хорошее знание ЕСКД и правил оформления РКД, ТЗ, ТУ, РЭ и пр;<br />Руководство коллективом разработчиков от 10 человек;<br />Желательно знание порядка сертификации авиационного оборудования и условий его применения на военных и гражданских воздушных судах (самолетах и вертолетах);<br />Желателен опыт работы с авиационными конструкторскими бюро и/или авиастроительными предприятиями (ПАО \"Туполев\", ПАО \"Ил\", Иркут, МИГ, Сухой, Миль, Камов, ОКБ \"Яковлева\", Объединенная Авиастроительная Корпорация, ПАО \"Вертолеты России\");<br />Желателен опыт работы на предприятии, разрабатывающем и производящем военную или авиационную технику;<br />Желательно знание основ оптики;<br />Умение грамотно вести деловую переписку;<br />Грамотная речь;<br />Готовность к командировкам;<br />Хорошее знание ПС;<br />Владение английским языком (чтение технической литературы и разговорный английский);</p>', '<p>Организация, руководство и контроль за процессом разработки новых изделий - радиоэлектронной аппаратуры и светодиодного светотехнического оборудования военного и специального назначения;<br />Руководство коллективом конструкторов, схемотехников, программистов, а также архивом предприятия и испытательной лабораторией: постановка задач, контроль за выполнением работы;<br />Проведение переговоров с Заказчиками для определения потребности рынка в новых изделиях; согласование с Заказчиками технических требований и технических заданий на разработку новых изделий;<br />Участие в разработке технических требований и технических заданий;<br />Разработка облика (принципов построения) новых изделий;<br />Консультирование Заказчиков по техническим вопросам, по вопросам подбора оборудования, обеспечение Заказчиков технической документацией (ТУ, ГЧ, РЭ, схемы подключений и т.д.);<br />Обеспечение выполнения ОКР в заданные сроки;<br />Выбор наилучших конструктивных, схемотехнических, оптических решений при разработке новых изделий;<br />Планирование работы подчиненных сотрудников и подразделений;<br />Участие в подборе новых сотрудников.</p>', '<p>Испытательный срок: 3 месяца<br />Социальные льготы: в соответствии с ТК РФ<br />Режим работы: 5/2 с 9 до 18.<br />Заработная плата: 100 - 130 тыс.руб. по результатам собеседования.</p>', '', '0', '0', '', '', '', '2', '115', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-17 17:56:56'),
('116', '6', 'Выездной сервисный инженер', 'Выездной сервисный инженер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: Среднее специальное;</p>\r\n<p>Опыт работы: От 2 лет;</p>\r\n<p>Водительские права категории В;</p>\r\n<p>Опыт ремонта дорожно-строительной техники-двигатель, КПП, электрика, гидравлика.</p>', '<p>Выезд к клиентам для осуществления сервисного ремонта и обслуживания дорожно- строительной техники на специальном автомобиле;<br />Проведение сервисных и плановых работ по техническому обслуживанию дорожно-строительной техники;<br />Работа с фронтальными погрузчиками, бульдозерами, катками, автогрейдерами, экскаваторами.</p>', '<p>Разъездная работа;</p>\r\n<p>Полный рабочий день;</p>\r\n<p>Заработная плата (размер и форма оплаты): оклад по договоренности + процент от наряд-заказа, премии за лояльность.</p>', '', '0', '0', '', '', '', '2', '116', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-22 10:17:28'),
('117', '14', 'Менеджер по продажам (дорожно-строительной техники)', 'Менеджер по продажам (дорожно-строительной техники)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт работы в продажах технически сложных товаров (автомобильного грузового и специального транспорта);<br />Наличие прав категории В.</p>', '<p>Активные продажи;<br />Холодные звонки;<br />Выезд к клиентам.</p>', '<p>Отдел продаж дорожно-строительной техники и вилочных погрузчиков;<br />Заработная плата по договоренности + премии за лояльность;<br />График работы: полный рабочий день.</p>', '', '0', '0', '', '', '', '2', '117', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-22 11:18:33'),
('118', '3', 'Директор по инвестициям', 'Директор по инвестициям', 'Зеленоград', '0', '1970-01-01', '', '', '<p>До 100 000 руб.</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 3-х лет</p>\r\n<p>Необходимые навыки: <br />• Опыт ведения проектов (подготовка документов, взаимодействие с государственными органами, сдача отчетности)<br />• Хорошие коммуникативные навыки.<br />• Опыт работы с государственными органами<br />Знание иностранного языка: знание английского языка на уровне upper-intermediate - приветствуется <br />ПК: Уверенный пользователь</p>', '<p>• Подготовка бизнес-планов и комплекта конкурсной документации для участия в конкурсах на предоставление финансирования по проектам<br />• Подача документов на конкурс<br />• Подготовка документов на оформление получения финансирования<br />• Получение финансирования через Казначейство, фонды<br />• Сопровождение проектов, подготовка и подача отчетных документов по проектам<br />• Работа с министерствами, фондами, казначейством</p>', '<p>Социальные льготы: <br />• Офис в экологически чистом районе Москвы (г. Зеленоград) рядом с лесом и водоемом;<br />• Работа на современном оборудовании (высокопроизводительные компьютеры, большие мониторы и т.д.);<br />• Оформление по ТК РФ;<br />• Полностью белая заработная плата;<br />• Профильные конференции, семинары<br />Режим работы: пятидневная рабочая неделя</p>', '', '0', '0', '', '', '', '2', '118', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-27 16:23:57'),
('119', '15', 'Инспектор отдела технического контроля (ОТК)', 'Инспектор отдела технического контроля (ОТК)', 'Королев', '0', '1970-01-01', '', '', '<p>От 50 000 руб.</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 2-х лет</p>\r\n<p>Опыт работы в сфере антикоррозионной защиты, огнезащиты, покрытий металлоконструкций или опыт работы на производстве, подразумевающем взаимодействие с различными типами покрытий, желательно металлоконструкций, деталей из металла и т.п. (или, например, производство профессиональных лакокрасочных материалов / ЛКМ и т.д.).<br />Опыт работы инженером технологом или инженером ОТК является преимуществом.</p>', '<p>В компанию, занимающуюся специальными строительными работами, защитой конструкций (огнезащитой, теплоизоляцией, антикоррозионной защитой металла) и промышленной очисткой требуется специалист на должность Инспектор отдела технического контроля (ОТК).<br />В обязанности специалиста будут входить:<br />- контроль качества операций по нанесению тяжелых антикоррозионных покрытий на металлоизделия (крупногабаритные металлические колодцы);<br />- проверка соответствующей документации.</p>', '<p>Заработная плата: обсуждается на собеседовании (зависит от совокупности опыта и квалификационных характеристик кандидата).</p>\r\n<p>Работа на производстве под Королевом.<br />График работы: 5/2, 8-часовой рабочий день.<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '119', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-27 16:42:39'),
('120', '5', 'Помощник по хозяйству', 'Помощник по хозяйству', 'Менделеево', '3', '1970-01-01', '', '', '<p>25 000 руб.</p>', '<p>Опыт работы в семьях в аналогичной должности крайне приветствуется;<br />Аккуратность, мастеровитость, хозяйственность.</p>', '<p>Хозяйственные работы по дому и участку (преимущественно по участку.<br />Участок лесного характера с небольшими газонами - 25 соток.<br />В обязанности будут входить различные поручения по факту их возникновения:<br />- уборка территории (листва, снег - есть снегоуборочная машина, садовый пылесос);<br />- вынос мусора (вывоз бака к мусороуборочной машине 1 раз в неделю);<br />- покос травы (2 небольших участка газона);<br />- сезонная обработка деревьев от вредителей (сосны);<br />- встреча и проводы гостей (открыть / закрыть ворота);<br />- кормление животных по графику (3 собаки - дрессированные немецкий овчарки, к своим относятся ласково, хорошие помощники при охране участка; 3 кота);<br />- иные поручения, не требующие особых физических нагрузок.</p>', '<p>Нужен помощник по хозяйству в хорошую порядочную семью в загородный дом (лесной участок 25 соток).<br />Работа на постоянной основе с проживанием (для проживания отводится второй этаж обустроенного гаража, есть спальня, душ, небольшая кухня с плитой).<br />Если у Вас есть личный транспорт, на территории участка для него есть парковка.<br />Имеется возможность добраться на общественном транспорте.<br />Режим работы: одна неделя через две (с понедельника по понедельник, с 7.30 до 20.00).</p>', '', '0', '0', '', '', '', '2', '120', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-29 17:16:14'),
('121', '10', 'Менеджер по продажам логистических услуг (Менеджер по развитию направления)', 'Менеджер по продажам логистических услуг (Менеджер по развитию направления)', 'Москва', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее;</p>\r\n<p>Необходимый стаж работы по специальности: 2 года;</p>\r\n<p>Необходимые навыки:</p>\r\n<p>Опыт прямых продаж транспортно-логистических услуг;<strong><br /></strong>Навыки ведения коммерческих переговоров B2B;<strong><br /></strong>Знание ВЭД и технологий мультимодальных перевозок;</p>\r\n<p>Наличие актуального плана собственных продаж;</p>\r\n<p>Знание иностранного языка: английский язык на уровне делового общения и письма;</p>\r\n<p>ПК: знание базовых проф. функций ПК;</p>\r\n<p>Дополнительные требования: активная жизненная позиция, нацеленность на достижение результата.</p>', '<p>• Поиск и привлечение клиентов, активные продажи;<br />• Ведение коммерческих переговоров, посещение выставок, <br />участие в отраслевых тендерах;<br />• Обработка запросов клиентов, утверждение оптимальных схем и условий перевозки, <br />формирование коммерческих предложений;<br />• Заключение договоров в области транспортно-экспедиторского обслуживания;<br />• Делегирование функций своему ассистенту (ассистентам) <br />и менеджеру по работе с клиентами;<br />• Контроль процесса мультимодальной перевозки;<br />• Выполнение плана продаж с соблюдением нормы рентабельности сделок. <br />Уровень подчинения: руководство осуществляет Директор по развитию</p>', '<p>Уровень зарплаты и % от личных продаж обсуждаются; <br />Испытательный срок - 3 месяца;<br />Оформление в соответствии с ТК РФ;<br />Режим работы: с 9:30 до 18:30;<br />Командировки: возможны.</p>', '', '0', '0', '', '', '', '2', '121', '*', '0', '0000-00-00 00:00:00', '479', '2019-05-30 13:56:43'),
('122', '10', 'Руководитель группы беспроводные технологии', 'Руководитель группы беспроводные технологии', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее (техническое; желательно, но не обязательно: электроника, маркетинг);<br />Презентабельный внешний вид;<br />Свободное владение английским языком;<br />Опыт в иностранном представительстве или компании дистрибьюторе электронных компонентов.</p>', '<p>Вы будете развивать дистрибуцию электронных компонентов для беспроводных технологий (GPS, Wi-Fi, GLONASS / ГЛОНАСС, Bluetooth, GSM). <br />Вашей задачей будет ежедневное интенсивное общение на английском языке по данной тематике с иностранными партнерами. <br />Подчинение директору по маркетингу.</p>', '<p>Полный рабочий день, 5/2;</p>\r\n<p>Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '122', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-06 10:14:14'),
('123', '3', 'Главный бухгалтер', 'Главный бухгалтер', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>35 000 руб.</p>', '<p>Образование: высшее;</p>\r\n<p>Опыт работы: от 3-х лет;</p>\r\n<p>Знание и умение работать в программах: 1С: Бухгалтерия 8.3, СБИС; <br />Опыт работы с платежами в системах \"Клиент-банк\";<br />Дополнительные требования: желательно наличие транспортного средства, а также умение пользоваться удаленным доступом в программы. Внимательность, ответственность, пунктуальность, умение работать с большими объемами документации.</p>', '<p>Ведение бухгалтерского и налогового учета ООО и НП по упрощенной системе налогообложения:<br />- Правильное и своевременное отражение всех операций, связанных с осуществлением финансово-хозяйственной деятельности организаций на счетах бухгалтерского учета.<br />- Подготовка квартальной и годовой бухгалтерской и налоговой отчетности, направление ее в контролирующие органы.<br />- Учет расчетов с поставщиками и подрядчиками, контроль документооборота и правильности оформления первичной документации.<br />- Ведение банковских, кассовых операций.<br />- Ведение кадрового делопроизводства (прием, увольнение, листы временной нетрудоспособности, кадровые перемещения).<br />- Обеспечение надлежащего документооборота первичной учетной документации и организация ее хранения.</p>', '<p>Адрес: Московская область, Солнечногорский район, д. Лопотово;<br />Заработная плата (размер и форма оплаты): от 35 000 руб. на руки, оформление в соответствии с ТК РФ, возможно заключение договора с ИП;<br />Социальные льготы: оплата отпускных, ежегодная премия в размере оклада по результатам работы;<br />Режим работы: ненормированный график работы. Пн-Пт: по необходимости на удаленной основе; Сб (10:00-19:00 11:00-20:00) (возможно перенести на другой день недели - Пт или Вс) с обязательным присутствием на территории; <br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '123', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-10 17:05:00'),
('124', '15', 'Инженер-разработчик РЭА (Схемотехник)', 'Инженер-разработчик РЭА (Схемотехник)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 80 000 руб.</p>', '<h1> </h1>\r\n<p>Образование: среднее техническое или высшее (можем работать со студентами);</p>\r\n<p>Необходимый стаж работы по специальности: от 1-го года;</p>\r\n<p>- Знания протоколов и различных физических интерфейсов (Ethernet, USB, UART, I2C, SPI);<br />- Понимание цифровой и аналоговой схемотехники: транзистор, компаратор, ОУ, ШИМ, АЦП, ЦАП.;<br />- Грамотное владение русским языком, доступное изложение своих мыслей в устной и письменной форме;<br />- Навыки организации и планирования выполняемых работ;<br />- Ответственность, способность и мотивация на обучение и повышение квалификации, мотивация на достижение личного результата в работе, порядочность, контактность, умение работать в команде.<br />- Опыт работы по ремонту аппаратуры, умение паять и что-то делать своими руками;<br />- Опыт проектирования и запуска в производство цифровых устройств на основе микроконтроллеров.<br />Знание иностранного языка: на уровне чтения технической документации.</p>', '<p>- Разработка схем на базе микроконтроллеров и микропроцессоров;<br />- Разработка POS терминалов для банковской сферы и транспорта;<br />- Подбор комплектации и аналогов для заказа;<br />- Разработка топологии ПП;<br />- Заказ ПП и участие в сборке опытных образцов;<br />- Участие в испытаниях макетных и опытных образцов изделий;<br />- Разработка стендов для испытаний и для серийного производства.</p>', '<p>Заработная плата (размер и форма оплаты): от 80000 рублей (в зависимости от квалификации) <br />Испытательный срок: до 3-х месяцев;<br />Социальные льготы: <br />- Трудоустройство и соц. пакет в соответствии с ТК РФ, мед. страховка;<br />- Работа в стабильной, динамично развивающейся международной компании;<br />- Сплоченный коллектив профессионалов, нацеленных на результат;<br />- Множество интересных и разнообразных задач;<br />- Участие в международной сертификации и внедрениях;<br />- Комфортные рабочие места, современное программное обеспечение, высокий уровень развития IT-инфраструктуры;<br />Режим работы: Гибкий график работы в офисе в центре Зеленограда.</p>', '', '0', '0', '', '', '', '2', '124', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-10 17:41:51'),
('126', '25', 'Секретарь', 'Секретарь', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35 000 руб.</p>', '<p>Высшее образование;</p>\r\n<p>Стаж работы по специальности: не обязателен;<br />Необходимые навыки: ПК (уверенный пользователь), знание 1С8 (как плюс), пакет базовых офисных программ Microsoft,основы документооборота;<br />Знание иностранного языка: уровень Intermediate;</p>\r\n<p>Дополнительные требования: грамотная речь, аккуратность, внимательность, исполнительность, умение работать в команде, человек процесса, честность, сообразительность.</p>', '<p>- обработка входящих звонков и корреспонденции;<br />- работа с исходящей и входящей корреспонденцией;<br />- встреча посетителей и сопровождение до сотрудников;<br />- обеспечение ОФИСа канцтоварами, водой, кофе и т.п (контроль наличия, заказ);<br />- подготовка переговорной перед переговорами (контроль порядка, наличия канцтоваров);<br />- ведение календаря встреч (эпизодически)</p>', '<p>Заработная плата на испытательный срок 30 000 руб , срок 2 месяца;<br />После испытательного срока оклад 35 000 руб. ( в зависимости от квалификации и по результатам собеседования), возможны премии;<br />Социальные льготы: бесплатный обед, корпоративные праздники, оформление по ТК, оплачиваемый отпуск (2+2 недели), спортивная секция по волейболу, возможность ротации внутри компании через 2-3 года;<br />Режим работы: 5 дней, пн - пт, с 9 до 18</p>', '', '0', '0', '', '', '', '2', '126', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-11 09:43:15'),
('127', '5', 'Повар в семью', 'Повар в семью', 'Истра', '0', '1970-01-01', '', '', '<p>от 70 000 руб.</p>', '<p>Можно без профильного образование, главное уметь и любить готовить.<br />Опыт работы в семьях, наличие рекомендаций обязательно. <br />Наличие медицинской книжки.</p>', '<p>Приготовление блюд для семьи из 5 человек. <br />Диетическая кухня (средиземноморская легкая диетическая еда). <br />Курица, рыба, редко свинина, говядина. <br />Детям - куриные котлеты. Никаких особых соусов. <br />Желательно не более 4-х компонентов в блюде. <br />В конце рабочего дня на кухне за собой нужно будет все убрать.</p>', '<p>Адрес: Истринский район Московской области, деревня Павловское;<br />График: 5/2, с 10:00 до 16:30 (16.00)</p>', '', '0', '0', '', '', '', '2', '127', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-13 10:02:24'),
('128', '5', 'Горничная', 'Горничная', 'Зеленоград', '0', '1970-01-01', '', '', '<p>2500 руб.</p>', '<p>Опыт работы в семьях;<br />Наличие рекомендаций.</p>', '<p>Уборка квартиры;<br />Иногда глажка.</p>', '<p>Уборка трехэтажной квартиры в МЖК (700 кв.м.);<br />Уборка 1 раз в неделю - 1 этаж (200 кв.м.);<br />Любой будний день с 10.00 и примерно до 16.00.</p>', '', '0', '0', '', '', '', '2', '128', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-13 16:08:46');/**ABDB**/
