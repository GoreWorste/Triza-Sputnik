32\\u0435\\u043d\\u043d\\u044b\\u043c\\u0438 \\u0441\\u0438\\u043b\\u0430\\u043c\\u0438 \\u0438\\u0441\\u043a\\u0430\\u0442\\u044c \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u044f\\u0449\\u0438\\u0435 <strong>\\u0432\\u0430\\u043a\\u0430\\u043d\\u0441\\u0438\\u0438<\\/strong> \\u0438 \\u0436\\u0434\\u0430\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430 \\u043e\\u0442 \\u0440\\u0430\\u0431\\u043e\\u0442\\u043e\\u0434\\u0430\\u0442\\u0435\\u043b\\u044f. \\u0421\\u0430\\u043c\\u044b\\u0439 \\u043f\\u043e\\u043f\\u0443\\u043b\\u044f\\u0440\\u043d\\u044b\\u0439 \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431 - \\u044d\\u0442\\u043e \\u043f\\u043e\\u0438\\u0441\\u043a\\u0438 \\u0432 \\u0438\\u043d\\u0442\\u0435\\u0440\\u043d\\u0435\\u0442\\u0435, \\u043b\\u044e\\u0434\\u0438 \\u0432\\u0432\\u043e\\u0434\\u044f\\u0442 \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441 \\u00ab<strong>\\u0438\\u0449\\u0443 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443<\\/strong>\\u00bb, \\u0438 \\u043f\\u043e\\u0438\\u0441\\u043a\\u043e\\u0432\\u0430\\u044f \\u0441\\u0438\\u0441\\u0442\\u0435\\u043c\\u0430 \\u0432\\u044b\\u0434\\u0430\\u0435\\u0442 \\u0441\\u043e\\u0442\\u043d\\u0438 \\u0441\\u0441\\u044b\\u043b\\u043e\\u043a \\u043d\\u0430 \\u0431\\u0430\\u0437\\u044b \\u0432\\u0430\\u043a\\u0430\\u043d\\u0441\\u0438\\u0439. \\u041f\\u043e\\u0441\\u043b\\u0435 \\u044d\\u0442\\u043e\\u0433\\u043e \\u043d\\u0430\\u0447\\u0438\\u043d\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0440\\u043e\\u043f\\u043e\\u0442\\u043b\\u0438\\u0432\\u0430\\u044f \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430 \\u043f\\u043e \\u043f\\u0440\\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0443 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0439, \\u0432\\u044b\\u0431\\u043e\\u0440\\u0443 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u044f\\u0449\\u0438\\u0445 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u043e\\u0432 \\u0438 \\u043e\\u0442\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044e \\u0440\\u0435\\u0437\\u044e\\u043c\\u0435 \\u0432 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432\\u044b\\u0435 \\u0441\\u043b\\u0443\\u0436\\u0431\\u044b \\u043e\\u0440\\u0433\\u0430\\u043d\\u0438\\u0437\\u0430\\u0446\\u0438\\u0439. \\u00a0\\u0421 \\u043e\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b, \\u044d\\u0442\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435, \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0435 \\u0440\\u0430\\u043d\\u043e \\u0438\\u043b\\u0438 \\u043f\\u043e\\u0437\\u0434\\u043d\\u043e \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u0438\\u0432\\u0435\\u0441\\u0442\\u0438 \\u043a \\u043f\\u043e\\u043b\\u0443\\u0447\\u0435\\u043d\\u0438\\u044e \\u0436\\u0435\\u043b\\u0430\\u0435\\u043c\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b. \\u041d\\u043e \\u0432 \\u0442\\u043e \\u0436\\u0435 \\u0432\\u0440\\u0435\\u043c\\u044f, \\u0438\\u043d\\u043e\\u0433\\u0434\\u0430 \\u043e\\u0436\\u0438\\u0434\\u0430\\u043d\\u0438\\u044f \\u043d\\u0435 \\u043e\\u043f\\u0440\\u0430\\u0432\\u0434\\u044b\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f, \\u043e\\u0442\\u0432\\u0435\\u0442\\u044b \\u043e\\u0442 \\u043a\\u043e\\u043c\\u043f\\u0430\\u043d\\u0438\\u0439 \\u043d\\u0435 \\u043f\\u043e\\u0441\\u0442\\u0443\\u043f\\u0430\\u044e\\u0442 \\u0438\\u043b\\u0438 \\u0441\\u043e\\u0438\\u0441\\u043a\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f \\u043e\\u0442 \\u0441\\u043e\\u043c\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0440\\u0430\\u0431\\u043e\\u0442\\u043e\\u0434\\u0430\\u0442\\u0435\\u043b\\u0435\\u0439. \\u041f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u0442\\u0430\\u043a, \\u0447\\u0442\\u043e \\u043f\\u043e\\u0438\\u0441\\u043a \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b \\u0