043d\\u0430\\u043b\\u0430 \\u0422\\u0420\\u0418\\u0417\\u0410, \\u0441\\u0442\\u0430\\u0440\\u0435\\u0439\\u0448\\u0443\\u044e \\u0433\\u0440\\u0443\\u043f\\u043f\\u0443 \\u043a\\u043e\\u043c\\u043f\\u0430\\u043d\\u0438\\u0439 \\u043f\\u043e \\u043f\\u043e\\u0434\\u0431\\u043e\\u0440\\u0443 \\u0438 \\u043f\\u0440\\u0435\\u0434\\u043e\\u0441\\u0442\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u044e \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u043b\\u0430  \\u0432 \\u0420\\u043e\\u0441\\u0441\\u0438\\u0438, 31 \\u0438\\u044e\\u043b\\u044f 2020 \\u0433. \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u043b\\u043e \\u0441\\u0435\\u0440\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442 \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u044f \\u0421\\u0422\\u041e 03.080.02033720.\\r\\n\\r\\n\\u041d\\u0435\\u0441\\u043c\\u043e\\u0442\\u0440\\u044f \\u043d\\u0430 \\u0440\\u0430\\u0441\\u043f\\u0440\\u043e\\u0441\\u0442\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u0435 \\u041a\\u043e\\u0440\\u043e\\u043d\\u0430\\u0432\\u0438\\u0440\\u0443\\u0441\\u043d\\u043e\\u0439 \\u0438\\u043d\\u0444\\u0435\\u043a\\u0446\\u0438\\u0438 -  COVID-19 (\\u0432 \\u043f\\u0440\\u043e\\u0441\\u0442\\u043e\\u0440\\u0435\\u0447\\u0438\\u0438 \\u043a\\u043e\\u0432\\u0438\\u0434), \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0435 \\u043f\\u043e\\u0432\\u043b\\u0438\\u044f\\u043b\\u043e \\u043d\\u0430 \\u0434\\u0435\\u043b\\u043e\\u0432\\u0443\\u044e \\u0430\\u043a\\u0442\\u0438\\u0432\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432\\u043e \\u0432\\u0441\\u0435\\u043c \\u043c\\u0438\\u0440\\u0435 \\u0438 \\u0432 \\u0442\\u043e\\u043c \\u0447\\u0438\\u0441\\u043b\\u0435 \\u043e\\u0441\\u043b\\u043e\\u0436\\u043d\\u0438\\u043b\\u043e \\u0441\\u0438\\u0442\\u0443\\u0430\\u0446\\u0438\\u044e \\u0441 \\u0442\\u0440\\u0443\\u0434\\u043e\\u0443\\u0441\\u0442\\u0440\\u043e\\u0439\\u0441\\u0442\\u0432\\u043e\\u043c \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u043b\\u0430 \\u043a 