/**ABDB**/CREATE TABLE `#__ucm_content` (
  `core_content_id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `core_type_alias` varchar(400) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'FK to the content types table',
  `core_title` varchar(400) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `core_alias` varchar(400) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '',
  `core_body` mediumtext COLLATE utf8mb4_unicode_ci,
  `core_state` tinyint(1) NOT NULL DEFAULT '0',
  `core_checked_out_time` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '0000-00-00 00:00:00',
  `core_checked_out_user_id` int(10) unsigned NOT NULL DEFAULT '0',
  `core_access` int(10) unsigned NOT NULL DEFAULT '0',
  `core_params` text COLLATE utf8mb4_unicode_ci,
  `core_featured` tinyint(4) unsigned NOT NULL DEFAULT '0',
  `core_metadata` varchar(2048) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'JSON encoded metadata properties.',
  `core_created_user_id` int(10) unsigned NOT NULL DEFAULT '0',
  `core_created_by_alias` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `core_created_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `core_modified_user_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'Most recent user that modified',
  `core_modified_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `core_language` char(7) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `core_publish_up` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `core_publish_down` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `core_content_item_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'ID from the individual type table',
  `asset_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'FK to the #__assets table.',
  `core_images` text COLLATE utf8mb4_unicode_ci,
  `core_urls` text COLLATE utf8mb4_unicode_ci,
  `core_hits` int(10) unsigned NOT NULL DEFAULT '0',
  `core_version` int(10) unsigned NOT NULL DEFAULT '1',
  `core_ordering` int(11) NOT NULL DEFAULT '0',
  `core_metakey` text COLLATE utf8mb4_unicode_ci,
  `core_metadesc` text COLLATE utf8mb4_unicode_ci,
  `core_catid` int(10) unsigned NOT NULL DEFAULT '0',
  `core_xreference` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'A reference to enable linkages to external data sets.',
  `core_type_id` int(10) unsigned NOT NULL DEFAULT '0',
  PRIMARY KEY (`core_content_id`),
  KEY `tag_idx` (`core_state`,`core_access`),
  KEY `idx_access` (`core_access`),
  KEY `idx_alias` (`core_alias`(100)),
  KEY `idx_language` (`core_language`),
  KEY `idx_title` (`core_title`(100)),
  KEY `idx_modified_time` (`core_modified_time`),
  KEY `idx_created_time` (`core_created_time`),
  KEY `idx_content_type` (`core_type_alias`(100)),
  KEY `idx_core_modified_user_id` (`core_modified_user_id`),
  KEY `idx_core_checked_out_user_id` (`core_checked_out_user_id`),
  KEY `idx_core_created_user_id` (`core_created_user_id`),
  KEY `idx_core_type_id` (`core_type_id`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Contains core content data in name spaced fields';
/**ABDB**/INSERT INTO `#__ucm_content`  VALUES 
('1', 'com_content.article', 'Запрос на подбор специалистов Китая', 'zapros-na-podbor-spetsialistov-kitaya', '<p>В наше кадровое агентство поступил запрос от компании - производителя приборов для медицины на поиск специалиста по закупкам в Китае и юго-восточной Азии оборудования и материалов. </p>\r\n<p>Мы прогнозируем всплеск потребности в таких специалистах.</p>\r\n<p>Стоимость подбора такого специалиста от 1,5 заработной платы, гарантии предоставляются</p>\r\n<p>Ждем Ваши заказы на персонал по работе с Китаем.</p>\r\n<p>Телефон 8- 495-739-07-82 с 9-00 до 17-00 </p>\r\n<p> </p>', '1', '0000-00-00 00:00:00', '0', '1', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '479', '', '2022-03-18 14:06:11', '479', '2023-08-08 08:57:00', '*', '2022-03-18 14:06:11', '0000-00-00 00:00:00', '24', '108', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '535', '6', '1', '', '', '15', '', '1'),
('2', 'com_newsfeeds.newsfeed', 'Решение Зеленограда есть. Компании электронной отрасли испытывают дефицит кадров.', 'reshenie-zelenograda-est-kompanii-elektronnoj-otrasli-ispytyvayut-defitsit-kadrov', '<p>В середине девяностых годов прошлого века одна успешная американская компания -  производитель инновационных приборов для банковской сферы, открыла филиал в Зеленограде. Компания наняла инженеров - конструкторов РЭА, программистов ПЛИС, проектных менеджеров, системных программистов, тестировщиков и т.д.</p>\r\n<p>Но санкции США в начале двухтысячных потребовали прекращение  высокотехнологичных разработок в России. Компания закрыла филиал в Москве, но группа разработчиков, куда входили инженеры конструкторы РЭА, инженер - технолог и другие специалисты, в том числе IT, осталась на Родине и продолжила развитие приборов в данной сфере. Уже на основе наших технологических решений и другой элементной базы.</p>\r\n<p>Компания продолжала сотрудничество с МИЭТом, МИРЭА, Бауманкой, МАИ и другими нашими университетами, которые успешно готовят нашу элиту, прибористов, инженеров - электроников, инженеров - схемотехников, технических писателей, инженеров по качеству и диспетчеров производства, embedded - программистов и других спецов для  радиоэлектронных компаний и компаний производителей приборов.</p>\r\n<p>Что в итоге: в России эта компания создала производство собственных высокотехнологичных  приборов не только для банковской сферы, но и для других отраслей, где требовались похожие решения, успешно заместила импорт и стала экспортером мирового уровня. На основе обширной кооперации с этой компанией сотрудничают и развиваются другие смежные компании  по всей России. Численность ключевого персонала - творцов (в том числе главных и ведущих конструкторов, руководителей КБ, начальников производства), выросла в десятки раз. Приборы продаются по всему миру, в том числе в самих США, Канаде, а наши \"мозги\" делают их конкурентными с  любыми аналогами.</p>\r\n<p>Мой опыт подбора кадров для компаний радиоэлектроники с 1992 года позволил отследить несколько историй похожих на описанную выше. Конечно, надо снять \"шляпу\" перед теми светлыми головами, которые не опустив свои руки удержали, собрали и развили свои направления.  </p>\r\n<p>Кадры можно покупать и  собирать по всему миру, как это делают  США, но можно, создавая условия  опираться на наш научный и интеллектуальный потенциал. Самое интересное, что этот путь только кажется более долгим и затратным. На самом деле правильно подсчитанный экономический эффект в данном случае многократно умножается на другие благоприятные моменты от развития собственного кадрового потенциала. </p>', '1', '0000-00-00 00:00:00', '0', '1', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '0', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '479', '', '2023-08-11 12:41:14', '479', '2023-08-15 10:41:53', '*', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '7', '112', '{\"image_first\":\"images\\/900x600_adaptiveResize_ministr14_kadry14_1.jpg\",\"float_first\":\"\",\"image_first_alt\":\"\\u0414\\u043e\\u043a\\u043b\\u0430\\u0434 \\u0432 \\u041a\\u043e\\u0440\\u043f\\u043e\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u0417\\u0435\\u043b\\u0435\\u043d\\u043e\\u0433\\u0440\\u0430\\u0434\",\"image_first_caption\":\"\\u042e\\u0440\\u0438\\u0439 \\u041f\\u043e\\u043b\\u0435\\u0442\\u0430\\u0435\\u0432 \\u0434\\u043e\\u043a\\u043b\\u0430\\u0434\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432\\u0438\\u043a\\u0430\\u043c \\u043f\\u0440\\u0438\\u0431\\u043e\\u0440\\u0438\\u0441\\u0442\\u0441\\u043a\\u0438\\u0445 \\u0438 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043c\\u043f\\u0430\\u043d\\u0438\\u0439 \\u0417\\u0435\\u043b\\u0435\\u043d\\u043e\\u0433\\u0440\\u0430\\u0434\\u0430, \\u0432\\u0445\\u043e\\u0434\\u044f\\u0449\\u0438\\u0445 \\u0432 \\u043a\\u043b\\u0430\\u0441\\u0442\\u0435\\u0440 \\u0422\\u0435\\u0445\\u043d\\u043e\\u044e\\u043d\\u0438\\u0442\\u0438 \\u043e \\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u0430\\u0445 \\u043f\\u043e\\u0438\\u0441\\u043a\\u0430 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u043b\\u0430\\u043e\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}', 'https://www.jobcv.ru/novosti/reshenie-zelenograda-est-kompanii-elektronnoj-otrasli-ispytyvayut-defitsit-kadrov', '0', '10', '7', '', '', '14', '', '3');
/**ABDB**/CREATE TABLE `#__ucm_base` (
  `ucm_id` int(10) unsigned NOT NULL,
  `ucm_item_id` int(10) NOT NULL,
  `ucm_type_id` int(11) NOT NULL,
  `ucm_language_id` int(11) NOT NULL,
  PRIMARY KEY (`ucm_id`),
  KEY `idx_ucm_item_id` (`ucm_item_id`),
  KEY `idx_ucm_type_id` (`ucm_type_id`),
  KEY `idx_ucm_language_id` (`ucm_language_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
