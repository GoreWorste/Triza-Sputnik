/**ABDB**/CREATE TABLE `#__overrider` (
  `id` int(10) NOT NULL AUTO_INCREMENT COMMENT 'Primary Key',
  `constant` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `string` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `file` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/**ABDB**/CREATE TABLE `#__newsfeeds` (
  `catid` int(11) NOT NULL DEFAULT '0',
  `id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `alias` varchar(400) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '',
  `link` varchar(2048) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `published` tinyint(1) NOT NULL DEFAULT '0',
  `numarticles` int(10) unsigned NOT NULL DEFAULT '1',
  `cache_time` int(10) unsigned NOT NULL DEFAULT '3600',
  `checked_out` int(10) unsigned NOT NULL DEFAULT '0',
  `checked_out_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `ordering` int(11) NOT NULL DEFAULT '0',
  `rtl` tinyint(4) NOT NULL DEFAULT '0',
  `access` int(10) unsigned NOT NULL DEFAULT '0',
  `language` char(7) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `params` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `created` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `created_by` int(10) unsigned NOT NULL DEFAULT '0',
  `created_by_alias` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `modified` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `modified_by` int(10) unsigned NOT NULL DEFAULT '0',
  `metakey` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `metadesc` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `metadata` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `xreference` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'A reference to enable linkages to external data sets.',
  `publish_up` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `publish_down` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `description` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `version` int(10) unsigned NOT NULL DEFAULT '1',
  `hits` int(10) unsigned NOT NULL DEFAULT '0',
  `images` text COLLATE utf8mb4_unicode_ci NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_access` (`access`),
  KEY `idx_checkout` (`checked_out`),
  KEY `idx_state` (`published`),
  KEY `idx_catid` (`catid`),
  KEY `idx_createdby` (`created_by`),
  KEY `idx_language` (`language`),
  KEY `idx_xreference` (`xreference`)
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/**ABDB**/INSERT INTO `#__newsfeeds`  VALUES 
('14', '1', 'Получение Сертификата СТО Агентством Персона-Спутник', 'poluchenie-sertifikata-sto-agentstvom-persona-sputnik', 'https://www.jobcv.ru/novosti/sertifikat', '1', '10', '3600', '479', '2024-07-04 12:06:14', '1', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-10 21:19:06', '479', '', '2023-08-11 09:40:58', '479', '', 'Сертификат СТО  Подбор персонала Вакансии Зеленоград', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '<p><span data-contrast=\"auto\">Кадр</span><span data-contrast=\"auto\">овое агентство ПЕРСОНА-Спутник, один из офисов которого расположен в городе Зеленограде и </span><span data-contrast=\"auto\">входящее в группу подбора персонала ТРИЗА, старейшую</span><span data-contrast=\"auto\"> группу компаний по подбору и предоставлению </span><span data-contrast=\"auto\">персонала </span><span data-contrast=\"auto\"> в</span><span data-contrast=\"auto\"> России, 31 июля 2020 г. получило сертификат соответствия</span><span data-contrast=\"auto\"> </span><span data-contrast=\"auto\">СТО 03.080.02033720.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p> </p>\r\n<p><span data-contrast=\"auto\">Агентство Персона </span><span data-contrast=\"auto\">Sputnik</span><span data-contrast=\"auto\"> </span><span data-contrast=\"auto\">занимается и предоставлением домашнего персонала в семьи. Агентство не берет денег с домашнего персонала за трудоустройство в Зеленограде и </span><span data-contrast=\"auto\">Москве, </span><span data-contrast=\"auto\">может подбирать луч</span><span data-contrast=\"auto\">ших работников в семьи для самых</span><span data-contrast=\"auto\"> ответственных и статусных заказчиков, как например подбор семейных пар</span><span data-contrast=\"auto\"> для помощи по ведению хозяйства как на дачи так и в коттеджи с постоянным проживанием владельцев</span><span data-contrast=\"auto\"> но озере Круглое, в </span><span data-contrast=\"auto\">Барвиху</span><span data-contrast=\"auto\">, Рублевское шоссе, Николина гора, </span><span data-contrast=\"auto\">Фирсановка</span><span data-contrast=\"auto\"> и другие замечательные места ближайшего Подмосковья где проживают семьи работодателей, которые нуждаются в домашней </span><span data-contrast=\"auto\">прислуге –няня, гувернантка, мажордом, персональный водитель, семейная пара, садовник, повар в семью</span><span data-contrast=\"auto\">. </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p> </p>\r\n<p><span data-contrast=\"auto\">ПЕРСОНА-Спутник соответствует требованиям стандарта СТО 03.080.02033720.1-</span><span data-contrast=\"auto\">2020 .</span><span data-contrast=\"auto\"> Сертификат СТО позволяет участвовать в тендерах и торгах и подтверждает надежность компании как делового партнера.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> <img src=\"images/2021-02-10_23-27-21.png\" alt=\"\" /></span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>', '4', '19', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\\u0421\\u0435\\u0440\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442 \\u0421\\u0422\\u041e\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '2', 'Свежие вакансии в Зеленограде', 'svezhie-vakansii-v-zelenograde', 'https://www.jobcv.ru/novosti/vakansii_zelenograd', '-2', '10', '3600', '0', '0000-00-00 00:00:00', '2', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-14 14:59:32', '479', 'Юрий Полетаев', '2021-02-14 16:10:24', '479', 'Юрий Полетаев, Зеленоград, Вакансии', 'Свежие вакансии от стабильных и надежных работодателей в г.Зеленоград. Кадровое агентство «ТРИЗА-СПУТНИК» предлагает вашему вниманию широчайшую базу свежих вакансии, которые вы сможете найти на сайте www.jobcv.ru', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', 'Работа в Зеленограде: свежие вакансии на сегодня', '2021-02-14 16:11:30', '0000-00-00 00:00:00', '<p> </p>\r\n<h1><strong>Свежие вакансии в Зеленограде</strong></h1>\r\n<p>Вот уже более 15 лет кадровое агентство «ТРИЗА-СПУТНИК» предлагает свои услуги по подбору персонала и помощи в трудоустройстве в Москве и Московской области. За это время мы помогли тысячам работодателей найти компетентных сотрудников на замещаемые должности, многие из них стали нашими постоянными клиентами. Мы дорожим своей репутацией и используем уникальные авторские методики для поиска и тестирования соискателей, благодаря чему добиваемся 100 %-х результатов и решаем кадровые задачи любой сложности.</p>\r\n<h2>Найти работу в Зеленограде с компанией «ТРИЗА-СПУТНИК»</h2>\r\n<p>HR-менеджеры, работающие в нашем агентстве, - это не просто посредники, которые штудируют сотни объявлений о вакансиях. Услуги наших сотрудников имеют высокую ценность еще и тем, что они детально описывают соискателям ситуацию на рынке труда в интересующей сфере, рассказывают об уровне дохода, на который кандидат может претендовать, помогают соотнести ожидания каждого соискателя с предложениями работодателей и предложить оптимальные варианты.</p>\r\n<p>Кроме того, специалисты кадровых агентств дают рекомендации, каким образом можно повысить шансы на успешное трудоустройство, если что-то вы делаете неправильно.</p>\r\n<p><strong>На сегодня</strong> мы располагаем широчайшей базой свежих вакансий от прямых работодателей в <strong>г.Зеленоград</strong>, в которой вы найдете гораздо больше привлекательных вариантов, чем в свободном доступе в газетах или сети Интернет.</p>\r\n<h2>Свежие объявления и резюме</h2>\r\n<p>Сотрудничество с компанией «ТРИЗА-СПУТНИК» - это возможность получить достойную<strong> работу </strong>в стабильных компаниях Зеленограда, для этого мы регулярно размещаем на нашем сайте новые вакансии от прямых работодателей.</p>\r\n<p>Каждый клиент может быть уверен, что мы предлагаем только те кандидатуры, которые максимально соответствуют должностным и корпоративным требованиям. Для этого каждый соискатель проходит несколько этапов тестирования, на которых мы оцениваем его профессиональные и коммуникативные навыки, способность принимать решения и работать в предлагаемых условиях. Благодаря передовым методикам наши специалисты успешно проверяют объявленные характеристики соискателя и выбирают только тех кандидатов, которые смогут результативно выполнять свои обязанности, повышая эффективность деятельности компании.</p>\r\n<p>Если вы оказались в ситуации поиска работы и хотите реализовать свой профессиональный потенциал в надежной и перспективной компании, то наши услуги - это именно то, что вам нужно.</p>\r\n<p><strong> </strong></p>', '3', '5', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '3', 'Вакансии в Солнечногорске от прямых работодателей', 'vakansii-v-solnechnogorske-ot-pryamykh-rabotodatelej', 'https://www.jobcv.ru/novosti/vakansii_solnechnogorsk', '1', '10', '3600', '479', '2024-07-04 12:06:11', '3', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-14 15:05:21', '479', '', '2021-02-14 15:05:21', '0', 'Юрий Полетаев, Солнечногорск, Вакансии, Зеленоград, Подбор пресонала', 'Вакансии в Солнечногорске от прямых работодателей на сайте www.jobcv.ru. Самые актуальные и свежие вакансии от лучших компаний в кадровом агентстве «ТРИЗА-СПУТНИК». ', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '<h1><strong>Вакансии в Солнечногорске от прямых работодателей</strong></h1>\r\n<p>Услуги надежного и авторитетного кадрового агентства <strong>на сегодня</strong> считаются самым эффективным способом поиска компетентных сотрудников, идеально соответствующих должностным требованиям. Также кадровые компании обеспечивают отличную возможность для соискателей получить желаемую работу по специальности в кратчайшие сроки. На современном рынке труда работодатели заинтересованы не только в опытных профессионалах с большим стажем, но и в молодых инициативных специалистах с хорошим образованием и без опыта <strong>работы. </strong>В каждом из этих случаев важным фактором успеха считается правильная презентация своих сильных сторон и преимуществ  работодателю.</p>\r\n<h2>Свежие вакансии от прямых работодателей</h2>\r\n<p>Кадровое агентство «ТРИЗА-СПУТНИК» предлагает услуги по подбору персонала различных категорий в городе <strong>Солнечногорске</strong>, Зеленограде, Химках и других городах Московской области. </p>\r\n<p>Наше агентство работает в этой сфере уже более 15 лет, за это время мы сформировали команду профессиональных менеджеров и экспертов по кадрам и наработали методическую базу, состоящую из самых эффективных инструментов поиска и подбора персонала.</p>\r\n<p>Наши преимущества:</p>\r\n<ul>\r\n<li>Нацеленность на результат - на каждую должность мы подбираем кандидатов, на 100 % удовлетворяющих требованиям наших заказчиков.</li>\r\n<li>Индивидуальный подход - с учетом пожеланий работодателя и корпоративных стандартов мы формируем наиболее результативную стратегию поиска, которая позволяет найти максимально подходящую кандидатуру в кратчайшие сроки.</li>\r\n<li>Приемлемые цены на услуги - мы заинтересованы, чтобы каждый новый заказчик стал постоянным клиентом нашего агентства, поэтому ведем гибкую ценовую политику.</li>\r\n<li>Профессиональные HR-специалисты - поиском кандидата занимаются сразу несколько специалистов по подбору кадров, что существенно повышает эффективность работы на каждом этапе.</li>\r\n</ul>\r\n<h2>Огромные возможности для соискателей</h2>\r\n<p>На сайте <a href=\"http://www.jobcv.ru\">www.jobcv.ru</a> вы сможете найти интересные для вас вакансии от прямых работодателей и отправить свое резюме. Наши специалисты максимально оперативно просматривают все отклики, и если ваше резюме соответствует профессиональным требованиям заказчика, мы пригласим вас на собеседование. Даже если ваши характеристики не соответствуют указанной вакансии, мы сможем предложить вам другие варианты и поместим ваше резюме в свою базу, поэтому шанс найти работу существенно возрастает.</p>', '1', '1', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '4', ' Работа в Зеленограде: вакансии от прямых работодателей', 'rabota-v-zelenograde-vakansii-ot-pryamykh-rabotodatelej', 'https://www.jobcv.ru/novosti/vakansii_ot_rabotodatelei', '1', '5', '3600', '479', '2024-07-04 12:06:11', '4', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-14 15:22:30', '479', '', '2021-02-14 15:22:30', '0', 'Юрий Полетаев, Триза-Спутник, Вакансии агенства, Подбор высокоинтеллектуального персонала, подбор массового персонала', 'Работа в Зеленограде и Москве, вакансии от прямых работодателей. Самые свежие вакансии с должностными обязанностями и заработной платой вы сможете посмотреть на сайте www.jobcv.ru.', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '<p><strong></strong></p>\r\n<h1>Работа в Зеленограде: вакансии от прямых работодателей</h1>\r\n<p>Многие соискатели, столкнувшись с задачей найти работу, предпочитают собственными силами искать подходящие <strong>вакансии</strong> и ждать ответа от работодателя. Самый популярный способ - это поиски в интернете, люди вводят запрос «<strong>ищу работу</strong>», и поисковая система выдает сотни ссылок на базы вакансий. После этого начинается кропотливая работа по просмотру предложений, выбору подходящих вариантов и отправлению резюме в кадровые службы организаций.  С одной стороны, это правильное решение, которое рано или поздно может привести к получению желаемой работы. Но в то же время, иногда ожидания не оправдываются, ответы от компаний не поступают или соискатель получает предложения от сомнительных работодателей. Получается так, что поиск работы может затянуться на неопределенный срок. В этом случае услуги кадровых агентств станут тем самым эффективным инструментом, который поможет сократить время на поиски работы, избавляя соискателя от недобросовестных работодателей и смутных предложений. Как правило, оплата подобных услуг, окупается в кратчайшие сроки получением желаемой работы с ожидаемым уровнем заработной платы.</p>\r\n<p>Сотрудничество с агентством «ТРИЗА-СПУТНИК» существенно повышает ваши шансы на скорейшее трудоустройство в проверенной компании.</p>\r\n<h2>Свежие вакансии от лучших работодателей</h2>\r\n<p>Услуги рекрутинговых агентств имеют массу неоспоримых преимуществ, особенно на современном трудовом рынке, где спрос значительно превышает предложение, а среди соискателей существует огромная конкуренция. В такой ситуации очень важно максимально эффективно презентовать себя работодателю, для этого целесообразно воспользоваться услугами профессионалов, которые помогут показать ваши самые выигрышные стороны и предложат вакансии от надежных и стабильных работодателей.</p>\r\n<p>Услуги кадровых агентств актуальны для специалистов разных уровней и сфер деятельности. Если вы - высококвалифицированный профессионал, который претендует на управляющую должность, то помощь кадровых агентств вам понадобится в первую очередь.</p>\r\n<p>Нам доверяют крупнейшие компании в <strong>Москве, Зеленограде</strong> и других городах Московской области. Наши клиенты - стабильные и устойчивые игроки на местном рынке, которые могут обеспечить сотрудникам достойную заработную плату и профессиональное развитие. Самые интересные вакансии, в том числе на замещение руководящих должностей, размещены в нашей базе, поэтому обращаясь к нам, вы получаете <strong>свежие</strong> варианты, которых не встретить в свободном доступе в сети Интернет.</p>', '1', '1', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '5', 'Свежие вакансии в Химках от прямых работодателей', 'svezhie-vakansii-v-khimkakh-ot-pryamykh-rabotodatelej', 'https://www.jobcv.ru/novosti/vakansii_himki', '-2', '5', '3600', '0', '0000-00-00 00:00:00', '5', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-14 15:25:00', '479', '', '2021-02-14 15:25:00', '0', 'Юрий Полетаев, Триза-Спутник, Подбор персонала', 'Компания «ТРИЗА-СПУТНИК» собрала самые свежие вакансии в Химках от прямых работодателей. Широчайшая база вакансий от частных лиц, работа без посредников и ориентация на результат. ', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '2021-02-14 16:11:38', '0000-00-00 00:00:00', '<h1>Свежие вакансии в Химках от прямых работодателей</h1>\r\n<p>Кадровое агентство «ТРИЗА-СПУТНИК» предлагает своим клиентам услуги подбора кадров любых специальностей и сфер деятельности. Профессиональные сотрудники - это один из ключевых факторов успешной и эффективной деятельности компании, поэтому мы подходим к процессу поиска со всей ответственностью, используя самые результативные методы поиска и отбора.</p>\r\n<h2>Работа в Химках: вакансии от частных лиц</h2>\r\n<p>Наши специалисты сформировали широчайшую базу, которая включает в себя самые <strong>свежие вакансии</strong> от <strong>прямых работодателей</strong> и является уникальным шансом для всех, кто <strong>ищет работу. </strong></p>\r\n<p>Мы сотрудничаем с работодателями из Москвы и Московской области<strong> - Химки, </strong>Зеленоград, Солнечногорск и другие города. С нашей помощью любой соискатель может найти себе работу в своем городе, для этого вам необходимо грамотно составить резюме и отправить его нашим специалистам. Мы предложим вам несколько вариантов вакансий, поэтому шанс найти желаемую <strong>работу</strong> существенно возрастает.</p>\r\n<h2>Работа без посредников и через кадровое агентство: наши преимущества</h2>\r\n<ul>\r\n<li>Наши HR-менеджеры подкорректируют ваш поиск и определят, каким сферам и организациям будут интересны ваши навыки и опыт, а также насколько ваши ожидания по оплате труда соответствуют профессиональному уровню.</li>\r\n<li>Мы поможем вам правильно продемонстрировать себя работодателю, подкорректируем резюме и грамотно опишем все ваши преимущества и навыки.</li>\r\n<li>Подскажем, какие именно факторы могут вам мешать получить желаемую работу;</li>\r\n<li>наша база, сформированная исключительно из вакансий проверенных компаний, избавит вас от сомнительных и недобросовестных работодателей.</li>\r\n<li>Для тех, кто ищет работу впервые, наши менеджеры дадут несколько полезных рекомендаций, который помогут избежать ошибок на собеседовании с работодателем.</li>\r\n<li>Мы предложим вам вакансии, которых нет в открытом доступе, поскольку есть такие работодатели, которые ищут персонал только с помощью кадровых агентств.</li>\r\n</ul>\r\n<p>Трудоустройство в большей степени зависит от самого соискателя, его профессиональных знаний, навыков, опыта и амбиций, а наша компания предоставит вам выбор качественных вариантов, среди которых вы сможете выбрать наиболее привлекательные предложения.</p>\r\n<p>Для наших заказчиков мы формируем базу из актуальных резюме, которая в совокупности с передовыми методами поиска и тестирования соискателя, позволяет нам подбирать на каждую должность максимально подходящую кандидатуру.</p>', '1', '2', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '6', 'Лента новостей', 'lenta-novostej', 'https://www.jobcv.ru/novosti', '1', '5', '3600', '479', '2024-07-04 12:06:13', '6', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2021-02-14 15:54:17', '479', '', '2021-02-14 15:54:17', '0', '', '', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '', '1', '1', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '7', 'Решение Зеленограда есть. Компании электронной отрасли испытывают дефицит кадров.', 'reshenie-zelenograda-est-kompanii-elektronnoj-otrasli-ispytyvayut-defitsit-kadrov', 'https://www.jobcv.ru/novosti/reshenie-zelenograda-est-kompanii-elektronnoj-otrasli-ispytyvayut-defitsit-kadrov', '1', '5', '3600', '479', '2024-07-04 12:06:14', '7', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2023-08-11 12:41:14', '479', 'Poletaev', '2023-08-15 10:41:53', '479', '', '', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '<p>В середине девяностых годов прошлого века одна успешная американская компания -  производитель инновационных приборов для банковской сферы, открыла филиал в Зеленограде. Компания наняла инженеров - конструкторов РЭА, программистов ПЛИС, проектных менеджеров, системных программистов, тестировщиков и т.д.</p>\r\n<p>Но санкции США в начале двухтысячных потребовали прекращение  высокотехнологичных разработок в России. Компания закрыла филиал в Москве, но группа разработчиков, куда входили инженеры конструкторы РЭА, инженер - технолог и другие специалисты, в том числе IT, осталась на Родине и продолжила развитие приборов в данной сфере. Уже на основе наших технологических решений и другой элементной базы.</p>\r\n<p>Компания продолжала сотрудничество с МИЭТом, МИРЭА, Бауманкой, МАИ и другими нашими университетами, которые успешно готовят нашу элиту, прибористов, инженеров - электроников, инженеров - схемотехников, технических писателей, инженеров по качеству и диспетчеров производства, embedded - программистов и других спецов для  радиоэлектронных компаний и компаний производителей приборов.</p>\r\n<p>Что в итоге: в России эта компания создала производство собственных высокотехнологичных  приборов не только для банковской сферы, но и для других отраслей, где требовались похожие решения, успешно заместила импорт и стала экспортером мирового уровня. На основе обширной кооперации с этой компанией сотрудничают и развиваются другие смежные компании  по всей России. Численность ключевого персонала - творцов (в том числе главных и ведущих конструкторов, руководителей КБ, начальников производства), выросла в десятки раз. Приборы продаются по всему миру, в том числе в самих США, Канаде, а наши \"мозги\" делают их конкурентными с  любыми аналогами.</p>\r\n<p>Мой опыт подбора кадров для компаний радиоэлектроники с 1992 года позволил отследить несколько историй похожих на описанную выше. Конечно, надо снять \"шляпу\" перед теми светлыми головами, которые не опустив свои руки удержали, собрали и развили свои направления.  </p>\r\n<p>Кадры можно покупать и  собирать по всему миру, как это делают  США, но можно, создавая условия  опираться на наш научный и интеллектуальный потенциал. Самое интересное, что этот путь только кажется более долгим и затратным. На самом деле правильно подсчитанный экономический эффект в данном случае многократно умножается на другие благоприятные моменты от развития собственного кадрового потенциала. </p>', '10', '0', '{\"image_first\":\"images\\/900x600_adaptiveResize_ministr14_kadry14_1.jpg\",\"float_first\":\"\",\"image_first_alt\":\"\\u0414\\u043e\\u043a\\u043b\\u0430\\u0434 \\u0432 \\u041a\\u043e\\u0440\\u043f\\u043e\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0440\\u0430\\u0437\\u0432\\u0438\\u0442\\u0438\\u044f \\u0417\\u0435\\u043b\\u0435\\u043d\\u043e\\u0433\\u0440\\u0430\\u0434\",\"image_first_caption\":\"\\u042e\\u0440\\u0438\\u0439 \\u041f\\u043e\\u043b\\u0435\\u0442\\u0430\\u0435\\u0432 \\u0434\\u043e\\u043a\\u043b\\u0430\\u0434\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432\\u0438\\u043a\\u0430\\u043c \\u043f\\u0440\\u0438\\u0431\\u043e\\u0440\\u0438\\u0441\\u0442\\u0441\\u043a\\u0438\\u0445 \\u0438 \\u044d\\u043b\\u0435\\u043a\\u0442\\u0440\\u043e\\u043d\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043c\\u043f\\u0430\\u043d\\u0438\\u0439 \\u0417\\u0435\\u043b\\u0435\\u043d\\u043e\\u0433\\u0440\\u0430\\u0434\\u0430, \\u0432\\u0445\\u043e\\u0434\\u044f\\u0449\\u0438\\u0445 \\u0432 \\u043a\\u043b\\u0430\\u0441\\u0442\\u0435\\u0440 \\u0422\\u0435\\u0445\\u043d\\u043e\\u044e\\u043d\\u0438\\u0442\\u0438 \\u043e \\u043f\\u0440\\u043e\\u0431\\u043b\\u0435\\u043c\\u0430\\u0445 \\u043f\\u043e\\u0438\\u0441\\u043a\\u0430 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u043b\\u0430\\u043e\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}'),
('14', '8', 'Кадры для радиоэлектроники, к чему приводит уход западных компаний  ', 'kadry-dlya-radioelektroniki-k-chemu-privodit-ukhod-zapadnykh-kompanij', 'https://www.jobcv.ru/novosti/kadry-dlya-radioelektroniki-k-chemu-privodit-ukhod-zapadnykh-kompanij', '1', '5', '3600', '479', '2024-07-04 12:06:12', '8', '0', '1', '*', '{\"show_feed_image\":\"\",\"show_feed_description\":\"\",\"show_item_description\":\"\",\"feed_character_count\":\"\",\"newsfeed_layout\":\"\",\"feed_display_order\":\"\"}', '2023-08-15 10:49:44', '479', '', '2023-08-16 10:34:16', '479', '', '', '{\"robots\":\"\",\"rights\":\"\",\"hits\":null}', '', '2023-08-15 13:32:51', '2024-08-15 13:33:00', '<p>В середине девяностых годов прошлого века одна успешная американская компания -  производитель инновационных приборов для банковской сферы, открыла филиал в Зеленограде. Компания наняла инженеров - конструкторов РЭА, программистов ПЛИС, проектных менеджеров, системных программистов, тестировщиков и т.д.</p>\r\n<p> </p>\r\n<p>Но санкции США в начале двухтысячных потребовали прекращение  высокотехнологичных разработок в России. Компания закрыла филиал в Москве, но группа разработчиков, куда входили инженеры конструкторы РЭА, инженер - технолог и другие специалисты, в том числе IT, осталась на Родине и продолжила развитие приборов в данной сфере. Уже на основе наших технологических решений и другой элементной базы.</p>\r\n<p> </p>\r\n<p>Компания продолжала сотрудничество с МИЭТом, МИРЭА, Бауманкой, МАИ и другими нашими университетами, которые успешно готовят нашу элиту, прибористов, инженеров - электроников, инженеров - схемотехников, технических писателей, инженеров по качеству и диспетчеров производства, embedded - программистов и других спецов для  радиоэлектронных компаний и компаний производителей приборов.</p>\r\n<p> </p>\r\n<p>Что в итоге: в России эта компания создала производство собственных высокотехнологичных  приборов не только для банковской сферы, но и для других отраслей, где требовались похожие решения, успешно заместила импорт и стала экспортером мирового уровня. На основе обширной кооперации с этой компанией сотрудничают и развиваются другие смежные компании  по всей России. Численность ключевого персонала - творцов (в том числе главных и ведущих конструкторов, руководителей КБ, начальников производства), выросла в десятки раз. Приборы продаются по всему миру, в том числе в самих США, Канаде, а наши \"мозги\" делают их конкурентными с  любыми аналогами.</p>\r\n<p> </p>\r\n<p>Мой опыт подбора кадров для компаний радиоэлектроники с 1992 года позволил отследить несколько историй похожих на описанную выше. Конечно, надо снять \"шляпу\" перед теми светлыми головами, которые не опустив свои руки удержали, собрали и развили свои направления. </p>\r\n<p> </p>\r\n<p>Кадры можно покупать и  собирать по всему миру, как это делают  США, но можно, создавая условия  опираться на наш научный и интеллектуальный потенциал. Самое интересное, что этот путь только кажется более долгим и затратным. На самом деле правильно подсчитанный экономический эффект в данном случае многократно умножается на другие благоприятные моменты от развития собственного кадрового потенциала.</p>', '5', '0', '{\"image_first\":\"\",\"float_first\":\"\",\"image_first_alt\":\"\",\"image_first_caption\":\"\",\"image_second\":\"\",\"float_second\":\"\",\"image_second_alt\":\"\",\"image_second_caption\":\"\"}');
