('93', '49', 'Call us', '', '<table style=\"width: 733px;\">\r\n<tbody>\r\n<tr>\r\n<td style=\"width: 406px; text-align: right;\"><img class=\"fa\" src=\"images/jobcv/sois_icon.jpg\" alt=\"phone_number\" /> <a id=\"contact_soiskatel\"></a><strong>Соис</strong><strong>кателю</strong></td>\r\n<td style=\"width: 331px; text-align: right;\"><img class=\"fa\" src=\"images/jobcv/rabotod_icon.jpg\" alt=\"time_icon\" /><a id=\"contact_rabotodatel\"></a><strong>Работодателю</strong></td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 406px; text-align: right;\">8 (963) 711-27-24 </td>\r\n<td style=\"width: 331px; text-align: right;\">8 (495) 740-78-88</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width: 406px; text-align: right;\"><a title=\"Посмотреть вакансии ТРИЗА-спутник\" href=\"vacancy\">Посмотреть вакансии</a></td>\r\n<td style=\"width: 331px; text-align: right;\"><a title=\"Запрос на подбор персонала в ТРИЗА-спутник\" href=\"index.php?option=com_content&amp;view=article&amp;id=15:zapros-na-podbor-personala&amp;catid=2:pages\" target=\"_self\">Запрос на подбор персонала</a></td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p><strong> </strong></p>', '1', 'logobar', '0', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '1', 'mod_custom', '1', '0', '{\"prepare_content\":0,\"backgroundimage\":\"\",\"layout\":\"_:default\",\"moduleclass_sfx\":\"\",\"cache\":1,\"cache_time\":900,\"cachemode\":\"static\",\"module_tag\":\"div\",\"bootstrap_size\":\"0\",\"header_tag\":\"h3\",\"header_class\":\"\",\"style\":\"0\"}', '0', '*'),
