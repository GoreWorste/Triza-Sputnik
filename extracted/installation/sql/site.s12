/**ABDB**/CREATE TABLE `#__k2_users` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `userID` int(11) NOT NULL,
  `userName` varchar(255) DEFAULT NULL,
  `gender` enum('m','f') NOT NULL DEFAULT 'm',
  `description` text NOT NULL,
  `image` varchar(255) DEFAULT NULL,
  `url` varchar(255) DEFAULT NULL,
  `group` int(11) NOT NULL DEFAULT '0',
  `plugins` text NOT NULL,
  `ip` varchar(15) NOT NULL,
  `hostname` varchar(255) NOT NULL,
  `notes` text NOT NULL,
  PRIMARY KEY (`id`),
  KEY `userID` (`userID`),
  KEY `group` (`group`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_users`  VALUES 
('1', '478', 'Super User', 'm', '', NULL, NULL, '1', '', '176.59.42.8', '176.59.42.8', '');
/**ABDB**/CREATE TABLE `#__k2_user_groups` (
  `id` int(10) unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `permissions` text NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/CREATE TABLE `#__k2_tags_xref` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `tagID` int(11) NOT NULL,
  `itemID` int(11) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `tagID` (`tagID`),
  KEY `itemID` (`itemID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/CREATE TABLE `#__k2_tags` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `published` smallint(6) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `published` (`published`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/CREATE TABLE `#__k2_rating` (
  `itemID` int(11) NOT NULL DEFAULT '0',
  `rating_sum` int(11) unsigned NOT NULL DEFAULT '0',
  `rating_count` int(11) unsigned NOT NULL DEFAULT '0',
  `lastip` varchar(50) NOT NULL DEFAULT '',
  PRIMARY KEY (`itemID`),
  KEY `rating_sum` (`rating_sum`),
  KEY `rating_count` (`rating_count`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/CREATE TABLE `#__k2_log` (
  `status` int(11) NOT NULL,
  `response` text NOT NULL,
  `timestamp` datetime NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_log`  VALUES 
('200', 'OK', '2018-08-02 00:40:04');
/**ABDB**/CREATE TABLE `#__k2_items` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `title` varchar(255) NOT NULL,
  `alias` varchar(255) DEFAULT NULL,
  `catid` int(11) NOT NULL,
  `published` smallint(6) NOT NULL DEFAULT '0',
  `introtext` mediumtext NOT NULL,
  `fulltext` mediumtext NOT NULL,
  `video` text,
  `gallery` varchar(255) DEFAULT NULL,
  `extra_fields` text CHARACTER SET utf8 COLLATE utf8_unicode_ci,
  `extra_fields_search` text NOT NULL,
  `created` datetime NOT NULL,
  `created_by` int(11) NOT NULL DEFAULT '0',
  `created_by_alias` varchar(255) NOT NULL,
  `checked_out` int(10) unsigned NOT NULL,
  `checked_out_time` datetime NOT NULL,
  `modified` datetime NOT NULL,
  `modified_by` int(11) NOT NULL DEFAULT '0',
  `publish_up` datetime NOT NULL,
  `publish_down` datetime NOT NULL,
  `trash` smallint(6) NOT NULL DEFAULT '0',
  `access` int(11) NOT NULL DEFAULT '0',
  `ordering` int(11) NOT NULL DEFAULT '0',
  `featured` smallint(6) NOT NULL DEFAULT '0',
  `featured_ordering` int(11) NOT NULL DEFAULT '0',
  `image_caption` text NOT NULL,
  `image_credits` varchar(255) NOT NULL,
  `video_caption` text NOT NULL,
  `video_credits` varchar(255) NOT NULL,
  `hits` int(10) unsigned NOT NULL,
  `params` text NOT NULL,
  `metadesc` text NOT NULL,
  `metadata` text NOT NULL,
  `metakey` text NOT NULL,
  `plugins` text NOT NULL,
  `language` char(7) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `access` (`access`),
  KEY `catid` (`catid`),
  KEY `created_by` (`created_by`),
  KEY `created` (`created`),
  KEY `featured_ordering` (`featured_ordering`),
  KEY `featured` (`featured`),
  KEY `hits` (`hits`),
  KEY `item` (`published`,`publish_up`,`publish_down`,`trash`,`access`),
  KEY `language` (`language`),
  KEY `ordering` (`ordering`),
  KEY `published` (`published`),
  KEY `publish_down` (`publish_down`),
  KEY `publish_up` (`publish_up`),
  KEY `trash` (`trash`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_items`  VALUES 
('1', 'Специалист по корпоративной коммуникации', 'ekspert-vnutri-korporativnogo-kommunikaczii', '4', '1', '<h1 style=\"margin-top: 20px;\">Специалист по корпоративной коммуникации</h1>\r\n  \r\n\r\n  <table width=\"100%\">\r\n    <tr>\r\n    <td><p class=\"p_zp\"><span class=\"content_zp\">Заработная плата:</span> от 100 000 рублей</p><br>\r\n        <p><span class=\"content_group\">Место работы</span><br>Зеленоград</p><br>\r\n        <p><span class=\"content_group\">Профиль деятельности компании</span><br>Подразделение крупной мебельной корпорации</p><br>\r\n        <p><span class=\"content_group\">Требования к кандидату</span><br><p>&nbsp;Опыт от 1-2 лет в планировании практической связи и разработке ключевых сообщений;<br>\r\n• Понимание использования коммуникации как стратегического инструмента для достижения бизнес целей;<br>\r\n• Опыт использования соответствующих инструментов, приложений и каналов. Базовые навыки верстки.<br>\r\n• Знание инструментов Microsoft Office (PPT, Word&amp;Excel);<br>\r\n• Свободное владение английским и русским языками (письменно и устно);<br>\r\n• Проведение тренингов по связи для лидеров подразделений;<br>\r\n• Способность интерпретировать сложные бизнес-направления и решения и преподносить их простыми словами;<br>\r\n• Способность сочетать стратегическую и оперативную работу;<br>\r\n• Понимание потребностей аудитории/целевых групп;<br>\r\n• Умение работать самостоятельно и активно искать информацию и быть в курсе того, что происходит в организации;<br>\r\n• Прирожденный коммуникатор; хорошая устная и письменная речь, способность изъясняться простым языком, понятным для неподготовленного слушателя;<br>\r\n• Построение прочных и доверительных отношений как с руководителями, так и с коллегами;<br>\r\n• Сильные межличностные качества, навык влияния на людей;<br>\r\n• Разделять культуру и ценности Компании;<br>\r\n• Заинтересованность в ассортименте мебели для дома и понимание повседневной жизни людей;<br>\r\n• Хорошее общее знание Компании является преимуществом;<br>\r\n• Понимание \"силы\" слова и руководства через коммуникацию;<br>\r\n• Заинтересованность в коммуникационных тенденциях и их применении;<br>\r\n• Клиентоориентированность;<br>\r\n•&nbsp;Опыт выступления перед публикой.</p>\r\n</p><br>\r\n        <p><span class=\"content_group\">Характер выполняемой работы</span><br><p>• Обеспечение эффективной двусторонней связи всех сотрудников Компании;<br>\r\n• Вы будете являться частью команды по управлению сайтом, вносить вклад в план развития местного бизнеса;<br>\r\n• Обеспечение менеджеров, руководителей групп и сотрудников средствами связи и информацией по внесенным изменениям. Работа по развитию коммуникационной компетенции и компетенции по управлению изменениями.&nbsp;<br>\r\n• Планирование, координирование, производство и слежение за передачей связи по местному Календарю и Плану Связи;<br>\r\n• Убедиться, что все товары представлены на сайте;<br>\r\n• 20% времени будет уходить на разработку проектов местной связи и ее передачи;<br>\r\n• Участие в создании местного плана действий на уровне подразделения;<br>\r\n• Обеспечение эффективной информационной передачи со свободными каналами связи в подразделении (например, ТВ, местные информационные бюллетени, плакаты и доски объявлений);<br>\r\n• Активное участие в местных, региональных и национальных сетях и развитие отношений между другими местными организациями;<br>\r\n• Уважать и делиться культурой и ценностями компании, а также стараться отразить это в материалах связи;<br>\r\n• Распространение ценностей компании и создание открытого и доброжелательного климат внутри сегмента.</p>\r\n</p><br>\r\n        <p><span class=\"content_group\">Условия работы</span><br><p>В подразделение крупной корпорации требуется специалист корпоративной коммуникации, способный выполнять роль \"рассказчика\" внутри компании, обеспечивать связь и общение между отделами и сотрудниками разного звена.&nbsp;<br>\r\nМы рады принять в дружный коллектив энергичного, доброжелательного и готового к работе с людьми специалиста.</p>\r\n\r\n<p><br>\r\nГрафик работы: 5/2 с 9 до 18 (возможен ненормированный рабочий день)<br>\r\nЗаработная плата от 100 000 рублей - обсуждается индивидуально</p>\r\n\r\n<p>Место работы: Есипово (Солнечногорский район)</p>\r\n</p>', '', NULL, NULL, '[{\"id\":\"1\",\"value\":\"\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u0432\\u0430\\u043f\\u041e\\u04