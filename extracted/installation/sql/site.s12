('95', '51', 'Call us - mobile', '', '<p><span style=\"margin: 0 25px 0 0px !important;\"><img style=\"padding-right: 5px;\" src=\"images/jobcv/icon10_white.png\" alt=\"phone_number\" />Звоните нам:</span></p>\r\n<div class=\"contact_line contact_phone1\">Телефон для работодателей: <b>8 (495) 740-78-88 </b>(мобильный)</div>\r\n<div class=\"contact_line contact_phone2\">Телефон для соискателей: <b>8 (963) 711-27-24</b></div>', '1', 'top2', '0', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '0000-00-00 00:00:00', '0', 'mod_custom', '1', '0', '{\"prepare_content\":0,\"backgroundimage\":\"\",\"layout\":\"_:default\",\"moduleclass_sfx\":\"\",\"cache\":1,\"cache_time\":900,\"cachemode\":\"static\",\"module_tag\":\"div\",\"bootstrap_size\":\"0\",\"header_tag\":\"h3\",\"header_class\":\"\",\"style\":\"0\"}', '0', '*'),
