/**ABDB**/CREATE TABLE `#__k2_extra_fields_groups` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_extra_fields_groups`  VALUES 
('1', 'Описание вакансии');
/**ABDB**/CREATE TABLE `#__k2_extra_fields` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `value` text NOT NULL,
  `type` varchar(255) NOT NULL,
  `group` int(11) NOT NULL,
  `published` tinyint(4) NOT NULL,
  `ordering` int(11) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `group` (`group`),
  KEY `published` (`published`),
  KEY `ordering` (`ordering`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_extra_fields`  VALUES 
('1', 'Требования к кандидату', '[{\"name\":null,\"value\":\"\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0439 \\u043a \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0443\",\"editor\":null,\"rows\":\"\",\"cols\":\"\",\"target\":null,\"alias\":\"Tpebovaniyakkandidatu\",\"required\":1,\"showNull\":0}]', 'textarea', '1', '1', '1'),
('2', 'Характер выполняемой работы', '[{\"name\":null,\"value\":\"\\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0445\\u0430\\u0440\\u0430\\u043a\\u0442\\u0435\\u0440\\u0430 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u044f\\u0435\\u043c\\u043e\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u044b\",\"editor\":null,\"rows\":\"\",\"cols\":\"\",\"target\":null,\"alias\":\"Hapaktepvypolnyaemoypaboty\",\"required\":1,\"showNull\":0}]', 'textarea', '1', '1', '2');
/**ABDB**/CREATE TABLE `#__k2_comments` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `itemID` int(11) NOT NULL,
  `userID` int(11) NOT NULL,
  `userName` varchar(255) NOT NULL,
  `commentDate` datetime NOT NULL,
  `commentText` text NOT NULL,
  `commentEmail` varchar(255) NOT NULL,
  `commentURL` varchar(255) NOT NULL,
  `published` int(11) NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `commentDate` (`commentDate`),
  KEY `countComments` (`itemID`,`published`),
  KEY `itemID` (`itemID`),
  KEY `latestComments` (`published`,`commentDate`),
  KEY `published` (`published`),
  KEY `userID` (`userID`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/**ABDB**/CREATE TABLE `#__k2_categories` (
  `id` int(11) unsigned NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `alias` varchar(255) NOT NULL,
  `description` text NOT NULL,
  `parent` int(11) DEFAULT '0',
  `extraFieldsGroup` int(11) NOT NULL,
  `published` smallint(6) NOT NULL DEFAULT '0',
  `access` int(11) NOT NULL DEFAULT '0',
  `ordering` int(11) NOT NULL DEFAULT '0',
  `image` varchar(255) NOT NULL,
  `params` text NOT NULL,
  `trash` smallint(6) NOT NULL DEFAULT '0',
  `plugins` text NOT NULL,
  `language` char(7) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `access` (`access`),
  KEY `category` (`published`,`access`,`trash`),
  KEY `language` (`language`),
  KEY `ordering` (`ordering`),
  KEY `parent` (`parent`),
  KEY `published` (`published`),
  KEY `trash` (`trash`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8;
/**ABDB**/INSERT INTO `#__k2_categories`  VALUES 
('1', 'Вакансии', 'vacancy', '<p>Для того чтобы посмотреть список интересующих Вас вакансий, выберите рубрику из списка.<br>\r\nВы можете направить свою информацию, <a href=\"/resume.html\">заполнив анкету на сайте</a> или переслав резюме на email: <a href=\"mailto:job@jobcv.ru\">job@jobcv.ru</a>.</p>\r\n\r\n<h3>Информация</h3>\r\n\r\n<p>Работа в Зеленограде или работа стабильная по специальности - цель программы.<br>\r\nДля желающих предусмотрены индивидуальные консультации:<br>\r\n• Корректировка резюме 500 рублей с включением фотографии по желанию;<br>\r\n• Составление резюме без фотографии 800 рублей (с фотографией 1000 рублей)<br>\r\nКадровое агентство «ТРИЗА-СПУТНИК» предлагает размещение Ваших вакансий в Интернете на специально отобранных сайтах с устойчиво высокой статистикой посещений и просмотров объявлений для поиска работников и работы в Зеленограде, Химках, Шереметьево.</p>\r\n\r\n<h4>Подробнее о нашем комплексе услуг:</h4>\r\n\r\n<p>1. Мы размещаем Ваши вакансии, предварительно составив грамотное объявление, что поможет добиться быстрого результата.<br>\r\n2. Регулярно обновляем Ваши вакансии на всех сайтах, благодаря чему Ваше объявление всегда будет находиться на верхних строчках.<br>\r\n3. Удаляем объявления после закрытия вакансии. Вас не будут беспокоить ненужными звонками!<br>\r\n<br>\r\n<strong>Ваши преимущества:</strong><br>\r\n1. Экономия времени.<br>\r\n2. Экономия денег: вы экономите на рекламе в печатных изданиях и на оплате доступа к различным базам данных.<br>\r\nЦена размещения и поддержания одной вакансии в течение календарного месяца-1500 рублей.</p>\r\n\r\n<h3>Как получить работу в условиях кризиса</h3>\r\n\r\n<p>Работа в Зеленограде или работа стабильная по специальности - цель программы<br>\r\nЗапись на тренинг и на индивидуальные консультации по телефону: (495) 739-07-82<br>\r\nПравильно составленное резюме позволяет привлечь внимание работодателя или агентства по подбору персонала к своей кандидатуре. Второй этап - интервью - является решающим фактором при выборе кандидата.</p>\r\n\r\n<h4>Вы узнаете:</h4>\r\n\r\n<ul>\r\n	<li>как правильно представить информацию о себе в резюме</li>\r\n	<li>какие резюме не проходят незамеченными</li>\r\n	<li>в какие компании лучше направлять резюме</li>\r\n	<li>как произвести правильное впечатление на интервью</li>\r\n	<li>как правильно построить рассказ о себе и своем профессиональном опыте</li>\r\n	<li>на какую должность, з/п и в каких компаниях Вы можете претендовать</li>\r\n	<li>ошибки, которые снижают ваши шансы</li>\r\n	<li>маленькие хитрости, которые привлекают работодателей и интервьюеров</li>\r\n</ul>\r\n\r\n<p>Приходите на тренинг со своим написанным резюме или готовыми идеями, чтобы иметь возможность в ходе тренинга получить практические индивидуальные рекомендации для улучшения своего резюме.<br>\r\nОсновная цель тренинга - подготовить участников к прохождению собеседования с работодателем. Участники узнают, как составлять эффективное резюме, как подготовиться и пройти собеседование, какие подводные камни их ожидают на каждом из этапов поиска работы и что ждет будущий работодатель.<br>\r\n<strong>Для желающих предусмотрены также индивидуальные консультации.</strong><br>\r\nКорректировка резюме 500 рублей<br>\r\nСоставление резюме с \"0\" 1000 рублей<br>\r\nИндивидуальная консультация 1250.00 руб./час<br>\r\nТренинг - каждую среду 19:00 - 21:30 - 800 рублей (минимальная группа 4 человека)<br>\r\nЗапись по телефону: (495) 739-07-82</p>\r\n\r\n<h3>Как мы работаем с соискателями</h3>\r\n\r\n<p>Каждый обратившийся специалист, который прислал нам своё резюме, автоматически заносится в базу данных.<br>\r\nЕсли Вы направляете резюме&nbsp;&nbsp; на определённую вакансию, рекомендуем Вам позвонить и поинтересоваться о прохождении почты на сервер компании. Подача резюме - это только первый шаг на пути получения работы в&nbsp; регионе Зеленоград, Химки, Шереметьево, Солнечногорск, Лобня, Истра, Москва, в основном в районе метро Речной вокзал - Белорусская и р-н Митино,&nbsp; на который мы подбираем и ориентируемся при предоставлении специалистов и временного персонала, в том числе персонала в семью: няни, домработницы, гувернёры, мажордомы, персональные водители, сиделки, репетиторы, садовники, помощники по хозяйству, охранники и другие.<br>\r\n<br>\r\nПосле поступления резюме в базу данных оно рассматривается консультантами на предмет соответствия запросам потенциальных работодателей. Только в случае соответствия мы связываемся с Вами и начинаем процедуру по проверке Ваших компетенций в соответствии с запросами работодателя.<br>\r\n<br>\r\nБесплатно поиск работы, консультации, составление анкет, помощь в составлении резюме при направлении на вакансии агентства. Подготовка к собеседованию на вакансии агентства, в том числе на иностранных языках, тестирование.<br>\r\n<br>\r\nКадровое агентство «ТРИЗА - СПУТНИК» осуществляет поиск работы и поиск вакансий в Зеленограде, Химках и в районе станции м. Речной Вокзал. Агентство бесплатно трудоустраивает персонал в семьи на конкурсной основе. Оказываем помощь в составлении резюме, заполнении анкеты, подготовим к собеседованию, трудоустроим и проконсультируем кандидатов. Все услуги для населения оказываются бесплатно.<br>\r\n<br>\r\n«Мой опыт работы в компании доказывает, что в карьерном росте не существует непреодолимых границ. Возможно все. Нужны только вера и воля.»<br>\r\nЦитата: Полетаев Юрий — генеральный&nbsp; директор агентства по подбору персонала «ТРИЗА - СПУТНИК»<br>\r\n&nbsp;<br>\r\nВы можете заполнить анкету на сайте или направить свой вариант резюме.<br>\r\n<br>\r\nТрудоустройство и консультации для соискателей бесплатные.</p>', '0', '0', '1', '1', '1', '', '{\"inheritFrom\":\"0\",\"catMetaDesc\":\"\",\"catMetaKey\":\"\",\"catMetaRobots\":\"\",\"catMetaAuthor\":\"\",\"theme\":\"\",\"num_leading_items\":\"2\",\"num_leading_columns\":\"1\",\"leadingImgSize\":\"Large\",\"num_primary_items\":\"4\",\"num_primary_columns\":\"2\",\"primaryImgSize\":\"Medium\",\"num_seconda