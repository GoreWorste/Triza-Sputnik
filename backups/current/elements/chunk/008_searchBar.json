ue=\"\"> - Все города - </option>\n      <option value=\"Зеленоград\">Зеленоград</option>\n<option value=\"Москва\">Москва</option>\n<option value=\"Московская область, д. Брёхово\">Московская область, д. Брёхово</option>\n<option value=\"Мытищи\">Мытищи</option>\n<option value=\"Солнечногорск\">Солнечногорск</option>\n<option value=\"Химки\">Химки</option>\n    </select>\n  </div>\n  <div class=\"filter-search btn-group pull-left\">\n    <input type=\"text\" name=\"filter_search\" id=\"filter_search\" placeholder=\" Поиск...\" value=\"\" />\n  </div>\n  <div class=\"btn-group pull-left\" id=\"jobokay_search_buttons\">\n    <button class=\"btn hasTooltip\" id=\"jobokay_search_submit\" type=\"submit\" title=\" Поиск\"><i class=\"icon-search\"></i></button>\n    <button class=\"btn hasTooltip\" id=\"jobokay_search_clear\" type=\"button\" title=\" Очистить\" onclick=\"document.getElementById('filter_search').value='';this.form.submit();\"><i class=\"icon-remove\"></i></button>\n  </div>\n</div>\n</form>\n</div><br>\n</div></div></div></div></div></div></section>",
