  "snippet": "<section id=\"sp-search\"><div class=\"container\"><div class=\"row\"><div id=\"sp-search\" class=\"col-sm-12 col-md-12\"><div class=\"sp-column searchvac\"><div class=\"sp-module \"><h3 class=\"sp-module-title\">Быстрый поиск вакансий</h3><div class=\"sp-module-content\">\n<div id=\"jobokay_search_container\"><form action=\"/vacancy\" method=\"get\" name=\"jobsearchForm\" id=\"adminForm\">\n<div id=\"filter-bar\" class=\"btn-toolbar module-filter-bar\">\n  <label for=\"filter_search\" class=\"jobsearch-label\"> Быстрый поиск работы</label>\n  <div class=\"btn-group pull-left\">\n    <select name=\"filter_jobcategory\" class=\"inputbox\">\n    <option value=\"\"> - Все категории - </option>\n    <option value=\"2\">Административный персонал</option>\n<option value=\"3\">Бухгалтерия, управленческий учет, финансы предприятия</option>\n<option value=\"4\">Высший менеджмент</option>\n<option value=\"5\">Домашний персонал</option>\n<option value=\"22\">Закупки</option>\n<option value=\"28\">Инженерно-технические специальности, производство</option>\n<option value=\"7\">Информационные технологии, интернет, телеком</option>\n<option value=\"10\">Маркетинг, реклама, PR</option>\n<option value=\"11\">Медицина, фармацевтика</option>\n<option value=\"13\">Начало карьеры, студенты</option>\n<option value=\"14\">Продажи, работа с клиентами</option>\n<option value=\"15\">Производство, промышленность, рабочий персонал</option>\n<option value=\"25\">Секретари, помощники руководителя, переводчики</option>\n<option value=\"6\">Сервис</option>\n<option value=\"16\">Спортивные клубы, фитнес, салоны красоты</option>\n<option value=\"17\">Строительство, недвижимость</option>\n<option value=\"18\">Транспорт, логистика, склады</option>\n<option value=\"20\">Управление персоналом, тренинги</option>\n<option value=\"21\">Юристы</option>\n    </select>\n  </div>\n  <div class=\"btn-group pull-left\">\n    <select name=\"filter_joblocation\" class=\"inputbox\">\n      <option value=\"\"> - Все города - </option>\n      <option value=\"Зеленоград\">Зеленоград</option>\n<option value=\"Москва\">Москва</option>\n<option value=\"Московская область, д. Брёхово\">Московская область, д. Брёхово</option>\n<option value=\"Мытищи\">Мытищи</option>\n<option value=\"Солнечногорск\">Солнечногорск</option>\n<option value=\"Химки\">Химки</option>\n    </select>\n  </div>\n  <div class=\"filter-search btn-group pull-left\">\n    <input type=\"text\" name=\"filter_search\" id=\"filter_search\" placeholder=\" Поиск...\" value=\"\" />\n  </div>\n  <div class=\"btn-group pull-left\" id=\"jobokay_search_buttons\">\n    <button class=\"btn hasTooltip\" id=\"jobokay_search_submit\" type=\"submit\" title=\" Поиск\"><i class=\"icon-search\"></i></button>\n    <button class=\"btn hasTooltip\" id=\"jobokay_search_clear\" type=\"button\" title=\" Очистить\" onclick=\"document.getElementById('filter_search').value='';this.form.submit();\"><i class=\"icon-remove\"></i></button>\n  </div>\n</div>\n</form>\n</div><br>\n</div></div></div></div></div></div></section>",
