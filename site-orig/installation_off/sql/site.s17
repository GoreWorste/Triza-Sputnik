('4', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Полетаев Ю.К. |-_-|textInput_-_Компания|-_-|ТРИЗА-Спутник|-_-|textInput_-_Телефон|-_-|8-916-600-22-32|-_-|textInput_-_E-mail|-_-|5345808@mail.ru|-_-|textInput_-_Позиции для поиска|-_-|ТЕСТ |-_-|textarea_-_', '2018-09-11', '1'),
('5', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Владимир|-_-|textInput_-_Компания|-_-|google|-_-|textInput_-_Телефон|-_-||-_-|textInput_-_E-mail|-_-|z-a-y-a@bk.ru|-_-|textInput_-_Позиции для поиска|-_-|Добрый день! Презентация www.kalnelen.ru|-_-|textarea_-_', '2018-12-14', '1'),
('6', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Дмитрий|-_-|textInput_-_Компания|-_-|Acroweb|-_-|textInput_-_Телефон|-_-|+79295576993|-_-|textInput_-_E-mail|-_-|it@acroweb.ru|-_-|textInput_-_Позиции для поиска|-_-|Программист PHP Bitrix\r\n|-_-|textarea_-_', '2019-01-09', '1'),
('7', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Елена|-_-|textInput_-_Компания|-_-|google|-_-|textInput_-_Телефон|-_-||-_-|textInput_-_E-mail|-_-|mallla_87@mail.ru|-_-|textInput_-_Позиции для поиска|-_-|Здравствуйте. Посмотрите презентацию www.fenedex.ru Что думаете?|-_-|textarea_-_', '2019-01-28', '1'),
('8', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Петрова Елена|-_-|textInput_-_Компания|-_-|Своё ИП|-_-|textInput_-_Телефон|-_-|+79082360290|-_-|textInput_-_E-mail|-_-|el3na2018petrova@yandex.ru|-_-|textInput_-_Позиции для поиска|-_-|Добрый день. Меня зовут Елена, я представляю компанию по продаже образовательных услуг. Сейчас требуется менеджер по продажам, в перспективе также нужен будет подбор РОП. Хотелось бы уточнить по условиям сотрудничества, стоимость и возможно договор,чтобы сразу ознакомится со всеми условиями Вашего агентства|-_-|textarea_-_', '2019-02-01', '1'),
('9', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Татьяна|-_-|textInput_-_Компания|-_-|google|-_-|textInput_-_Телефон|-_-||-_-|textInput_-_E-mail|-_-|bavleni83@mail.ru|-_-|textInput_-_Позиции для поиска|-_-|Добрый день! Хочу вас пригласить на мероприятие www.manlobel.ru|-_-|textarea_-_', '2019-02-09', '1'),
('10', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Марина|-_-|textInput_-_Компания|-_-|google|-_-|textInput_-_Телефон|-_-||-_-|textInput_-_E-mail|-_-|svetofor1982@list.ru|-_-|textInput_-_Позиции для поиска|-_-|Добрый день. Приносим свои извинения, но вы уже посмотрели нашу презентацию? http://pomanester.ru/|-_-|textarea_-_', '2019-02-25', '1'),
('11', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Павлов Евгений Игоревич|-_-|textInput_-_Компания|-_-|ВекФорт|-_-|textInput_-_Телефон|-_-|+79255060540|-_-|textInput_-_E-mail|-_-|pavlov@vecfort.ru|-_-|textInput_-_Позиции для поиска|-_-||-_-|textarea_-_', '2019-03-30', '1'),
('12', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Раптовский Александр|-_-|textInput_-_Компания|-_-|ООО \"1С-Старт\"|-_-|textInput_-_Телефон|-_-|+79166445872|-_-|textInput_-_E-mail|-_-|alexander@regberry.ru|-_-|textInput_-_Позиции для поиска|-_-|Добрый день.\r\n\r\nИщем следующих сотрудников:\r\nhttps://hh.ru/vacancy/30451037\r\nhttps://hh.ru/vacancy/30732254\r\n\r\nСможете помочь?\r\n\r\n-- \r\nС уважением,\r\nРаптовский Александр|-_-|textarea_-_', '2019-04-01', '1'),
('13', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Архипова Юлия Алексеевна|-_-|textInput_-_Компания|-_-|АО \"ЭЛВИС-НеоТек\"|-_-|textInput_-_Телефон|-_-|+79651643013|-_-|textInput_-_E-mail|-_-|Yuarhipova@elveesneotek.com|-_-|textInput_-_Позиции для поиска|-_-|Прошу подобрать в мою компанию 2-х сотрудников: Коммерческий директор и директор по развитию бизнеса|-_-|textarea_-_', '2019-04-05', '1'),
('14', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Трусов Алексей Владимирович|-_-|textInput_-_Компания|-_-|АСК ГРУПП МСК|-_-|textInput_-_Телефон|-_-|+79260167908|-_-|textInput_-_E-mail|-_-|alext@askgrupp.ru|-_-|textInput_-_Позиции для поиска|-_-|1) Водитель-экспедитор\r\nот 40 000 до 50 000 руб. на руки\r\nМесто работы: деревня Грибки\r\nТребуемый опыт работы: 3–6 лет\r\nПолная занятость, полный день\r\nОбязанности:\r\nДоставка продукции клиентам, указанным в накладных; Проверка правильности и качества загрузки машины; Отслеживание сохранности продукции в процессе доставки; Отпуск продукции...\r\nТребования:\r\nВодительские права категории \"В\" \"С\"; Опыт экспедирования грузов от 1 года; Знание правил дорожного движения; Хорошее знание Москвы и Московской области\r\nУсловия:\r\nАвтомобиль IVECO, Лада Ларгус\r\nОпыт вождения\r\nПрава категории B, C\r\n\r\n2) Менеджер по работе с клиентами\r\nот 30 000 до 40 000 руб. на руки\r\nМесто работы: деревня Грибки\r\nТребуемый опыт работы: 1–3 года\r\nПолная занятость, полный день\r\nОбязанности:\r\nАктивный поиск клиентов\r\nРабота с уже существующими\r\nПринятие и обработка заказов с интернет-магазина\r\nТребования:\r\nХорошее знание компьютера\r\nЗнание 1С\r\nУсловия:\r\n8 часовой рабочий день\r\n5 дневная рабочая неделя|-_-|textarea_-_', '2019-07-09', '1'),
('15', 'Заявка на подбор специалистов', 'Ваше ФИО|-_-|Клепикова Светлана Юрьевна|-_-|textInput_-_Компания|-_-|ООО \"ФОРТИС\"|-_-|textInput_-_Телефон|-_-|+79057034001|-_-|textInput_-_E-mail|-_-|klepikova_s@mail.ru|-_-|textInput_-_Позиции для поиска|-_-|Срочно требуется один менеджер по продаже шин и дисков. \r\nТРЕБОВАНИЯ:\r\n- мужчина;\r\n- возраст: от 25 до 45 лет;\r\n- знание ПК (уверенный пользователь) ОБЯЗАТЕЛЬНО;\r\n- опыт работы в продажах, в т.ч. с юридическими лицами;\r\n- наличие водительских прав и личного авто (желательно);\r\n- способность работать в режиме многозадачности;\r\n- умение систематизировать информацию и планировать рабочий день.\r\n\r\nОБЯЗАННОСТИ:\r\n- оформление и сопровождение заказов (опт и розница);\r\n- формирование клиентской базы;\r\n- работа с поставщиками, поиск лучших предложений;\r\n- выполнение поручений руководства;\r\n- обновление информации на сайте.\r\n\r\nУСЛОВИЯ:\r\n- оклад + проценты с продаж (по итогам собеседования);\r\n- график работы: 5/2 с 9-18 (возможно увеличение рабочего дня в сезонные месяцы);\r\n- работа в офисе в Зеленограде, без разъездов;\r\n- оформление по ТК после испытательного срока.|-_-|textarea_-_', '2019-07-21', '1'),
