/**ABDB**/INSERT INTO `#__content`  VALUES 
('13', '78', 'Главная', 'home', '<h2>ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\": оперативный и надежный подбор вакансий и персонала!</h2>\r\n<p><img src=\"data:image/jpeg;base64,\" width=\"234\" height=\"267\" /></p>\r\n<p>Найти работу через кадровое агентство сегодня просто! Компания ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\" дает уникальную возможность каждому жителю Москвы и Московской области трудоустроиться или подобрать надежный, опытный персонал в свой дом недорого.</p>\r\n<p>Мы считаем, что залогом успеха любого предприятия является профессионализм его сотрудников и готовы доказать это прямо сейчас! Рекрутинговых компаний очень много, но только наше агентство предлагает соискателям и всем работодателям самые выгодные условия для сотрудничества.</p>\r\n<h2>Почему сегодня наши клиенты выбирают нас?</h2>\r\n<ul>\r\n<li>ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\" -- одно из самых авторитетных и надежных, крупнейших агентств по трудоустройству и подбору работников.</li>\r\n<li>Огромный опыт работы. На российском рынке труда мы успешно действуем более 20 лет.</li>\r\n<li>На нашем счету свыше 2000 проектов, которые наши специалисты успешно реализовали.</li>\r\n<li>Постоянный мониторинг свободных рабочих мест и предложений по трудоустройству.</li>\r\n<li>Опытная команда специалистов с бесценным (в среднем, 9 лет).</li>\r\n<li>Быстрое и удобное оформление.</li>\r\n<li>Мы знаем о рынке труда всё! Лучшие предложения в Москве и Московской области: Зеленограде, Химках, Шереметьево, Солнечногорске, Красногорске и др.</li>\r\n<li>Стоимость услуг отличается демократичностью.</li>\r\n<li>Мы создали уникальную эффективную и оперативную систему управления заказами.</li>\r\n<li>Оперативность подбора персонала и надежность.  </li>\r\n<li>Headhunting. Подбор временного персонала с учетом всех пожеланий.</li>\r\n</ul>\r\n<h2>Подбор персонала в Москве с ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\"</h2>\r\n<h2><img class=\"pull-left\" style=\"padding-right: 10px;\" src=\"images/g2.jpg\" alt=\"Поиск работы через агентство\" width=\"455\" /></h2>\r\n<p>Наша компания работает во многих городах Московской области, что очень удобно, особенно, если человек еще не определился с местом и поиском будущей работы. Для того, чтобы всегда быть в курсе событий и предлагать своим клиентам только актуальные вакансии и предложения, рекрутинговое кадровое агентство ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\" регулярно анализирует рынок региона и обновляет собственные базы данных.</p>\r\n<p>На сегодняшний день сотрудниками центра подбора формируются специальные группы специалистов, начиная от обычных складских работников и заканчивая руководителями. Мы также осуществляем качественный рекрутмент персонала во многих сферах деятельности: консультантов, продавцов, грузчиков и др.</p>\r\n<p>Хотите повысить эффективность расходов на содержание персонала? Воспользуйтесь такими нашими услугами, как:</p>\r\n<ul>\r\n<li>Лизинг (специалист в аренду).</li>\r\n<li>Аутсорсинг (привлечение внешних подрядчиков).</li>\r\n<li>Аутстаффингом (внештатный персонал).</li>\r\n</ul>\r\n<p>Мы выполним абсолютно любое ваше пожелание. Для того, чтобы минимизировать ваши финансовые риски, мы заключаем дополнительные соглашения с сотрудниками, занимающими материально ответственные должности, и водителями, перевозящими дорогостоящие и ценные грузы.</p>\r\n<h2>Лучшее кадровое агентство по подбору домашнего персонала в г. Москва</h2>\r\n<p><img class=\"pull-right\" style=\"padding-left: 15px;\" src=\"images/g3.jpg\" alt=\"Подбор домашнего персонала\" width=\"440\" height=\"300\" /></p>\r\n<p>В 1997 в ООО \"ПЕРСОНА-СПУТНИК\" ГК \"ТРИЗА\" создан специальный отдел по поиску работы и подбору элитного, домашнего персонала в семьи: нянь, гувернанток, поваров, горничных, садовников, сиделок, личных тренеров, домработниц, репетиторов и пр. Почти за 20 лет успешной работы в этом сегменте рынка мы заработали безупречную деловую репутацию, о чем свидетельствуют многочисленные благодарственные отзывы наших клиентов.</p>\r\n<p>Посетите нас по адресу, указанному на нашем сайте, или свяжитесь с нашими компетентными консультантами по телефонам, указанным на сайте уже сегодня! Мы быстро и просто утолим ваш «кадровый голод» или найдем высокооплачиваемую работу с учетом ваших профессиональных навыков и мастерства. </p>\r\n<p><br /><br /></p>\r\n<p> </p>', '', '1', '2', '2018-08-02 04:30:33', '478', '', '2024-08-16 12:24:43', '479', '479', '2025-05-30 07:20:08', '2018-08-02 04:30:33', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '14', '4', '', '', '1', '597491', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('14', '84', 'Мероприятия по Техническому Аудиту предприятий, проводящемуся силами сторонних экспертов из профильных предприятий', 'meropriyatiya-po-tekhnicheskomu-auditu-predpriyatij-provodyashchemusya-silami-storonnikh-ekspertov-iz-profilnykh-predpriyatij', '<p>За многие годы сотрудничества с промышленными предприятиями, а мы подбираем персонал, как кадровое агентство в Москве и Зеленограде аж с 1992 года, страшно подумать как давно, нам удавалось искать очень редких, ключевых производственных экспертов. На рынке труда некоторые из этих специалистов единичны, они всегда востребованы ввиду колоссальной, да да именно колоссальной эффективности их в вклада в технологический прорыв компаний. Для скептиков или не понимающих о каких людях идет речь приведу широко известный, легко проверяемый исторический факт. Сразу оговорюсь , дотошные читатели пусть не проверяют точность указанных мною процентов и имен я не назову, так как я знаю об этом много лет и у меня нет ни времени не желания выискивать все заново. В общем дело было в ... ГУЛАГе. На копание канала пригнали нового ЗК — такого вот технического эксперта, о которых я говорил выше и которыми как водиться,  Русская земля всегда была богата. Работа заключалась в том что (как я помню из источников), внизу котлована заключенному насыпали полную тачку тяжелой породы (камни и глина) и он, по грязному, скользкому серпантину поднимал этот груз на вершину и сгружал. Бдительный учетчик стоял и «точковал», т. е. учтывал каждую провезенную мимо тачку поименно, то есть каждым ЗК и контроллировал ее наполненность. Разумеется пайки для рабочих расчитывались строго по норме вполнения в рабочий день.</p>\r\n<p>Сами понимаете, что нормы были не профсоюзные а ГУЛАГовские и жалеть там никто никого не собирался. Так вот,  наш талант только взглянув!!! на процесс, предложил дешевый и простой путь, повысивший производительность труда  на огромную кучу (не помню точно — 1000 % или сколько) процентов, снизил при этом до минимальнейшего неизбежный,  для таких работ травматизм и шееломание (то есть смертность!) . Конечно нормы и соответсвенно выдавыаемые пайки тоже пересмотрели :-))</p>\r\n<p>Сохраню интригу, не буду описывать что он предложил. Вот Вам задача!</p>\r\n<p>Кто хочет тот сам посмотрит исторические справки, а может кто-то и пораскинет мозгами и сам получит кайф и радоть от творчества аналитика- изобретателя и предложит схожее красивое и простое в своей гениальности решение. Ведь до этого человека тысячи -! -других человеков мрачно таскали тачки, а сотни других мрачно их подгоняли, а десятки третьих — подгоняли вторых и всем была нужна срочность — читай высокая производительность. Это я о чем - есть Люди и есть люди. Некоторых — очень мало....</p>\r\n<p>Те кому предназначена эта информация, уже наверно смекнули к чему это все я клонил.</p>\r\n<p>Да, мы действительно для некоторых направлений производства можем предложить новые мозги, новое видение, которое приведет к повышению производительности труда, снижению издержек, улучшению технологии производства. И мы не боимся конкуренции на этом рынке услуг — пожалуйста, се ву пле! Таких экспертов раз, два, три и … обчелся и кое-кто из них работает с нами, а о ком-то мы знаем … тачки... вы помните! И Он был Один, и оказался в ГУЛАГе. Потом  кстати , судьба этого человека сложилась, скажем так: «с пользой для Родины».</p>\r\n<p>Снижение издержек в десятки раз возможно при выявлении ключевых моментов влияющих на себестоимость продукции. Можно подстаканник сделать за пять операций , а можно и за три.</p>\r\n<p>Нашими аналитиками-экспертами из предприятий профильных проверяемому проводиться аудит и выдаются конкретные (тачки!) предложения по техническому аудиту, ведь именно технический или технологический аудит - новое слово в деле повышения конкурентноспособности на современных глобальных рынках.</p>', '', '1', '10', '2018-08-21 16:29:26', '478', '', '2018-08-21 18:26:17', '479', '479', '2025-05-30 07:20:07', '2018-08-21 16:29:26', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '1', '', '', '1', '12054', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('15', '90', 'Запрос на подбор персонала', 'zapros-na-podbor-personala', '<p>Подбор персонала - одна из основных обязанностей компании ТРИЗА-Спутник. Правильный подбор персонала позволит укомплектовать штат компетентными сотрудниками, увеличить производительность и доход компании.</p>\r\n<p>Вы можете заполнить заявку на подбор персонала и мы свяжемся с вами в ближайшее время!</p>\r\n<p>У вас появились вопросы?</p>\r\n<p>Задайте их нашим менеджерам по телефону: 8 (495)740-78-88 или на e-mail: <a href=\"mailto:sputnik.personal@yandex.ru\">sputnik.personal@yandex.ru</a></p>\r\n<p> </p>\r\n<div style=\"margin-left: 25%;\">\r\n<p>{convertforms 1} </p>\r\n</div>', '', '1', '2', '2018-09-10 01:35:19', '478', '', '2025-05-30 08:00:41', '479', '0', '0000-00-00 00:00:00', '2018-09-10 01:35:19', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"1\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '28', '3', '', '', '1', '61967', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('16', '95', 'Сертификат СТО', 'sertifikat-sto', '<p><a href=\"index.php?Itemid=179\">Сертификат СТО</a>  </p>\r\n<p>Кадровое агентство ПЕРСОНА-Спутник, один из офисов которого расположен в городе Зеленограде и входящее в группу подбора персонала ТРИЗА, старейшую группу компаний по подбору и предоставлению персонала  в России, 31 июля 2020 г. получило сертификат соответствия СТО 03.080.02033720.</p>\r\n<p>Несмотря на распространение Коронавирусной инфекции -  COVID-19 (в просторечии ковид), которое повлияло на деловую активность во всем мире и в том числе осложнило ситуацию с трудоустройством персонала к лучшим работодателям Москвы и  России, руководитель агентства Полетаев Юрий Константинович принял решение о получении сертификата надежного поставщика товаров и услуг - СТО 03.080.02033720.</p>\r\n<p>Получение сертификата в это кризисное время  - спада производства и распространения пандемии короновируса и в преддверии эпидемии гриппа, ОРВИ и других инфекций было организованно специально для удобства заказчиков, что бы они меньше тратили время на поиск надежных поставщиков для организации процесса поиска, подбора и предоставления персонала как в компании и корпорации, так и в свои семьи.</p>\r\n<p>Много лет агентство Персона Sputnik занимается и предоставлением домашнего персонала в семьи. Агентство не берет денег с домашнего персонала за трудоустройство в Зеленограде и Москве, может подбирать лучших работников в семьи для самых ответственных и статусных заказчиков, как например подбор семейных пар для помощи по ведению хозяйства как на дачи так и в коттеджи с постоянным проживанием владельцев на озере Круглое, в Барвиху, Рублевское шоссе, Николина гора, Фирсановка и другие замечательные места ближайшего Подмосковья где проживают семьи работодателей, которые нуждаются в домашней прислуге –няня, гувернантка, мажордом, персональный водитель, семейная пара, садовник, повар в семью.</p>\r\n<p>Давайте задумаемся – сколько агентств по подбору домашнего персонала и подбору персонала для организаций имеют действующий Сертификат СТО, да еще обновленный в 2020 году, в то не простое время, когда в Мире свирепствует пандемия коронавируса и в преддверии эпидемии гриппа,ОРВИ?</p>\r\n<p>Такая информация должна помочь в выборе надежного поставщика сложных услуг – предоставления персонала.  Директор агентства занятости имеет заслуженный диплом -Менеджер года города Москвы, полученный  от Мэра г. Москва и членов правительства города на основе конкурсных процедур, написания работы и анализа всей совокупности безупречной работы кадрового агентства Зеленограда на протяжении многих лет.</p>\r\n<p>ПЕРСОНА-Спутник соответствует требованиям стандарта СТО 03.080.02033720.1-2020 . Сертификат СТО позволяет участвовать в тендерах и торгах и подтверждает надежность компании как делового партнера.</p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> <img src=\"images/2021-02-10_23-27-21.png\" alt=\"\" />  <img src=\"images/2021-02-10_23-28-07.png\" alt=\"\" /></span></p>\r\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>', '', '-2', '2', '2021-02-10 20:51:45', '479', '', '2021-02-10 21:29:33', '479', '0', '0000-00-00 00:00:00', '2021-02-10 20:51:45', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\\u0421\\u0435\\u0440\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442 \\u0421\\u0422\\u041e\",\"image_intro_caption\":\"\\u0421\\u0435\\u0440\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442 \\u0421\\u0422\\u041e \",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"0\",\"show_create_date\":\"0\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"1\",\"show_icons\":\"1\",\"show_print_icon\":\"1\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"1\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\\u0421\\u0435\\u0440\\u0442\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442 \\u0421\\u0422\\u041e\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '5', '2', '', 'Сертификат СТО Агентства по трудоустройству Триза Спутник. Вакансии Резюме', '1', '54', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('17', '96', 'Сертификат СТО', 'sertifikat-sto-2', '<p>Кадровое агентство ПЕРСОНА-Спутник, один из офисов которого расположен в городе Зеленограде и входящее в группу подбора персонала ТРИЗА, старейшую группу компаний по подбору и предоставлению персонала  в России, 31 июля 2020 г. получило сертификат соответствия СТО 03.080.02033720.</p>\r\n<p>Несмотря на распространение Коронавирусной инфекции -  COVID-19 (в просторечии ковид), которое повлияло на деловую активность во всем мире и в том числе осложнило ситуацию с трудоустройством персонала к лучшим работодателям Москвы и  России, руководитель агентства Полетаев Юрий Константинович принял решение о получении сертификата надежного поставщика товаров и услуг - СТО 03.080.02033720.</p>\r\n<p>Получение сертификата в это кризисное время  - спада производства и распространения пандемии короновируса и в преддверии эпидемии гриппа, ОРВИ и других инфекций было организованно специально для удобства заказчиков, что бы они меньше тратили время на поиск надежных поставщиков для организации процесса поиска, подбора и предоставления персонала как в компании и корпорации, так и в свои семьи.</p>\r\n<p>Много лет агентство Персона Sputnik занимается и предоставлением домашнего персонала в семьи. Агентство не берет денег с домашнего персонала за трудоустройство в Зеленограде и Москве, может подбирать лучших работников в семьи для самых ответственных и статусных заказчиков, как например подбор семейных пар для помощи по ведению хозяйства как на дачи так и в коттеджи с постоянным проживанием владельцев на озере Круглое, в Барвиху, Рублевское шоссе, Николина гора, Фирсановка и другие замечательные места ближайшего Подмосковья где проживают семьи работодателей, которые нуждаются в домашней прислуге –няня, гувернантка, мажордом, персональный водитель, семейная пара, садовник, повар в семью.</p>\r\n<p>Давайте задумаемся – сколько агентств по подбору домашнего персонала и подбору персонала для организаций имеют действующий Сертификат СТО, да еще обновленный в 2020 году, в то не простое время, когда в Мире свирепствует пандемия коронавируса и в преддверии эпидемии гриппа,ОРВИ?</p>\r\n<p>Такая информация должна помочь в выборе надежного поставщика сложных услуг – предоставления персонала.  Директор агентства занятости имеет заслуженный диплом -Менеджер года города Москвы, полученный  от Мэра г. Москва и членов правительства города на основе конкурсных процедур, написания работы и анализа всей совокупности безупречной работы кадрового агентства Зеленограда на протяжении многих лет.</p>\r\n<p>ПЕРСОНА-Спутник соответствует требованиям стандарта СТО 03.080.02033720.1-2020 . Сертификат СТО позволяет участвовать в тендерах и торгах и подтверждает надежность компании как делового партнера.</p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> <img src=\"images/2021-02-10_23-27-21.png\" alt=\"\" />  <img src=\"images/2021-02-10_23-28-07.png\" alt=\"\" /></span></p>\r\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>', '', '1', '2', '2021-02-10 21:03:21', '479', '', '2021-02-10 21:03:21', '0', '0', '0000-00-00 00:00:00', '2021-02-10 21:03:21', '0000-00-00 00:00:00', '{}', '{}', '{\"spfeatured_image\":\"\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '2', '', 'Сертификат СТО Подбор обучение персонала. Размещение вакансий', '1', '7403', '{}', '0', '*', '', ''),
('18', '97', 'Работа в Зеленограде: свежие вакансии на сегодня', 'rabota-v-zelenograde-svezhie-vakansii-na-segodnya', '<p> </p>\r\n<h1><strong>Свежие вакансии в Зеленограде</strong></h1>\r\n<p>Вот уже более 15 лет кадровое агентство «ТРИЗА-СПУТНИК» предлагает свои услуги по подбору персонала и помощи в трудоустройстве в Москве и Московской области. За это время мы помогли тысячам работодателей найти компетентных сотрудников на замещаемые должности, многие из них стали нашими постоянными клиентами. Мы дорожим своей репутацией и используем уникальные авторские методики для поиска и тестирования соискателей, благодаря чему добиваемся 100 %-х результатов и решаем кадровые задачи любой сложности.</p>\r\n<h2>Найти работу в Зеленограде с компанией «ТРИЗА-СПУТНИК»</h2>\r\n<p>HR-менеджеры, работающие в нашем агентстве, - это не просто посредники, которые штудируют сотни объявлений о вакансиях. Услуги наших сотрудников имеют высокую ценность еще и тем, что они детально описывают соискателям ситуацию на рынке труда в интересующей сфере, рассказывают об уровне дохода, на который кандидат может претендовать, помогают соотнести ожидания каждого соискателя с предложениями работодателей и предложить оптимальные варианты.</p>\r\n<p>Кроме того, специалисты кадровых агентств дают рекомендации, каким образом можно повысить шансы на успешное трудоустройство, если что-то вы делаете неправильно.</p>\r\n<p><strong>На сегодня</strong> мы располагаем широчайшей базой свежих вакансий от прямых работодателей в <strong>г.Зеленоград</strong>, в которой вы найдете гораздо больше привлекательных вариантов, чем в свободном доступе в газетах или сети Интернет.</p>\r\n<h2>Свежие объявления и резюме</h2>\r\n<p>Сотрудничество с компанией «ТРИЗА-СПУТНИК» - это возможность получить достойную<strong> работу </strong>в стабильных компаниях Зеленограда, для этого мы регулярно размещаем на нашем сайте новые вакансии от прямых работодателей.</p>\r\n<p>Каждый клиент может быть уверен, что мы предлагаем только те кандидатуры, которые максимально соответствуют должностным и корпоративным требованиям. Для этого каждый соискатель проходит несколько этапов тестирования, на которых мы оцениваем его профессиональные и коммуникативные навыки, способность принимать решения и работать в предлагаемых условиях. Благодаря передовым методикам наши специалисты успешно проверяют объявленные характеристики соискателя и выбирают только тех кандидатов, которые смогут результативно выполнять свои обязанности, повышая эффективность деятельности компании.</p>\r\n<p>Если вы оказались в ситуации поиска работы и хотите реализовать свой профессиональный потенциал в надежной и перспективной компании, то наши услуги - это именно то, что вам нужно.</p>\r\n<p><strong> </strong></p>\r\n<p>1.</p>\r\n<p>ALT: Найти работу в Зеленограде: актуальные вакансии от крупных работодателей</p>\r\n<p>2.</p>\r\n<p>ALT: Работа в г. Зеленоград: свежие объявления на сайте <a href=\"http://www.jobcv.ru\">www.jobcv.ru</a></p>\r\n<p> </p>', '', '-2', '13', '2021-02-10 21:36:24', '479', '', '2021-02-14 14:02:29', '479', '0', '0000-00-00 00:00:00', '2021-02-10 21:36:24', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '1', 'Работа в Зеленограде: свежие вакансии на сегодня', 'Свежие вакансии от стабильных и надежных работодателей в г.Зеленоград. Кадровое агентство «ТРИЗА-СПУТНИК» предлагает вашему вниманию широчайшую базу свежих вакансии, которые вы сможете найти на сайте www.jobcv.ru', '1', '57', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('19', '98', 'Вакансии в Солнечногорске от прямых работодателей', 'vakansii-v-solnechnogorske-ot-pryamykh-rabotodatelej', '<p> </p>\r\n<h1><strong>Вакансии в Солнечногорске от прямых работодателей</strong></h1>\r\n<p>Услуги надежного и авторитетного кадрового агентства <strong>на сегодня</strong> считаются самым эффективным способом поиска компетентных сотрудников, идеально соответствующих должностным требованиям. Также кадровые компании обеспечивают отличную возможность для соискателей получить желаемую работу по специальности в кратчайшие сроки. На современном рынке труда работодатели заинтересованы не только в опытных профессионалах с большим стажем, но и в молодых инициативных специалистах с хорошим образованием и без опыта <strong>работы. </strong>В каждом из этих случаев важным фактором успеха считается правильная презентация своих сильных сторон и преимуществ  работодателю.</p>\r\n<h2>Свежие вакансии от прямых работодателей</h2>\r\n<p>Кадровое агентство «ТРИЗА-СПУТНИК» предлагает услуги по подбору персонала различных категорий в городе <strong>Солнечногорске</strong>, Зеленограде, Химках и других городах Московской области. </p>\r\n<p>Наше агентство работает в этой сфере уже более 15 лет, за это время мы сформировали команду профессиональных менеджеров и экспертов по кадрам и наработали методическую базу, состоящую из самых эффективных инструментов поиска и подбора персонала.</p>\r\n<p>Наши преимущества:</p>\r\n<ul>\r\n<li>Нацеленность на результат - на каждую должность мы подбираем кандидатов, на 100 % удовлетворяющих требованиям наших заказчиков.</li>\r\n<li>Индивидуальный подход - с учетом пожеланий работодателя и корпоративных стандартов мы формируем наиболее результативную стратегию поиска, которая позволяет найти максимально подходящую кандидатуру в кратчайшие сроки.</li>\r\n<li>Приемлемые цены на услуги - мы заинтересованы, чтобы каждый новый заказчик стал постоянным клиентом нашего агентства, поэтому ведем гибкую ценовую политику.</li>\r\n<li>Профессиональные HR-специалисты - поиском кандидата занимаются сразу несколько специалистов по подбору кадров, что существенно повышает эффективность работы на каждом этапе.</li>\r\n</ul>\r\n<h2>Огромные возможности для соискателей</h2>\r\n<p>На сайте <a href=\"http://www.jobcv.ru\">www.jobcv.ru</a> вы сможете найти интересные для вас вакансии от прямых работодателей и отправить свое резюме. Наши специалисты максимально оперативно просматривают все отклики, и если ваше резюме соответствует профессиональным требованиям заказчика, мы пригласим вас на собеседование. Даже если ваши характеристики не соответствуют указанной вакансии, мы сможем предложить вам другие варианты и поместим ваше резюме в свою базу, поэтому шанс найти работу существенно возрастает.</p>\r\n<p> </p>\r\n<p> </p>', '', '-2', '13', '2021-02-10 21:40:08', '479', '', '2021-02-14 14:01:43', '479', '0', '0000-00-00 00:00:00', '2021-02-10 21:40:08', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '0', 'Работа в Солнечногорске: свежие вакансии, прямой работодатель', 'Вакансии в Солнечногорске от прямых работодателей на сайте www.jobcv.ru. Самые актуальные и свежие вакансии от лучших компаний в кадровом агентстве «ТРИЗА-СПУТНИК».', '1', '70', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('20', '100', 'Свежие вакансии в Зеленограде', 'svezhie-vakansii-v-zelenograde', '<p> </p>\r\n<h1> </h1>\r\n<p>Вот уже более 15 лет кадровое агентство «ТРИЗА-СПУТНИК» предлагает свои услуги по подбору персонала и помощи в трудоустройстве в Москве и Московской области. За это время мы помогли тысячам работодателей найти компетентных сотрудников на замещаемые должности, многие из них стали нашими постоянными клиентами. Мы дорожим своей репутацией и используем уникальные авторские методики для поиска и тестирования соискателей, благодаря чему добиваемся 100 %-х результатов и решаем кадровые задачи любой сложности.</p>\r\n<h2>Найти работу в Зеленограде с компанией «ТРИЗА-СПУТНИК»</h2>\r\n<p>HR-менеджеры, работающие в нашем агентстве, - это не просто посредники, которые штудируют сотни объявлений о вакансиях. Услуги наших сотрудников имеют высокую ценность еще и тем, что они детально описывают соискателям ситуацию на рынке труда в интересующей сфере, рассказывают об уровне дохода, на который кандидат может претендовать, помогают соотнести ожидания каждого соискателя с предложениями работодателей и предложить оптимальные варианты.</p>\r\n<p>Кроме того, специалисты кадровых агентств дают рекомендации, каким образом можно повысить шансы на успешное трудоустройство, если что-то вы делаете неправильно.</p>\r\n<p><strong>На сегодня</strong> мы располагаем широчайшей базой свежих вакансий от прямых работодателей в <strong>г.Зеленоград</strong>, в которой вы найдете гораздо больше привлекательных вариантов, чем в свободном доступе в газетах или сети Интернет.</p>\r\n<h2>Свежие объявления и резюме</h2>\r\n<p>Сотрудничество с компанией «ТРИЗА-СПУТНИК» - это возможность получить достойную<strong> работу </strong>в стабильных компаниях Зеленограда, для этого мы регулярно размещаем на нашем сайте новые вакансии от прямых работодателей.</p>\r\n<p>Каждый клиент может быть уверен, что мы предлагаем только те кандидатуры, которые максимально соответствуют должностным и корпоративным требованиям. Для этого каждый соискатель проходит несколько этапов тестирования, на которых мы оцениваем его профессиональные и коммуникативные навыки, способность принимать решения и работать в предлагаемых условиях. Благодаря передовым методикам наши специалисты успешно проверяют объявленные характеристики соискателя и выбирают только тех кандидатов, которые смогут результативно выполнять свои обязанности, повышая эффективность деятельности компании.</p>\r\n<p>Если вы оказались в ситуации поиска работы и хотите реализовать свой профессиональный потенциал в надежной и перспективной компании, то наши услуги - это именно то, что вам нужно.</p>\r\n', '\r\n<p><strong> </strong></p>', '1', '15', '2021-02-14 14:16:04', '479', 'Юрий Полетаев', '2021-02-14 16:15:40', '479', '479', '2025-05-30 07:20:05', '2021-02-14 14:16:04', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"0\",\"link_titles\":\"1\",\"show_tags\":\"\",\"show_intro\":\"1\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"1\",\"link_parent_category\":\"1\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\\u0421\\u0432\\u0435\\u0436\\u0438\\u0435 \\u0432\\u0430\\u043a\\u0430\\u043d\\u0441\\u0438\\u0438 \\u043e\\u0442 \\u0441\\u0442\\u0430\\u0431\\u0438\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0438 \\u043d\\u0430\\u0434\\u0435\\u0436\\u043d\\u044b\\u0445 \\u0440\\u0430\\u0431\\u043e\\u0442\\u043e\\u0434\\u0430\\u0442\\u0435\\u043b\\u0435\\u0439 \\u0432 \\u0433.\\u0417\\u0435\\u043b\\u0435\\u043d\\u043e\\u0433\\u0440\\u0430\\u0434. \\u041a\\u0430\\u0434\\u0440\\u043e\\u0432\\u043e\\u0435 \\u0430\\u0433\\u0435\\u043d\\u0442\\u0441\\u0442\\u0432\\u043e \\u00ab\\u0422\\u0420\\u0418\\u0417\\u0410-\\u0421\\u041f\\u0423\\u0422\\u041d\\u0418\\u041a\\u00bb \\u043f\\u0440\\u0435\\u0434\\u043b\\u0430\\u0433\\u0430\\u0435\\u0442 \\u0432\\u0430\\u0448\\u0435\\u043c\\u0443 \\u0432\\u043d\\u0438\\u043c\\u0430\\u043d\\u0438\\u044e \\u0448\\u0438\\u0440\\u043e\\u0447\\u0430\\u0439\\u0448\\u0443\\u044e \\u0431\\u0430\\u0437\\u0443 \\u0441\\u0432\\u0435\\u0436\\u0438\\u0445 \\u0432\\u0430\\u043a\\u0430\\u043d\\u0441\\u0438\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0432\\u044b \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u043d\\u0430\\u0439\\u0442\\u0438 \\u043d\\u0430 \\u0441\\u0430\\u0439\\u0442\\u0435 www.jobcv.ru\",\"article_page_title\":\"\\u0411\\u043b\\u043e\\u0433\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '4', '8', 'Вакансии, Зеленоград, Триза-Спутник, Юрий Полетаев', ' Свежие вакансии от стабильных и надежных работодателей в г.Зеленоград. Кадровое агентство «ТРИЗА-СПУТНИК» предлагает вашему вниманию широчайшую базу свежих вакансии, которые вы сможете найти на сайте www.jobcv.ru', '1', '2533', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('21', '101', 'Вакансии в Солнечногорске от прямых работодателей', 'vakansii-v-solnechnogorske-ot-pryamykh-rabotodatelej', '<p> </p>\r\n<h1><strong>Вакансии в Солнечногорске от прямых работодателей</strong></h1>\r\n<p>Услуги надежного и авторитетного кадрового агентства <strong>на сегодня</strong> считаются самым эффективным способом поиска компетентных сотрудников, идеально соответствующих должностным требованиям. Также кадровые компании обеспечивают отличную возможность для соискателей получить желаемую работу по специальности в кратчайшие сроки. На современном рынке труда работодатели заинтересованы не только в опытных профессионалах с большим стажем, но и в молодых инициативных специалистах с хорошим образованием и без опыта <strong>работы. </strong>В каждом из этих случаев важным фактором успеха считается правильная презентация своих сильных сторон и преимуществ  работодателю.</p>\r\n<h2>Свежие вакансии от прямых работодателей</h2>\r\n<p>Кадровое агентство «ТРИЗА-СПУТНИК» предлагает услуги по подбору персонала различных категорий в городе <strong>Солнечногорске</strong>, Зеленограде, Химках и других городах Московской области. </p>\r\n<p>Наше агентство работает в этой сфере уже более 15 лет, за это время мы сформировали команду профессиональных менеджеров и экспертов по кадрам и наработали методическую базу, состоящую из самых эффективных инструментов поиска и подбора персонала.</p>\r\n<p>Наши преимущества:</p>\r\n<ul>\r\n<li>Нацеленность на результат - на каждую должность мы подбираем кандидатов, на 100 % удовлетворяющих требованиям наших заказчиков.</li>\r\n<li>Индивидуальный подход - с учетом пожеланий работодателя и корпоративных стандартов мы формируем наиболее результативную стратегию поиска, которая позволяет найти максимально подходящую кандидатуру в кратчайшие сроки.</li>\r\n<li>Приемлемые цены на услуги - мы заинтересованы, чтобы каждый новый заказчик стал постоянным клиентом нашего агентства, поэтому ведем гибкую ценовую политику.</li>\r\n<li>Профессиональные HR-специалисты - поиском кандидата занимаются сразу несколько специалистов по подбору кадров, что существенно повышает эффективность работы на каждом этапе.</li>\r\n</ul>\r\n<h2>Огромные возможности для соискателей</h2>\r\n<p>На сайте <a href=\"http://www.jobcv.ru\">www.jobcv.ru</a> вы сможете найти интересные для вас вакансии от прямых работодателей и отправить свое резюме. Наши специалисты максимально оперативно просматривают все отклики, и если ваше резюме соответствует профессиональным требованиям заказчика, мы пригласим вас на собеседование. Даже если ваши характеристики не соответствуют указанной вакансии, мы сможем предложить вам другие варианты и поместим ваше резюме в свою базу, поэтому шанс найти работу существенно возрастает.</p>\r\n<p> </p>', '', '1', '15', '2021-02-14 14:22:35', '479', 'Юрий Полетаев', '2021-05-15 20:07:09', '479', '479', '2025-05-30 07:20:04', '2021-02-14 14:22:35', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"1\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"0\",\"show_create_date\":\"0\",\"show_modify_date\":\"0\",\"show_publish_date\":\"0\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"0\",\"show_hits\":\"0\",\"show_noauth\":\"1\",\"urls_position\":\"0\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '7', '9', 'Вакансии, Зеленоград, Солнечногорск, Триза-Спутник, Юрий Полетаев', 'Вакансии в Солнечногорске от прямых работодателей на сайте www.jobcv.ru. Самые актуальные и свежие вакансии от лучших компаний в кадровом агентстве «ТРИЗА-СПУТНИК». ', '1', '2574', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('22', '104', 'Работа в Зеленограде: вакансии от прямых работодателей', 'rabota-v-zelenograde-vakansii-ot-pryamykh-rabotodatelej', '<h1>Работа в Зеленограде: вакансии от прямых работодателей</h1>\r\n<p>Многие соискатели, столкнувшись с задачей найти работу, предпочитают собственными силами искать подходящие <strong>вакансии</strong> и ждать ответа от работодателя. Самый популярный способ - это поиски в интернете, люди вводят запрос «<strong>ищу работу</strong>», и поисковая система выдает сотни ссылок на базы вакансий. После этого начинается кропотливая работа по просмотру предложений, выбору подходящих вариантов и отправлению резюме в кадровые службы организаций.  С одной стороны, это правильное решение, которое рано или поздно может привести к получению желаемой работы. Но в то же время, иногда ожидания не оправдываются, ответы от компаний не поступают или соискатель получает предложения от сомнительных работодателей. Получается так, что поиск работы может затянуться на неопределенный срок. В этом случае услуги кадровых агентств станут тем самым эффективным инструментом, который поможет сократить время на поиски работы, избавляя соискателя от недобросовестных работодателей и смутных предложений. Как правило, оплата подобных услуг, окупается в кратчайшие сроки получением желаемой работы с ожидаемым уровнем заработной платы.</p>\r\n<p>Сотрудничество с агентством «ТРИЗА-СПУТНИК» существенно повышает ваши шансы на скорейшее трудоустройство в проверенной компании.</p>\r\n<h2>Свежие вакансии от лучших работодателей</h2>\r\n<p>Услуги рекрутинговых агентств имеют массу неоспоримых преимуществ, особенно на современном трудовом рынке, где спрос значительно превышает предложение, а среди соискателей существует огромная конкуренция. В такой ситуации очень важно максимально эффективно презентовать себя работодателю, для этого целесообразно воспользоваться услугами профессионалов, которые помогут показать ваши самые выигрышные стороны и предложат вакансии от надежных и стабильных работодателей.</p>\r\n<p>Услуги кадровых агентств актуальны для специалистов разных уровней и сфер деятельности. Если вы - высококвалифицированный профессионал, который претендует на управляющую должность, то помощь кадровых агентств вам понадобится в первую очередь.</p>\r\n<p>Нам доверяют крупнейшие компании в <strong>Москве, Зеленограде</strong> и других городах Московской области. Наши клиенты - стабильные и устойчивые игроки на местном рынке, которые могут обеспечить сотрудникам достойную заработную плату и профессиональное развитие. Самые интересные вакансии, в том числе на замещение руководящих должностей, размещены в нашей базе, поэтому обращаясь к нам, вы получаете <strong>свежие</strong> варианты, которых не встретить в свободном доступе в сети Интернет.</p>', '', '1', '15', '2021-02-14 16:09:34', '479', 'Юрий Полетаев', '2022-03-23 10:12:33', '479', '479', '2025-05-30 07:20:04', '2021-02-14 16:09:34', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '7', 'Вакансии агентства, Подобрать линейные персонал, Подобрать высококвалифицированный персонал, Вакансии, Кандидаты, Резюме', 'Работа в Зеленограде и Москве, вакансии от прямых работодателей. Самые свежие вакансии с должностными обязанностями и заработной платой вы сможете посмотреть на сайте www.jobcv.ru.', '1', '2635', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('23', '105', 'Сертификат СТО', 'sertifikat-sto', '<p><span data-contrast=\"auto\">Кадр</span><span data-contrast=\"auto\">овое агентство ПЕРСОНА-Спутник, один из офисов которого расположен в городе Зеленограде и </span><span data-contrast=\"auto\">входящее в группу подбора персонала ТРИЗА, старейшую</span><span data-contrast=\"auto\"> группу компаний по подбору и предоставлению </span><span data-contrast=\"auto\">персонала </span><span data-contrast=\"auto\"> в</span><span data-contrast=\"auto\"> России, 31 июля 2020 г. получило сертификат соответствия</span><span data-contrast=\"auto\"> </span><span data-contrast=\"auto\">СТО 03.080.02033720.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p> </p>\r\n<p><span data-contrast=\"auto\">Агентство Персона </span><span data-contrast=\"auto\">Sputnik</span><span data-contrast=\"auto\"> </span><span data-contrast=\"auto\">занимается и предоставлением домашнего персонала в семьи. Агентство не берет денег с домашнего персонала за трудоустройство в Зеленограде и </span><span data-contrast=\"auto\">Москве, </span><span data-contrast=\"auto\">может подбирать луч</span><span data-contrast=\"auto\">ших работников в семьи для самых</span><span data-contrast=\"auto\"> ответственных и статусных заказчиков, как например подбор семейных пар</span><span data-contrast=\"auto\"> для помощи по ведению хозяйства как на дачи так и в коттеджи с постоянным проживанием владельцев</span><span data-contrast=\"auto\"> но озере Круглое, в </span><span data-contrast=\"auto\">Барвиху</span><span data-contrast=\"auto\">, Рублевское шоссе, Николина гора, </span><span data-contrast=\"auto\">Фирсановка</span><span data-contrast=\"auto\"> и другие замечательные места ближайшего Подмосковья где проживают семьи работодателей, которые нуждаются в домашней </span><span data-contrast=\"auto\">прислуге –няня, гувернантка, мажордом, персональный водитель, семейная пара, садовник, повар в семью</span><span data-contrast=\"auto\">. </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p> </p>\r\n<p><span data-contrast=\"auto\">ПЕРСОНА-Спутник соответствует требованиям стандарта СТО 03.080.02033720.1-</span><span data-contrast=\"auto\">2020 .</span><span data-contrast=\"auto\"> Сертификат СТО позволяет участвовать в тендерах и торгах и подтверждает надежность компании как делового партнера.</span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:240}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> <img src=\"images/2021-02-10_23-27-21.png\" alt=\"\" /></span></p>\r\n<p><span data-contrast=\"auto\"> </span><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>\r\n<p><span data-ccp-props=\"{&quot;201341983&quot;:0,&quot;335559739&quot;:160,&quot;335559740&quot;:259}\"> </span></p>', '', '1', '15', '2021-02-14 16:13:36', '479', 'Юрий Полетаев', '2021-05-15 20:06:21', '479', '479', '2025-05-30 07:20:03', '2021-02-14 16:13:36', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"1\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '6', 'Вакансии агентства, Подобрать линейные персонал, Подобрать высококвалифицированный персонал, Вакансии, Кандидаты, Резюме', 'Кадровое агентство ПЕРСОНА-Спутник, один из офисов которого расположен в городе Зеленограде и входящее в группу подбора персонала ТРИЗА, старейшую группу компаний по подбору и предоставлению персонала  в России, 31 июля 2020 г. получило сертификат соответствия СТО 03.080.02033720. ', '1', '2767', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('24', '107', 'Запрос на подбор специалистов Китая', 'zapros-na-podbor-spetsialistov-kitaya', '<p>В наше кадровое агентство поступил запрос от компании - производителя приборов для медицины на поиск специалиста по закупкам в Китае и юго-восточной Азии оборудования и материалов. </p>\r\n<p>Мы прогнозируем всплеск потребности в таких специалистах.</p>\r\n<p>Стоимость подбора такого специалиста от 1,5 заработной платы, гарантии предоставляются</p>\r\n<p>Ждем Ваши заказы на персонал по работе с Китаем.</p>\r\n<p>Телефон 8- 495-739-07-82 с 9-00 до 17-00 </p>\r\n<p> </p>', '', '1', '15', '2022-03-18 14:06:11', '479', '', '2023-08-08 08:57:00', '479', '479', '2025-05-30 07:20:02', '2022-03-18 14:06:11', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '6', '5', '', '', '1', '1887', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '1', '*', '', ''),
('25', '109', 'Время подбирать специалистов по информационной безопасности', 'vremya-podbirat-spetsialistov-po-informatsionnoj-bezopasnosti', '<p>В компанию, которая занимается разработкой и производством средств сетевой информационной безопасности отрыта должность \"<em><strong>Реверс-инженер I категории</strong></em>\".</p>\r\n<p><strong>Обязанности:</strong></p>\r\n<ul>\r\n<li>Поиск уязвимостей в ПО различных устройств;</li>\r\n<li>Реверс-инжиниринг;</li>\r\n<li>Работа с фаззером;</li>\r\n<li>Дизассемблирование;</li>\r\n<li>Написание небольших программ и сценариев;</li>\r\n<li>Работа с firmware, загрузчиками, ПО и ядром Linux;</li>\r\n<li>Проведение исследований электронных приборов различного назначения;</li>\r\n<li>При необходимости - выезд на предприятие-разработчик прибора.</li>\r\n</ul>\r\n<p><strong>Требования:</strong></p>\r\n<ul>\r\n<li>Высшее образование по направлению «Программирование» или «Информационная безопасность».</li>\r\n<li>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 8 лет.</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n</li>\r\n<li>Навыки успешного проектирования, разработки и тестирования ПО для микроконтроллеров (минимум два проекта, доведённых до релиза);</li>\r\n<li>Навыки чтения документации по ЕСКД, в том числе схемы электрической принципиальной.</li>\r\n<li>Умение пользоваться средствами разработки и отладки cppcheck, ctags, IDA Pro, Ghidra, gdb, binwalk или аналогами.</li>\r\n<li>Навыки поиска и чтения технической документации на английском языке.</li>\r\n<li>Знакомство с концепцией безопасной разработки программного обеспечения в команде</li>\r\n</ul>\r\n<p><strong>Условия:</strong></p>\r\n<ul>\r\n<li>\r\n<p><strong>Заработная плата:</strong> по результатам собеседования с успешными кандидатами;.</p>\r\n</li>\r\n<li>\r\n<p><strong>Социальные льготы:</strong> годовые премии по результатам.</p>\r\n</li>\r\n<li>\r\n<p><strong>Режим работы:</strong> 5/2, с 9:00 до 18:00.</p>\r\n</li>\r\n<li>\r\n<p><strong>Командировки:</strong> не более 2 недель за раз, не более 2 месяцев в год.</p>\r\n</li>\r\n</ul>', '', '1', '10', '2023-04-10 13:45:55', '479', '', '2023-04-10 13:45:55', '0', '479', '2025-05-30 07:20:01', '2023-04-10 13:45:55', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '0', '', '', '1', '45', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('26', '111', 'Тест', 'test', '<p>тест</p>', '', '-2', '15', '2023-08-07 15:12:08', '479', '', '2023-08-07 15:12:08', '0', '0', '0000-00-00 00:00:00', '2023-08-07 15:12:08', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '0', '', '', '1', '1', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('27', '115', 'В Центре развития предпринимательства Зеленограда прошел семинар, который проводил главный консультант Инновационного территориального кластера «Зеленоград» по подбору персонала Полетаев Юрий Константинович', 'lenta-novostej', '<p><strong>В Центре развития предпринимательства Зеленограда прошел семинар, который проводил главный консультант Инновационного территориального кластера «Зеленоград» по подбору персонала Полетаев Юрий Константинович, руководитель  кадрового агентство «ПЕРСОНА-Спутник», который осуществляет свою деятельность по поиску и подбору персонала с 1992 года. </strong></p>\r\n<p>− Основной инструмент работы − заявка на подбор персонала, − начал выступление Ю.Полетаев, генеральный директор агентства «ПЕРСОНА-Спутник», на семинаре «Эффективный подбор кадров в малом бизнесе».</p>\r\n<p>В мероприятии приняли участие генеральные директора малых предприятий, помощники генеральных директоров крупных предприятий, руководители кадровых служб, менеджеры по подбору персонала.</p>\r\n<p>– Заявка – начальное звено технологической цепочки, − подчеркнул Юрий Константинович. − Лишь за ней следует поиск, собеседование и направление кандидата в компанию, а в последствии и найм сотрудника.</p>\r\n<p> Грамотная заявка прогнозирует успех</p>\r\n<p>Докладчик раздал слушателям формы заявок на подбор специалистов и достаточно объемные анкеты на подбор сложных профессионалов.</p>\r\n<p>− При решении кадровой задачи мы разговариваем непосредственно с тем, кому нужен специалист. Бывает, что на решение влияют определенные внутренние мотивы. Поэтому без личного контакта причины отказов, как правило, понять трудно. Заявка несет в себе не только требования, но и срочность, приоритет.</p>\r\n<p>Все зависит от того, кого вы ищите. Например, главного бухгалтера. Какими качествами он должен обладать? На самом деле, за главного бухгалтера говорит срок и должность, которую он занимал до этого, хороший – работает 5-7 лет по профессии. В таком случае для профессионала тесты не нужны. О нем многое может рассказать сменивший его новый главный бухгалтер. Брать на такую должность человека без опыта работы – большой риск. Если вы знаете стиль работы человека на предыдущем месте, то, скорее всего, он будет вести себя так же и у вас. </p>\r\n<p>«Горбатого могила исправит»</p>\r\n<p>– В этой русской поговорке – суть еще одного этапа рекрутинга (поиска, отбора и приема на работу сотрудников), – отметил Юрий Константинович. – При подборе кандидата рекомендую изучать стереотипы поведения на предыдущем месте работы, старайтесь не связываться с теми, кто готов тратить на дорогу более 2 часов. Также для эффективного найма необходимо разобраться в мотивации, и если она невнятная, то прогноз будет неутешительный. Разговаривая, обращайте внимание на мелочи, старайтесь извлечь больше информации из собеседования.</p>\r\n<p>При поиске сотрудников классический шаг − это объявление. Его текст должен быть без серой скучности и излишней игривости. Составляя объявление, нужно учесть такую характеристику денег как не насыщаемость, что более чем оправданно в дальнейшем. Ведь стереотипы со временем меняются: что раньше было роскошью, становится необходимостью. Поэтому не надо обещать роста зарплаты, лучше предлагать компенсационный пакет и период пересмотра гонорара. Составляя объявление, нужно представить идеального кандидата.</p>\r\n<p>При потоке кандидатов необходимо проводить сравнительный анализ − построить таблицы и ставить баллы, оставить трех и предложить их руководству. При составлении списка лучшего кандидата ставьте на второе место, среднего – на первое, худшего – на последнее. Предлагайте возможности, которые человек реально получит на вашей работе.</p>\r\n<p>Хороший специалист − горячий пирожок, на него всегда есть спрос</p>\r\n<p>− В нашей работе много маркетинга, реального бизнеса и психологии, есть что-то и от разведки, − поделился Юрий Константинович. − В России сотрудники фирмы говорят: «Мы работаем в компании», а у англичан − «Мы работаем с компанией». Это наглядно характеризует отношения сотрудника и коллектива.</p>\r\n<p>Еще нужно отметить, что новое поколение мотивировано не на деньги. Старайтесь  в объявлении не говорить о зарплате, в первую очередь, надо говорить о возможностях, которые предоставляет работа.</p>\r\n<p>− <strong>Как проверить кандидата на предыдущем месте работы?</strong> − задал  вопрос коммерческий директор медицинского центра.</p>\r\n<p>− Главное – этика, особенно если речь идет о таком некрупном агломирате как город Зеленоград, город Солнечногорск, город Химки и так далее. Об этом обязательно нужно заботиться. Необходимо доверие к пришедшему на собеседование человеку. Спросите кандидата, разрешает ли он собрать рекомендации, посмотрите на его реакцию и, исходя из этого, действуйте дальше. В некоторых случаях достаточно неформально поговорить на предыдущем месте работы с его коллегами. В случае если кандидат пока еще работает, можно встретиться с коллегами с предыдущего места, до того, на котором он работает сейчас. Если вы не получаете достаточной информации или вас она не удовлетворяет, нужно задуматься о надежности этого кандидата.</p>\r\n<p>Дополнительно для проверки кандидата сейчас существуют много цифровых платформ, собирающих информацию о кандидате из официальных, открытых источниках.</p>\r\n<p> Малый бизнес заинтересован в универсальных солдатах</p>\r\n<p>− Малый бизнес – то, над чем мы думаем, хотим быть ему полезными, − отмечает Юрий Полетаев. − Для нас малое предприятие − до 150 человек, супермалое или микро предприятие − 5-6-12. Малый бизнес сейчас − пасынок. А рекрутинг не может быть дешевым – это не массовая услуга. Если вы прибегаете к помощи рекрутингового агентства, это будет дорого. Развитием интернет-технологий нас, живых рекрутеров не заменит. Не заменит нормальное , человеческое общение и Искусственный Интеллект. Между человеком предлагающим работу  и человеком готовым работать - считаю, должен  стоять профессионал по найму.</p>\r\n<p><strong>− Как вы гарантируете результат?</strong> − поинтересовался генеральный директор зеленоградского ателье. − Я хочу заплатить деньги и получить кандидата.</p>\r\n<p>− Мы с вами игроки одной команды. Мы предлагаем  кандидатов, прошедших этапы отбора, интервью, и готовых на предварительные условия Заказчика. Предусмотрена Договором и гарантия бесплатной замены специалиста.</p>\r\n<p>Кадровое Агентство ПЕРСОНА – Спутник так же лицензировано РосТрудом как ЧАЗ – Частное Агентство Занятости и может оформлять людей у себя в штате на основании 116 ФЗ «О заёмном труде» .Человек может быть оформлен у  нас на основании этого Закона  на срок до 9 месяцев., т.е. быть оформленным в агентстве, официально получать заработную плату и все налоговые отчисления. Офисные специалиста, такие как секретари, бухгалтеры и т.п, любые специалисты временного характера, проектного характера. Сейчас мы занимаемся мониторингом персонала в области высоких технологий, в электронике. Смотрим, какие есть обучающие программы.</p>\r\n<p><strong>− Как выявить при собеседовании людей, которые на словах говорят: «Я хочу, я буду», а по сути «не совсем хочу, не совсем буду»,</strong> − спросил коммерческий директор медицинского центра.</p>\r\n<p>− На собеседовании важно определять мотивацию и некоторые личностные качества, относящиеся к характеру будущей работы, в том числе психологические и профессиональные качества. Для секретаря − скорость печати от 140 символов, оперативность, экстраверсия. А для руководителя важно как он нанимал, как увольнял сотрудников. По статистике только 4-5% людей могут вести свой бизнес самостоятельно. К каждой вакансии, каждой компании и её условиям найма работников, в том числе и рабочих, рабочий персонал, например портной, автоэлектрик – установщик, оператор станков с ЧПУ и других, нужно подходить индивидуально.</p>\r\n<p><strong>− Как дела с рынком неквалифицированных специалистов?</strong> − последовал очередной вопрос аудитории. − <strong>Профессионалов с малой квалификацией, средним образованием?</strong></p>\r\n<p>− Мы обращаем внимание на этот рынок, т.к. к нам приходят по нему заявки. Но считаем, что нужно повышать уровень автоматизации неквалифицированного труда, в пользу повышения квалификации. Например, автоматическое складское хозяйство и т.п.</p>\r\n<p><strong>− Ваше мнение по поводу взращивания персонала в течение 1,5 лет. Если человек без профессии, но у него есть желания и есть стремления?</strong></p>\r\n<p>− Хотите взять, изучайте претендента на вакансию, гармонизирует ли он вокруг себя среду. Если кандидат изначально с проблемами, знайте, что и вы столкнетесь с ними. Молодежи сейчас мало − обращайте внимание на мигрантов.</p>\r\n<p><strong>− Есть ли услуга тестирования сотрудника? Вы даете заключения? Есть ли готовые тесты?</strong></p>\r\n<p>− Под готового специалиста? Да есть, но самый первый  тест – это мы с вами. Наше впечатление от кандидата, наш опыт, способность анализировать полученную информацию. Прислушайтесь к своему мнению. Анализируйте, что не так, что вам не понравилось.</p>\r\n<p><strong>− А если мне нужно посадить человека за телефон,  в автомобиль. Я беру с опытом работы, по знакомству и все равно − неудача. Почему?</strong></p>\r\n<p>− Не такая простая вакансия водителя. Если вы хотите, чтобы человек проработал у вас 3- 5 лет, имейте в виду, что процесс вождения машины - интеллектуальный. Хороший водитель − с хорошим хобби, с семьей, хорошо ухоженной. Хороший управленец, менеджер – экстраверт. Интроверт работает с бумагами.</p>\r\n<p><strong>− А если после института брать менеджера по закупкам без опыта работы?</strong></p>\r\n<p>− Менеджеры на отдел закупок − люди с историей. Хорошие закупщики ценятся. Смотрите на прежний опыт, проверяйте рекомендации, семью, как в ней выстраиваются отношения.</p>\r\n<p> </p>', '', '1', '15', '2024-08-01 10:15:13', '479', '', '2024-08-01 10:15:13', '0', '479', '2025-05-30 07:20:01', '2024-08-01 10:15:13', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '4', '', '', '1', '1125', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('28', '116', 'Политика обработки персональных данных пользователей сайта', 'politika-obrabotki-personalnykh-dannykh-polzovatelej-sajta', '<p><strong>Политика обработки персональных данных</strong></p>\r\n<p>Общие положения</p>\r\n<p>Принципы и условия обработки персональных данных</p>\r\n<p>Согласие субъекта персональных данных на обработку его персональных данных</p>\r\n<p>Цели обработки персональных данных</p>\r\n<p>Круг субъектов, персональные данные которых обрабатываются</p>\r\n<p>Права субъекта персональных данных</p>\r\n<p>Обеспечение безопасности персональных данных</p>\r\n<p>Заключительные положения</p>\r\n<p>1.1. Настоящая Политика определяет порядок обработки персональных данных и меры по обеспечению безопасности персональных данных в Обществе с ограниченной ответственностью «СПУТНИК - Персонал» (далее «Оператор») с целью защиты прав и свобод человека и гражданина при обработке его персональных данных, в том числе защиты прав на неприкосновенность частной жизни, личную и семейную тайну.</p>\r\n<p> </p>\r\n<p>1.2. Настоящая Политика разработана в соответствии с Федеральным законом от 27.07.2006 г. №152-ФЗ «О персональных данных».</p>\r\n<p> </p>\r\n<p>1.3. Действие настоящей Политики распространяется на аффилированные лица Оператора, дочерние общества, а также следующие компании: Общество с ограниченной ответственностью «СПУТНИК - Персонал», Общество с ограниченной ответственностью «ПЕРСОНА - Спутник».</p>\r\n<p> </p>\r\n<p>1.4. В настоящей Политике используются следующие термины и определения:</p>\r\n<p> </p>\r\n<p>1) персональные данные - любая информация, относящаяся к прямо или косвенно определенному или определяемому физическому лицу (субъекту персональных данных);</p>\r\n<p> </p>\r\n<p>2) оператор - государственный орган, муниципальный орган, юридическое или физическое лицо, самостоятельно или совместно с другими лицами организующие и (или) осуществляющие обработку персональных данных, а также определяющие цели обработки персональных данных, состав персональных данных, подлежащих обработке, действия (операции), совершаемые с персональными данными;</p>\r\n<p> </p>\r\n<p>3) обработка персональных данных - любое действие (операция) или совокупность действий (операций), совершаемых с использованием средств автоматизации или без использования таких средств с персональными данными, включая сбор, запись, систематизацию, накопление, хранение, уточнение (обновление, изменение), извлечение, использование, передачу (распространение, предоставление, доступ), обезличивание, блокирование, удаление, уничтожение персональных данных;</p>\r\n<p> </p>\r\n<p>4) автоматизированная обработка персональных данных - обработка персональных данных с помощью средств вычислительной техники;</p>\r\n<p> </p>\r\n<p>5) распространение персональных данных - действия, направленные на раскрытие персональных данных неопределенному кругу лиц;</p>\r\n<p> </p>\r\n<p>6) предоставление персональных данных - действия, направленные на раскрытие персональных данных определенному лицу или определенному кругу лиц;</p>\r\n<p> </p>\r\n<p>7) блокирование персональных данных - временное прекращение обработки персональных данных (за исключением случаев, если обработка необходима для уточнения персональных данных);</p>\r\n<p> </p>\r\n<p>8) уничтожение персональных данных - действия, в результате которых становится невозможным восстановить содержание персональных данных в информационной системе персональных данных и (или) в результате которых уничтожаются материальные носители персональных данных;</p>\r\n<p> </p>\r\n<p>9) обезличивание персональных данных - действия, в результате которых становится невозможным без использования дополнительной информации определить принадлежность персональных данных конкретному субъекту персональных данных;</p>\r\n<p> </p>\r\n<p>10) информационная система персональных данных - совокупность содержащихся в базах данных персональных данных и обеспечивающих их обработку информационных технологий и технических средств;</p>\r\n<p> </p>\r\n<p>1.5. Действие настоящей Политики распространяется на все персональные данные субъектов, обрабатываемые Оператором с применением средств автоматизации и без применения таких средств.</p>\r\n<p> </p>\r\n<p>2.1. Обработка персональных данных должна осуществляться на законной и справедливой основе.</p>\r\n<p> </p>\r\n<p>2.2. Обработка персональных данных должна ограничиваться достижением конкретных, заранее определенных и законных целей.</p>\r\n<p> </p>\r\n<p>2.3. Не допускается объединение баз данных, содержащих персональные данные, обработка которых осуществляется в целях, несовместимых между собой.</p>\r\n<p> </p>\r\n<p>2.4. Обработке подлежат только персональные данные, которые отвечают целям их обработки.</p>\r\n<p> </p>\r\n<p>2.5. Содержание и объем обрабатываемых персональных данных должны соответствовать заявленным целям обработки.</p>\r\n<p> </p>\r\n<p>2.6. При обработке персональных данных должны быть обеспечены точность персональных данных, их достаточность, а в необходимых случаях и актуальность по отношению к целям обработки персональных данных.</p>\r\n<p> </p>\r\n<p>2.7. Хранение персональных данных должно осуществляться в форме, позволяющей определить субъекта персональных данных, не дольше, чем этого требуют цели обработки персональных данных, если срок хранения персональных данных не установлен федеральным законом, договором, стороной которого, выгодоприобретателем или поручителем по которому является субъект персональных данных.</p>\r\n<p> </p>\r\n<p>2.8. Оператор обрабатывает персональные данные при наличии одного из следующих условий:</p>\r\n<p> </p>\r\n<p>2.8.1. обработка персональных данных осуществляется с согласия субъекта персональных данных;</p>\r\n<p> </p>\r\n<p>2.8.2. обработка персональных данных необходима для достижения целей, предусмотренных законом, для осуществления и выполнения возложенных законодательством Российской Федерации на Оператора функций, полномочий и обязанностей;</p>\r\n<p> </p>\r\n<p>2.8.3. обработка персональных данных необходима для исполнения договора, стороной которого либо выгодоприобретателем или поручителем по которому является субъект персональных данных, а также для заключения договора по инициативе субъекта персональных данных или договора, по которому субъект персональных данных будет являться выгодоприобретателем или поручителем;</p>\r\n<p> </p>\r\n<p>2.8.4. обработка персональных данных необходима для осуществления прав и законных интересов Оператора или третьих лиц либо для достижения общественно значимых целей при условии, что при этом не нарушаются права и свободы субъекта персональных данных;</p>\r\n<p> </p>\r\n<p>2.8.5. осуществляется обработка персональных данных, доступ неограниченного круга лиц к которым предоставлен субъектом персональных данных либо по его просьбе;</p>\r\n<p> </p>\r\n<p>2.8.6. осуществляется обработка персональных данных, подлежащих опубликованию или обязательному раскрытию в соответствии с федеральным законом.</p>\r\n<p> </p>\r\n<p>3.1. Субъект персональных данных принимает решение о предоставлении его персональных данных и дает согласие на их обработку свободно, своей волей и в своем интересе.</p>\r\n<p> </p>\r\n<p>3.2. Согласие на обработку персональных данных должно быть конкретным, информированным и сознательным.</p>\r\n<p> </p>\r\n<p>3.3. Согласие на обработку персональных данных может быть дано субъектом персональных данных или его представителем в любой позволяющей подтвердить факт его получения форме, если иное не установлено федеральным законом. Используя соответствующий интернет-сайт Оператора и нажимая «Я согласен» субъект персональных данных выражает свое согласие и дает разрешение на обработку своих персональных данных в порядке, предусмотренном настоящей Политикой. Если субъект персональных данных не согласен с положениями настоящей Политики, следует воздержаться от использования интернет-сайта и передачи Оператору персональных данных.</p>\r\n<p> </p>\r\n<p>3.4. Согласие на обработку персональных данных может быть отозвано субъектом персональных данных. Электронный адрес с обращением по отзыву своих персональных данных:  <a href=\"mailto:sputnik.personal@yandex.ru\">sputnik.personal@yandex.ru</a></p>\r\n<p> </p>\r\n<p>4.1. Оператор обрабатывает персональные данные субъекта персональных данных исключительно в следующих целях:</p>\r\n<p> </p>\r\n<p>4.1.1. осуществления деятельности по трудоустройству граждан и подбора персонала, предусмотренной Уставом Оператора;</p>\r\n<p> </p>\r\n<p>4.1.2. заключения, исполнения и прекращения гражданско-правовых договоров с физическими, юридическим лицами, индивидуальными предпринимателями и иными лицами, в случаях, предусмотренных действующим законодательством и Уставом Оператора;</p>\r\n<p> </p>\r\n<p>4.1.3. организации кадрового учета Оператора, обеспечения соблюдения законов и иных нормативно-правовых актов, заключения и исполнения обязательств по трудовым и гражданско-правовым договорам; ведения кадрового делопроизводства, содействия работникам в трудоустройстве, обучении и продвижении по службе, пользования различного вида льготами, исполнения требований налогового законодательства в связи с исчислением и уплатой налога на доходы физических лиц, пенсионного законодательства, заполнения первичной статистической документации, в соответствии с Трудовым кодексом РФ, Налоговым кодексом РФ, федеральными законами.</p>\r\n<p> </p>\r\n<p>5.1. В зависимости от субъекта персональных данных, Оператор обрабатывает персональные данные следующих категорий субъектов персональных данных:</p>\r\n<p> </p>\r\n<p>5.1.1. персональные данные работника Оператора;</p>\r\n<p> </p>\r\n<p>5.1.2. персональные данные Клиента (потенциального Клиента, партнера, контрагента), а также персональные данные руководителя, участника (акционера) или сотрудника юридического лица, являющегося Клиентом (потенциальным Клиентом, партнером, контрагентом) Оператора;</p>\r\n<p> </p>\r\n<p>5.1.3. персональные данные Соискателя, обратившегося к Оператору в целях содействия в трудоустройстве, Кандидата, претендующего на вакантные должности Клиента Оператора;</p>\r\n<p> </p>\r\n<p>5.1.4. персональные данные физического лица, обратившегося к Оператору с жалобами, заявлениями и обращениями.</p>\r\n<p> </p>\r\n<p>Субъект персональных данных имеет право:</p>\r\n<p> </p>\r\n<p>6.1. на получение сведений о персональных данных, обрабатываемых Оператором;</p>\r\n<p> </p>\r\n<p>6.2. требовать уточнения своих персональных данных, их блокирования или уничтожения в случае, если персональные данные являются неполными, устаревшими, недостоверными, незаконно полученными или не являются необходимыми для заявленной цели обработки, а также принимать предусмотренные законом меры по защите своих прав;</p>\r\n<p> </p>\r\n<p>6.3. получать информацию о сроках обработки своих персональных данных, в том числе о сроках их хранения;</p>\r\n<p> </p>\r\n<p>6.4. требовать извещения всех лиц, которым ранее были сообщены неверные или неполные его персональные данные, обо всех произведенных в них исключениях, исправлениях или дополнениях;</p>\r\n<p> </p>\r\n<p>6.5. обжаловать в уполномоченный орган по защите прав субъектов персональных данных или в судебном порядке неправомерные действия или бездействия при обработке его персональных данных.</p>\r\n<p> </p>\r\n<p>7.1. Безопасность персональных данных, обрабатываемых Оператором, обеспечивается реализацией правовых, организационных, технических и программных мер, необходимых и достаточных для обеспечения требований федерального законодательства в области защиты персональных данных.</p>\r\n<p> </p>\r\n<p>7.2. Оператор предпринимает необходимые организационные и технические меры для обеспечения безопасности персональных данных от случайного или несанкционированного доступа, уничтожения, изменения, блокирования доступа и других несанкционированных действий.</p>\r\n<p> </p>\r\n<p>7.3. Оператор применяет следующие организационно-технические меры:</p>\r\n<p> </p>\r\n<p>7.3.1. назначение должностных лиц, ответственных за организацию обработки и защиты персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.2. ограничение и регламентация состава работников, имеющих доступ к персональным данным;</p>\r\n<p> </p>\r\n<p>7.3.3. ознакомление работников с требованиями федерального законодательства и нормативных документов Оператора по обработке и защите персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.4. обеспечение учета и хранения материальных носителей информации и их обращения, исключающего хищение, подмену, несанкционированное копирование и уничтожение;</p>\r\n<p> </p>\r\n<p>7.3.5. определение угроз безопасности персональных данных при их обработке, формирование на их основе моделей угроз;</p>\r\n<p> </p>\r\n<p>7.3.6. разработка на основе модели угроз системы защиты персональных данных для соответствующего класса информационных систем;</p>\r\n<p> </p>\r\n<p>7.3.7. реализация разрешительной системы доступа пользователей к информационным ресурсам, программно-аппаратным средствам обработки и защиты информации;</p>\r\n<p> </p>\r\n<p>7.3.8. регистрация и учет действий пользователей информационных систем персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.9. парольная защита доступа пользователей к информационной системе персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.10. применение средств контроля доступа к коммуникационным портам, устройствам ввода-вывода информации, съемным машинным носителям и внешним накопителям информации;</p>\r\n<p> </p>\r\n<p>7.3.11. применение в необходимых случаях средств криптографической защиты информации для обеспечения безопасности персональных данных при передаче по открытым каналам связи и хранении на машинных носителях информации;</p>\r\n<p> </p>\r\n<p>7.3.12. осуществление антивирусного контроля, предотвращение внедрения в корпоративную сеть вредоносных программ (программ-вирусов) и программных закладок;</p>\r\n<p> </p>\r\n<p>7.3.13. применение межсетевого экранирования;</p>\r\n<p> </p>\r\n<p>7.3.14. обнаружение вторжений в корпоративную сеть Оператора, нарушающих или создающих предпосылки к нарушению установленных требований по обеспечению безопасности персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.15. централизованное управление системой защиты персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.16. резервное копирование информации;</p>\r\n<p> </p>\r\n<p>7.3.17. обеспечение восстановления персональных данных, модифицированных или уничтоженных вследствие несанкционированного доступа к ним;</p>\r\n<p> </p>\r\n<p>7.3.18. обучение работников, использующих средства защиты информации, применяемые в информационных системах персональных данных, правилам работы с ними;</p>\r\n<p> </p>\r\n<p>7.3.19. учет применяемых средств защиты информации, эксплуатационной и технической документации к ним;</p>\r\n<p> </p>\r\n<p>7.3.20. проведение мониторинга действий пользователей, проведение разбирательств по фактам нарушения требований безопасности персональных данных;</p>\r\n<p> </p>\r\n<p>7.3.21. размещение технических средств обработки персональных данных, в пределах охраняемой территории;</p>\r\n<p> </p>\r\n<p>7.3.22. поддержание технических средств охраны, сигнализации помещений в состоянии постоянной готовности.</p>\r\n<p> </p>\r\n<p>8.1. Настоящая Политика является внутренним документом Оператора, общедоступной и подлежит размещению на официальном сайте Оператора.</p>\r\n<p> </p>\r\n<p>8.2. Настоящая Политика подлежит изменению, дополнению в случае появления новых законодательных актов и специальных нормативных документов по обработке и защите персональных данных.</p>\r\n<p> </p>\r\n<p>8.3. Контроль исполнения требований настоящей Политики осуществляется ответственным за обеспечение безопасности персональных данных Оператора.</p>\r\n<p> </p>\r\n<p>8.4. Ответственность должностных лиц Оператора, имеющих доступ к персональным данным, за невыполнение требований норм, регулирующих обработку и защиту персональных данных, определяется в соответствии с законодательством Российской Федерации и внутренними документами Оператора.</p>', '', '1', '2', '2025-05-30 08:16:36', '479', '', '2025-05-30 08:22:46', '479', '0', '0000-00-00 00:00:00', '2025-05-30 08:16:36', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"1\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '3', '1', '', '', '1', '727', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', '');/**ABDB**/
/**ABDB**/INSERT INTO `#__content`  VALUES 
('29', '117', 'Соглашение об оказании услуг по использованию сайта', 'soglashenie-ob-okazanii-uslug-po-ispolzovaniyu-sajta', '<p><strong>Соглашение об оказании услуг по использованию сайта https://www.jobcv.ru</strong></p>\r\n<p> </p>\r\n<p>Общество с ограниченной ответственностью «ПЕРСОНА-Спутник», именуемое в дальнейшем, «Исполнитель», предоставляет любому физическому лицу, именуемому в дальнейшем «Соискатель», услуги по содействию в трудоустройстве посредством предоставления сервисов сайта https://www.jobcv.ru   на приведенных ниже условиях.</p>\r\n<p> </p>\r\n<p>Безусловным принятием (акцептом) условий настоящей оферты считается регистрация на сайте https://www.jobcv.ru/</p>\r\n<p> </p>\r\n<ol>\r\n<li>Термины и определения, используемые в настоящем соглашении</li>\r\n</ol>\r\n<p> </p>\r\n<p>1.1. Сайт – содержимое интернет-страниц, расположенных в сети Интернет на домене https://www.jobcv.ru</p>\r\n<p> </p>\r\n<p>1.2. Соискатель – зарегистрированный пользователь Сайта, разместивший персональные данные в Базе данных Исполнителя (см.ниже) посредством заполнения Анкеты (см.ниже) с целью поиска работы.</p>\r\n<p> </p>\r\n<p>База данных Исполнителя – совокупность анкет Соискателей, используемая Исполнителем в процессе оказания услуг по подбору персонала работодателям на основе договоров с последними.</p>\r\n<p> </p>\r\n<p>1.4. Персональные данные – любая информация, о Соискателе, в том числе его фамилия, имя, отчество, год, месяц, дата и место рождения, адрес, семейное, социальное, имущественное положение, образование, профессия, доходы, другая информация, связанная с поиском работы, которую Соискатель указывает по своему усмотрению.</p>\r\n<p> </p>\r\n<p>1.5. Анкета – документ, содержащий персональные данные Соискателя, относящихся к поиску работы, которые Соискатель указывает по своему усмотрению.</p>\r\n<p> </p>\r\n<p>1.6. Личный кабинет – закрытая часть сайта, на которую Соискатель попадает посредством ввода своих регистрационных данных (логина и пароля) и получает доступ для размещения, редактирования и удаления персональных данных.</p>\r\n<p> </p>\r\n<p>1.7. Обработка персональных данных –  действия (операции) с персональными данными, включая сбор, систематизацию, накопление, хранение, уточнение (обновление, изменение), использование, распространение (в том числе передачу), обезличивание, блокирование, уничтожение персональных данных.</p>\r\n<p> </p>\r\n<p>1.8.   Клиент – потенциальный работодатель, разместивший заказ на подбор персонала у Исполнителя.</p>\r\n<p> </p>\r\n<ol start=\"2\">\r\n<li>Предмет соглашения</li>\r\n</ol>\r\n<p> </p>\r\n<p>2.1. Исполнитель обязуется предоставить возможность Соискателю размещать Анкету в Базе данных Исполнителя посредством Сайта, просматривать вакансии, опубликованные на Сайте, и создавать на них отклики.</p>\r\n<p> </p>\r\n<p>2.2. В рамках данного соглашения Соискатель в соответствии с Федеральным законом «О персональных данных» № 152-ФЗ от 27 июля 2006г. дает согласие Исполнителю на обработку своих персональных данных в целях содействия в трудоустройстве.</p>\r\n<p> </p>\r\n<p>2.3. Соискатель несет ответственность за достоверность размещаемой информации.</p>\r\n<p> </p>\r\n<p>2.4. Контактную информацию, указанную в Анкете Исполнитель использует при обращении сотрудников Исполнителя к Соискателю.</p>\r\n<p> </p>\r\n<p>2.5. Соискатель соглашается и принимает, что Исполнитель оставляет за собой право вносить уточнения в имеющуюся информацию о Соискателе и/или добавлять сведения, необходимые для содействия в трудоустройстве  Соискателя, но только после устного или письменного согласования этих сведений с Соискателем, в том числе в результате собеседования (п. 2.6).</p>\r\n<p> </p>\r\n<p>2.6. Соискатель принимает, что его Анкета будет представлена Клиенту Исполнителем только после проведения собеседования сотрудников Исполнителя и Соискателя при встрече лично или посредством технических средств, то есть по телефону и посредством электронных платформ, официально разрешённых к использованию в РФ.</p>\r\n<p> </p>\r\n<p>2.7. Используя сайт www.jobcv.ru  , Соискатель соглашается и принимает, что Исполнитель оставляет за собой право использовать его персональную информацию анонимно и в обобщенном виде для статистических целей, а также для таргетинга рекламы.</p>\r\n<p> </p>\r\n<p>2.8. Настоящее Согласие не имеет ограничения срока его действия.</p>\r\n<p> </p>\r\n<p>2.9. Для отзыва настоящего Соглашения Соискатель должен прислать электронное письмо Исполнителю на почту sputnik.personal@yandex.ru , в котором он отзывает свое Соглашение. Исполнитель после получения электронного письма на почту sputnik.personal@yandex.ru уничтожает персональные данные Соискателя из Базы данных Исполнителя и уведомляет об этом Соискателя.</p>\r\n<p> </p>\r\n<p>2.10. Данное соглашение не является договором между Исполнителем и Соискателем о трудоустройстве последнего и не гарантирует трудоустройство Соискателя.</p>\r\n<p> </p>\r\n<p>2.11. Настоящее соглашение не может пониматься как установление между Исполнителем и Соискателем агентских отношений, отношений товарищества, отношений по совместной деятельности, отношений личного найма, либо каких-то иных отношений, прямо не предусмотренных в настоящем соглашении</p>\r\n<p> </p>\r\n<p>2.12. Настоящее Соглашение может быть изменено Исполнителем в одностороннем порядке без какого-либо предупреждения Соискателя и Пользователей Сайта, путем размещения новой редакции Соглашения на сайте https://www.jobcv.ru</p>\r\n<p> </p>\r\n<ol start=\"3\">\r\n<li>Обязанности Исполнителя</li>\r\n</ol>\r\n<p> </p>\r\n<p>3.1. Исполнитель обязуется:</p>\r\n<p> </p>\r\n<p>3.1.1. Предоставить возможность Соискателю сформировать Анкету на сайте и сохранить её в Базе данных.</p>\r\n<p> </p>\r\n<p>3.1.2. Предоставить возможность Соискателю редактировать Анкету через Личный кабинет (в настоящее время Личный кабинет находится в разработке) в любой момент по своему усмотрению.</p>\r\n<p> </p>\r\n<p>3.1.3. Предоставить Соискателю возможность просмотра опубликованных на Сайте вакансий, имеющихся в распоряжении Исполнителя.</p>\r\n<p> </p>\r\n<p>3.2. Исполнитель прилагает все возможные усилия для того, чтобы избежать несанкционированного использования третьими лицами персональных данных Соискателя. Однако Исполнитель не несет ответственности за такое нецелевое использование, в том числе Клиентом Исполнителя, персональной информации Соискателей, произошедшее не по умыслу Исполнителя.</p>\r\n<p> </p>\r\n<ol start=\"4\">\r\n<li>Обязанности Соискателя</li>\r\n</ol>\r\n<p> </p>\r\n<p>4.1. Соискатель обязуется НЕ совершать следующих действий :</p>\r\n<p> </p>\r\n<p>4.1.1. Любым способом, посредством Сайта, размещать, распространять, сохранять, загружать и/или уничтожать материалы (информацию) в нарушение законодательства РФ и международного законодательства.</p>\r\n<p> </p>\r\n<p>4.1.2. Размещать и/или передавать посредством Сайта, информацию в виде текста, изображения, звука или программного кода, которая может быть противозаконной, угрожающей, оскорбительной, клеветнической, заведомо ложной, грубой, непристойной, вредить другим посетителям Сайта, нарушать их права и законные интересы.</p>\r\n<p> </p>\r\n<p>4.1.3. Внедрять в размещаемые данные исполняемый код (клиентские скрипты: java-script, visual basic-script и т.п.), любые внедряемые объекты (java-апплеты, flash и т.п.), использовать frame и iframe, каскадные таблицы стилей, переопределяющие используемые на Сайте, а также html-код, нарушающий оригинальный дизайн страницы.</p>\r\n<p> </p>\r\n<p>4.1.4. Представляться чужим именем или от чужого имени (частного лица или организации) — зарегистрированного на Сайте Соискателя, представителя организации работодателя, сотрудника Исполнителя. Вводить в заблуждение пользователей и администрацию Сайта относительно своей идентификации любым иным способом.</p>\r\n<p> </p>\r\n<p>4.1.5. Размещать заведомо недостоверную информацию.</p>\r\n<p> </p>\r\n<p>4.1.6. Передавать пароль на доступ к Личному кабинету (Личный кабинет  в настоящее время недоступен и находится в разработке) третьим лицам. Соискатель несет ответственность за сохранение конфиденциальности пароля и любое использование Сайта посредством его пароля.</p>\r\n<p> </p>\r\n<p>4.1.7. Размещать и/или передавать, используя Сайт, материалы, в случае, если Соискатель не имеет на это соответствующих прав. Это касается материалов, защищенных авторскими правами, торговыми марками, патентами, а также соглашениями о нераспространении информации, конфиденциальности и тому подобными.</p>\r\n<p> </p>\r\n<p>4.1.8. Уничтожать и/или изменять любые материалы на Сайте, автором которых Соискатель не является.</p>\r\n<p> </p>\r\n<p>4.1.9. Использовать информацию о телефонах, почтовых адресах, адресах электронной почты для целей иных, нежели тематика Сайта.</p>\r\n<p> </p>\r\n<p>4.1.10. Размещать объявления, связанные с игорным бизнесом, финансовыми пирамидами, религиозными сектами, оккультными и эротическими услугами, а также информацию, противоречащую действующему законодательству.</p>\r\n<p> </p>\r\n<ol start=\"5\">\r\n<li>Использование Сайта</li>\r\n</ol>\r\n<p> </p>\r\n<p>Используя Сайт, Соискатель обязуется не нарушать и не пытаться нарушать информационную безопасность Сайта, что включает в себя:</p>\r\n<p> </p>\r\n<p>5.1. Доступ к данным, не предназначенным для данного Соискателя или вход в систему под логином, не принадлежащем данному Соискателю.</p>\r\n<p> </p>\r\n<p>5.2. Попытки проверить уязвимость системы безопасности Сайта, нарушение процедуры регистрации и авторизации без разрешения Исполнителя.</p>\r\n<p> </p>\r\n<p>5.3. Попытки создать помехи в использовании Сайта другим пользователям, что включает в себя распространение компьютерных вирусов, порчу данных, постоянную рассылку повторяющейся информации, пересылку электронной почты через сервер сайта, одновременную отправку большого количества электронной почты и/или запросов к Сайту с целью намеренно вывести сервер сайта из строя и тому подобные действия, выходящие за рамки нормального целевого использования Сайта, и могущие умышленно или по неосторожности повлечь сбои в его работе.</p>\r\n<p> </p>\r\n<p>5.4. Имитацию и/или подделку любого заголовка пакета TCP/IP или любой части заголовка в любом электронном письме или размещенном на Сайте материале.</p>\r\n<p> </p>\r\n<ol start=\"6\">\r\n<li>Защищенные разделы Сайта и пароли</li>\r\n</ol>\r\n<p> </p>\r\n<ol start=\"7\">\r\n<li>Информация о пользователе</li>\r\n</ol>\r\n<p> </p>\r\n<p>7.1. Исполнитель прилагает все возможные усилия для того, чтобы избежать несанкционированного использования персональной информации Соискателей.</p>\r\n<p> </p>\r\n<p>7.2. Исполнитель не несет ответственности за возможное нецелевое использование персональной информации пользователей, произошедшее из-за:</p>\r\n<p> </p>\r\n<p>7.2.1. технических неполадок в программном обеспечении, серверах или компьютерных сетях, находящихся вне контроля Исполнителя;</p>\r\n<p> </p>\r\n<p>7.2.2. перебоев в работе Сайта, связанных с намеренным или ненамеренным использованием Сайта не по назначению третьими лицами, описанным в разделе «Использование Сайта»;</p>\r\n<p> </p>\r\n<p>7.3. Исполнитель обязуется не предоставлять никакой персональной информации о Соискателях частным лицами и организациям, заявляющим о возможном нецелевом использовании подобной информации (рассылки несанкционированной рекламы, «спама», предоставлении информации другим лицам и тому подобное).</p>\r\n<p> </p>\r\n<ol start=\"8\">\r\n<li>Финансовые отношения</li>\r\n</ol>\r\n<p> </p>\r\n<p>8.1. Исполнитель оказывает услуги и сервисы Сайта бесплатно.</p>\r\n<p> </p>\r\n<ol start=\"9\">\r\n<li>Использование материалов Сайта</li>\r\n</ol>\r\n<p> </p>\r\n<p>9.1. Каждый Пользователь Сайта, Соискатель отвечает за информацию, размещаемую от его имени и за последствия этого размещения.</p>\r\n<p> </p>\r\n<p>9.2. Сайт является лишь средством для передачи информации и ни в коем случае не несет ответственности за ее достоверность и актуальность.</p>\r\n<p> </p>\r\n<p>9.3. Исполнитель прилагает все возможные усилия для того, чтобы исключить с Сайта небрежную, неаккуратную или заведомо неполную информацию, однако, в конечном счете, ответственность за нее лежит на разместивших ее лицах.</p>\r\n<p> </p>\r\n<p>9.4. При перепечатке и ином использовании материалов Сайта, не являющихся Анкетой Соискателей, описаниями компаний или вакансий, а также логотипом, элементами дизайна, внешнего вида и структуры Сайта, ссылка на Сайт обязательна.</p>\r\n<p> </p>\r\n<p>9.5. Использование Анкеты Соискателей, описаний компаний и вакансий недопустимо ни с какими целями, кроме соответствующих тематике Сайта (поиск работы, сотрудников, получение информации о рынке труда).</p>\r\n<p> </p>\r\n<p>9.6. В случае, если Клиент Исполнителя сохраняет представленную Исполнителем Анкету Соискателя в своей собственной базе данных, то ответственность за это несет Клиент Исполнителя в рамках Закона «О персональных данных», как оператор персональных данных.</p>\r\n<p> </p>\r\n<p>9.7. Логотип «ПЕРСОНА - Спутник», а также логотип «ТРИЗА – Спутник», и логотип «СПУТНИК – Персонал» название, элементы дизайна, оформления и общий внешний вид сайта являются собственностью Исполнителя и их использование запрещено без согласия Исполнителя.</p>\r\n<p> </p>\r\n<p>9.8. Используя информацию с Сайта, Соискатель осознает и принимает риски, связанные с возможной недостоверностью размещенной на Сайте информации, а также с тем, что некоторая информация может показаться ему оскорбительной, клеветнической, заведомо ложной, грубой, непристойной. Если это произошло, Соискатель должен немедленно прекратить использовать Сайт и сообщить Исполнителю о наличии подобной информации.</p>\r\n<p> </p>\r\n<p>9.9. Исполнитель не гарантирует, что зарегистрированные Анкеты будут представлены определенному количеству Клиентов Исполнителя или хотя бы одному.</p>\r\n<p> </p>\r\n<p>9.10. Исполнитель не гарантирует, что программное обеспечение, сервера и компьютерные сети, используемые Сайтом свободны от ошибок и компьютерных вирусов. Если использование Сайта повлекло за собой утрату данных или порчу оборудования, Исполнитель не несет за это ответственности.</p>', '', '1', '2', '2025-05-30 08:33:10', '479', '', '2025-05-30 08:33:10', '0', '0', '0000-00-00 00:00:00', '2025-05-30 08:33:10', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '0', '', '', '1', '682', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('30', '119', 'Резидент ОЭЗ \"Технополис Москва\" выразил благодарность кадровому агентству \"ПЕРСОНА-Спутник\" за быстрый и качественный подбор дефицитного персонала ', 'rezident-oez-tekhnopolis-moskva-vyrazil-blagodarnost-kadrovomu-agentstvu-persona-sputnik-za-bystryj-i-kachestvennyj-podbor-defitsitnogo-personala', '<p>ООО «ДИ ВАЙ ТЕХНОЛОДЖИС» («DY TECHNOLOGIES»)<br />124460, г. Москва, г. Зеленоград, ул. Конструктора Лукина, д. 51</p>\r\n<p><br />В связи с увеличением объема производства в ООО «Ди Вай Технолоджис» возникла необходимость быстрого и качественного подбора «дефицитного» персонала. Путем проведения тендера среди кадровых агентств по условиям оплаты и срокам закрытия вакансий было принято решение в пользу \"ПЕРСОНА-Спутник\" г. Зеленоград.<br />За все время работы команда ПЕРСОНА-Спутник\" проявила высокий уровень профессионализма, внимательность к деталям и готовность быстро реагировать на наши запросы, были учтены все наши рекомендации и пожелания по каждому профилю должности. Дефицитные вакансии были закрыты качественно и в объявленные сроки. Отказов и замен не было.<br />Особенно хочу отметить индивидуальный подход к нашей компании и коммуникацию со стороны генерального директора \"ПЕРСОНА-Спутник\" Полетаева Юрия Константиновича. Рекомендую этого агентство всем, кто ищет надежного и ответственного партнера!<br />Генеральный директор М.В. Годенко<br />«ДИ ВАЙ ТЕХНОЛОДЖИС» («DY TECHNOLOGIES»)<br /><br /></p>', '', '1', '15', '2025-06-11 10:43:32', '479', '', '2025-06-11 10:45:59', '479', '479', '2025-06-11 10:46:40', '2025-06-11 10:43:32', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '2', '3', '', '', '1', '609', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('31', '120', 'Проблема борьбы за власть среди \"белых воротничков\"', 'problema-borby-za-vlast-sredi-belykh-vorotnichkov', '<p>Проблема борьбы за власть среди \"белых воротничков\" – это чаще всего симптом системных проблем в компании (стратегия, культура, процессы, лидерство), а не просто личные недостатки менеджеров. Решение требует *комплексного подхода и активной позиции высшего руководства*. Без четкого сигнала \"сверху\" о недопустимости политиканства и важности сотрудничества, а также без создания соответствующих стимулов и условий, эта борьба будет продолжаться, нанося ущерб эффективности и здоровью организации.</p>\r\n<p>В следующей статье я постараюсь дать рекомендации о том, что можно сделать и какие решения принять для компании и руководства.</p>\r\n<p>Генеральный директор кадрового агентства \"ПЕРСОНА-Спутник\" Ю.К.Полетаев</p>', '', '1', '15', '2025-06-11 10:50:55', '479', '', '2025-06-11 10:50:55', '0', '0', '0000-00-00 00:00:00', '2025-06-11 10:50:55', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '2', '', '', '1', '590', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('32', '121', 'Анализ причин и возможные решения важной и распространенной проблемы - борьбы за власть и влияние среди менеджеров среднего звена (\"белых воротничков\") в ущерб корпоративным целям и прямым обязанностям – серьезный вызов для многих организаций', 'analiz-prichin-i-vozmozhnye-resheniya-vazhnoj-i-rasprostranennoj-problemy-borby-za-vlast-i-vliyanie-sredi-menedzherov-srednego-zvena-belykh-vorotnichkov-v-ushcherb-korporativnym-tselyam-i-pryamym-obyazannostyam-sereznyj-vyzov-dlya-mnogikh-organizatsij', '<p>Вы подняли действительно важную и распространенную проблему. Борьба за власть и влияние среди менеджеров среднего звена (\"белых воротничков\") в ущерб корпоративным целям и прямым обязанностям – серьезный вызов для многих организаций. Вот анализ причин и возможные решения:</p>\r\n<p>Причины такого поведения:</p>\r\n<p>1. Ограниченные ресурсы и возможности для роста (\"Узкое горлышко\"): Выше топ-менеджмента мест мало. Менеджеры среднего звена видят борьбу за влияние как единственный способ продвинуться или сохранить свою позицию.<br />2. Неясные или конфликтующие цели и приоритеты: Если цели отделов противоречат друг другу или не согласованы с общей стратегией компании, менеджеры начинают конкурировать за ресурсы и признание, а не сотрудничать.<br />3. Система вознаграждения и оценки: Если KPI и бонусы основаны исключительно на результатах отдела (а не компании в целом) или поощряют индивидуальные достижения в ущерб командной работе, конкуренция становится выгодной.<br />4. Недостаток доверия и прозрачности: Неясные критерии принятия решений наверху, фаворитизм или неинформированность порождают подозрительность и желание \"играть в политику\", чтобы защитить себя и свое подразделение.<br />5. Недостаточное лидерство \"сверху\": Топ-менеджмент может не задавать четкий тон сотрудничества, не пресекать политиканство или даже сам создавать атмосферу конкуренции между подразделениями.<br />6. Страх и неуверенность: Реорганизации, сокращения, неопределенность рынка заставляют менеджеров бороться за выживание и влияние, чтобы обезопасить себя.<br />7. Двойная подотчетность: Менеджеры среднего звена часто разрываются между требованиями высшего руководства и потребностями/ожиданиями своих сотрудников. Это напряжение может выливаться в борьбу за ресурсы и влияние как способ справиться.<br />8. Личные амбиции и особенности характера: Некоторые люди просто более склонны к интригам и борьбе за власть по своей природе.</p>\r\n<p>Негативные последствия для компании:</p>\r\n<p>Падение производительности: Энергия тратится на политику, а не на работу.<br />Плохие решения: Принимаются не оптимальные для компании, а удобные для \"победившей\" группы решения.<br />Потеря инноваций: Сотрудничество и обмен идеями блокируются.<br />Токсичная корпоративная культура: Появляются стресс, недоверие, текучка кадров (особенно талантливых, кто не хочет участвовать в играх).<br />Репутационный ущерб: Конфликты на среднем уровне влияют на клиентов, партнеров и имидж компании.<br />Снижение лояльности: Сотрудники разочаровываются, видя, что продвижение зависит не от заслуг, а от политики.</p>', '', '1', '15', '2025-06-11 10:55:30', '479', '', '2025-06-11 10:55:30', '0', '0', '0000-00-00 00:00:00', '2025-06-11 10:55:30', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '1', '', '', '1', '583', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', ''),
('33', '122', 'Что можно сделать в компаниях и организациях для снижения негативных последствий борьбы за власть среди менеджеров среднего звена', 'chto-mozhno-sdelat-v-kompaniyakh-i-organizatsiyakh-dlya-snizheniya-negativnykh-posledstvij-borby-za-vlast-sredi-menedzherov-srednego-zvena', '<p>Что можно сделать (решения для компании и руководства):</p>\r\n<p>1. Четкая стратегия и согласованные цели:<br />- Четко формулируйте и доводите до всех общую стратегию компании.<br />- Устанавливайте KPI, которые поощряют межфункциональное сотрудничество и общий успех компании (например, доля общекорпоративных целей в бонусе).<br />- Регулярно пересматривайте и корректируйте цели отделов на предмет согласованности.<br />2. Сильная культура и ценности:<br />- Активно формируйте и поддерживайте культуру, основанную на доверии, сотрудничестве, прозрачности и подотчетности.<br />- Вознаграждайте и публично признавайте примеры успешного сотрудничества между отделами.<br />- Нулевая терпимость к интригам и саботажу – четкие последствия за такое поведение.<br />3. Эффективная система оценки и развития:<br />- Оценивайте менеджеров не только по результатам их отдела, но и по вкладу в общеорганизационные проекты, навыкам сотрудничества, развитию команды.<br />- Создавайте прозрачные карьерные пути и программы развития (менторство, ротация), чтобы уменьшить ощущение \"узкого горлышка\".<br />- Инвестируйте в обучение soft skills: коммуникация, разрешение конфликтов, эмоциональный интеллект, лидерство (а не только управление).<br />4. Укрепление лидерства:<br />Топ-менеджмент должен подавать личный пример сотрудничества и открытости.<br />Руководители высшего звена должны активно выявлять и пресекать политиканство, выступать арбитрами в межфункциональных конфликтах.<br />Налаживайте прямые каналы коммуникации между топ-менеджментом и менеджерами среднего звена (например, регулярные встречи, открытые Q&amp;A).<br />5. Улучшение процессов:<br />- Оптимизируйте процессы, чтобы минимизировать точки трения между отделами.<br />- Внедряйте кросс-функциональные проектные команды с общими целями и подотчетностью.<br />- Обеспечьте прозрачность в распределении ресурсов и принятии решений.<br />6. <strong>Подбор и расстановка кадров</strong>:<br />При найме и продвижении менеджеров среднего звена уделяйте особое внимание их ценностям, способности к сотрудничеству и эмоциональному интеллекту, а не только техническим навыкам.<br />Рассматривайте ротацию менеджеров между отделами для расширения кругозора и разрушения \"силосов\".</p>\r\n<p>Проблема борьбы за власть среди \"белых воротничков\" – это чаще всего симптом системных проблем в компании (стратегия, культура, процессы, лидерство), а не просто личные недостатки менеджеров. Решение требует комплексного подхода и активной позиции высшего руководства. Без четкого сигнала \"сверху\" о недопустимости политиканства и важности сотрудничества, а также без создания соответствующих стимулов и условий, эта борьба будет продолжаться, нанося ущерб эффективности и здоровью организации.</p>', '', '1', '15', '2025-06-11 11:00:52', '479', '', '2025-06-11 11:00:52', '0', '0', '0000-00-00 00:00:00', '2025-06-11 11:00:52', '0000-00-00 00:00:00', '{\"image_intro\":\"\",\"float_intro\":\"\",\"image_intro_alt\":\"\",\"image_intro_caption\":\"\",\"image_fulltext\":\"\",\"float_fulltext\":\"\",\"image_fulltext_alt\":\"\",\"image_fulltext_caption\":\"\"}', '{\"urla\":false,\"urlatext\":\"\",\"targeta\":\"\",\"urlb\":false,\"urlbtext\":\"\",\"targetb\":\"\",\"urlc\":false,\"urlctext\":\"\",\"targetc\":\"\"}', '{\"article_layout\":\"\",\"show_title\":\"\",\"link_titles\":\"\",\"show_tags\":\"\",\"show_intro\":\"\",\"info_block_position\":\"\",\"info_block_show_title\":\"\",\"show_category\":\"\",\"link_category\":\"\",\"show_parent_category\":\"\",\"link_parent_category\":\"\",\"show_associations\":\"\",\"show_author\":\"\",\"link_author\":\"\",\"show_create_date\":\"\",\"show_modify_date\":\"\",\"show_publish_date\":\"\",\"show_item_navigation\":\"\",\"show_icons\":\"\",\"show_print_icon\":\"\",\"show_email_icon\":\"\",\"show_vote\":\"\",\"show_hits\":\"\",\"show_noauth\":\"\",\"urls_position\":\"\",\"alternative_readmore\":\"\",\"article_page_title\":\"\",\"show_publishing_options\":\"\",\"show_article_options\":\"\",\"show_urls_images_backend\":\"\",\"show_urls_images_frontend\":\"\",\"spfeatured_image\":\"\",\"spfeatured_image_alt\":\"\",\"post_format\":\"standard\",\"gallery\":\"\",\"audio\":\"\",\"video\":\"\",\"link_title\":\"\",\"link_url\":\"\",\"quote_text\":\"\",\"quote_author\":\"\",\"post_status\":\"\"}', '1', '0', '', '', '1', '598', '{\"robots\":\"\",\"author\":\"\",\"rights\":\"\",\"xreference\":\"\"}', '0', '*', '', '');
/**ABDB**/CREATE TABLE `#__contact_details` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `alias` varchar(400) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `con_position` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `address` text COLLATE utf8mb4_unicode_ci,
  `suburb` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `state` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `country` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `postcode` varchar(100) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `telephone` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `fax` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `misc` mediumtext COLLATE utf8mb4_unicode_ci,
  `image` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `email_to` varchar(255) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `default_con` tinyint(1) unsigned NOT NULL DEFAULT '0',
  `published` tinyint(1) NOT NULL DEFAULT '0',
  `checked_out` int(10) unsigned NOT NULL DEFAULT '0',
  `checked_out_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `ordering` int(11) NOT NULL DEFAULT '0',
  `params` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `user_id` int(11) NOT NULL DEFAULT '0',
  `catid` int(11) NOT NULL DEFAULT '0',
  `access` int(10) unsigned NOT NULL DEFAULT '0',
  `mobile` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `webpage` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `sortname1` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `sortname2` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `sortname3` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `language` varchar(7) COLLATE utf8mb4_unicode_ci NOT NULL,
  `created` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `created_by` int(10) unsigned NOT NULL DEFAULT '0',
  `created_by_alias` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `modified` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `modified_by` int(10) unsigned NOT NULL DEFAULT '0',
  `metakey` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `metadesc` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `metadata` text COLLATE utf8mb4_unicode_ci NOT NULL,
  `featured` tinyint(3) unsigned NOT NULL DEFAULT '0' COMMENT 'Set if contact is featured.',
  `xreference` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'A reference to enable linkages to external data sets.',
  `publish_up` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `publish_down` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `version` int(10) unsigned NOT NULL DEFAULT '1',
  `hits` int(10) unsigned NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_access` (`access`),
  KEY `idx_checkout` (`checked_out`),
  KEY `idx_state` (`published`),
  KEY `idx_catid` (`catid`),
  KEY `idx_createdby` (`created_by`),
  KEY `idx_featured_catid` (`featured`,`catid`),
  KEY `idx_language` (`language`),
  KEY `idx_xreference` (`xreference`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/**ABDB**/CREATE TABLE `#__categories` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `asset_id` int(10) unsigned NOT NULL DEFAULT '0' COMMENT 'FK to the #__assets table.',
  `parent_id` int(10) unsigned NOT NULL DEFAULT '0',
  `lft` int(11) NOT NULL DEFAULT '0',
  `rgt` int(11) NOT NULL DEFAULT '0',
  `level` int(10) unsigned NOT NULL DEFAULT '0',
  `path` varchar(400) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `extension` varchar(50) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `title` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `alias` varchar(400) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '',
  `note` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `description` mediumtext COLLATE utf8mb4_unicode_ci,
  `published` tinyint(1) NOT NULL DEFAULT '0',
  `checked_out` int(11) unsigned NOT NULL DEFAULT '0',
  `checked_out_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `access` int(10) unsigned NOT NULL DEFAULT '0',
  `params` text COLLATE utf8mb4_unicode_ci,
  `metadesc` varchar(1024) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'The meta description for the page.',
  `metakey` varchar(1024) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'The meta keywords for the page.',
  `metadata` varchar(2048) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT 'JSON encoded metadata properties.',
  `created_user_id` int(10) unsigned NOT NULL DEFAULT '0',
  `created_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `modified_user_id` int(10) unsigned NOT NULL DEFAULT '0',
  `modified_time` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `hits` int(10) unsigned NOT NULL DEFAULT '0',
  `language` char(7) COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `version` int(10) unsigned NOT NULL DEFAULT '1',
  PRIMARY KEY (`id`),
  KEY `cat_idx` (`extension`,`published`,`access`),
  KEY `idx_access` (`access`),
  KEY `idx_checkout` (`checked_out`),
  KEY `idx_path` (`path`(100)),
  KEY `idx_left_right` (`lft`,`rgt`),
  KEY `idx_alias` (`alias`(100)),
  KEY `idx_language` (`language`)
) ENGINE=InnoDB AUTO_INCREMENT=17 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
