/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('129', '5', 'Сиделка', 'Сиделка', 'Зеленоград', '3', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт работы сиделкой в семьях от 2 лет;<br />Наличие рекомендаций.</p>', '<p>Уход за крупным (около 90 кг) пожилым мужчиной (81 год). <br />Перенес инфаркт и несколько операций. <br />Нужно будет ухаживать за мужчиной, переворачивать его, что бы не образовывались пролежни.<br />Кормить, мыть, следить за своевременным приемом лекарств.<br />Проводить небольшую уборку в квартире.<br />На перевязку приходит специализированная медсестра.</p>', '<p>Работа с проживанием в квартире в Зеленограде;<br />Оплата по договоренности.</p>', '', '0', '0', '', '', '', '2', '129', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-14 17:40:58'),
('130', '15', 'Уборщик-обработчик тары', 'Уборщик-обработчик тары', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>25 000 руб.</p>', '<p>Образование: среднее;</p>\r\n<p>Опыт работы: от 1 года;</p>\r\n<p>Ответственный, исполнительный, без вредных привычек; <br />Наличие медицинской книжки (компенсация затрат).</p>', '<p>Контроль наличия всех необходимых компонентов для качественной мойки и обработки технологических емкостей и тары;<br />Соблюдение установленной технологии мойки и обработки технологических емкостей и тары (температура воды, пропорция дезинфицирующего раствора, время обработки, сушка тары и т.д.);<br />Приготовление моющих и дезинфицирующих растворов; <br />Получение моющих средств, инвентаря и обтирочных материалов;<br />Осуществление стирки тканевых рукавов, колпаков с линии хлеба;<br />Уборку помещений, коридоров, лестниц, с соблюдением правил охраны труда, техники безопасности, производственной санитарии, гигиены и пожарной безопасности;<br />Удаление пыли с мебели, стеллажей, подметание и мойку (вручную или с помощью машин и приспособлений) полов, лестниц, мойку стен, окон и т.д.;<br />Сборка и транспортировка мусора и отходов в установленное место; <br />Осуществление расстановки урн для мусора, их чистка и дезинфекция;<br />Своевременная замена бумаги, заливка моющих и дезинфицирующих средств в диспенсеры;</p>', '<p>Социальные льготы: <br />- ежемесячная премия по установленным показателям - 30% от оклада;<br />- оформление по ТК РФ; <br />- корпоративный транспорт по Солнечногорску;<br />- компенсация за питание; <br />- скидки на продукцию компании; <br />- страхование от несчастных случаев;<br />Режим работы: 5-2 (с 9 до 18.00, в пятницу до 17.00, на время отсутствия сменной уборщицы- переход в смену по графику день, ночь, 2 выходных с 7 до 19.00 и с 19.00 до 7.00).</p>', '', '0', '0', '', '', '', '2', '130', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-19 17:43:09'),
('131', '14', 'Менеджер по продажам (дома, коттеджи)', 'Менеджер по продажам (дома, коттеджи)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<div>Образование: законченное высшее;</div>\r\n<div>Опыт работы: от 2-х лет в продажах малого домостроения;</div>\r\n<div>Наличие автомобиля желательно;</div>\r\n<div>Грамотная устная и письменная речь;</div>\r\n<div>Уровень владения ПК: уверенный пользователь MS Office, CRM; желательно знание 1С.</div>\r\n<div> </div>\r\n<div>Дополнительные требования к кандидату:</div>\r\n<div> </div>\r\n<div>Коммуникабельность, умение найти подход к собеседнику;</div>\r\n<div>Презентабельный внешний вид;</div>\r\n<div>Широкий кругозор;</div>\r\n<div>Умение убеждать;</div>\r\n<div>Внимательность: работа с документами, с расчетами;</div>\r\n<div>Ответственность;</div>\r\n<div>Умение аргументировать позицию компании;</div>\r\n<div>Активность, целеустремлённость, желание развиваться и зарабатывать.</div>', '<p>Консультирование клиентов по вопросам строительства (технологии, стоимость, договорные отношения);<br />Подготовка коммерческих предложений;<br />Просчет предварительных смет;<br />Заключение договоров проектирования и подряда;<br />Взаимодействие со смежными подразделениями;<br />Показ домов на различных стадиях строительства.</p>', '<p>Место работы: офис Зеленоград; <br />График работы: 5/2 с 9.00 до 18.00;<br />Испытательный срок: до 3-х месяцев;<br />Оформление по ТК РФ;<br />Стабильная заработная плата;<br />Возможность профессионального и карьерного роста;<br />Материальные выплаты в случаях рождения ребенка, смерти близкого родственника;<br />Частичная компенсация расходов на питание в рабочее время;<br />Компенсация 50% расходов на занятия спортом, включая карты фитнес-клубов;<br />Оплата курсов по повышению квалификации;<br />Единовременная выплата премии за отказ от курения;<br />Частичная компенсация расходов на приобретение спортивного инвентаря (велосипед), при условии использовании его в качестве трансфера к рабочему месту;<br />Компенсация медицинского лечения;<br />Чай, кофе в течение рабочего дня за счет компании;<br />Регулярные тренинги по улучшению профессиональных навыков;<br />Регулярные корпоративные мероприятия, проводимые полностью за счет компании;<br />Выплата премий за подачу и внедрение собственных идей, направленных на повышение качества работы компании.</p>', '', '0', '0', '', '', '', '2', '131', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-24 17:49:51'),
('132', '15', 'Водитель Автопогрузчика/Разнорабочий', 'Водитель Автопогрузчика/Разнорабочий', 'Истра', '3', '1970-01-01', '', '', '<p>35 000 руб.</p>', '<p><strong>Образование:</strong> среднее и выше;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 2-х лет;</p>\r\n<p><strong>Необходимые навыки:</strong> Нужен опыт работы на погрузчике нашего типа (Львовский погрузчик, 5 тонн) + навыки мелкого ремонта (поддержки) погрузчика. Контролировать уровень масла, подтягивать гайки, следить за протечками и т.п.;</p>\r\n<p><strong>Дополнительные требования:</strong> желательно - гражданство Таджикистан (у нас уже есть сотрудник из Таджикистана, так что будут работать в паре). Сотрудник должен быть готов к переезду на территорию (есть вагончик со всеми удобствами – бесплатно). Желательно наличие прав категории B;</p>\r\n<h1> </h1>', '<p>- Работа на Львовском погрузчике, 5 тонн;<br />- Погрузка/Разгрузка машин с пиломатериалом (основная работа); <br />- Зимой этим же погрузчиком нужно чистить снег на территории; <br />- Когда нет работы на погрузчике (у нас не бывают машины каждый день), то есть работа на складе (переупаковка товара, формирование пачек), или разная работа на нашей базе (уборка, покосить траву, полить дерева и т.п.).</p>', '<p>Работа с проживанием;</p>\r\n<p>Режим работы: Пн-Пт., с 9-17.</p>', '', '0', '0', '', '', '', '2', '132', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-25 15:34:19'),
('133', '7', 'Младший программист C/С++', 'Младший программист C/С++', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 50 000 руб.</p>', '<ul>\r\n<li>Высшее или незаконченное высшее техническое/математическое образование</li>\r\n<li>Базовое знание языков C и C++</li>\r\n<li>Знание принципов ООП</li>\r\n<li>Базовые знания основ архитектуры операционных систем</li>\r\n<li>Алгоритмическая подготовка</li>\r\n<li>Понимание базовых принципов работы электронной аппаратуры</li>\r\n<li>Желание обучаться и развиваться в сфере разработки программного обеспечения</li>\r\n</ul>\r\n<p><strong>Желательно:</strong></p>\r\n<ul>\r\n<li>Знание стандарта C++11, C++14</li>\r\n<li>Знание фреймворка Qt</li>\r\n<li>Знание STL, шаблонов проектирования</li>\r\n<li>Опыт использования ОС Windows и Linux</li>\r\n</ul>', '<ul>\r\n<li>Разработка программного обеспечения на языках программирования C и C++ (с использованием фреймворка Qt)</li>\r\n<li>Анализ исходных требований, уточнение поставленных задач</li>\r\n</ul>', '<ul>\r\n<li>Полное соблюдение ТК РФ</li>\r\n<li>\r\n<p>Частичная занятость (минимум 32 рабочих часа в неделю), полный день (желательно).</p>\r\n</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '133', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-25 16:30:27'),
('134', '7', 'Старший программист С++', 'Старший программист С++', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 100 000 руб.</p>', '<ul>\r\n<li>Высшее техническое/математическое образование</li>\r\n<li>Отличное знание и опыт разработки на языке C++ от 2 лет</li>\r\n<li>Знание фреймворка Qt</li>\r\n<li>Уверенное знание STL, шаблонов проектирования</li>\r\n<li>Знание основ архитектуры операционных систем</li>\r\n<li>Опыт разработки под Windows: сетевых приложений, многопоточных приложений, графического интерфейса пользователя</li>\r\n<li>Знание основ UNIX-подобных систем</li>\r\n<li>Хорошая алгоритмическая подготовка</li>\r\n<li>Умение писать качественный, хорошо структурированный код, опыт рефакторинга кода</li>\r\n<li>Понимание принципов работы электронной аппаратуры</li>\r\n</ul>\r\n<p><strong>Желательно:</strong></p>\r\n<ul>\r\n<li>Знание стандарта С++11, C++14</li>\r\n<li>Знание одного из скриптовых языков</li>\r\n<li>Опыт разработки под *NIX</li>\r\n<li>Опыт работы с базами данных</li>\r\n<li>Опыт использования протоколов MQTT или ZEROMQ</li>\r\n<li>Опыт кроссплатформенной разработки</li>\r\n<li>Разработка программного обеспечения для оборудования стандартов VXI, LXI, AXIe</li>\r\n</ul>', '<ul>\r\n<li>Разработка кроссплатформенной SCADA-системы на языке программирования C++ с использованием фреймворка Qt</li>\r\n<li>Анализ исходных требований, уточнение поставленных задач</li>\r\n<li>Сопровождение программных продуктов, ведение технической документации</li>\r\n</ul>', '<ul>\r\n<li>Полное соблюдение ТК РФ</li>\r\n<li>\r\n<p style=\"text-align: justify;\">Полная занятость, полный день</p>\r\n</li>\r\n</ul>', '', '0', '0', '', '', '', '2', '134', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-25 16:33:20'),
('135', '15', 'Водитель ричтрака (высотного электроштабелера)', 'Водитель ричтрака (высотного электроштабелера)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 45 000 руб.</p>', '<p><strong>Образование:</strong> среднее</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> 1 год</p>\r\n<p><strong>Необходимые навыки:</strong> Опыт работы на ричтраке от 1 года</p>\r\n<p><strong>Дополнительные требования:</strong> Наличие действующих прав тракториста-машиниста</p>', '<ul>\r\n<li>Погрузо-разгрузочные работы;</li>\r\n<li>Размещение и снятие грузов в зонах хранения.</li>\r\n</ul>', '<p>Место работы: д. Елино;</p>\r\n<p>Режим работы: 5/2 с 08:00-17:00;<br />Доставка на работу корпоративным транспортом от м. Водный стадион и ЖД станции Сходня;<br />Предоставление форменной/спецодежды.</p>', '', '0', '0', '', '', '', '2', '135', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-25 17:33:31'),
('136', '18', 'Кладовщик', 'Кладовщик', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40 000 руб.</p>', '<p>Образование: Среднее</p>\r\n<p>Опыт работы: От 1 года</p>\r\n<p>Выносливость, хорошая физическая форма.</p>\r\n<p>Знание офисных программ, знание 1С.</p>\r\n<p>Желательно наличие опыта работы с адресным хранением.</p>', '<p>• Проверка принимаемых на склад и отпускаемых со склада ТМЦ;<br />• Отслеживание сохранности находящихся на складе ТМЦ;<br />• Следить за надлежащим состоянием складских помещений;<br />• Комплектование партий отпускаемых ТМЦ в соответствии с заявками клиентов;<br />• Участие в инвентаризациях</p>', '<p>Работа в Солнечногорском районе, д. Елино.<br />Режим работы: 5/2 с 13:00-22:00;<br />Доставка на работу корпоративным транспортом от м. Водный стадион и ЖД станции Сходня;<br />Предоставление форменной/спецодежды.</p>', '', '0', '0', '', '', '', '2', '136', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-25 17:36:21'),
('137', '3', 'Бухгалтер на участок Банк-Клиент ', 'Бухгалтер на участок Банк-Клиент ', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Высшее экономическое образование;</p>\r\n<p>Опыт работы от 2х лет бухгалтером по проведению платежей или специалистом казначейства;</p>\r\n<p>Опыт работы в холдинговой структуре будет являться преимуществом;</p>\r\n<p>Знание систем Банк-клиент различных банков;</p>\r\n<p>Знание законодательства РФ в части рублевых платежей;</p>\r\n<p>Умение разносить банковские выписки по счетам бухгалтерского учета (знание плана счетов бухгалтерского учета);</p>\r\n<p>Знание бухгалтерского и налогового законодательства (в рамках данного участка работы);</p>\r\n<p>Умение работать с большим количеством информации;</p>\r\n<p>Уверенный пользователь MS Office;</p>\r\n<p>Активное участие в проектной работе;</p>\r\n<p>Знание SAP будет являться преимуществом;</p>\r\n<p>Математический склад ума, умение работать в режиме многозадачности, самостоятельность, ответственность, исполнительность, усидчивость, умение работать в команде, стрессоустойчивость, высокая скорость печати, внимательность, пунктуальность;</p>\r\n<p>Знание валютных операций и валютного законодательства как преимущество;</p>\r\n<p>Опыт работы в рамках ФЗ-275, 44 (открытие спец. счетов, работа с УФК);</p>', '<p>- Ежедневные снятия остатков по счетам в системах банк-клиент, загрузка выписок и формирование таблицы с остатками по счетам компаний;</p>\r\n<p>- Ежедневное разнесение банковских выписок в SAP компаний;</p>\r\n<p>- Платежи сотрудникам компании (з/пл, АО);</p>\r\n<p>- Учет кассовых операций;</p>\r\n<p>- Подготовка документов для банка (ежеквартально по перечням банка в рамках осуществления мониторинга за финансовым состоянием заемщика и по мере требования банка) по компании;</p>\r\n<p>- Прочие операции (размещение денежных средств на депозитных счетах в банках, гарантии, аккредитивы, получение выписок, справок и т. д. по мере необходимости);</p>\r\n<p>- Печать и архивирование банковских выписок, счетов на оплату, платежных поручений, контроль за наличием оригиналов указанных документов;</p>\r\n<p>- Взаимозаменяемость по банковским валютным операциям;</p>', '<p>Место работы: г. Химки, Вашутинское ш., корпоративный транспорт от м. Речной вокзал, Планерная, ж/д ст. Химки (15 минут от станции);</p>\r\n<p>Полная занятость, полный день;</p>\r\n<p>Оформление согласно ТК РФ;</p>\r\n<p>Бесплатные обеды в офисе;</p>\r\n<p>ДМС (включая стоматологию);</p>\r\n<p>Мобильная связь;</p>\r\n<p>Компенсация занятий спортом;</p>\r\n<p>Обучение;</p>\r\n<p>Возможность участия в пенсионной программе.</p>', '', '0', '0', '', '', '', '2', '137', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-26 12:00:16'),
('138', '15', 'Инженер по снабжению и кооперации', 'Инженер по снабжению и кооперации', 'Зеленоград', '0', '1970-01-01', '', '', '<p>30 000 - 40 000 руб.</p>', '<p>Образование средне-специальное (техническое), желательно высшее;</p>\r\n<p>Опыт работы от 5 лет в сфере закупок и кооперации;</p>\r\n<p>Знание основ механообработки, чтение чертежей;</p>\r\n<p>Опыт успешных переговоров;</p>\r\n<p>Личный автомобиль;</p>\r\n<p>Желательно наличие наработанной базы поставщиков и предприятий-производителей;</p>\r\n<p>Мобильность, энергичность;</p>', '<p>Отслеживание остатков на складе, планирование объемов закупок, осуществление закупок;</p>\r\n<p>Поиск и оценка поставщиков;</p>\r\n<p>Поиск предприятий-производителей, оценка качества выпускаемой ими продукции, проведение переговоров об условиях сотрудничества, о размещении производственного заказа (в основном механические детали);</p>\r\n<p>Отслеживание сроков и качества выполнения заказов;</p>', '<p>Оформление по ТК РФ, полный соц. пакет;</p>\r\n<p>График работы с 9:00 до 18:00, 5/2;</p>\r\n<p>Местные командировки (Москва, МО).</p>', '', '0', '0', '', '', '', '2', '138', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-26 15:17:28'),
('139', '7', 'IT - Специалист', 'IT - Специалист', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт администрирования MS Windows Server, VMWare ESXi Server;<br />Опыт работы с внешними провайдерами.<br />Свободное владение письменным и устным русским и английским языками;<br />Microsoft Windows Server 2008/2012/2016 и клиентская ОС Windows 7-10;<br />VMWare ESXi Server;<br />1С Предприятие (как преимущество);<br />Microsoft SQL Server (как преимущество);<br />Symantec Backup Exec;<br />PowerShell (основы);<br />Основы работы в сети (Wi-Fi, WAN, LAN, DNS, DHCP, VPN, Firewall);<br />Устранение неполадок оборудования (ноутбуки, настольные компьютеры, серверы);<br />Практические навыки в рамках лучших практик методологии ITIL.<br />Ориентация на бизнес и результат;<br />Аналитический склад ума;<br />Способность работать как в команде, так и самостоятельно;<br />Организованность;<br />Способность работать в режиме многозадачности;</p>', '<p>Обеспечение поддержки конечного пользователя (2-й уровень);<br />Поддержка местной инфраструктуры (в сотрудничестве с глобальными командами инфраструктуры);<br />Содействие реализации местных и глобальных проектов (развертывание);<br />Предлагать и участвовать в повышении производительности IT-сервисов, чтобы обеспечить превосходное качество работы и высокий уровень удовлетворенности клиентов;<br />Способствовать постоянному улучшению, внедряя стандарты с общей целью повышения эффективности;<br />Знание документов, связанных с местной инфраструктурой;<br />Консультация конечных пользователей по поводу инструментов на рабочем месте (включая написание инструкций);<br />Проведение тренингов для конечных пользователей;<br />Способствовать оптимизации расходов на местную инфраструктуру;<br />Ведение активов оборудования (прием / отправка товаров, обновление базы данных инвентаризации и т. д.);<br />Участвовать в закупках IT;<br />Взаимодействовать с внешними провайдерами;</p>', '<p>Работа в офисе в Химках;</p>\r\n<p>Конкурентная заработная плата + годовой бонус;<br />Медицинская страховка (включая стоматолога);<br />Оплата мобильной связи;<br />Бесплатные обеды в офисе;<br />Корпоративный транспорт от м. Речной вокзал, Планерная, ж/д ст. Химки (15 минут от станции);<br />Возможность участия в пенсионной программе;<br />Обучение (включая английский).</p>', '', '0', '0', '', '', '', '2', '139', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-28 10:18:06'),
('140', '17', 'Водитель (машинист, оператор) автокрана (манипулятора)', 'Водитель (машинист, оператор) автокрана (манипулятора)', 'Москва, м. Беговая', '0', '1970-01-01', '', '', '<p>70 000 рублей</p>', '<table class=\"table-to-div\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tbody>\r\n<tr>\r\n<td width=\"25%\">\r\n<p class=\"graytext\">Образование</p>\r\n</td>\r\n<td>\r\n<p>Среднее специальное</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td>\r\n<p class=\"graytext\">Опыт работы</p>\r\n</td>\r\n<td>\r\n<p>От 3 лет</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td>\r\n<p class=\"graytext\">Водительские права</p>\r\n</td>\r\n<td>\r\n<p>Категории B, C</p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td valign=\"top\">\r\n<p class=\"graytext\">Требования</p>\r\n</td>\r\n<td>\r\n<p>- Среднее профессиональное образование;<br />- Наличие удостоверения машиниста автокрана;<br />- Наличие водительского удостоверения с разрешающими категориями;<br />- Знание ПДД;<br />- Ответственность;<br />- Работоспособность;<br />- Коммуникабельность.<br />- Знать правила технической эксплуатации техники</p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>', '<p>В компанию, занимающуюся общестроительными работами и прокладкой инженерных коммуникаций СРОЧНО требуется Машинист / оператор / водитель на автокран (на базе КамАЗа).<br />Объекты по Москве.</p>', '<p>- заработная плата от 70 000 руб.</p>\r\n<p>- график работы: 5/2, с 8-00 до 17-00, перерыв на обед 1 час</p>\r\n<p>- оформление по ТК</p>\r\n<p>- оплачиваемые отпуска, больничные</p>\r\n<p>- корпоративный транспорт от ст. м. Беговая, развозящий работников по объектам строительства</p>', '', '0', '0', '', '', '', '2', '140', '*', '0', '0000-00-00 00:00:00', '479', '2019-06-28 18:13:16'),
('141', '18', 'Водитель-экспедитор', 'Водитель-экспедитор', 'Долгопрудный', '0', '1970-01-01', '', '', '<p>от 40 000 до 50 000 руб. на руки.</p>', '<p><strong>Образование:</strong> среднее-специальное;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 3-6 лет;</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>- Водительские права категории В, С;</p>\r\n<p>- Опыт экспедирования грузов от 1 года;</p>\r\n<p>- Знание правил дорожного движения;</p>\r\n<p>- Хорошее знание Москвы и Московской области.</p>', '<p>Доставка продукции клиентам, указанным в накладных; <br />Проверка правильности и качества загрузки машины; <br />Отслеживание сохранности продукции в процессе доставки; <br />Отпуск продукции.</p>', '<p>Автомобиль IVECO, Лада Ларгус;<br />Оформление в соответствии с ТК РФ;<br />Полная занятость, полный день.</p>', '', '0', '0', '', '', '', '2', '141', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-10 11:48:07'),
('142', '14', 'Менеджер по работе с клиентами', 'Менеджер по работе с клиентами', 'Долгопрудный', '0', '1970-01-01', '', '', '<p>от 30 000 до 40 000 руб. на руки.</p>', '<p><strong>Образование:</strong> высшее;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1-3 года;</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>- Хорошее знание компьютера;<br /> - Знание 1С.</p>', '<p>- Активный поиск клиентов;<br /> - Работа с уже существующими клиентами;<br /> - Принятие и обработка заказов с интернет-магазина.</p>', '<p><strong>Социальные льготы:</strong> Оформление в соответствии с ТК РФ;</p>\r\n<p><strong>Режим работы:</strong> Полная занятость (5/2), полный день (8 часов);</p>\r\n<p><strong>Командировки:</strong> нет.</p>', '', '0', '0', '', '', '', '2', '142', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-10 12:02:09'),
('143', '14', 'Торговый представитель на своём транспорте', 'Торговый представитель на своём транспорте', 'Долгопрудный', '0', '1970-01-01', '', '', '<p>от 45 000 руб. + процент от продаж</p>', '<p><strong>Образование:</strong> среднее-специальное;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1 года;</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>- Наличие прав категории B;</p>\r\n<p>- Наличие собственного автомобиля;</p>\r\n<p>- Приветствуется наличие своей базы клиентов по направлению: отопление, водопровод, сантехника, канализация;</p>\r\n<p><strong>ПК: </strong>Уверенный пользователь ПК.</p>', '<p>- Активный поиск клиентов на строительных рынках;<br />- Раздача каталогов компании;<br />- Сбор визиток продавцов;<br />- Договор с продавцами и доставка мелкого товара;<br />- Ведение клиентской базы (будет предоставлено рабочее место в офисе с компьютером);</p>', '<p>Адрес: Московская обл., городской округ Мытищи, деревня Грибки;</p>\r\n<p>Социальные льготы: Оформление в соответствии с ТК РФ;<br />Режим работы: 5/2, 9.00 - 18.00.</p>', '', '0', '0', '', '', '', '2', '143', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-11 15:58:03'),
('144', '15', 'Кладовщик с функциями менеджера по снабжению', 'Кладовщик с функциями менеджера по снабжению', 'Королев', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: среднее и выше<br />Опыт работы: от 5 лет<br />От кандидаток (кандидатов) на данную позицию требуется твердый характер, навыки организационной и исполнительной работы (коллектив преимущественно мужской).<br />Без вредных привычек!<br />На предлагаемой должности требуются ответственность, скрупулезность в хранении ТМЦ, ведении учета и выдаче материалов.</p>', '<p>Работа на производственном объекте (заводе) в окрестностях г. Королев (Ярославский проезд).<br />- Отслеживание материалов / оборудования на складе, дополнительный заказ необходимого для обеспечения беспрерывного процесса производства.<br />- Частичная работа с поставщиками ЛКМ и расходных материалов (помощь начальнику отдела снабжения).<br />- Приемка и распределение поступивших материалов и ТМЦ в складских помещениях.<br />- Учет и контроль за выдачей и расходованием мат.ценностей.<br />- Соблюдение норм и правил хранения. <br />- Проведение инвентаризации.</p>', '<p>В компанию, занимающуюся специальными строительными работами, защитой конструкций (огнезащитой, теплоизоляцией, антикоррозионной защитой металла) и промышленной очисткой требуется специалист на должность Кладовщик с функциями менеджера по снабжению.<br />Предлагаемый график работы: 5 дней в неделю с 8-00 до 17-00.<br />Заработная плата: обсуждается на собеседовании и зависит от квалификационных характеристик кандидата.<br />Слаженный и ответственный коллектив.<br />Перспективы карьерного роста.</p>', '', '0', '0', '', '', '', '2', '144', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-12 18:30:44'),
('145', '15', 'Разнорабочий / Рабочий склада', 'Разнорабочий / Рабочий склада', 'Зеленоград', '0', '1970-01-01', '', '', '<p>40 000 рублей</p>', '<p>Образование: среднее и выше<br />Необходимый стаж работы по специальности: не важен<br />Необходимые навыки: исполнительность, аккуратность, готовность к физическим нагрузкам. <br />Желательно, но не обязательно наличие прав на вождение погрузчика.<br />Желательно без вредных привычек!</p>', '<p>Выполнение указаний старшего сотрудника на производстве светлых наливных нефтепродуктов (масляные и парафиновые эмульсии), таких как получение сырья со склада, работа с переливанием материалов из емкостей, транспортировка по складу. Транспортировка тяжестей не предполагается.</p>', '<p>В зеленоградскую компанию (д. Елино), занимающуюся производством масляных и парафиновых эмульсий требуются сотрудники на позицию Разнорабочий / Рабочий склада. <br />Заработная плата: фиксированная часть - 25-30 тысяч рублей (в зависимости от квалификации кандидата) + премии (в зависимости от загруженности работой и переработок).<br />Оформление по ТК РФ. <br />Испытательный срок - 2 месяца.<br />Есть возможность карьерного развития в компании по направлениям - работа на складе, производство, ремонтная бригада. <br />Помещение на производстве без запаха.<br />На территории производства есть своя столовая, средняя стоимость обеда - 300 рублей, есть компенсация питания (50%).<br />Режим работы: 5/2, с 8:00 до 17:00. </p>', '', '0', '0', '', '', '', '2', '145', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-12 18:31:52'),
('146', '5', 'Помощница по хозяйству с функцией няни', 'Помощница по хозяйству с функцией няни', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>300 руб. в час.<br />Бензин или проезд на общественном транспорте оплачивается отдельно.</p>', '<p><strong>Образование:</strong> среднее и выше</p>\r\n<p><strong>Стаж работы и профессиональный опыт:</strong> от 5-ти лет</p>\r\n<p><strong>Конкретные навыки и умения:</strong></p>\r\n<p>- опыт работы в семьях в аналогичной должности;</p>\r\n<p>- опыт и умение работы с детьми, знание развивающих программ, хозяйственность, умение готовить;</p>\r\n<p>- желательно наличие личного транспорта;</p>', '<p>Уход и присмотр за ребенком в возрасте 2-х лет:<br />- развивающие занятия с ребенком, <br />- прогулки, <br />- кормление, <br />- помощь с приготовлением пищи для ребенка, <br />- утюжка детских вещей;<br />Выполнение мелких поручений по хозяйству;</p>', '<p>Работа в загородном доме, большая территория для прогулок.</p>\r\n<p>Адрес: Солнечногорский район, д. Якиманское.<br />Режим работы: 5\\2 с 9:00 до 17:00 (возможно позже). <br />Может потребоваться иногда выйти в субботу или воскресенье.<br />Питание предоставляется.</p>', '', '0', '0', '', '', '', '2', '146', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-16 15:49:45'),
('147', '17', 'Сметчик / Расчетчик (светопрозрачные конструкции, фасады)', 'Сметчик / Расчетчик (светопрозрачные конструкции, фасады)', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее строительное / архитектурное / иное высшее техническое<br />Необходимый стаж работы по специальности: от 2-х лет<br />Необходимые навыки: работа в специализированных программах Логикаль и Шукаль (желательно), знание разных систем профилей.<br />Знание общих нормативных требований (ГОСТ, СНиП).<br />ПК: MS (Word, Excel, PowerPoint), LogiKal<br />Рекомендуется наличие водительского удостоверения и личного автомобиля.</p>', '<p>- Расчет стоимости конструкций, составление смет по проектам.<br />- Работа с поставщиками, формирование заявок на закупку профиля, комплектующих.<br />- Расчеты конструкций и их элементов на нагрузки и воздействия.<br />- Подготовка документации в цех.<br />- Полное техническое сопровождение заказа до сдачи объекта.</p>', '<p>Заработная плата: по результатам собеседования и в зависимости от квалификационных характеристик кандидата<br />Социальные льготы: Оформление по ТК РФ. Полный соц. пакет. Корпоративный транспорт по г. Солнечногорску.<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00, обеденный перерыв с 12-00 до 13-00.</p>', '', '0', '0', '', '', '', '2', '147', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-17 13:22:29'),
('148', '15', 'Инженер-конструктор (светопрозрачные металлоконструкции, фасады)', 'Инженер-конструктор (светопрозрачные металлоконструкции, фасады)', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее строительное / архитектурное / иное техническое<br />Опыт работы с алюминиевыми конструкциями, фасадами - не менее 2-х лет.<br />Знание расчетных и конструкторских программ. <br />Умение читать и разбираться в строительных нормах и правилах, ТУ, технических регламентах. <br />Умение разрабатывать рабочую документацию на фасады здания, как в составе ОПР, так и в составе полного комплекта рабочих чертежей (монтажных схем, раскладок и т.д.)<br />ПК: MS (Word, Excel, PowerPoint), AutoCAD, LogiKal<br />Рекомендуется наличие личного автомобиля.</p>', '<p>На производство солнечногорского филиала международной компании, занимающейся изготовлением светопрозрачных алюминиевых металлоконструкций требуется специалист на позицию Инженер-конструктор.<br />В обязанности будут входить:<br />- Проектирование светопрозрачных алюминиевых конструкций.<br />- Расчет материалов и комплектующих для проекта;<br />- Разработка полного комплекта чертежей КМ, КМД, выпуск спецификаций.<br />- Взаимодействие с архитекторами, проектировщиками, строителями по техническим вопросам проектов;<br />- Контроль над выполнением проектной документации в соответствии с ТЗ;<br />- Выезды на объекты.</p>', '<p>Заработная плата: обсуждается на собеседовании.<br />Место работы: Солнечногорск.<br />График работы: 5/2 (Пн-Пт), 8:00-17:00, обеденный перерыв - с 12:00 до 13:00.<br />Оформление по ТК РФ. Есть корпоративный транспорт по г. Солнечногорск.<br />Есть перспективы карьерного роста.<br />Возможны командировки.</p>', '', '0', '0', '', '', '', '2', '148', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-17 16:38:31'),
('149', '18', 'Менеджер по логистике ', 'Менеджер по логистике ', 'Химки', '0', '1970-01-01', '', '', '<p>45 000 руб.</p>', '<p><strong>Образование:</strong> Высшее;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1-го года в релевантной должности (на позиции, связанной с административной работой). Опыт работы в логистике не обязателен;</p>\r\n<p><strong>Необходимые навыки:</strong> высокая степень внимательности и аккуратности;</p>\r\n<p><strong>Знание иностранного языка:</strong> разговорный английский язык (уровень Intermediate и выше) – письменная корреспонденция;</p>\r\n<p><strong>ПК:</strong> свободное владение PC (MS Office);</p>\r\n<p><strong>Дополнительные требования:</strong> собранные, внимательные кандидаты, готовые интенсивно работать.</p>', '<p>Работа с экспресс-службами;<br />Оформление документов;<br />Упаковка и отправка грузов;<br />Ведение базы данных;<br />Ведение переписки на английском языке.</p>', '<p>Работа в г. Химки, Доставка корпоративным транспортом от ж/д станции Химки;<br />Официальное трудоустройство;<br />Режим работы: 5/2, с 9.00 до 18.00.</p>', '', '0', '0', '', '', '', '2', '149', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-17 17:16:50'),
('150', '15', 'Оператор линии поверхностного монтажа/Оператор линии SMD', 'Оператор линии поверхностного монтажа/Оператор линии SMD', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40 000 до 50 000 руб. на руки</p>', '<p>- Среднее специальное образование (техническое);<br />- Опыт работы от 3 лет;<br />- Умение читать конструкторскую документацию;<br />- Знание маркировки радиоэлектронных компонентов;<br />- Базовые знание технологического процесса;<br />- Умение работать с различным автоматизированным оборудованием;</p>', '<p>- Автоматизированный монтаж печатных плат;<br />- Подготовка и корректировка программ для оборудования, используемого в линии;<br />- Приемка комплектации и зарядка питателей установщика;<br />- Контроль качества монтажа на рабочем месте;<br />- Проведение регламентных работ по оборудованию;</p>', '<p>- Оформление по ТК РФ, полностью белая заработная плата на карту Сбербанка (от 40 до 50 тыс. руб. на руки);<br />- Режим работы: посменный;<br />- Перспективы профессионального и карьерного роста;<br />- Бесплатные обеды;<br />- Легкая транспортная доступность;<br />- Дружный коллектив;</p>', '', '0', '0', '', '', '', '2', '150', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-18 12:26:40'),
('151', '15', 'Инженер-конструктор (приборостроение)', 'Инженер-конструктор (приборостроение)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По результатам собеседования</p>', '<p>Высшее профильное образование<br />Опыт работы: от 2х лет<br />Знание SolidWorks, ЕСКД, желательно опыт проектирования кабелей и жгутов.</p>', '<p>Разработка конструкторской документации для электронных приборов (сборки приборов, корпуса, кронштейны для крепления приборов, кабели, жгуты) <br />Проверка исполнителей<br />Конструкторское сопровождение своих разработок в производстве.</p>', '<p>Место работы: Зеленоград.<br />Заработная плата (размер и форма оплаты): по результатам собеседования<br />Предполагаются премии. Возможны подработки.<br />Социальные льготы: трудоустройство по ТК РФ, полный соц. пакет<br />График работы: 5/2, с 9:00 до 18:00 или с 8:00 до 17:00.</p>', '', '0', '0', '', '', '', '2', '151', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-19 09:50:31'),
('152', '5', 'Повар в семью', 'Повар в семью', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>- Образование: высшее;<br />- Стаж работы и профессиональный опыт: не менее 10 лет, работа в семьях;<br />- 4, 5 поварской разряд;<br />- Знание техники приготовления здорового питания близкого к диете;<br />- Умение готовить мясо: баранина, говядина, свинина, каре ягненка; <br />- Умение готовить овощные супы и гарниры;<br />- Наличие медицинской книжки, диплом об образовании, отзывы с предыдущего места работы;<br />- Желательно наличие водительских прав;</p>', '<p>- Приготовление пищи для одного человека;<br />- Приготовление завтрака и обеда, подача блюд;<br />- Закупка продуктов;<br />- Соблюдение санитарно-гигиенических норм в процессе приготовления пищи и посуды, личная гигиена.</p>', '<p>- График работы: 5/2 (возможны дополнительные выходы в выходные), с 9:00 до 16:00;<br />- Еженедельная оплата труда (от 3000 до 5000 руб.), подарки, премии;</p>', '', '0', '0', '', '', '', '2', '152', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-19 16:23:58'),
('153', '20', 'Специалист по подбору персонала', 'Специалист по подбору персонала', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>- Образование: высшее;<br />- Опыт в подборе персонала от 2-х лет;<br />- Хорошие коммуникативные навыки, навыки ведения переговоров;<br />- Нацеленность на результат;<br />- Знание английского языка на уровне не ниже Intermediate;</p>\r\n<p>От потенциального сотрудника будут ожидать:<br />- Повышение удовлетворенности клиентов;<br />- Умение убеждать;<br />- Аналитический и рассудительный подход к работе;<br />- Умение быстро адаптироваться и реагировать на изменения;<br />- Умение работы в команде;</p>', '<p>- Наем подходящих кандидатов на соответствующие позиции, оперативно обеспечивающий поддержку бизнес-стратегии;<br />- Выполнение рекрутинговых мероприятий для удовлетворения потребностей бизнеса;<br />- Взаимодействие с HR-менеджерами (на тему должностных инструкций, профилей, скрининга резюме, процесса собеседования, переговоров по предложению работы кандидатам / job-offer, проверки рекомендаций и рекрутинговых мероприятий компании);<br />- Ведение кандидатов по вакансиям, отслеживание процесса до момента приема кандидата на работу в компанию и не передачи документации по новому сотруднику в HR-отдел;<br />- Сотрудничество с рекрутинговыми агентствами;</p>\r\n<p>Прочие функции:<br />- Способствование формированию положительного отношения к компании путем информативного, профессионального и ориентированного на клиента взаимодействия с клиентами / кандидатами;<br />- Выполнение других кадровых и рекрутинговых задач;</p>', '<p>- Место работы: г. Химки;<br />- Корпоративный транспорт от м. Речной вокзал, Планерная, ж/д ст. Химки (15 минут от станции);<br />- Полная занятость, полный день;<br />- Оформление согласно ТК РФ;<br />- Бесплатные обеды в офисе;<br />- Медицинская страховка (включая стоматолога);<br />- Оплата мобильной связи;<br />- Компенсация занятий спортом;</p>', '', '0', '0', '', '', '', '2', '153', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-19 16:59:55'),
('154', '15', 'Начальник производства (производство парафиновой эмульсии)', 'Начальник производства (производство парафиновой эмульсии)', 'д. Елино', '0', '1970-01-01', '', '', '<p>На испытательный срок (2 месяца) - 60 000 руб., после прохождения испытательного срока – до 80 000 руб.;</p>', '<p>- Образование: высшее (химик-технолог);<br />- Необходимый стаж работы по специальности: 1-2 года;<br />- Уверенный пользователь ПК (Microsoft Office, Excel);<br />- Умение работать в программе 1C: Производство.</p>', '<p>В подчинении начальника производства четыре бригады рабочих по три человека в бригаде;</p>\r\n<p>В обязанности начальника производства будет входить:<br />- Формирование смены/Контроль передачи смены/Организация подмены внутри смены/При необходимости начальник сам должен подменить операторов в смене;<br />- Ответственность за стандарт качества при выпуске смеси (эмульсия);<br />- Контроль технической безопасности;<br />- Ведение журналов;<br />- Сдача отчёта один раз в месяц;<br />- KPI;</p>\r\n<p>- Подача сырья на линию в реактор;<br />- Перемешивание сырья в реакторе и доведение его до реакционного состояния, проведение процесса;<br />- Контроль, охлаждение и складирование готовой продукции.</p>\r\n<p>Дополнительная информация: <br />- Есть свой химик-технолог;<br />- Есть начальник лаборатории по совместительству инженер по ТБ.</p>', '<p>Адрес: Московская область, Солнечногорский район, д. Елино;<br />Режим работы: 5/2, с 9 до 18<br />Заработная плата (размер и форма оплаты): на испытательный срок (2 месяца) - 60 000 руб., после прохождения испытательного срока – до 80 000 руб.;<br />Оформление по ТК РФ;<br />Столовая на территории предприятия.</p>', '', '0', '0', '', '', '', '2', '154', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-22 09:44:02'),
('155', '15', 'Электрик-монтажник', 'Электрик-монтажник', 'Королёв', '0', '1970-01-01', '', '', '<p>70 000 рублей</p>', '<p>Образование: Среднее специальное</p>\r\n<p>Опыт работы: От 3 лет</p>\r\n<p>Хороший опыт в монтаже.</p>\r\n<p>Группа электробезопасности - 3-я, 4-я.</p>', '<p>На производство компании, занимающейся специальными строительными работами, нанесением антикоррозионной защиты на металлоконструкции и промышленной очисткой, требуется Электрик-монтажник с хорошим опытом, не ниже 3-ей группы электробезопасности.<br />В обязанности будет входить монтаж, подключение электропитания по задокументированным и устным инструкциям.</p>', '<p>Производство в г. Королев (Ярославский проезд)<br />График работы: 5/2, с 8-00 до 17-00<br />Заработная плата: среднее значение - 70 тысяч рублей, обсуждается на собеседовании и зависит от квалификационных характеристик кандидата<br />Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '155', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-22 17:39:30'),
('156', '18', 'Водитель погрузчика/ричтрака', 'Водитель погрузчика/ричтрака', 'Поварово', '0', '1970-01-01', '', '', '<p>47 000 рублей до вычета НДФЛ</p>', '<p>Образование: среднее специальное и выше<br />Необходимый стаж работы по специальности: от 1 года опыт работы водителем погрузчика и ричтрака (опыт работы с автокомпонентами будет являться преимуществом)<br />Необходимые навыки: <br />• удостоверение категории B нового образца на управление спецтехникой<br />• внимательность, ответственность, готовность к обучению, умение работать в команде<br />ПК: желательно умение работать со сканером (ТСД)</p>', '<p>• Управление электропогрузчиком, ричтраком, буксировочным оборудованием с прицепным подвижным составом<br />• Погрузка, разгрузка автокомпонентов<br />• Сбор заказов<br />• Размещение продукции на складе<br />• Работа с терминалами сбора данных</p>', '<p>\"Белая\" заработная плата; выплачивается стабильно 2 раза в месяц, 47 000 рублей (до налогообложения)<br />Социальные льготы: <br />Оформление согласно ТК РФ<br />Полный рабочий день на территории работодателя<br />Испытательный срок составляет 3 месяца с момента выхода на работу<br />Спецодежда предоставляется<br />Корпоративная развозка из г. Клин, Солнечногорска, Зеленограда.<br />Режим работы: 5/2 (график работы с 07:00 до 16:00, с 1 сентября с 16:00 до 00:25)</p>', '', '0', '0', '', '', '', '2', '156', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-22 17:43:24'),
('157', '15', 'Инженер-конструктор (МСК) (светопрозрачные металлоконструкции, фасады)', 'Инженер-конструктор (МСК) (светопрозрачные металлоконструкции, фасады)', 'Москва, м. Дубровка', '0', '1970-01-01', '', '', '<p>100 000 рублей</p>', '<p>Образование: высшее строительное / архитектурное / иное техническое<br />Опыт работы с алюминиевыми конструкциями, фасадами - не менее 2-х лет.<br />Знание расчетных и конструкторских программ. <br />Умение читать и разбираться в строительных нормах и правилах, ТУ, технических регламентах. <br />Умение разрабатывать рабочую документацию на фасады здания, как в составе ОПР, так и в составе полного комплекта рабочих чертежей (монтажных схем, раскладок и т.д.)<br />ПК: MS (Word, Excel, PowerPoint), AutoCAD, LogiKal</p>', '<p>В представительство филиала международной компании, занимающейся изготовлением светопрозрачных алюминиевых металлоконструкций требуется специалист на позицию Инженер-конструктор.<br />В обязанности будут входить:<br />- Проектирование светопрозрачных алюминиевых конструкций.<br />- Расчет материалов и комплектующих для проекта;<br />- Разработка полного комплекта чертежей КМ, КМД, выпуск спецификаций.<br />- Взаимодействие с архитекторами, проектировщиками, строителями по техническим вопросам проектов;<br />- Контроль над выполнением проектной документации в соответствии с ТЗ;<br />- Выезды на объекты.</p>', '<p>Заработная плата: среднее значение - 100 000 руб., обсуждается на собеседовании и зависит от квалификационных характеристик кандидата.<br />Место работы: Москва, улица Шарикоподшипниковская, ближайшее метро - Дубровка.<br />График работы: 5/2 (Пн-Пт), 8:00-17:00, обеденный перерыв - с 12:00 до 13:00.<br />Оформление по ТК РФ. <br />Есть перспективы карьерного роста.<br />Возможны командировки.</p>', '', '0', '0', '', '', '', '2', '157', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-22 18:11:07'),
('158', '14', 'Менеджер отдела продаж', 'Менеджер отдела продаж', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата на испытательный срок - от 40 000 руб. После успешного прохождения испытательного срока суммарный доход в месяц при выполнении личного плана и общего плана всего предприятия - от 100 000 руб.</p>', '<p>В активно растущую высокотехнологичную компанию, один из лидеров рынка контрактного производства, требуется менеджер в отдел продаж.</p>\r\n<p>- Высшее образование;</p>\r\n<p>- Желателен опыт в продажах услуг производственных предприятий, особенно в высокотехнологичных сферах. Таких как производство электроники, элементной базы, создание программного обеспечения и систем связи. Стаж работы - от 3 лет.<br />- Высокая ответственность за результаты своего труда;<br />- Коммуникабельность;<br />- Знание технологий продаж;<br />- Умение преподнести себя;<br />- Умение составлять презентации под вновь возникающие задачи;<br />- Умение планировать продажи и добиваться исполнение плана;<br />- Умение работать в программах: 1С, пакет Microsoft Office, почтовые программы, и т.д;<br />- Желательно навыки работы со специализированным ПО - ALTIUM или PCAD, CAM viewer на уровне просмотра документов.</p>', '<p>- Привлечением новых клиентов;<br />- Расширение клиентской базы, в том числе поиск новых ниш, где искать клиентов;<br />- Выезд к клиентам (не реже 2 раз в неделю). Основные регионы - Москва, Московская область, Санкт-Петербург, Екатеринбург, крупные города Европейской части;<br />- Ежемесячная отчетность.</p>', '<p>- График работы: с 9:00 до 18:00;<br />- Перерыв на обед 1 час; <br />- В офисе предусмотрены бесплатные обеды;<br />- Заработная плата (полностью белая): оклад + бонус за выполнение личного плана + бонус за выполнение плана всего предприятия; <br />- Испытательный срок - 3 месяца; <br />- Заработная плата на испытательный срок - от 40 000 руб. После успешного прохождения испытательного срока суммарный доход в месяц при выполнении личного плана и общего плана всего предприятия - от 100 000 руб.;<br />- Молодой коллектив; <br />- Отсутствие текучки кадров;<br />- Обучение персонала при приеме;<br />- Постоянное повышение квалификации после прохождения испытательного срока.</p>', '', '0', '0', '', '', '', '2', '158', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-24 16:08:05'),
('159', '15', 'Заместитель начальника ОТК', 'Заместитель начальника ОТК', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Высшее образование;</p>\r\n<p>Стаж работы по специальности: от 3х лет;</p>\r\n<p>Необходимые навыки:<br />• Умение работать с ТД и КД (умение читать чертежи, схемы);<br />• Знание порядка производства изделий, основных технологических процессов производства;<br />• Знание ПК и умение работать на нем;<br />• Умение работать с электроизмерительным оборудованием;</p>\r\n<p>Личные качества: <br />• Внимательность<br />• Ответственность<br />• Стрессоустойчивость</p>', '<p>• Ведение \"Рабочего дела изделия\"<br />• Проведение предъявительских и приемосдаточных испытаний;<br />• Оформление приемных актов и протоколов испытаний, выполнение работ по профилактике брака;<br />• Подготовка (при необходимости) предъявительских документов для ВП и предъявление изделий ВП;<br />• Классификация брака на обслуживаемом участке по видам, установление причин его возникновения и своевременное принятие мер к его устранению <br />• Производить внешний осмотр, технический контроль качества, готовых изделий на соответствие требованиям чертежей, ТУ, стандартов на сборочном участке;<br />• Проводить проверку сопроводительной документации на поставляемую продукцию, удостоверяющую ее качество; <br />• Осуществлять контроль за изоляцией несоответствующей продукции;<br />• Участвовать в исследовании дефектов, выявленных при контроле качества, испытаниях и в разработке мероприятий по устранению и предупреждению этих дефектов;<br />• Участие (при необходимости) в упаковке изделий и их отгрузке потребителю;</p>', '<p>Режим работы: 5/2;</p>\r\n<p>Заработная плата (размер и форма оплаты): по результатам собеседования;<br />Испытательный срок: до 3-х месяцев;<br />Социальные льготы: в соответствии с ТК РФ.<br /><br /></p>', '', '0', '0', '', '', '', '2', '159', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-25 14:48:58'),
('160', '15', 'Радиомонтажник', 'Радиомонтажник', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40 000 руб.</p>', '<p>В компанию, которая занимается производственно-научная деятельностью, разработкой и производством радиоэлектронной аппаратурой и светотехническим оборудованием на основе светодиодов требуется \"Радиомонтажник\".</p>\r\n<p>Образование: среднее специальное;</p>\r\n<p>Опыт работы в аналогичной должности - от 3х лет;<br />Умение читать электрические схемы.</p>', '<p>Проверка, наладка, диагностика и ремонт импульсных блоков питания и источников тока.</p>', '<p>График работы: 5/2;<br />Заработная плата: по результатам собеседования (от 40 000 тысяч рублей);<br />Испытательный срок: 3 месяца;</p>', '', '0', '0', '', '', '', '2', '160', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-25 15:35:10'),
('161', '15', 'Слесарь-сборщик РЭА', 'Слесарь-сборщик РЭА', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35 000 руб.</p>', '<p>В компанию, которая занимается производственно-научная деятельностью, разработкой и производством радиоэлектронной аппаратурой и светотехническим оборудованием на основе светодиодов требуется \"Слесарь-сборщик РЭА\".</p>\r\n<p>Образование: среднее специальное;</p>\r\n<p>Необходимый стаж работы по специальности: от 3 лет в аналогичной должности;<br />Личные качества: <br />• Внимательность;<br />• Ответственность;<br />• Аккуратность.</p>', '<p>Сборка отверткой, доводка напильником, надфилем, покраска деталей и приборов РЭА;<br />Чтение чертежей.</p>', '<p>Заработная плата (размер и форма оплаты): 35 000 руб.;<br />Испытательный срок: до 3-х месяцев;<br />Социальные льготы: в соответствии с ТК РФ;<br />Режим работы: 5/2.</p>', '', '0', '0', '', '', '', '2', '161', '*', '0', '0000-00-00 00:00:00', '479', '2019-07-25 15:48:54'),
('162', '15', 'Монтажник РЭА', 'Монтажник РЭА', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Сдельная оплата, по результатам собеседования</p>', '<p>В активно растущую высокотехнологичную компанию, один из лидеров рынка контрактного производства, требуется \"Монтажник РЭА\"</p>\r\n<p>Образование: среднее специальное;<br />Необходимый стаж работы по специальности: от 1,5 лет;</p>\r\n<p>Необходимые навыки: <br />Опыт работы в аналогичной должности;<br />Умение читать электрические схемы;</p>', '<p>Монтаж радиоэлектронной аппаратуры;</p>', '<p>Заработная плата (размер и форма оплаты): сдельная оплата, по результатам собеседования;<br />Испытательный срок: 2-3 месяца;<br />Социальные льготы: по ТК РФ;<br />Режим работы: 5/2 с 9 до 18.</p>', '', '0', '0', '', '', '', '2', '162', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-06 11:27:34'),
('163', '1', 'Наладчик стекольных автоматов', 'Наладчик стекольных автоматов', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>Договорная (по результатам собеседования);</p>', '<p>Образование: среднее специальное;<br />Необходимый стаж работы по специальности: от 3-х лет;<br />Необходимые навыки: Опыт работы со стекольными станками/автоматами. <br />Без вредных привычек; <br />Ответственный;<br />С желанием работать; <br />Желательно наличие водительского удостоверения;</p>', '<p>- Наладка, ремонт и профилактический осмотр;<br />- Проверка исправности узлов и механизмов;<br />- Подналадка механизмов в процессе работы;<br />- Определение износа;<br />- Смена изношенных деталей и узлов механизмов;</p>', '<p>Место работы: г. Солнечногорск;</p>\r\n<p>Заработная плата (размер и форма оплаты): Договорная (по результатам собеседования);<br />Социальные льготы: Оформление по ТК РФ;<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17.00, обеденный перерыв с 12.00 до 13.00.</p>', '', '0', '0', '', '', '', '2', '163', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-06 12:16:38'),
('164', '6', 'Личный повар директора компании', 'Личный повар директора компании', 'Зеленоград', '0', '1970-01-01', '', '', '<p>На испытательный срок (1,5 -2 месяца) - 30 000 руб.; После прохождения испытательного срока – 40 000 руб;</p>', '<p>Образование: среднее, среднее специальное;<br />Необходимый стаж работы по специальности: от 5 лет;<br />Необходимые навыки: <br />Умение готовить вкусную, домашнюю еду;<br />Чистоплотность;<br />Пунктуальность; <br />Вежливость;</p>', '<p>Приготовление завтрака, обеда, иногда кофе для директора компании;</p>', '<p>Заработная плата (размер и форма оплаты): на испытательный срок (1,5 -2 месяца) - 30 000 руб.; После прохождения испытательного срока – 40 000 руб;<br />Режим работы: 5/2, с 9-00 до 17-00;<br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '164', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-07 11:17:17'),
('165', '15', 'Инженер ПТО', 'Инженер ПТО', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>Договорная (по результатам собеседования);</p>', '<p>Образование: Среднее специальное;<br />Необходимый стаж работы по специальности: от 3-х лет;<br />ПК: Уверенный пользователь; <br />Высокая степень ответственности, активность, работоспособность, исполнительность, внимательность и умение сосредоточиться на выполнении конкретной задачи;<br />Умение профессионального чтения проектной документации;<br />Хорошее знание AutoCAD, MS Office, 1С — (желательно);<br />Опыт работы в проектных организациях или взаимодействие с ними - приветствуется!</p>', '<p>Подготовка исполнительной документации;<br />Подготовка необходимой документации к приемке;<br />Работа со службами заказчика;<br />Проверка объемов выполненных работ;<br />Подсчет объемов по чертежам.<br />Осуществление проверки документации;<br />Подготовка необходимых данных для составления отчетности о выполнении работ;<br />Подготовка ведомостей объемов работ, учет объемов выполненных работ;<br />Составление ведомостей объемов работ на дополнительные работы, <br />а также сравнительные ведомости объемов работ;<br />Осуществление документального надзора за выполнением проектных решений;<br />Контроль сроков и качества работ;<br />Взаимодействие со смежными отделами.</p>', '<p>Место работы: г. Солнечногорск;<br />Заработная плата (размер и форма оплаты): Договорная (по результатам собеседования);<br />Социальные льготы: Оформление по ТК РФ;<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00, обеденный перерыв с 12-00 до 13-00.</p>', '', '0', '0', '', '', '', '2', '165', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-07 12:54:24'),
('166', '15', 'Специалист по поддержке', 'Специалист по поддержке', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 рублей (по результатам собеседования);</p>', '<p>Образование: высшее техническое образование;<br />Необходимый стаж работы по специальности: от 2-х лет;<br />Необходимые навыки: <br />- Умение ясно выражать мысли в письменной и устной форме;<br />- Умение работать в режиме многозадачности, обучаемость, стрессоустойчивость, коммуникабельность, пунктуальность, ответственность;<br />- Уверенный пользователь ПК;<br />- Знание английского языка на удовлетворительном уровне;<br />- Опыт работы в технической поддержке как серьезное преимущество.</p>', '<p>- Прием и обработка обращений по вопросам технической поддержки по телефону и по почте;<br />- Консультирование по вопросам, связанным с установкой, настройкой и эксплуатацией оборудования;<br />- Консультирование конечных пользователей, технических служб заказчиков, а также менеджеров по продажам по оборудованию и техническим решениям;<br />- Написание технических инструкций для пользователей;<br />- Подготовка спецификаций, описаний и иной технической документации, необходимой для презентации продукции и решений.</p>', '<p>Заработная плата (размер и форма оплаты): от 40000 рублей (по результатам собеседования);<br />Социальные льготы: <br />- Трудоустройство и соц. пакет в соответствии с ТК РФ, мед. страховка;<br />- Работа в стабильной, динамично развивающейся международной компании;<br />Режим работы: Полный рабочий день, работа в офисе в центре Зеленограда.</p>', '', '0', '0', '', '', '', '2', '166', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-13 13:01:37'),
('167', '5', 'Уборщица офиса', 'Уборщица офиса', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35000 руб.</p>', '<p>Образование: среднее<br />Необходимый стаж работы по специальности: от 2-х лет<br />Необходимые навыки: <br />- Опыт работы уборщицей/горничной;<br />- Чистоплотность, пунктуальность, вежливость.</p>', '<p>Уборка офисного помещения площадью 350 м2 (чистое), санузел - 18м2, комната приема пищи - 16м2. </p>\r\n<p>Ежедневно выбрасывать мусор, мыть пол, поливать цветы, вытирать пыль (раз в 2 недели), убираться в санузле, на кухне.</p>', '<p>Социальные льготы: Оформление как самозанятый.<br />Режим работы: Ежедневно (пн.- пт.) с 18.00 до 21.00, работа в офисе в центре Зеленограда.</p>', '', '0', '0', '', '', '', '2', '167', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-15 15:34:02'),
('168', '3', 'Бухгалтер по авансовым отчетам', 'Бухгалтер по авансовым отчетам', 'Шереметьево', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее профильное образование (бух учет, анализ и аудит).<br />Опыт работы по специальности: от 2х лет.<br />Понимание основ бухгалтерского учета (корреспонденция счетов, виды первичных документов) и налогообложения.<br />Знание компьютера: на уровне уверенного пользователя. Уверенное владение 1С.<br />Иностранные языки: английский как преимущество.</p>', '<p>Работа с первичной документацией на участке авансовые отчеты<br />Учет расчетов с подотчетными лицами (по командировкам и служебным поездкам)<br />Контроль своевременного предоставления и правильности оформления АО по командировкам сотрудников<br />Контроль своевременного перечисления аванса и возмещения перерасхода средств подотчетным лицам<br />Проверка документов, подтверждающих расходы сотрудников в служебных поездках<br />Проверка документов и корректное отражение в 1С расходов по приобретению вспомогательных материалов с последующей компенсацией по авансовому отчету<br />Своевременное внесение данных в 1С<br />Инвентаризация расчетов с подотчетными лицами</p>', '<p>В американскую компанию-лидера разработки и производства дизельных двигателей требуется специалист на позицию Бухгалтер по авансовым отчетам по временному контракту до декабря 2019 г.<br />Месторасположение компании: Шереметьево, микрорайон Клязьма.<br />График работы: 5/2, с 9-00 до 18-00.<br />Размер заработной платы: обсуждается на собеседовании.<br />Есть корпоративный транспорт до и от места работы - ст.м. Войковская, Сходненская, Ховрино, Речной вокзал; Зеленоград. <br />Оформление по временному договору.<br />Срок контракта - с сентября по декабрь 2019 г.</p>', '', '0', '0', '', '', '', '2', '168', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-15 17:42:44');
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('169', '15', 'Менеджер отдела качества / Специалист по сертификации', 'Менеджер отдела качества / Специалист по сертификации', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата на испытательный срок (срок 2 месяца) 45 000 - 50 000 руб.;</p>', '<p>В компанию, которая является крупнейшим поставщиком электронно-компонентной базы на российском рынке требуется \"Менеджер отдела качества / Специалист по сертификации\".</p>\r\n<p>- Оконченное высшее образование (техническое);<br />- Опытный пользователь ПК:<br />- Знание законодательства РФ и Таможенного Союза в области подтверждения соответствия;<br />- Знание требований ТР ТС (004, 010, 020) и правил проведения сертификации продукции;<br />- Знание требований ГОСТ Р ИСО 9001-2015;<br />- Опыт работы в области сертификации продукции;<br />- Английский язык (средний уровень владения);<br />- Необходимый стаж работы по специальности: 3-6 лет.</p>', '<p>Проведение работ по сертификации продукции по требованиям ТР ТС и ГОСТ Р (опыт от 3 - лет):<br />- Прием заявок на сертификацию от подразделений компании;<br />- Подготовка и подача документов в государственные органы и органы по сертификации;<br />- Участие в подготовке технической документации (технических описаний на продукцию);<br />- Участие в отборе образцов, отправка на исследования образцов продукции;<br />- Согласование макетов документов и протоколов испытаний к ним с органами по сертификации;<br />- Контроль сроков действия оформленных разрешительных документов;<br />Поддержание и совершенствование действующей системы менеджмента качества (опыт от 3 - лет): <br />- Описание бизнес-процессов и ведение документации СМК;<br />- Участие во внутренних и внешних аудитах СМК;<br />- Учет рекламаций от потребителей;<br />- Оформление рекламаций поставщикам.</p>', '<p>- Уровень подчинения (место в структуре): непосредственный начальник подразделения;<br />- Заработная плата на испытательный срок (срок 2 месяца) 45 000 - 50 000 руб.;<br />- Режим работы: 5 дней, пн - пт, с 9 до 18;<br />- Социальные льготы : бесплатный обед, кофе, чай в офисе, возможность посещать спорт секцию по баскетболу, тренинги, корп. праздники,  подарки детям на НГ.</p>', '', '0', '0', '', '', '', '2', '169', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-19 10:24:44'),
('170', '4', 'Клиентский менеджер с опытом рекрутмента ', 'Клиентский менеджер с опытом рекрутмента ', 'Москва', '0', '1970-01-01', '', '', '<p>Заработная плата: оклад + бонус, совокупный доход обсуждается с кандидатом на собеседовании.</p>', '<p>Ищем клиентского менеджера в проект, управляющий большой сетью кадровых агентств (вся Россия и страны ЕврАзЭс). Заказчики – крупные холдинги со значительным объемом подбора персонала, исполнители – сотни кадровых агентств по всей России. Проект является уникальным для России, основан на использовании современного подхода к решению масштабных задач подбора – MSP (managed service provider. Целевая задача проекта – обеспечение процесса подбора от 3 до 10 тыс. человек в год. Задача кандидата - быть единым контактным лицом как для работодателей, так и для рекрутинговых агентств с ответственностью за конечный результат <br />(трудоустройство кандидатов).</p>\r\n<p>- Подтвержденный опыт 1–3 года рекрутером;<br />- Хорошие коммуникативные навыки, способность эффективно общаться и выстраивать отношения как с заказчиками, так и с агентствами;<br />- Работа с большим количеством писем и звонков без упущений и ошибок;<br />- Ориентированность на результат.</p>', '<p>- Коммуникация с заказчиками и кадровыми агентствами по всем вопросам в режиме \"одного окна\" (снятие вакансии, логистика кандидатов, обратная связь, контроль документов/оплат);<br />- Организация работы агентств (выстраивание процесса работы, обучение, анализ присланных резюме на релевантность и т.п.);<br />- Использование CRM для ведения всех процессов, наполнение CRM данными.</p>', '<p>- График работы: 5/2 (ненормированный рабочий день), выходные суббота и воскресенье; <br />- Оформление согласно ТК РФ, трудовой договор;<br />- Испытательный срок: 3 месяца;<br />- Заработная плата: оклад + бонус, совокупный доход обсуждается с кандидатом на собеседовании;<br />- Место работы: Москва, м. Красносельская.</p>\r\n<p>Преимущества работы в компании:<br />1.Интересная и опытная команда с опытом реализации серьезных проектов в HR <br />(Олимпиада в Сочи, аутстаффинг на 35 тыс. человек);<br />2. Полезные знакомства в сфере HR за счет обширных контактов акционеров;<br />3. Работа в испытывающей бум индустрии HR Tech;<br />4. Обучение, личностное развитие, карьерный рост в рамках проекта федерального масштаба;<br />5. Уникальный и разносторонний опыт в подборе/оценке (любые позиции, географии, индустрии).</p>', '', '0', '0', '', '', '', '2', '170', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-21 09:52:50'),
('171', '4', 'Ведущий консультант по поиску и оценке персонала управленческого звена', 'Ведущий консультант по поиску и оценке персонала управленческого звена', 'Москва', '0', '1970-01-01', '', '', '<p>Заработная плата: оклад + премии за закрытые вакансии.</p>', '<p>- Опыт работы в рекрутменте от 5 лет;<br />- Прекрасное владение инструментами прямого поиска;<br />- Активный и профессиональный пользователь социальных сетей;<br />- Опыт работы с крупными клиентами (ведение переговоров, развития отношений, подготовки отчетов и аналитики);<br />- Грамотная русская речь, хорошие коммуникационные навыки;<br />- Владение инструментами оценки – интервью по компетенции, центр оценки;<br />- Ориентация – активная и многозадачная, самостоятельная работа, профессиональный рост и материальное благополучие.</p>', '<p>- Полный цикл подбора персонала - от взятия заявки и формирования профиля до участия в подготовке оффера;<br />- Развитие ключевых клиентов, получение новых заказов в работу, предоставление консалтинга и прочее;<br />- Мониторинг рынка туда по целевым позициям;<br />- Работа самостоятельная или в паре с сорсером.</p>', '<p>- График работы: 5/2, выходные суббота и воскресенье;<br />- Оформление согласно ТК РФ, трудовой договор, неограниченный рабочий день, + 2 дня к отпуску, начало рабочего дня плавающее – с 8.00 до 9.30 в зависимости от удобства работника;<br />- Заработная плата: оклад + премии за закрытые вакансии;<br />- Испытательный срок: 3 месяца;<br />- Место работы: Москва, м. Красносельская.</p>\r\n<p>Преимущества работы в компании:<br />- Официальное трудоустройство по ТК РФ;<br />- Официальная заработная плата 2 раза в месяц;<br />- Работа в центре Москвы;<br />- Стабильность бизнеса (компания существует и ежегодно растет с 2011 года);<br />- Работа с крупными компаниями, известными брендами, уровневыми заказами по подбору ключевого, управленческого звена – финансовых директоров, генеральных директоров, директоров по логистике и проч. N-1/ N-2 уровень, что определяет уровень общения;<br />- Прямой контакт с Заказчиками, уровень общения Генеральный директор, акционер, директор по персоналу, директор по рекрутменту;<br />- Значительное корпоративное обучение, мероприятия и спорт;<br />- Вертикальное и горизонтальное развитие в компании, возможность работать на разных позициях и на разных проектах.</p>', '', '0', '0', '', '', '', '2', '171', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-21 10:35:06'),
('172', '4', 'Менеджер по развитию ключевых клиентов', 'Менеджер по развитию ключевых клиентов', 'Москва', '0', '1970-01-01', '', '', '<p>Заработная плата: оклад + бонус, обсуждается с кандидатом на собеседовании.</p>', '<p>- Высшее образование;<br />- Не менее 5 лет успешных прямых продаж;<br />- Структурированность и системность, аналитический склад ума;<br />- Ориентация на заработок и работу с интеллектуальными продуктами;<br />- Амбициозность в плане уровня общения и рабочего сообщества;<br />- Грамотная речь, отличные коммуникативные навыки – возможность выступать на круглых столах;<br />- Быстрота;<br />- Желание развиваться в продажах и общем управлении, работать с крупными брендами <br />и заказчиками.</p>', '<p>Развитие бизнеса (продажа подбора и оценки персонала, программ по развитию персонала, оценки рынка, крупных аутсорсинговых услуг, и проч) путем:<br />- Развития текущих крупных Заказчиков (уровень Росатома, Сбербанка и проч.);<br />- Ведение крупных тендеров;<br />- Поиск потенциальных крупных, федеральных клиентов через холодные звонки;<br />- Участие в разработке комплексных продуктов.</p>', '<p>- График работы: 5/2 (ненормированный рабочий день), выходные суббота и воскресенье;<br />- Оформление согласно ТК РФ, трудовой договор;<br />- Заработная плата: оклад + бонус, обсуждается с кандидатом на собеседовании;<br />- Испытательный срок: 3 месяца;<br />- Место работы: Москва, м. Красносельская;<br />- Подчинение / место в структуре: подчинение Операционному Директору; <br />- Подчиненные – матричные (консультанты-исполнители).</p>\r\n<p>Преимущества работы в компании:<br />- официальное трудоустройство по ТК РФ;<br />- «белая» заработная плата 2 раза в месяц;<br />- значительное корпоративное обучение, мероприятия ;<br />- офис в центре Москвы (м. Красносельская);<br />- полный пакет услуг в сфере HR (комплементарные продажи);<br />- работа с интересными заказчиками – личностное и профессиональное развитие через отрасль и продукты;<br />- современное рабочее место – laptop, оплата мобильной связи и проч.;<br />- отличный и результативный коллектив;<br />- возможность карьерного продвижения.</p>', '', '0', '0', '', '', '', '2', '172', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-21 11:17:47'),
('173', '14', 'Менеджер по продажам', 'Менеджер по продажам', 'Москва', '0', '1970-01-01', '', '', '<p>Заработная плата: оклад + бонус, обсуждается с кандидатом на собеседовании.</p>', '<p>- Высшее образование;<br />- Не менее 1 года опыта холодных звонков;<br />- Грамотная речь, отличные коммуникативные навыки;<br />- Желание развиваться в продажах, работать с крупными брендами и заказчиками.</p>', '<p>Развитие бизнеса (продажа тренингов, оценки персонала, программ по развитию персонала, оценки рынка и проч) путем:<br />- Поиск потенциальных клиентов через холодные звонки; <br />- Работа с входящими запросами;<br />- Развитие текущих клиентов.</p>', '<p>- График работы: 5/2 (ненормированный рабочий день), выходные суббота и воскресенье;<br />- Оформление согласно ТК РФ, трудовой договор;<br />- Заработная плата: оклад + бонус, обсуждается с кандидатом на собеседовании;<br />- Испытательный срок: 3 месяца;<br />- Место работы: Москва, м. Красносельская;<br />- Подчинение/ место в структуре: подчинение Операционному Директору.</p>\r\n<p>Преимущества работы в компании: <br />- официальное трудоустройство по ТК РФ;<br />- «белая» заработная плата 2 раза в месяц;<br />- значительное корпоративное обучение, мероприятия;<br />- офис в центре Москвы (м. Красносельская);<br />- полный пакет услуг в сфере HR (комплементарные продажи);<br />- работа с интересными заказчиками – личностное и профессиональное развитие через отрасль и продукты;<br />- современное рабочее место – laptop, оплата мобильной связи и проч.;<br />- отличный и результативный коллектив;<br />- возможность карьерного продвижения.</p>', '', '0', '0', '', '', '', '2', '173', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-21 11:46:37'),
('174', '7', 'Аналитик информационных систем', 'Аналитик информационных систем', 'Москва', '0', '1970-01-01', '', '', '<p>Заработная плата: оклад + бонус (20% от годового оклада, 1 раз в год).</p>', '<p>- Высшее профессиональное - техническое (информационные технологии, автоматика, информатика); <br />- Опыт работы: не менее 2 лет в сфере анализа и обработки данных, внедрения и сопровождения информационных систем и баз данных; <br />- Свободное владение PL/SQL, SQL, OLAP<br />- Опыт работы с аналитическими системами и хранилищами данных;<br />- Опыт работы с большими объемами данных, понимание основ построения СУБД Oracle - основная (знание других СУБД - IBM DB2, MSSQL, PostgreSQL и др. – приветствуется).<br />- Знание Linux на уровне «продвинутый пользователь» будет плюсом;<br />- Английский язык – хороший уровень (письменный и разговорный).</p>', '<p>- Поддержка и развитие информационных систем Бюро (БКИ, Антифрод, Риск-CRM, B2C, DQM, коннеторов и API интеграции;<br />- Построение выборок данных из БД, необходимых для разработки новых продуктов (совместно со специалистами департамента продуктов), а также для анализа текущей работы систем.<br />- Составление и анализ требований, анализ спецификаций и технической документации по ИС Бюро;<br />- Разработка методик и процедур для выгрузки аналитических отчетов в различных ИС;<br />- Анализ ошибок в информации, предоставляемой клиентами для загрузки в системы;<br />- Поддержка клиентов в процессе эксплуатации ИС Бюро по сложным техническим вопросам, выходящим за рамки компетенции Службы поддержки.</p>', '<p>- График работы: График 5/2, выходные суббота и воскресенье;<br />- Оформление согласно ТК РФ, трудовой договор;<br />- Заработная плата: оклад + бонус (20% от годового оклада, 1 раз в год); <br />- Испытательный срок: 3 месяца;<br />- Место работы: Москва, м. Новокузнецкая;</p>\r\n<p>Преимущества работы в компании:<br /> - официальное трудоустройство по ТК РФ;<br />- «белая» заработная плата 2 раза в месяц;<br />- значительное корпоративное обучение, мероприятия;<br /> - опыт работы в компании с западной корпоративной культурой;<br /> - творческий коллектив с нешаблонным мышлением и яркой корпоративной жизнью.</p>', '', '0', '0', '', '', '', '2', '174', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-21 12:12:56'),
('176', '15', 'Специалист по системе менеджмента качества (СМК)', 'Специалист по системе менеджмента качества (СМК)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: Высшее <br />Необходимый стаж работы по специальности: от 5-х лет<br />Необходимые навыки: <br />• высшее образование по специальности: \"Управление качеством\",<br />• желательно высшее техническое образование (полиграфическое),<br />• умение работать с нормативными документами, технической документацией,<br />• знание ИСО 9001-2015,<br />• технический склад ума<br />ПК: Продвинутый уровень.</p>', '<p>В зеленоградскую компанию, специализирующуюся на полиграфическом и голографическом производстве, требуется Специалист по системе менеджмента качества (СМК).</p>\r\n<p>Должностные обязанности: <br />• Внедрение и поддержание системы менеджмента качества в производстве голографической продукции,<br />• Разработка, оформление и ведение документации. (основные документы имеются, на начальном этапе – подготовка к предсертификационному аудиту со стороны консалтинговой компании, после получения сертификата ISO 9001 возможно совмещение должности технолога)<br />• Организация и проведение внутренних и внешних аудитов. Контроль за соблюдением СМК.</p>', '<p>Заработная плата: обсуждается на собеседовании и зависит от квалификационных характеристик кандидата.<br />Оформление по ТК РФ<br />Режим работы: 5/2, с 9 до 17.30 </p>', '', '0', '0', '', '', '', '2', '176', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-27 17:58:11'),
('177', '4', 'Технический директор (системы безопасности, бизнес-мониторинг)', 'Технический директор (системы безопасности, бизнес-мониторинг)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее<br />Опыт работы: от 3 лет<br />Навыки:<br />• Опыт управления R&amp;D, связанной с разработкой аппаратно-программных систем в направлении систем безопасности, компьютерного зрения, встраиваемых систем;<br />• Опыт создания и разработки распределенных систем (центр мониторинга, диспетчерского центра, агрегации потоков видео);<br />• Опыт взаимодействия с заказчиком, и работы с ожиданиями заказчиков;<br />• Опыт взаимодействия с госорганами в части определения требований к техническим решениям;<br />• Опыт внедрения и реализации крупных федеральных долгосрочных проектов;<br />• Опыт постановки на производство вновь разработанных изделий;<br />• Отстройки ОТК.</p>', '<p><br />• Выбор технологических и архитектурных решений для продуктов Компании;<br />• Формирование стратегии развития продуктов с точки зрения финансовых, временных и других аспектов;<br />• Планирование и построение процессов продуктовой разработки;<br />• Распределение задач между командами;<br />• Формирование продуктовых стратегий и отслеживание их реализации;<br />• Обеспечение темпа и качества продуктовой разработки на максимальном уровне;<br />• Управление технологическими рисками.</p>', '<p>• просторный офис в экологически чистом районе Москвы (г. Зеленоград) рядом с лесом и водоемом;<br />• работа на современном оборудовании (высокопроизводительные компьютеры, большие мониторы и т.д.);<br />• оформление по ТК РФ;<br />• полностью белая заработная плата;<br />• профильные конференции, семинары.</p>', '', '0', '0', '', '', '', '2', '177', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-27 18:09:11'),
('178', '5', 'Няня-воспитатель', 'Няня-воспитатель', 'Черная Грязь', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>- педагогическое образование, опыт работы воспитателем или учителем;<br />- опыт работы в семьях в аналогичной должности;<br />- умение работать с детьми, готовность к активному времяпрепровождению, ответственность, умение готовить;<br />- желательно наличие личного автомобиля.<br />Наличие официальных документов (диплом, лицензия и т.д.): документ о высшем образовании, наличие трудовой книжки с указанием опыта работы в образовательных или дошкольных учреждениях</p>', '<p>Присмотр за детьми (2 девочки в возрасте 6 и 8 лет) и исполнение обязанностей по уходу и воспитанию:<br />- Забирать детей из школы после уроков;<br />- Помогать в решении домашних заданий, следить за полным их выполнением;<br />- Вести образовательные занятия в игровом формате (развивающие игры, рисование, чтение);<br />- Сопровождать на дополнительные занятия, прогулки;<br />- Кормить (готовить или разогревать уже готовое) (обед, полдник, ужин).<br />Ожидаемый выход работника на работу - 1.10.2019.</p>', '<p>Работа на постоянной основе в районе д. Черная Грязь.<br />Имеется возможность добраться до места работы на общественном транспорте от Лобни, Шереметьево, Сходни. <br />Режим работы: полный рабочий день (15.00 до 20.00), возможно изменение количества рабочих часов в день по обстоятельствам. <br />Воскресенье - выходной. По обстоятельствам выходной в субботу. <br />Заработная плата: обсуждается с успешным кандидатом. <br />При использовании работником личного автомобиля оплата ГСМ.</p>', '', '0', '0', '', '', '', '2', '178', '*', '0', '0000-00-00 00:00:00', '479', '2019-08-28 12:27:49'),
('179', '2', 'Секретарь генерального директора', 'Секретарь генерального директора', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40 000 руб.</p>', '<p>Опыт работы секретарем руководителя высшего звена от 3-х лет;<br />Желание и способность работать в режиме многозадачности;<br />Способность держать в голове и оперировать большими объемами информации;<br />Внимательность, хорошая память;<br />Аккуратность, любовь к чистоте и порядку - обязательно;<br />Системность мышления;<br />Знание делового этикета;<br />Умение сервировать стол;<br />Пунктуальность;<br />Неконфликтность;<br />Стессоустойчивость;<br />Возможность задерживаться на работе по необходимости (нечасто).</p>', '<p>Прием, регистрация и обработка входящей корреспонденции;<br />Регистрация, обработка и отправка исходящей корреспонденции;<br />Ведение учета документооборота по всей деловой корреспонденции предприятия;<br />Ведение внутреннего документооборота в полном объеме, ведение реестра по внутреннему и внешнему документообороту;<br />Вычитка и корректирование исходящих писем;<br />Протоколирование совещаний;<br />Контроль исполнения распоряжений директора сотрудниками предприятия;<br />Информационное взаимодействие со всеми структурными подразделениями предприятия;<br />Подготовка к приемам и встреча гостей;<br />Контроль своевременного заказа канцелярии, расходных материалов, воды;<br />Контроль уборки офиса, поддержание чистоты в кабинете директора;<br />Тревел-поддержка всех командируемых сотрудников предприятия - приобретение билетов, бронирование гостиниц и др.;<br />Выдача наличных на оперативные/хозяйственные нужды подотчетным лицам, ведение отчетности по расходуемым средствам;<br />Иные поручения руководителей;</p>', '<p>Город: Зеленоград<br />Заработная плата: от 40 000 руб.<br />Трудоустройство в соответствии с ТК РФ, \"белая\" заработная плата.<br />График работы: пн-пт. 8:45-18:00.</p>', '', '0', '0', '', '', '', '2', '179', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-05 17:32:12'),
('181', '5', 'Семейная пара', 'Семейная пара', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>80 000 руб.</p>', '<p><strong>Образование:</strong> среднее специальное</p>\r\n<p><strong>Стаж работы и профессиональный опыт:</strong> от 3-х лет</p>\r\n<p><strong>Конкретные навыки и умения:</strong></p>\r\n<p>- опыт работы в семьях в аналогичной должности;</p>\r\n<p>- у мужа должны быть действующие права категории В, он должен быть исполнительным, со знаниями работы по дому, чтобы смог произвести мелкий ремонт;</p>\r\n<p>- жена должна уметь готовить;</p>\r\n<p>Спокойные, ответственные, доброжелательные, внимательные к деталям люди.</p>', '<p>Требуется семейная пара с проживанием в частный дом, участок 25 соток.</p>\r\n<p>В мужские обязанности входит:</p>\r\n<p>- поездки в магазин на машине;</p>\r\n<p>- работа по дому (мелкий ремонт);</p>\r\n<p>- работа по участку (уборка снега, стрижка газона и растительности);</p>\r\n<p>- уход за территорией и растительностью.</p>\r\n<p>В женские обязанности входит:</p>\r\n<p>- приготовление пищи;</p>\r\n<p>- сухая и влажная уборка;</p>\r\n<p>- знание бытовой химии и бытовой техники;</p>\r\n<p>- уход за одеждой и обувью;</p>\r\n<p>- стирка, глажка.</p>', '<p><strong>Адрес:</strong> д. Мышецкое, Солнечногорский район Московской области</p>\r\n<p>Работа на постоянной основе с проживанием (для проживания отводится обустроенный двухэтажный гараж, есть спальня, душ, кухня). Если нет своей машины, то она предоставляется.<br />Не нормированный рабочий день. Предоставляется выходной и отпуск.<br />Условия оплаты труда и другие мотивации: 80 000 руб. (по договоренности есть возможность получать 100 000 руб. если дополнительно взять работу по соседнему участку, 15 соток).</p>', '', '0', '0', '', '', '', '2', '181', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-09 13:51:38'),
('182', '5', 'Няня', 'Няня', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p><strong>Образование:</strong> среднее специальное</p>\r\n<p><strong>Стаж работы и профессиональный опыт:</strong> от 5 лет</p>\r\n<p><strong>Конкретные навыки и умения:</strong></p>\r\n<p>- Опыт работы в семьях в аналогичной должности;</p>\r\n<p>- Наличие рекомендаций с прежних мест работы;</p>\r\n<p>- Наличие прав категории В и личного автомобиля;</p>\r\n<p>- Знание развивающих программ приветствуется.</p>', '<p>- Уход и развитие ребёнка, девочка 2,2 года;<br />- Отвозить ребёнка на занятия и забирать с них на автомобиле; <br />- Развивающие занятия с ребёнком;<br />- Игры, прогулки; <br />- Уборка за ребёнком (игрушки, одежда, коляску помыть);<br />- Кормление, иногда приготовление простой пищи для ребёнка.</p>', '<p>Работа в Зеленограде, в МЖК.</p>\r\n<p>График Работы: Полный рабочий день (5/2 с 9.00 до 19.00), с возможностью раньше/позже/выходные.<br />В следующем году семья планирует переезд в частный дом (20 минут от Зеленограда), с няней будет обсуждаться возможность работы с проживанием. </p>', '', '0', '0', '', '', '', '2', '182', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-09 16:04:16'),
('183', '2', 'Офис-менеджер', 'Офис-менеджер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40000 рублей (по результатам собеседования).</p>', '<p>Образование: высшее образование (желательно техническое);<br />Необходимый стаж работы по специальности: от 2-х лет;<br />Необходимые навыки: <br />- Технический склад ума;<br />- Ответственность, исполнительность, коммуникабельность, быстрая обучаемость; <br />- Умение работать в режиме многозадачности; <br />- Грамотная устная и письменная речь; <br />- Умение ясно выражать мысли;<br />- Уверенный пользователь ПК, MS Office;<br />- Отсутствие вредных привычек.<br />Знание иностранного языка: базовое знание английского языка.</p>', '<p>- Прием и распределение звонков;<br />- Деловая переписка;<br />- Консультации клиентов по продуктам компании;<br />- Консультирование по вопросам, связанным с установкой, настройкой и эксплуатацией оборудования;<br />- Прием, регистрация, хранение, учет и рассылка корреспонденции;<br />- Обеспечение жизнедеятельности офиса (заказ воды, канцелярии, и т.п.);<br />- Организация приема посетителей (встреча, чай-кофе).</p>', '<p>Заработная плата (размер и форма оплаты): от 40000 рублей (по результатам собеседования). <br />Социальные льготы: <br />- Трудоустройство и соц. пакет в соответствии с ТК РФ, мед. страховка<br />- Работа в стабильной, динамично развивающейся международной компании;<br />Режим работы: Полный рабочий день, работа в офисе в центре Зеленограда.</p>', '', '0', '0', '', '', '', '2', '183', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-11 12:29:44'),
('184', '5', 'Няня к грудничку', 'Няня к грудничку', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Требуется няня к грудничку (девочка).</p>\r\n<p>Опыт работы в семьях в аналогичной должности;<br />Наличие рекомендаций с прежних мест работы.</p>', '<p>Уход за грудным ребенком.</p>', '<p>Работа в Зеленограде.<br />График работы: 2 часа в день 5 дней в неделю.</p>', '', '0', '0', '', '', '', '2', '184', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-11 15:55:11'),
('185', '15', 'Оператор станка с ЧПУ', 'Оператор станка с ЧПУ', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 50 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Оператор станка с ЧПУ.</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1 года;</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>Опыт работы на производстве (деревообработка);</p>\r\n<p>Опыт работы на станке с ЧПУ аналогичным Rover A.</p>', '<p>- Работа на станке с ЧПУ (Rover A);<br />- Обслуживание станка (наладка станка, контроль качества, написание и корректировка станочных программ, подготовка файлов для работы на станке);<br />- Обработка и деревообрабатывающая присадка под фурнитуру.<br />Уровень подчинения (место в структуре): Директору производства.</p>', '<p>Место работы: г. Солнечногорск;</p>\r\n<p>Режим работы: 5/2, 2/2, 14/14;<br />Предоставляется питание, проживание (вахтовый метод), профессиональный мед.осмотр (1 раз в год), спецодежда (после прохождения ИС).</p>', '', '0', '0', '', '', '', '2', '185', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-12 13:32:21'),
('186', '15', 'Прессовщица', 'Прессовщица', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 30 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Прессовщица.</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1 года.</p>\r\n<p><strong>Необходимые навыки: </strong>Опыт работы на производстве приветствуется.</p>', '<p>- Проклеивание материалов для дверей;<br />- Подача под пресс;<br />- Начинение дверей внутренними материалами.<br />Уровень подчинения (место в структуре): Директору производства.</p>', '<p>Место работы: г. Солнечногорск;<br />Режим работы: 5/2, 2/2, 14/14;<br />Предоставляется питание, проживание (вахтовый метод), профессиональный мед.осмотр (1 раз в год), спецодежда (после прохождения ИС).</p>', '', '0', '0', '', '', '', '2', '186', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-12 13:57:51'),
('187', '15', 'Станочник', 'Станочник', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 35 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Станочник.</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 1 года.</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>Опыт работы на производстве (деревообработка);</p>\r\n<p>Опыт работы на станках обязателен.</p>', '<p>- Изготовление изделий из МДФ, ДСП и массива на станочном оборудовании (кромкооблицовочный, фрезерный, четырехсторонний строгальный);<br />- Обслуживание станка;<br />- Контроль качества изготавливаемой продукции;<br />- Работа с технической документацией и чертежами.<br />Уровень подчинения (место в структуре): Директору производства.</p>', '<p>Место работы: г. Солнечногорск;<br />Режим работы: 5/2, 2/2, 14/14;<br />Предоставляется питание, проживание (вахтовый метод).</p>', '', '0', '0', '', '', '', '2', '187', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-12 16:07:30'),
('188', '15', 'Столяр-сборщик, столяр-краснодеревщик', 'Столяр-сборщик, столяр-краснодеревщик', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 35 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Столяр-сборщик, столяр-краснодеревщик.</p>\r\n<p>Опыт работы на производстве (деревообработка) от 1 года;<br />Опыт работы на аналогичных должностях обязателен.</p>', '<p>- Изготовление дверей;<br />- Сборка столярных изделий после станка с ЧПУ;<br />- Работа на деревообрабатывающем оборудовании;<br />- Работа с массивом, шпон, МДФ;<br />- Сборка дверей, подгон деталей, присадка, установка фурнитуры;<br />- Обработка деталей (склейка, снятие шаблонов).<br />Уровень подчинения (место в структуре): Директору производства.</p>', '<p>Место работы: г. Солнечногорск;<br />Режим работы: 5/2, 2/2, 14/14;<br />Предоставляется питание, проживание (вахтовый метод), профессиональный мед.осмотр (1 раз в год), спецодежда (после прохождения ИС).</p>', '', '0', '0', '', '', '', '2', '188', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 09:32:40'),
('189', '15', 'Шлифовщик', 'Шлифовщик', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 30 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Шлифовщик.</p>\r\n<p>Опыт работы на производстве приветствуется.</p>', '<p>- Шлифовка МДФ, шпона, массива дерева;<br />- Подготовка дверей к грунтовке, покраске;<br />- Умение использовать шлифовальный материал для деревянных поверхностей;<br />- Полировка изделия из МДФ;<br />- Работа со шпатлевкой по дереву и шпону, а также шлифмашинками;<br />- Подготовка поверхностей под покрытие.<br />Уровень подчинения (место в структуре): Директору производства.</p>', '<p>Место работы: г. Солнечногорск;<br />Режим работы: 5/2, 2/2, 14/14;<br />Предоставляется питание, проживание (вахтовый метод), профессиональный мед.осмотр (1 раз в год), спецодежда (после прохождения ИС).</p>', '', '0', '0', '', '', '', '2', '189', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 09:57:56'),
('190', '15', 'Уборщица', 'Уборщица', 'Москва', '0', '1970-01-01', '', '', '<p>1200 руб. в день.</p>', '<p>В компанию на постоянное место работы требуется уборщица.</p>\r\n<p>Понимание принципов уборки и поддержания чистоты;<br />Знание правил уборки помещения, концентрацию моющих и дезинфицирующих средств;<br />Ответственность;<br />Трудоспособность;<br />Пунктуальность.</p>', '<p>- Уборка после ремонта и строительства;<br />- Поддержание чистоты и порядка в помещениях.</p>', '<p>Работа в строительной компании: г. Москва;</p>\r\n<p>Оформление по ТК;<br />График 6/1;<br />Оклад 1200 руб./день.</p>', '', '0', '0', '', '', '', '2', '190', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 12:32:39'),
('191', '15', 'Маляр', 'Маляр', 'Москва', '0', '1970-01-01', '', '', '<p>от 55 000 руб.</p>', '<p>В компанию на постоянное место работы требуется Маляр</p>\r\n<p>Необходимо знать технологию строительных и отделочных процессов;<br />Ответственность, работоспособность, наличие опыта работы - обязательно!</p>', '<p>- Малярные работы;<br />- Подготовительные работы под покраску;<br />- Высококачественное окрашивание поверхностей кистями, валиками, механизированным инструментом, агрегатами высокого давления;<br />- Шпатлевание, грунтование поверхностей механизированным инструментом, приготовление грунтовочных и окрасочных составов по готовой рецептуре;<br />- Выполнение поручений непосредственного руководителя.</p>', '<p>Работа в строительной компании: г. Москва;<br />Хороший коллектив;<br />Оформление по ТК РФ;<br />Стабильная заработная плата, от 55 000 рублей;<br />Жилье не предоставляется;<br />График работы: 5/2 или 6/1 или 7/0 с 9 до 18 часов.</p>', '', '0', '0', '', '', '', '2', '191', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 12:37:53'),
('192', '15', 'Конструктор-разработчик', 'Конструктор-разработчик', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 50 000 до 80 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Конструктор-разработчик.</p>\r\n<p>Образование: высшее;<br />Необходимый стаж работы по специальности: от 1 года;<br />Необходимые навыки: Опыт составления КД для изделий из массива дерева, МДФ, шпона;<br />Творческий подход к созданию новых изделий;<br />Опыт работы на производстве приветствуется;<br />ПК: уверенное владение, знание конструкторских программ (Компас 3D, AutoCAD).</p>', '<p>- Разработка новых моделей по фото, эскизам, техзаданиям, самостоятельное изготовление экспериментальных образцов изделий из дерева (двери, панели, интерьерные решения и др.);<br />- Составление чертежей изделий, технической документации;<br />- Согласование с начальником производства;<br />- Сопровождение изделий, внесение изменений в чертежи, ТД при необходимости;<br />- Анализ рынка, в том числе продукции конкурентов.</p>', '<p>Место работы: г. Солнечногорск;<br />Оформление по ТК РФ;<br />Есть возможность базового обучения;<br />Режим работы: 5/2, 8-часовой рабочий день.</p>', '', '0', '0', '', '', '', '2', '192', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 14:01:05'),
('193', '15', 'Мастер смены / и.о. начальника производства', 'Мастер смены / и.о. начальника производства', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 50 000 до 80 000 руб.</p>', '<p>В компанию, которая занимается производством дверей и деревообработкой требуется Мастер смены / и.о. начальника производства.</p>\r\n<p>Образование: высшее (в сфере деревообработки и т.п.);<br />Необходимый стаж работы по специальности: от 2-х лет;<br />Необходимые навыки:<br />- Опыт работы на производстве схожего профиля желателен;<br />- Опыт руководства коллективом (до 50-ти человек).</p>', '<p>- организация работы смены;<br />- планирование работы по участкам, постановка задач;<br />- контроль выполнения задач;<br />- ведение служебной документации;<br />- отчет работы смены за период (смену, месяц и т.д.);<br />- ведение учета рабочего времени;<br />- обеспечение требований охраны труда и пожарной безопасности.</p>', '<p>Место работы: г. Солнечногорск;<br />Заработная плата (размер и форма оплаты): обсуждается на собеседовании, зависит от квалификационных характеристик кандидата; ориентировочно - от 50 000 рублей с перспективами роста до 80 000 рублей, при повышении в должности до старшего мастера и в дальнейшем - начальника производства;<br />Социальные льготы: оформление по ТК РФ, есть возможность базового обучения;<br />Режим работы: 2/2, 12-часовой рабочий день.</p>', '', '0', '0', '', '', '', '2', '193', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-13 14:12:47'),
('194', '3', 'Экономист ', 'Экономист ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>\r\n<p><span style=\"font-size: 16px;\"> </span></p>', '<ul>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><strong><span style=\"font-size: 16px;\">Навыки договорной работы;</span></strong></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><strong><span style=\"font-size: 16px;\">Опыт составления расчетно-калькуляционных материалов (РКМ);</span></strong></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><strong><span style=\"font-size: 16px;\">Понимание принципов расчета себестоимости;</span></strong></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Желателен опыт работы с НИОКР, опыт работы по ГОЗ. Знание 223 ФЗ и 44 ФЗ;</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Грамотная речь и письмо;</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Уверенное пользование ПК. Хорошее знание пакета программ MS Office (Word, Excel, Outlook);</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Желательно знание английского языка.</span></li>\r\n</ul>', '<ul>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Составление договоров, спецификаций и других приложений к договорным документам.</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Подготовка расчетно-калькуляционных материалов по договорам.</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Подготовка плановой и отчетной калькуляции по составляемой продукции.</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Подготовка писем заказчикам по различным вопросам.</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Учет заявок и ведение базы данных договоров.</span></li>\r\n<li style=\"font-family: \'arial\' , sans-serif; line-height: 1.35em; margin: 0px; padding: 8px 0px 8px 0px;\"><span style=\"font-size: 16px;\">Согласование документов с Военными представителями МО РФ.</span></li>\r\n</ul>', '<p>Заработная плата: по результатам собеседования, зависит от квалификационных характеристик кандидата.<br />Социальные льготы: оформление в соответствии с ТК РФ, \"белая\" заработная плата.<br />Режим работы: 5/2 с 9-00 до 18-00.</p>', '', '0', '0', '', '', '', '2', '194', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-16 12:43:46'),
('195', '7', 'Администратор сайта / Интернет-магазина', 'Администратор сайта / Интернет-магазина', 'Андреевка', '0', '1970-01-01', '', '', '<p>от 50 000 руб.</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Администратор сайта / Интернет-магазина\".</p>\r\n<p>Образование: Высшее;<br />Необходимый стаж работы по специальности: от 5 лет;<br />Необходимые навыки: <br />Опыт работы в интернет-магазинах (например, электронная техника / доставка цветов / продукты питания – плюс);<br />Уверенный пользователь ПК.</p>', '<p>- Полное ведение сайта интернет-магазина; <br />- Создание карточек товаров, редактирование, удаление, внесение технических показателей;<br />- Введение артикульной системы; <br />- Создание рекламных блоков т.д.;<br />- Взаимодействие с отделом маркетинга.</p>', '<p>График работы: 5/2, с 9.00 до 18.00;<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Оформление по ТК РФ; <br />Оплата телефонной связи.</p>', '', '0', '0', '', '', '', '2', '195', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-20 17:31:25'),
('196', '2', 'Менеджер интернет-магазина', 'Менеджер интернет-магазина', 'Андреевка', '2', '1970-01-01', '', '', '<p>от 35 000 руб.</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Менеджер интернет-магазина\".</p>\r\n<p>Образование: Высшее;<br />Необходимый стаж работы по специальности: от 5 лет;<br />Необходимые навыки: <br />Опыт работы в интернет-магазинах, интернет-магазины по продаже продуктов питания – плюс.</p>', '<p>- Консультирование клиентов по телефону (горячая линия интернет-магазина);<br />- Создание / редактирование заказов в CRM.<br />Дополнительная информация: Холодных звонков нет.</p>', '<p>График работы: сменный график 2/2, с 9.00 до 21.00;<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Оформление по ТК РФ;<br />Оплата телефонной связи.</p>', '', '0', '0', '', '', '', '2', '196', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-20 17:41:23'),
('197', '18', 'Начальник склада', 'Начальник склада', 'Андреевка', '0', '1970-01-01', '', '', '<p>от 60 000 руб. </p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Начальник склада\".</p>\r\n<p>Образование: Высшее;<br />Необходимый стаж работы по специальности: от 5 лет;<br />Необходимые навыки: <br />Опыт создания склада с нуля;<br />Знание норм пожарной безопасности, СЭС нормативов.</p>', '<p>- Полный контроль и обслуживание склада; <br />- Управление грузчиками и комплектовщиками;<br />- Ведение отчетности по приходу, расходу и списаниям.</p>', '<p>График работы: 5/2, с 9.00 до 18.00;<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Оформление по ТК РФ;<br />Оплата телефонной связи.</p>', '', '0', '0', '', '', '', '2', '197', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-20 17:47:41'),
('198', '15', 'Охранник', 'Охранник', 'Андреевка', '2', '1970-01-01', '', '', '<p>от 20 000 руб.</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Охранник\".</p>\r\n<p>Образование: Высшее;<br />Необходимый стаж работы по специальности: от 5 лет.</p>', '<p>- Обеспечение безопасности в офисе и складской зоне;<br />- Контроль движения сотрудников;<br />- Минимизация потерь материальный ценностей;<br />- Контроль за охранной и пожарной сигнализациями.</p>', '<p>График работы: 1/2.<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Оформление по ТК РФ;<br />Оплата телефонной связи.</p>', '', '0', '0', '', '', '', '2', '198', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-20 17:53:04'),
('199', '21', 'Специалист по работе с арендаторами (по совмещению Юрист)', 'Специалист по работе с арендаторами (по совмещению Юрист)', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: Высшее (желательно юридическое)</p>\r\n<p> </p>\r\n<p>Необходимые навыки: умение общаться и договариваться с людьми, активность, выдержанность.</p>\r\n<p>Знание иностранного языка: английский предпочтителен.</p>\r\n<p>ПК: уверенный пользователь, желательно знание 1С</p>', '<p>Взаимодействие с арендаторами.</p>\r\n<p>Правовое обеспечение деятельности организации.</p>\r\n<p>Более развернуто должностные обязанности будут обговариваться с кандидатами на собеседовании.</p>\r\n<p>Уровень подчинения (место в структуре): генеральному директору, финансовому директору, главному бухгалтеру.</p>\r\n<p> </p>', '<p>Заработная плата: обсуждается на собеседовании<br />Социальные льготы: в рамках трудового законодательства<br />Режим работы: 5/2, полный день с 9-00 до 18-00</p>', '', '0', '0', '', '', '', '2', '199', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-23 12:03:24'),
('200', '5', 'Семейная пара', 'Семейная пара', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>от 80 000 руб.</p>', '<p>Требуется семейная пара с проживанием в частный дом (500 м2), участок 40 соток. Работа на постоянной основе, предоставляется проживание.</p>\r\n<p>Опыт работы в семьях в аналогичной должности;<br />У мужа должны быть действующие права категории В, он должен быть исполнительным, со знаниями работы по дому, чтобы смог произвести мелкий ремонт;<br />Жена должна уметь готовить;<br />Оба должны хорошо ладить с животными (у хозяев на участке проживает 5 собак).<br />Спокойные, ответственные, доброжелательные, внимательные к деталям люди.</p>', '<p>В мужские обязанности входит:<br />- поездки в магазин на машине (машина предоставляется);<br />- работа по дому (мелкий ремонт);<br />- работа по участку (уборка снега, стрижка газона и растительности);<br />- уход за территорией и растительностью;<br />- уход за собаками, кормление собак.<br />В женские обязанности входит:<br />- приготовление пищи;<br />- сухая и влажная уборка;<br />- знание бытовой химии и бытовой техники;<br />- уход за одеждой и обувью;<br />- стирка, глажка;<br />- уход за собаками, кормление собак.</p>', '<p>Месторасположение: Солнечногорский район Московской области.<br />График работы: не нормированный рабочий день (обсуждается на собеседовании). Предоставляется выходной и отпуск.<br />Заработная плата: от 80 000 руб. (обсуждается на собеседовании).</p>', '', '0', '0', '', '', '', '2', '200', '*', '0', '0000-00-00 00:00:00', '479', '2019-09-24 16:13:21'),
('202', '14', 'Менеджер активных продаж', 'Менеджер активных продаж', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35 000 тыс. руб. на испытательный срок, после прохождения испытательного срока + KPI.</p>', '<p>В Зеленоградскую компанию требуется \"Менеджер активных продаж\".</p>\r\n<p>Образование: высшее;<br />Необходимый стаж работы по специальности: от 1 года;<br />ПК: Уверенный пользователь;<br />Необходимые навыки: быстрая обучаемость, коммуникабельность.</p>', '<p>Поиск, привлечение, развитие новых и существующих клиентов.</p>', '<p>Заработная плата: 35 000 тыс. руб. на испытательный срок, после прохождения испытательного срока + KPI;<br />Испытательный срок: 1 месяц;<br />График работы: 5/2, с 9.00 до 18.00;<br />Предполагаются командировки по России.</p>', '', '0', '0', '', '', '', '2', '202', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-10 10:43:46'),
('203', '18', 'Руководитель склада', 'Руководитель склада', 'Зеленоград', '0', '1970-01-01', '', '', '<p>70 000 тыс. руб. на испытательный срок, после прохождения испытательного срока заработная плата будет повышаться.</p>', '<p>В Зеленоградскую компанию требуется \"Руководитель склада\".</p>\r\n<p>Образование: высшее;<br />Необходимый стаж работы по специальности: от 1 года;<br />Уверенный пользователь ПК, знание программы 1С Склад;<br />Необходимые навыки: быстрая обучаемость, коммуникабельность.</p>', '<p>Руководство складом;<br />Управление бизнес процессами склада;<br />Корректировка работы склада;<br />Мотивация и контроль сотрудников склада.</p>', '<p>Заработная плата: 70 000 тыс. руб. на испытательный срок, после прохождения испытательного срока заработная плата будет повышаться;<br />Испытательный срок: 1 месяц;<br />График работы: 5/2, с 9.00 до 18.00 (с 8.00 до 17.00);<br />Предполагаются редкие командировки по России.</p>', '', '0', '0', '', '', '', '2', '203', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-10 11:18:35'),
('204', '20', 'Менеджер по персоналу', 'Менеджер по персоналу', 'Зеленоград', '0', '1970-01-01', '', '', '<p>35 000 тыс. руб. на испытательный срок, после прохождения испытательного срока заработная плата будет повышаться.</p>', '<p>В Зеленоградскую компанию требуется \"Менеджер по персоналу\".</p>\r\n<p>Образование: высшее;<br />Необходимый стаж работы по специальности: от 2х лет;<br />ПК: Уверенный пользователь;<br />Необходимые навыки: быстрая обучаемость, коммуникабельность.</p>', '<p>Делопроизводство;<br />Оценка персонала;<br />Поиск сотрудников в компанию.</p>', '<p>Заработная плата: 35 000 тыс. руб. на испытательный срок, после прохождения испытательного срока заработная плата будет повышаться;<br />Испытательный срок: 1 месяц;<br />График работы: 5/2, с 9.00 до 18.00;<br />Предполагаются редкие командировки по России.</p>', '', '0', '0', '', '', '', '2', '204', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-10 11:45:03'),
('205', '5', 'Уборщица в офис', 'Уборщица в офис', 'Андреевка', '0', '1970-01-01', '', '', '<p>30 000 руб.</p>', '<p>Образование: среднее и выше;<br />Необходимый стаж работы по специальности: от 2-х лет;<br />Необходимые навыки:<br />- Опыт работы уборщицей/горничной;<br />- Чистоплотность, пунктуальность, вежливость.</p>', '<p>Уборка офисного помещения площадью 450 м2. <br />Вынос мусора, мытье полов, полив цветов, вытирание пыли. Уборка в санузле и на кухне.</p>', '<p>Уборка офисного помещения площадью 450 м2, работа в офисе в Андреевке.<br />Заработная плата (размер и форма оплаты): 30 000 руб.<br />Социальные льготы: Оформление по ТК РФ.<br />Режим работы: 5/2, по несколько часов в день (утренние часы).</p>', '', '0', '0', '', '', '', '2', '205', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-11 16:36:16'),
('206', '18', 'Специалист по обработке возвратов', 'Специалист по обработке возвратов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 30000 рублей</p>', '<h1> </h1>\r\n<p><strong>Образование</strong>: Высшее</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> От 1 года</p>\r\n<p><strong>Необходимые навыки:</strong> Опыт работы на складе с большим объемом номенклатуры. Знание всех логистических процессов, документооборота. Умение профессионально общаться и решать вопросы</p>\r\n<p><strong>Знание иностранного языка:</strong> Не обязательно</p>\r\n<p><strong>ПК:</strong> Уверенный пользователь</p>\r\n<p><strong>Дополнительные требования: </strong>Ответственность</p>', '<p>Обработка возвратов от покупателей и поставщиков.</p>\r\n<p>Взаимодействие с поставщиками по решению спорных вопросов.</p>', '<p><strong>Заработная плата (размер и форма оплаты):</strong> От 30 000 рублей</p>\r\n<p><strong>Режим работы:</strong> Полный рабочий день</p>\r\n<p><strong>Командировки:</strong> Нет</p>', '', '0', '0', '', '', '', '2', '206', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-14 15:39:34'),
('207', '18', 'Сотрудник склада', 'Сотрудник склада', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности.</p>', '<p><strong>Образование</strong>: Среднее или высшее;</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> Не важен;</p>\r\n<p><strong>Необходимые навыки:</strong> Быстрая обучаемость, умение быстро и качественно выполнять поставленные задачи;</p>\r\n<p><strong>Знание иностранного языка:</strong> Не обязательно;</p>\r\n<p><strong>ПК:</strong> Не обязательно.</p>', '<p>Маркировка продукции;</p>\r\n<p>Упаковка товара.</p>', '<p><strong>Заработная плата (размер и форма оплаты):</strong> 25 000 рублей на испытательный срок (2 месяца), оплачиваемые переработки (с ночными часами и соответствующим коэффициентом)</p>\r\n<p><strong>Режим работы:</strong> 5/2, с 16-00 до 22-00</p>\r\n<p><strong>Командировки:</strong> Нет</p>', '', '0', '0', '', '', '', '2', '207', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-14 15:45:37'),
('208', '18', 'Грузчик', 'Грузчик', 'Андреевка', '2', '1970-01-01', '', '', '<p>от 2000 рублей за смену</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Грузчик\".</p>\r\n<p>Образование: Среднее и выше;<br />Необходимый стаж работы по специальности: не требуется;<br />Необходимые навыки: выносливость, хорошая физическая форма, желателен опыт работы на складах.<br />Дополнительные требования: наличие действующей медицинской книжки или готовность сделать ее по запросу работодателя.</p>', '<p>• Выполнение погрузочно-разгрузочных работ;<br />• Перемещение грузов по территории склада, размещение товара;<br />• Участие в текущей работе склада;<br />• Участие в инвентаризации.<br />Уровень подчинения (место в структуре): Начальнику склада.</p>', '<p>График работы: 2/2, с 9.00 до 21.00 (также есть возможность подработки на неполный день);<br />Место работы: Андреевка, мкр Высокое<br />Заработная плата: от 2000 рублей за смену;<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '208', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-15 17:18:32'),
('209', '18', 'Комплектовщик-фасовщик', 'Комплектовщик-фасовщик', 'Андреевка', '2', '1970-01-01', '', '', '<p>от 2800 рублей за смену</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Комплектовщик-фасовщик\".</p>\r\n<p>Образование: Среднее и выше;<br />Необходимый стаж работы по специальности: от 1 года;<br />Необходимые навыки: опыт работы на складах, опыт работы на фасовке в розничных сетях (овощи, кондитерка, сухофрукты), аккуратность, опыт работы с горячим столом и другой упаковочной техникой.<br />Дополнительные требования: наличие действующей медицинской книжки.</p>', '<p>• Комплектовка и упаковка продукции;<br />• Наклейка этикеток, маркировка;<br />• Фасовка.<br />Уровень подчинения (место в структуре): Начальнику склада.</p>', '<p>График работы: три раза в неделю - вторник, четверг, суббота, с 10.00 до 22.00;<br />Заработная плата: от 2800 рублей за смену;<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '209', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-15 17:23:08'),
('210', '3', 'Главный бухгалтер (в единственном лице)', 'Главный бухгалтер ', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности </p>', '<h1> </h1>\r\n<p><strong>Образование: </strong>Высшее</p>\r\n<p><strong>Необходимый стаж работы по специальности:</strong> от 5ти лет</p>\r\n<p><strong>Необходимые навыки:</strong></p>\r\n<p>ОСН, Систем Банк-Клиент, Гарант, Консультант;</p>\r\n<p>Законодательства по БУ, НК РФ, законодательства РФ по МФО, ТК и кадрового делопроизводства;</p>\r\n<p>1С версии 8.3, MS Office.</p>\r\n<p>ПК: Уверенный пользователь </p>', '<p>Ведение бухгалтерского, налогового учета в полном объеме.</p>\r\n<p>Сдача бухгалтерской и налоговой отчетности;</p>\r\n<p>Взаимодействие с финансово-кредитными организациями;</p>\r\n<p>Подготовка документов по запросам гос. органов (ФНС, ФТС, и т.п.);</p>\r\n<p>Расчет и начисление заработной платы персонала компании;</p>\r\n<p>Ведение расчетных/кредитных/депозитных счетов в разных валютах;</p>\r\n<p>Оформление авансовых отчетов и командировочных документов;</p>\r\n<p>Составление финансовых отчетов для руководства.</p>', '<p><strong>Оформление:</strong> по ТК РФ</p>\r\n<p><strong>Режим работы: </strong>5/2, с 9-00 до 18-00</p>', '', '0', '0', '', '', '', '2', '210', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-16 15:52:19'),
('211', '4', 'Системный аналитик / Эксперт по внедрению бизнес-процессов', 'Системный аналитик / Эксперт по внедрению бизнес-процессов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности. </p>', '<p>Образование: Высшее </p>\r\n<p>Опыт работы: от 3 лет</p>\r\n<p>Требования:</p>\r\n<p>- Умение планировать свою деятельность, расставлять приоритеты, навыки тайм-менеджмента;</p>\r\n<p>- Высокие организаторские способности, умение управлять людьми;</p>\r\n<p>- Навыки обучения и работы в команде;</p>\r\n<p>- Стремление к автоматизации бизнес-процессов;</p>\r\n<p>- Способность к распределению внимания, удержанию в голове задач разной направленности;</p>\r\n<p>- Структурное и логическое мышление;</p>\r\n<p>- Инициативность, оперативность и, если нужно, креативность в решении возникающих вопросов;</p>\r\n<p>- ПК: уверенный пользователь.</p>', '<p>- Анализ систем производства и управления;</p>\r\n<p>- Стандартизация и систематизация всех бизнес-процессов на базе CRM-системы Мегаплан;</p>\r\n<p>- Внедрение мобильной версии системы для сотрудников, задействованных в проектах;</p>\r\n<p>- Контроль за поддержанием актуальности информации в системе;</p>\r\n<p>- Экспертиза по контролю и качеству выполняемых работ на уровне управления проектами.</p>\r\n<p>Анализ, мониторинг рентабельности проекта;</p>\r\n<p>- Разработка и внедрение системы мотивации персонала.</p>', '<p>В компанию, занимающуюся предоставлением услуг по нанесению антикоррозионных покрытий и промышленной очистки требуется специалист на должность \"Системный аналитик / Эксперт по внедрению бизнес-процессов\".</p>\r\n<p>Офис компании находится в г. Зеленоград.</p>\r\n<p>График работы: 5/2, с 9-00 до 18-00</p>\r\n<p>Оформление по ТК РФ</p>\r\n<p>Заработная плата: обсуждается индивидуально на собеседовании</p>', '', '0', '0', '', '', '', '2', '211', '*', '0', '0000-00-00 00:00:00', '479', '2019-10-31 12:37:38');/**ABDB**/
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('212', '14', 'Торговый представитель', 'Торговый представитель', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 40 000 руб. + процент от продаж</p>', '<p>Образование: среднее и выше (высшее образование не обязательно);<br />Необходимый стаж работы по специальности: желателен, но не обязателен;<br />Необходимые навыки:<br />Знать и понимать алгоритм поиска клиентов;<br />Обучаемость (надо будет изучить продукцию), коммуникабельность;<br />Грамотная речь, презентабельный внешний вид.</p>', '<p>Продвижение и представление продукции компании (направление: считыватели для СКУД);<br />Продажи в существующие интернет магазины;<br />Продажи компаниям, которые имеют отношение к монтажу считывателей;<br />Продажи \"системным интеграторам\" систем безопасности.</p>', '<p>Заработная плата (размер и форма оплаты): от 40 000 руб. + процент от продаж (в зависимости от квалификации кандидата, по результатам собеседования);<br />Социальные льготы: бесплатный обед, кофе, чай в офисе, возможность посещать спорт<br />секцию по баскетболу, тренинги, корп. праздники, подарки детям на НГ;<br />Режим работы: 5/2, с 9.00 до 18.00;<br />Командировки: да, 80% времени, транспортные расходы компенсируются.</p>', '', '0', '0', '', '', '', '2', '212', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-11 10:51:14'),
('213', '15', 'Водитель тягача категории Е', 'Водитель тягача категории Е', 'Солнечногорск', '2', '1970-01-01', '', '', '<p>Фиксированная часть - 30 тысяч рублей + премии за выполненные рейсы.</p>', '<p>Образование: среднее и выше;<br />Необходимый стаж работы по специальности: от 3х лет;<br />Необходимые навыки:<br />- Наличие действующих прав категории Е;<br />- Опыт работы на тягаче;<br />- Умение самостоятельно провести мелкий ремонт транспортного средства (желательно, но не обязательно);<br />- Пунктуальность, исполнительность и ответственность.<br />Дополнительные требования: желательно без вредных привычек.</p>', '<p>- Доставка сырья и готовой продукции (наливные грузы, парафиновые эмульсии в бочках) в пределах 500 км. от Москвы;<br />- Контроль за техническим состоянием транспортного средства в период работы;<br />- Отчетность, оформление документации.</p>', '<p>Адрес: Московская область, Солнечногорский район, д. Елино;<br />Режим работы: сменный график (обсуждается на собеседовании);<br />Заработная плата: фиксированная часть - 30 тысяч рублей + премии за выполненные рейсы;<br />Оформление по ТК РФ, социальный пакет.</p>', '', '0', '0', '', '', '', '2', '213', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-19 16:39:38'),
('214', '18', 'Водитель-экспедитор на своем автомобиле', 'Водитель-экспедитор на своем автомобиле', 'Андреевка', '2', '1970-01-01', '', '', '<p>От 500 руб. за точку доставки + дополнительная плата за размещение рекламы на кузове автомобиля.</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Водитель-экспедитор на своем автомобиле\".</p>\r\n<p>Образование: среднее и выше;<br />Необходимый стаж работы по специальности: не требуется;<br />Необходимые навыки:<br />- Наличие действующих прав категории В;<br />- Стаж безаварийного вождения от 5 лет;<br />- Знание правил ПДД;<br />- Оперативность;<br />- Пунктуальность;<br />- Стрессоустойчивость;<br />- Неконфликтность;<br />- Опрятный внешний вид;<br />Дополнительные требования:<br />- Наличие смартфона;<br />- Наличие личного легкового автомобиля, либо автомобиля типа \"каблук\".</p>', '<p>- Доставка пакетов с продуктами питания клиентам на дом по Москве и Московской области;<br />- Наличный расчет с клиентами;<br />- Возврат товара на склад.</p>', '<p>График работы: три дня в неделю (среда, пятница, воскресенье), с 9.00 до 21.00;<br />Место работы: Московская область, Солнечногорский район, городское поселение Андреевка;<br />Заработная плата: от 500 руб. за точку доставки + дополнительная плата за размещение рекламы на кузове автомобиля;<br />Компенсация расходов на мойку машины;<br />Оплата телефонной связи.</p>', '', '0', '0', '', '', '', '2', '214', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-21 14:31:44'),
('215', '15', 'Менеджер по продажам светопрозрачных алюминиевых конструкций', 'Менеджер по продажам светопрозрачных алюминиевых конструкций', 'Солнечногорск ', '0', '1970-01-01', '', '', '<p>По договоренности.</p>', '<p>Образование: не ниже средне-специального;<br />Опыт работы в продажах (желательно, в сфере светопрозрачных конструкций) не менее 3-х лет;<br />Техническая грамотность;<br />Отличные коммуникативные навыки, грамотная речь;<br />Опыт ведения переговоров;<br />Умение убеждать и располагать к себе;<br />ПК: MS (Word, Excel), 1С;<br />Желательно, но не обязательно наличие водительского удостоверения и личного автомобиля.</p>', '<p>- Сбор информации о потенциальных клиентах;<br />- Ведение переговоров с клиентами в отношении товаров и услуг организации;<br />- Консультирование клиентов о характеристиках, правилах эксплуатации продукции;<br />- Прием и обработка заказов клиентов;<br />- Согласование с клиентами порядка поставки, оплаты товаров, услуг, их объемы;<br />- Контроль за размером и порядком оплаты товаров, в соответствии с заключенными договорами;<br />- Принятие мер для сокращения дебиторской задолженности контрагентов.<br />Дополнительная информация: желательно наличие клиентской базы.</p>', '<p>Заработная плата: по результатам собеседования;<br />Оформление по ТК РФ;<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00;<br />Командировки: Возможны.</p>', '', '0', '0', '', '', '', '2', '215', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-26 17:15:49'),
('216', '15', 'Менеджер-расчетчик (светопрозрачные конструкции)', 'Менеджер-расчетчик (светопрозрачные конструкции)', 'Солнечногорск ', '0', '1970-01-01', '', '', '<p>По договоренности. </p>', '<p>- Опыт работы по расчетам светопрозрачных конструкций не менее 3-х лет;</p>\r\n<p>- Знание расчетных программ;</p>\r\n<p>- Чтение строительных чертежей на базовом уровне;</p>\r\n<p>- Желательно знание алюминиевых профильных систем (ALUTECH, Schuco, СИАЛ и т.д.);</p>\r\n<p>- ПК: MS (Word, Excel, PowerPoint), LogiKal (Логикаль), SchueCal (Шукаль);</p>\r\n<p>- Желательно, но не обязательно наличие водительского удостоверения и личного автомобиля;</p>\r\n<p>- Желательно знание английского языка.</p>', '<p>- Анализ конструкторской документации по светопрозрачным алюминиевым конструкциям;</p>\r\n<p>- Расчет материалов и комплектующих по проекту, работа с программами LogiKal, SchueCal для определения расценок;</p>\r\n<p>- Взаимодействие с архитекторами, проектировщиками, конструкторами по вопросам проектов;</p>\r\n<p>- Возможны выезды на объекты 1-2 раза в месяц.</p>', '<p>Работа в международной компании, ведение крупных проектов;</p>\r\n<p>Заработная плата: по результатам собеседования;</p>\r\n<p>Оформление по ТК РФ;</p>\r\n<p>Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00, дополнительные часы работы оплачиваются.</p>', '', '0', '0', '', '', '', '2', '216', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-26 17:24:08'),
('217', '16', 'Мастер маникюра и педикюра', 'Мастер маникюра и педикюра', 'Сходня', '2', '1970-01-01', '', '', '<p>Заработная плата: по результатам собеседования</p>', '<p>В салон красоты \"Family Club\" требуется мастер маникюра и педикюра.</p>\r\n<p>Образование: высшее;<br />Необходимый стаж работы по специальности: от 1 года;<br />Необходимые навыки:<br />- Качественное выполнение маникюрно-педикюрных услуг;<br />- Наличие действующей медицинской книжки;<br />- Пунктуальность;<br />- Неконфликтность;<br />- Опрятный внешний вид.</p>', '<p>- Маникюр: классический, аппаратный и др.;<br />- Педикюр: классический, аппаратный;<br />- Моделирование ногтей: гель, гель-лак;<br />- Современный дизайн ногтей (приветствуется);<br />- Санитарная обработка и дезинфекция инструментов и оборудования, заполнение соответствующих журналов.</p>', '<p>График работы: сменный график, с 10.00 до 21.00;<br />Место работы: Московская область, Солнечногорский район, деревня Голиково, микрорайон Золотые купола, улица Звездная, дом 97;<br />Заработная плата: по результатам собеседования, гарантия выхода.</p>\r\n<p>Контактное лицо: Шустова Алена</p>\r\n<p>Телефон: <a href=\"tel:8 (926) 0620656\">8 (926) 0620656</a></p>\r\n<p>E-mail: <a href=\"mailto:hohlacheva88@gmail.com\">hohlacheva88@gmail.com</a></p>', '', '0', '0', '', '', '', '2', '217', '*', '0', '0000-00-00 00:00:00', '479', '2019-11-29 11:15:35'),
('219', '5', 'Домработница', 'Домработница', 'Химки', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В частный дом в Фирсановку требуется домработница.</p>\r\n<p>Образование: среднее и выше;<br />Стаж работы и профессиональный опыт: от 2 лет в аналогичной должности;<br />Конкретные навыки и умения: знание бытовой техники, знание бытовой химии, знание поверхностей, умение готовить, трудолюбие, аккуратность, чистоплотность, вежливость, отсутствие вредных привычек;<br />Наличие медицинской книжки.</p>', '<p>Уборка частного дома (примерная площадь 300 - 400 м2):<br />- сухая и влажная уборка дома;<br />- стирка и глажка;<br />- частичное приготовление пищи;<br />- мытье посуды;<br />- другие поручения, связанные с домашним хозяйством.</p>', '<p>График работы: утверждается на собеседовании, возможно два варианта работы, либо работа на несколько раза в неделю, на полный день, либо работа с графиком 6/1 с 9.00 до 19.00, есть возможность проживания.<br />Условия оплаты труда и другие мотивации: заработная плата обсуждается на собеседовании.</p>', '', '0', '0', '', '', '', '2', '219', '*', '0', '0000-00-00 00:00:00', '479', '2019-12-25 12:52:06'),
('220', '5', 'Помощница по хозяйству', 'Помощница по хозяйству', 'Алабушево', '0', '1970-01-01', '', '', '<p>70 000 руб.</p>', '<p>В частный дом в Алабушево требуется Помощница по хозяйству.</p>\r\n<p>Образование: среднее и выше.<br />Стаж работы и профессиональный опыт: от 3 лет в аналогичной должности.<br />Конкретные навыки и умения: знание бытовой техники, знание бытовой химии, знание поверхностей, умение готовить, умение находить общий язык с детьми, доброжелательное отношение к животным, порядочность, чистоплотность, вежливость, отсутствие вредных привычек.<br />Наличие медицинской книжки.<br />Наличие водительских прав категории В и личного автомобиля.</p>', '<p>Уборка частного дома (примерная площадь 350 м2): <br />- сухая и влажная уборка дома;<br />- стирка и глажка; <br />- вынос мусора;<br />- мытье посуды;<br />- другие поручения, связанные с домашним хозяйством.<br />Приготовление пищи; <br />Присмотр за детьми (9, 7 лет, 3 года) - присмотреть, покормить, переодеть, в редких случаях уложить спать;<br />Иногда выгул собаки (швейцарская овчарка).</p>', '<p>График работы: работа без проживания, 5/2, (время не фиксированное, в какие-то дни раньше, в другие позже; готовность приехать, начиная с 8.00).<br />Условия оплаты труда и другие мотивации: заработная плата в месяц - 70 000 руб.</p>', '', '0', '0', '', '', '', '2', '220', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-09 10:59:47'),
('221', '2', 'Офис-менеджер', 'Офис-менеджер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>От 40000 рублей (по результатам собеседования)</p>', '<p>В компанию, которая занимается производством устройств и систем для безналичных платежей требуется офис-менеджер.</p>\r\n<p>Образование: высшее образование;<br />Необходимый стаж работы по специальности: от 2-х лет;<br />Необходимые навыки:<br />- Ответственность, исполнительность, коммуникабельность, быстрая обучаемость;<br />- Умение работать в режиме многозадачности;<br />- Грамотная устная и письменная речь;<br />- Умение ясно выражать мысли;<br />- Уверенный пользователь ПК, MS Office;<br />- Желательно, но не обязательно знание ВЭД (импорт, экспорт), 1С;<br />- Отсутствие вредных привычек.<br />Знание иностранного языка: базовое знание английского языка.</p>', '<p>- Прием и распределение звонков;<br />- Деловая переписка;<br />- Прием, регистрация, хранение, учет и рассылка корреспонденции;<br />- Обеспечение жизнедеятельности офиса (заказ воды, канцелярии, и т.п.);<br />- Организация приема посетителей (встреча, чай-кофе).</p>', '<p>Заработная плата (размер и форма оплаты): от 40000 рублей (по результатам собеседования).<br />Социальные льготы:<br />- Трудоустройство и соц. пакет в соответствии с ТК РФ, мед. страховка;<br />- Работа в стабильной, динамично развивающейся международной компании.<br />Режим работы: Полный рабочий день (с 9.00 до 18.00), работа в офисе в центре Зеленограда.</p>', '', '0', '0', '', '', '', '2', '221', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-14 11:58:04'),
('222', '15', 'Стикеровщик-упаковщик на производство', 'Стикеровщик-упаковщик на производство', 'Зеленоград', '1', '1970-01-01', '', '', '<p>Сдельная заработная плата, по выработке.</p>', '<p>СРОЧНО требуются работники на переупаковку и наклеивание стикеров.</p>\r\n<p>Аккуратность, внимательность, усидчивость.<br />Работа не тяжелая.<br />Обучение в процессе работы.</p>', '<p>Распаковка, проверка комплектности упаковки, отсутствия внешних повреждений устройств, разъемов и кабелей.<br />Наклейка этикеток.<br />Проверка работоспособности устройства.<br />Упаковка изделия.</p>', '<p>Работа в теплом помещении. Есть столовая.<br />График работы: по мере прихода партии продукции (2-3 дня на одну партию) по 11 часов 2-3 раза в месяц. Перерыв на обед - 1 час.<br />Заработная плата: сдельная, по выработке.<br />Производство находится в Зеленограде в районе МИЭТ.<br />Оформление по договору.<br />Планируемое время начала работ: начало июня 2020 г.</p>', '', '0', '0', '', '', '', '2', '222', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-14 12:28:19'),
('223', '17', 'Каменщик-строитель', 'Каменщик-строитель', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Каменщик-строитель\".</p>\r\n<p>Опыт работы каменщиком;<br />Отсутствие противопоказаний по состоянию здоровья.</p>', '<p>Устройство межкомнатных перегородок из Акотек панелей, газоблоков и пазогребня;<br />Монтаж вручную;<br />Уборка обрезков.<br />Материалы: раствор, клей, пена, деревянные клинья.<br />Инструмент: лазерный нивелир, уровень, резчик по бетону, перфоратор, шуруповерт, миксер, мастерок, молоток.</p>', '<p>В крупную строительную компанию требуется \"Каменщик-строитель\".<br />Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '223', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:20:03'),
('224', '17', 'Электромонтажник', 'Электромонтажник', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Электромонтажник\".</p>\r\n<p>Опыт работы по специальности;<br />Умение читать принципиальные и другие электрические схемы;<br />Действующее удостоверение или допуск по электробезопасности.</p>', '<p>Прокладка электросетей;<br />Монтаж, установка и подключение электрооборудования и электрощитов.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '224', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:23:51'),
('225', '17', 'Электромонтажник', 'Электромонтажник', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании </p>', '<p>В крупную строительную компанию требуется \"Электромонтажник\".</p>\r\n<p>Опыт работы по специальности от 3 лет;<br />Умение читать принципиальные и другие электрические схемы;<br />Действующее удостоверение или допуск по электробезопасности.</p>', '<p>Прокладка электросетей;<br />Монтаж, установка и подключение электрооборудования и электрощитов.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '225', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:25:53'),
('226', '17', 'Кровельщик', 'Кровельщик', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Кровельщик\".</p>\r\n<p>Опыт работы кровельщиком по устройству мягкой рулонной кровли;<br />Опыт наплавки гидроизоляционного материала;<br />Ответственность, исполнительность.</p>', '<p>Наплавка гидроизоляционного материала;<br />Монтаж мягкой рулонной кровли на объектах работодателя.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '226', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:29:00'),
('227', '17', 'Сварщик-сантехник', 'Сварщик-сантехник', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Сварщик-сантехник\".</p>\r\n<p>Опыт работы по сварке сантехнических труб от 1 года;<br />Наличие удостоверения или диплома сварщика.</p>', '<p>Сварка сантехнических труб (стояки и разводки в квартиры, водоснабжение, водоотведение, канализация, отопление) в строящихся домах.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '227', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:30:41'),
('228', '17', 'Монтажник систем вентиляции и кондиционирования', 'Монтажник систем вентиляции и кондиционирования', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Монтажник систем вентиляции и кондиционирования\".</p>\r\n<p>Опыт работы монтажником систем вентиляции;<br />Ответственность, исполнительность.</p>', '<p>Монтаж систем вентиляции в строящихся многоэтажных домах;<br />Работа на строительных объектах работодателя.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '228', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:32:14'),
('229', '17', 'Слесарь-сантехник', 'Слесарь-сантехник', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Слесарь-сантехник\".</p>\r\n<p>Опыт работы монтажником СТС или слесарем-сантехником в строящихся домах.</p>', '<p>Монтаж внутренних сантехнических систем (ГВС, ХВС, стояки и разводки в квартиры);<br />Полипропилен, НПВХ, ПВХ, сшитый полиэтилен.</p>', '<p>Место работы: Москва и МО;<br />Объекты находятся по всей Москве и МО (Мытищи, Бутово, Одинцово, Люберцы, Балашиха);<br />Бесплатный корпоративный транспорт от метро до объекта;<br />Официальное трудоустройство, строго по ТК РФ;<br />Стабильная белая заработная плата, выплачивается два раза в месяц;<br />Оплата труда сдельная, заработная плата зависит от объема выполненных работ;<br />График работы: с понедельника по пятницу, с 8:00 до 17:00, возможны подработки;<br />Оплачиваемый отпуск;<br />Оплачиваемые больничные листы;<br />Для иногородних предоставляется общежитие;<br />Предоставляется СИЗ, инструмент, спецодежда (лето/зима);<br />Бесплатное прохождение медосмотра;<br />Наличие профсоюза, который предоставляет путевки, подарки прочее.</p>', '', '0', '0', '', '', '', '2', '229', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:33:38'),
('230', '17', 'Контролер качества отделки', 'Контролер качества отделки', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В крупную строительную компанию требуется \"Контролер качества отделки\".</p>\r\n<p>Высшее строительное образование (ПГС);<br />Опыт работы в отделке от 3 лет;<br />Опыт работы в строительстве жилых домов.</p>', '<p>Выполнение строительного контроля на объекте по специализации - отделка;<br />Контроль соответствия результатов отделочных работ требованиям стандартов компании, строительных норм и правил, проектной и рабочей документации;<br />Координация работ;<br />Приемка работ;<br />Оценка затрат при устранении дефектов;<br />Контроль соблюдения сроков производственных работ;<br />Организация устранения замечаний;<br />Контроль исполнения договорных обязательств Заказчика;<br />Передача квартир и других помещений с завершенной отделкой Управлению заселения, клиентам и другим заинтересованным лицам.</p>', '<p>Официальное трудоустройство по ТК РФ с первого дня;<br />График работы 5/2;<br />Работа на объекте строительства в стабильной, растущей компании.</p>', '', '0', '0', '', '', '', '2', '230', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:34:54'),
('231', '17', 'Слесарь-электрогазосварщик аварийно-восстановительных работ', 'Слесарь-электрогазосварщик аварийно-восстановительных работ', 'Москва и МО', '2', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Среднее профессиональное образование;<br />Знание принципов работы инженерных систем многоквартирных домов;<br />Знание принципов устройства и работы тепломеханических и гидравлических систем.</p>', '<p>Выполнение сантехнических работ по заявкам;<br />Устранение аварийных ситуаций;<br />Снятие показаний приборов учета тепла, воды и пр.;<br />Совершение ежедневных осмотров подъездов и территорий.</p>', '<p>Официальное трудоустройство в крупнейшей управляющей компании России;<br />График работы 1/3;<br />Программа лояльности для сотрудников компании (корпоративные скидки на ДМС, изучение иностранных языков, страхование, фитнес, путешествия; специальные условия от банков-партнеров и многое другое);<br />Корпоративное обучение, электронная библиотека и база знаний.</p>', '', '0', '0', '', '', '', '2', '231', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:36:29'),
('232', '17', 'Плиточник', 'Плиточник', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Образование средне профессиональное;<br />Знание основных материалов, применяемых при облицовке наружных и внутренних поверхностей плиткой;<br />Навыки ремонта полов и смены облицовочных плиток;<br />Исполнительность, умение работать в команде.</p>', '<p>Выполнение плиточных работ согласно плана;<br />Отделочные работы, укладка плитки;<br />Составление заявок ТМЦ.</p>', '<p>Официальное трудоустройство в крупнейшей управляющей компании России;<br />Место работы Москва и МО;<br />Разъездной характер работы;<br />График работы 5/2;<br />Программа лояльности для сотрудников компании (корпоративные скидки на ДМС, изучение иностранных языков, страхование, фитнес, путешествия; специальные условия от банков-партнеров и многое другое);<br />Корпоративное обучение, электронная библиотека и база знаний;<br />Компенсация проезда.</p>', '', '0', '0', '', '', '', '2', '232', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:39:43'),
('233', '17', 'Техник по эксплуатации зданий', 'Техник по эксплуатации зданий', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Среднее профессиональное образование;<br />Знание принципов работы инженерных систем многоквартирных домов;<br />Знание принципов устройства и работы тепломеханических систем.</p>', '<p>Выполнение сантехнических работ по заявкам;<br />Устранение аварийных ситуаций;<br />Снятие показаний приборов учета тепла, воды и пр.;<br />Совершение ежедневных осмотров подъездов и территорий.</p>', '<p>Официальное трудоустройство в крупнейшей управляющей компании России;<br />График работы 5/2;<br />Место работы Москва и МО;<br />Программа лояльности для сотрудников компании (корпоративные скидки на ДМС, изучение иностранных языков, страхование, фитнес, путешествия; специальные условия от банков-партнеров и многое другое);<br />Корпоративное обучение, электронная библиотека и база знаний.</p>', '', '0', '0', '', '', '', '2', '233', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:42:03'),
('234', '17', 'Штукатур', 'Штукатур', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Полное физическое и душевное здоровье, отсутствие тяжелых и хронических заболеваний.<br />Для оформления договора подряда Вам необходимо зарегистрироваться как Самозанятый.<br />Компания ищет людей на постоянную работу. Нужны мастера для сотрудничества на долгие годы.</p>', '<p>Для работы в компании Вы должны уметь:<br />- штукатурить по маякам;<br />- оштукатуривать под правило.</p>', '<p>Компания строит более 2 миллионов квадратных метров нового жилья каждый год, поэтому у них нет сезонности и для Вас круглый год будет работа;<br />Предоставляется спец. одежда и инструменты, можно работать со своим инструментом;<br />Оформление официально, по договору подряда;<br />Помогут с оформлением статуса Самозанятого;<br />Помогут с открытием счета в банке;<br />График работы: 5/2 или 6/1;<br />Время работы строительных объектов с 8.00 до 21.00, при этом нужно отрабатывать не менее 9-ти часов в день.</p>', '', '0', '0', '', '', '', '2', '234', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:43:28'),
('235', '17', 'Гипсокартонщик', 'Гипсокартонщик', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Полное физическое и душевное здоровье, отсутствие тяжелых и хронических заболеваний.<br />Для оформления договора подряда Вам необходимо зарегистрироваться как Самозанятый.<br />Компания ищет людей на постоянную работу. Нужны мастера для сотрудничества на долгие годы.</p>', '<p>Для работы в компании Вы должны уметь:<br />- возводить каркас под зашивку ГКЛ;<br />- зашивать ГКЛ каркас.</p>', '<p>Компания строит более 2 миллионов квадратных метров нового жилья каждый год, поэтому у них нет сезонности и для Вас круглый год будет работа;<br />Предоставляется спец. одежда и инструменты, можно работать со своим инструментом;<br />Оформление официально, по договору подряда;<br />Помогут с оформлением статуса Самозанятого;<br />Помогут с открытием счета в банке;<br />График работы: 5/2 или 6/1;<br />Время работы строительных объектов с 8.00 до 21.00, при этом нужно отрабатывать не менее 9-ти часов в день.</p>', '', '0', '0', '', '', '', '2', '235', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-17 17:45:17'),
('236', '14', 'Менеджер по продажам алюминиевых композитных панелей', 'Менеджер по продажам алюминиевых композитных панелей', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности </p>', '<p>Образование: не ниже средне-специального;<br />Опыт работы в продажах (желательно, в сфере светопрозрачных конструкций) не менее 3-х лет;<br />Техническая грамотность;<br />Отличные коммуникативные навыки, грамотная речь;<br />Опыт ведения переговоров;<br />Умение убеждать и располагать к себе;<br />ПК: MS (Word, Excel), 1С;<br />Желательно, но не обязательно наличие водительского удостоверения и личного автомобиля.</p>', '<p>- Сбор информации о потенциальных клиентах;<br />- Ведение переговоров с клиентами в отношении товаров и услуг организации;<br />- Консультирование клиентов о характеристиках, правилах эксплуатации продукции;<br />- Прием и обработка заказов клиентов;<br />- Согласование с клиентами порядка поставки, оплаты товаров, услуг, их объемы;<br />- Контроль за размером и порядком оплаты товаров, в соответствии с заключенными договорами;<br />- Принятие мер для сокращения дебиторской задолженности контрагентов.<br />Дополнительная информация: желательно наличие клиентской базы.</p>', '<p>Заработная плата: по результатам собеседования;<br />Оформление по ТК РФ;<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00;<br />Командировки: Возможны.</p>', '', '0', '0', '', '', '', '2', '236', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-23 12:48:49'),
('237', '14', 'Менеджер по продажам стекла', 'Менеджер по продажам стекла', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: не ниже средне-специального;<br />Опыт работы в продажах (желательно, в сфере светопрозрачных конструкций) не менее 3-х лет;<br />Техническая грамотность;<br />Отличные коммуникативные навыки, грамотная речь;<br />Опыт ведения переговоров;<br />Умение убеждать и располагать к себе;<br />ПК: MS (Word, Excel), 1С;<br />Желательно, но не обязательно наличие водительского удостоверения и личного автомобиля.</p>', '<p>- Сбор информации о потенциальных клиентах;<br />- Ведение переговоров с клиентами в отношении товаров и услуг организации;<br />- Консультирование клиентов о характеристиках, правилах эксплуатации продукции;<br />- Прием и обработка заказов клиентов;<br />- Согласование с клиентами порядка поставки, оплаты товаров, услуг, их объемы;<br />- Контроль за размером и порядком оплаты товаров, в соответствии с заключенными договорами;<br />- Принятие мер для сокращения дебиторской задолженности контрагентов.<br />Дополнительная информация: желательно наличие клиентской базы.</p>', '<p>Заработная плата: по результатам собеседования;<br />Оформление по ТК РФ;<br />Режим работы: 5/2 (Пн-Пт), с 8-00 до 17-00;<br />Командировки: Возможны.</p>', '', '0', '0', '', '', '', '2', '237', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-23 13:10:31'),
('238', '5', 'Сиделка', 'Сиделка', 'Зеленоград', '3', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Опыт работы сиделкой в семьях от 2 лет;<br />Наличие рекомендаций.</p>', '<p>Уход за пожилой женщиной (85 лет, не лежачая).<br />Гигиенические процедуры, кормление;<br />Отслеживание времени приема лекарств;<br />Прогулки;<br />Уборка, поход в магазин.</p>', '<p>Работа с проживанием в квартире в Зеленограде (3 мкр.);<br />Оплата по договоренности;<br />Выходные дни по договоренности.</p>', '', '0', '0', '', '', '', '2', '238', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-27 17:15:59'),
('239', '3', 'Главный бухгалтер', 'Главный бухгалтер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 70000 рублей (по результатам собеседования).</p>', '<p>В компанию, которая занимается производством устройств и систем для безналичных платежей требуется главный бухгалтер.</p>\r\n<p>Образование: Высшее;<br />Необходимый стаж работы по специальности: Опыт работы главным бухгалтером в торговле и на производстве от 3 лет. Желательно опыт работы в компаниях, занимающихся разработками и опытным производством. <br />Необходимые навыки: <br />Ведение производственного учета (закрытие производственных счетов и расчет себестоимости, складские движения);<br />Опыт постановки учета производственных затрат в разрезе требуемых аналитик - будет огромным плюсом;<br />Опыт в разработке методологии: учетной политики, расчета себестоимости;<br />Знание всех участков бухгалтерии (производство, торговля);<br />Знание систем налогообложения ОСНО, УСН 15%, 6%;<br />ПК: уверенное владение ПК (MS Office, 1С 8.3, ЗУП, 1С склад).</p>', '<p>- Разработка стратегии, поиск гибких решений, предложение улучшений;<br />- Ведение бухгалтерского и налогового учета в полном объеме (1 компания на УСН, 2 на ОСН, в которой:<br />• мелкосерийное производство на собственных площадях,<br />• серийное контрактное производство, <br />• ВЭД.<br />- Ведение кадрового делопроизводства;<br />- Работа с 1С.<br />Дополнительная информация: младших бухгалтеров нет, фактически главный бухгалтер в единственном лице.</p>', '<p>Заработная плата (размер и форма оплаты): от 70000 рублей (по результатам собеседования).<br />Социальные льготы:<br />- Трудоустройство и соц. пакет в соответствии с ТК РФ, мед. страховка;<br />- Работа в стабильной, динамично развивающейся международной компании.<br />Режим работы: Полный рабочий день (с 9.00 до 18.00), работа в офисе в Зеленограде.</p>', '', '0', '0', '', '', '', '2', '239', '*', '0', '0000-00-00 00:00:00', '479', '2020-01-30 13:24:27'),
('240', '5', 'Домработница', 'Домработница', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>В частный загородный дом в Солнечногорском районе (д. Малые бережки) требуется домработница.</p>\r\n<p>Образование: среднее и выше;<br />Стаж работы и профессиональный опыт: от 3 лет в аналогичной должности;<br />Конкретные навыки и умения: знание бытовой техники, знание бытовой химии, знание поверхностей, умение готовить, чистоплотность, вежливость, трудолюбие, аккуратность, отсутствие вредных привычек;<br />Наличие медицинской книжки.</p>', '<p>Уборка частного дома (примерная площадь для уборки 300 м2):<br />- сухая и влажная уборка дома;<br />- стирка и глажка;<br />- приготовление пищи;<br />- сезонное мытье окон;<br />- другие поручения, связанные с домашним хозяйством.</p>', '<p>График работы: обсуждается на собеседовании, возможны разные варианта работы, ориентировочно график 5/2;<br />Есть возможность проживания (для проживания отводится небольшой дом со всем необходимым);<br />Условия оплаты труда: заработная плата обсуждается на собеседовании.</p>', '', '0', '0', '', '', '', '2', '240', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-03 17:33:47'),
('241', '15', 'Инженер-испытатель', 'Инженер-испытатель', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата: по результатам собеседования с успешным кандидатом.</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Инженер-испытатель.</p>\r\n<p>Образование: высшее техническое (желательно микроэлектроника);<br />Необходимый стаж работы по специальности: от 5 лет;<br />ПК: уверенный пользователь, умение работать с графическими редакторами (Компас, SolidWorks и т.д);<br />Дополнительные требования:<br />- Желательно: знание стандарта S1000D;<br />- Опыт работы в TG BUILDER (желательно);<br />- Работа с измерительной и испытательной аппаратурой.</p>', '<p>Разработка программ и методик испытаний;<br />Участие в испытаниях (предварительных, квалификационных, межведомственных, периодических, типовых) на воздействие климатических и механических факторов, оформление результатов испытаний.</p>', '<p>Работа в соответствие с ТК РФ;<br />График работы: с понедельника по пятницу, с 08:00 до 17:00;<br />Заработная плата: по результатам собеседования с успешным кандидатом.</p>', '', '0', '0', '', '', '', '2', '241', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-05 11:28:45'),
('242', '15', 'Главный конструктор / Начальник конструкторского бюро морского направления', 'Главный конструктор / Начальник конструкторского бюро морского направления', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании.</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Главный конструктор / Начальник конструкторского бюро морского направления.</p>\r\n<p>Образование: высшее техническое;<br />Необходимый стаж работы с аналогичными функциональными обязанностями: от 5 лет;<br />Необходимые навыки/опыт:<br />• знание ГОСТов, порядка, процедур разработки (проведение ОКР) военной и/или морской техники и постановки ее на производство;<br />• значительный опыт разработки и конструирования радиоэлектронной аппаратуры;<br />• опыт разработки светотехнических изделий, в том числе на основе светодиодов;<br />• знание основ светотехники и фотометрии;<br />• знание современной аналоговой и цифровой схемотехники (желательно импульсных блоков питания);<br />• хорошее знание ЕСКД и правил оформления РКД, ТЗ, ТУ, РЭ и пр;<br />• руководство коллективом разработчиков от 10 человек;<br />• желательно знание порядка сертификации оборудования и условий его применения на военных и гражданских морских судах;<br />• желателен опыт работы с морскими конструкторскими бюро и/или судостроительными предприятиями (Концерн \"Моринформсистема-Агат\", СПМБМ \"Малахит\", ЦКБ МТ \"Рубин\", ЦМКБ \"Алмаз\", Центр судоремонта \"Звездочка\" и др.);<br />• желателен опыт работы на предприятии, разрабатывающем и производящем военную технику;<br />• желательно знание основ оптики;<br />• умение грамотно вести деловую переписку;<br />• грамотная речь;<br />• готовность к командировкам;<br />• хорошее знание ПК;<br />• владение английским языком (чтение технической литературы и разговорный английский).</p>', '<p>• организация, руководство и контроль за процессом разработки новых изделий - радиоэлектронной аппаратуры и светодиодного светотехнического оборудования военного и специального назначения;<br />• руководство коллективом конструкторов, схемотехников, программистов, а также архивом предприятия и испытательной лабораторией: постановка задач, контроль за выполнением работы;<br />• проведение переговоров с Заказчиками для определения потребности рынка в новых изделиях;<br />• согласование с Заказчиками технических требований и технических заданий на разработку новых изделий;<br />• участие в разработке технических требований и технических заданий;<br />• разработка облика (принципов построения) новых изделий;<br />• консультирование Заказчиков по техническим вопросам, по вопросам подбора оборудования, обеспечение Заказчиков технической документацией;<br />• обеспечение выполнения ОКР в заданные сроки;<br />• выбор наилучших конструктивных, схемотехнических, оптических решений при разработке новых изделий;<br />• планирование работы подчиненных сотрудников и подразделений;<br />• участие в подборе новых сотрудников.</p>', '<p>Заработная плата: обсуждается на собеседовании;<br />Испытательный срок: 3 месяца;<br />Социальные льготы: в соответствии с ТК РФ;<br />Режим работы: 5/2, с 9 до 18.</p>', '', '0', '0', '', '', '', '2', '242', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-05 11:44:38'),
('244', '3', 'Бухгалтер-кассир', 'Бухгалтер-кассир', 'Зеленоград', '0', '1970-01-01', '', '', '<p>30 000 руб.</p>', '<p>В компанию OOO \"КРИОГАЗ\", занимающуюся розничной продажей промышленных газов, требуется бухгалтер-кассир.</p>\r\n<p>Образование: среднее специальное, высшее;<br />Необходимый стаж работы по специальности: от 1 года;<br />Дополнительные требования: знание программы 1С: Бухгалтерия.</p>', '<p>• Работа на кассе;<br />• Ведение учета по товару.</p>', '<p>Место работы: г. Зеленоград;<br />Заработная плата: 30 000 руб.;<br />Режим работы: Пн-Пт.: с 8.00 до 17.00 (2 субботы в месяц с 9.00 до 14.00).</p>\r\n<p>Контакты для связи: Ольга, Артем</p>\r\n<p>Телефон: <a href=\"tel:8 (909) 9747424; 8 (916) 1083651\">8 (909) 9747424; 8 (916) 1083651</a></p>\r\n<p>E-mail: <a href=\"mailto:povasina81@mail.ru\">povasina81@mail.ru</a></p>', '', '0', '0', '', '', '', '2', '244', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-06 09:46:04'),
('245', '14', 'Специалист коммерческого отдела (менеджер / инженер по продажам)', 'Специалист коммерческого отдела (менеджер / инженер по продажам)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>70000 руб.</p>', '<p>В зеленоградскую компанию, занимающуюся реализацией услуг по нанесению покрытий на металлоконструкции требуется Специалист в коммерческий отдел.</p>\r\n<p>Образование: высшее (желательно техническое).<br />Необходимые навыки:<br />- знание и понимание технологий нанесения промышленных покрытий в соответствии с требованиями международных стандартов и ГОСТ;<br />- опыт продаж подрядных услуг либо профессиональных промышленных лакокрасочных материалов (антикоррозионная защита, огнезащита, гидроизоляция, металлизация, износостойкие покрытия, ЛКМ и др.);<br />- наличие личного автомобиля приветствуется;<br />- хорошие коммуникативные навыки;<br />- желательно знание AutoCAD;<br />- желательно владение бизнес-английским языком;<br />- желательно навыки сметно-исполнительной работы.</p>', '<p>- Поиск и привлечение клиентов, продажа услуг по антикоррозионной защите, огнезащите, гидроизоляции, металлизации, нанесению износостойких покрытий.<br />- Расчет стоимости услуг (работ).<br />- Выезды на объекты.<br />- Ведение переговоров с заказчиками.<br />- Подача коммерческих предложений, заключение договоров.<br />- Участие в тендерах.</p>', '<p>Заработная плата: обсуждается индивидуально на собеседовании, от 70 тысяч рублей (оклад + бонусы (% от продаж)).<br />Режим работы: 5/2, с 9-00 до 18-00.<br />Социальные льготы: Оформление по ТК РФ. Испытательный срок - 3 месяца.<br />Компенсация ГСМ и амортизации автомобиля при его наличии и использовании, компенсация мобильной связи.<br />Есть возможность организовать проживание специалистам из регионов<br />Место работы и командировки: Работа на базе зеленоградского офиса, выезды на объекты заказчика. Работа преимущественно в офисе - тендеры и входящий поток. Не менее 2х командировок в месяц.</p>', '', '0', '0', '', '', '', '2', '245', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-11 18:03:07'),
('246', '22', 'Начальник отдела снабжения и кооперации', 'Начальник отдела снабжения и кооперации', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>Научно-производственному предприятию требуется начальник отдела снабжения и кооперации.</p>\r\n<p>Образование: высшее техническое<br />Необходимый стаж в релевантной должности: от 5ти лет<br />Необходимые навыки/опыт:<br />• Опыт работы в отделе снабжения в приборостроении или смежных отраслях обязателен;<br />• Знание основ механообработки;<br />• Опыт руководства подчиненными;<br />• Умение вести переговоры;<br />• Умение работать в 1С.</p>', '<p>• Руководство подчиненными;<br />• Делегирование задач между менеджерами по снабжению и кооперации;<br />• Проведение переговоров со сторонними организациями с целью размещения заказов на изготовление корпусных деталей;<br />• Учет материалов в 1С.</p>', '<p>Оформление в соответствие с ТК РФ, ДМС;<br />График работы: 5/2, полный рабочий день;<br />Заработная плата: по результатам собеседования, белая заработная плата, выплаты без задержек.</p>', '', '0', '0', '', '', '', '2', '246', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-13 15:16:43'),
('247', '22', 'Менеджер отдела снабжения и кооперации', 'Менеджер отдела снабжения и кооперации', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании.</p>', '<p>Научно-производственному предприятию требуется менеджер отдела снабжения и кооперации.</p>\r\n<p>Образование: высшее техническое<br />Необходимый стаж в релевантной должности: от 3х лет<br />Необходимые навыки/опыт:<br />• Опыт работы в отделе снабжения в приборостроении или смежных отраслях обязателен;<br />• Знание основ механообработки;<br />• Умение читать чертежи;<br />• Опыт успешных переговоров;<br />• Желательно наличие наработанной базы поставщиков и предприятий-производителей.</p>', '<p>• Выполнение поручений начальника отдела снабжения и кооперации;<br />• Отслеживание остатков на складе, планирование объемов закупок, осуществление закупок;<br />• Поиск и оценка поставщиков;<br />• Поиск предприятий-производителей, оценка качества выпускаемой ими продукции, проведение переговоров об условиях сотрудничества, о размещении производственного заказа (в основном механические детали);<br />• Отслеживание сроков и качества выполнения заказов.</p>', '<p>Оформление в соответствие с ТК РФ, ДМС;<br />График работы: 5/2, полный рабочий день;<br />Заработная плата: по результатам собеседования, белая заработная плата, выплаты без задержек.</p>', '', '0', '0', '', '', '', '2', '247', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-13 15:19:44'),
('248', '15', 'Инженер ПТО (производственно-технический отдел)', 'Инженер ПТО (производственно-технический отдел)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>от 70 000 рублей</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы - от 3х лет на строительных и производственных объектах в области антикоррозийной защиты, огнезащиты, монтажа или изготовления металлоконструкций.</p>\r\n<p>Опыт работы с AutoCAD, с исполнительной документацией, с чертежами.</p>\r\n<p>Разработка и написание ППР (проектно-производственных работ), оформление приказов, инструкций, сдача работ.</p>\r\n<p>Желательно наличие личного автотранспорта.</p>\r\n<p> </p>', '<ul>\r\n<li>Оформление актов выполненных работ и исполнительной документации, контроль качества работ.</li>\r\n<li>Расчет объемов предполагаемых работ.</li>\r\n<li>Участие в разработке рабочей документации: разработка ППР, тех.регламентов, проектов выполнения работ, чертежей и т.п.</li>\r\n<li>Участие в разработке смет.</li>\r\n</ul>\r\n<p> </p>', '<p>Зеленоградской компании, занимающейся специальным строительством (предоставление услуг по нанесению защитных покрытий на металлоконструкции), требуется специалист на позицию Инженер ПТО.</p>\r\n<p>Работа в офисе г. Зеленоград.</p>\r\n<p>Оформление по ТК РФ.</p>\r\n<p>Постоянный график работы: 5/2, с 9.00 - 18.00. 4 дня в офисе, 1 день на объектах Заказчика (Москва и МО).<br /><br /></p>', '', '0', '0', '', '', '', '2', '248', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-17 12:55:57'),
('249', '7', 'Программист С#', 'Программист С#', 'Самара', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<ul>\r\n<li>Знание С#, .NET Fundamentals,</li>\r\n<li>Знание сетевого программирования, многопоточного программирования,</li>\r\n<li>умение работать в команде.</li>\r\n</ul>\r\n<p>Будет плюсом:</p>\r\n<ul>\r\n<li>опыт разработки распределительных высоконагруженных сетевых приложений,</li>\r\n<li>знание WPF, WiX, C++/CLI, (MVVM),</li>\r\n<li>опыт руководства группой разработчиков.<br /><br /></li>\r\n</ul>', '<ul>\r\n<li>участие в разработке и проектировании серверных компонент систем видеонаблюдения и безопасности,</li>\r\n<li>поддержка и развитие текущих проектов.</li>\r\n</ul>', '<p>В компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности в г. Зеленоград, требуется специалист на позицию \"Программист C#\".</p>\r\n<p>Работа на базе подразделения в г. Самара.</p>\r\n<p>Заработная плата: обсуждается индивидуально на собеседовании</p>\r\n<p>Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '249', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-18 12:35:03'),
('250', '7', 'Ведущий программист C++', 'Ведущий программист C++', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<ul>\r\n<li>Опыт работы в релевантной должности от 1-го года;</li>\r\n</ul>\r\n<p>Обязательно:</p>\r\n<ul>\r\n<li>знание C++,</li>\r\n<li>STL,</li>\r\n<li>Boost,</li>\r\n<li>сетевого программирования,</li>\r\n<li>многопоточного программирования,</li>\r\n<li>умение работать в команде.</li>\r\n</ul>\r\n<p>Будет плюсом:</p>\r\n<ul>\r\n<li>опыт разработки распределенных высоконагруженных сетевых приложений,</li>\r\n<li>опыт разработки систем передачи видео/звука по сети,</li>\r\n<li>знание SQL.</li>\r\n</ul>', '<ul>\r\n<li>Участие в разработке и проектировании серверных компонент систем видеонаблюдения и безопасности;</li>\r\n<li>Поддержка и развитие текущих проектов.</li>\r\n</ul>', '<p>В компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности в г. Зеленоград, требуется специалист на позицию \"Ведущий программист C++\".</p>\r\n<p>Заработная плата: обсуждается индивидуально на собеседовании</p>\r\n<p>Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '250', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-18 13:40:54'),
('252', '15', 'Монтажник лифтового оборудования', 'Монтажник лифтового оборудования', 'Москва и МО', '0', '1970-01-01', '', '', '<p>Оклад 25 000 руб. + ежемесячные премии в зависимости от выработки.</p>', '<p>Для строительной организации требуются монтажники лифтового оборудования на полную занятость по Москве и Московской области. </p>\r\n<p>Образование: среднее, среднее специальное;<br />Опыт работы по специальности: от 3-х лет;<br />Отсутствие противопоказаний по здоровью, допуск к работе на высоте.</p>', '<p>Монтаж лифтового оборудования.</p>', '<p>График работы 5/2;<br />Оформление по ТК РФ;<br />Испытательный срок: 3 месяца;<br />Заработная плата: оклад 25 000 руб. + ежемесячные премии в зависимости от выработки, заработная плата полностью белая;<br />Обеспечение спецодеждой, инструментом;<br />Иногородним предоставляется общежитие.</p>', '', '0', '0', '', '', '', '2', '252', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-20 17:12:09'),
('253', '12', 'Специалист по учебно-методической работе', 'Специалист по учебно-методической работе', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад + премии, обсуждается на собеседовании.</p>', '<p>В зеленоградский университет требуется \"Специалист по учебно-методической работе\".</p>\r\n<p>Образование: высшее, желательно техническое;<br />Необходимый стаж работы по специальности: от 1 года.<br />Необходимые навыки:<br />• Опыт работы в сфере образования;<br />• Понимание учебного процесса;<br />• Знание современных учебных пособий и методик преподавания;<br />• Грамотная устная и письменная речь;<br />• Умение работать с документами.<br />ПК: уверенный пользователь ПК, владение пакетом MS Office, Internet.</p>', '<p>• Выполнение методической работы по планированию и организации учебного процесса;<br />• Разработка учебных программ, учебного плана;<br />• Составление расписания занятий студентов и преподавателей;<br />• Подготовка отчетов для учебного отдела ВУЗа.</p>', '<p>Место расположения: г. Зеленоград;<br />Заработная плата: оклад + премии, обсуждается на собеседовании;<br />Социальные льготы: оформление по ТК РФ, ежегодный отпуск, оплата больничного;<br />Режим работы: 5/2, с 9 до 18;<br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '253', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-26 12:54:43'),
('254', '25', 'Помощник руководителя (заведующего кафедрой)', 'Помощник руководителя (заведующего кафедрой)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад + премии, обсуждается на собеседовании.</p>', '<p>В зеленоградский университет требуется \"Помощник руководителя (заведующего кафедрой)\".</p>\r\n<p>Образование: высшее, желательно техническое;<br />Необходимый стаж работы по специальности: от 1 года (также готовы рассмотреть кандидатов без опыта работы по специальности).<br />Необходимые навыки:<br />• Грамотная устная и письменная речь;<br />• Лояльный характер, самоконтроль;<br />• Умение работать с документами;<br />• Навыки ведения делопроизводства.<br />ПК: уверенный пользователь ПК, владение пакетом MS Office, Internet.</p>', '<p>• Учет обращений и контроль исполнения поручений руководителя;<br />• Подготовка документов от имени руководителя;<br />• Ведение деловой переписки (электронной и бумажной);<br />• Организация кафедральных мероприятий - заседания, собрания и т.д.;<br />• Взаимодействие со структурами ВУЗа по направлениям деятельности кафедры (отдел кадров, приемная комиссия и др.).</p>', '<p>Место расположения: г. Зеленоград;<br />Заработная плата: оклад + премии, обсуждается на собеседовании;<br />Социальные льготы: оформление по ТК РФ, ежегодный отпуск, оплата больничного;<br />Режим работы: 5/2, с 9 до 18;<br />Командировки: нет.</p>', '', '0', '0', '', '', '', '2', '254', '*', '0', '0000-00-00 00:00:00', '479', '2020-02-26 12:57:49');
/**ABDB**/INSERT INTO `#__cwhire_`  VALUES 
('255', '7', 'Программист embedded', 'Программист embedded', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее</p>\r\n<p>Опыт работы: от 1 года</p>\r\n<p>Навыки</p>\r\n<p>- Опыт программирования под ОС GNU/Linux (С/С++).<br />- Желательно опыт работы в области обработки изображений/видео<br />- Понимание принципов работы камеры и процесса обработки сырых данных с камеры (Camera Processing Pipeline).<br />- Знакомство с технологиями видео-кодирования MPEG-4, H.264, H.265, etc.<br />- Отличное знание принципов работы операционной системы Linux.<br />- Умение собрать образ операционной системы из исходных кодов под различные платформы (Linux From Scratch).<br />- Знание принципов работы протоколов UART, I2C, SPI, CAN, USB, Ethernet.<br />- Опыт работы с периферийными устройствами (память, датчики и тд.).<br />- Знание языков программирования C и С++.<br />Знание иностранного языка: знание технического английского языка</p>', '<p>- Участие в исследовательской работе при разработке новых продуктов компании.<br />- Разработка прикладного программного обеспечения для ОС GNU/Linux (С/С++)<br />- Разработка драйверов устройств для ОС GNU/Linux<br />- Поддержка ранее разработанного ПО (С/С++)</p>', '<p>В зеленоградскую компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности, требуется специалист на позицию \"Программист embedded\".<br />Полностью белая заработная плата (обсуждается с каждым кандидатом индивидуально);<br />Социальные льготы: полное соблюдение ТК, офис в экологически чистом районе Москвы (г. Зеленоград) рядом с лесом и водоемом; работа на современном оборудовании (высокопроизводительные компьютеры, большие мониторы и т.д.);<br />Режим работы: пятидневная рабочая неделя.</p>', '', '0', '0', '', '', '', '2', '255', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-04 11:19:30'),
('256', '14', 'Менеджер отдела продаж (электронные компоненты)', 'Менеджер отдела продаж (электронные компоненты)', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад на испытательный срок в 2 месяца фиксированный: 50 000-80 000 руб. по результатам собеседования.</p>', '<p>Образование: высшее (желательно техническое)<br />Опыт работы в продажах корпоративным заказчикам на рынке электронных компонентов.<br />Навыки:<br />• Опытный пользователь ПК (пакет MS Office (Excel, Word), 1C Предприятие, эл.почта).<br />• Знание первичной бухгалтерской документации.<br />Личные качества:<br />• Активная жизненная позиция, умение работать на результат, высокая степень самомотивации.<br />• Энергичность, умение находить решение в сложных ситуациях.<br />• Ответственность, честность.<br />• Высокоразвитые навыки общения, умение налаживать и поддерживать конструктивные отношения, коммуникабельность, грамотная речь<br />• Стремление к профессиональному росту.<br />• Умение работать в команде.</p>', '<p>• Развитие бизнеса с клиентами по активным линейкам компании.<br />• Выполнение плана продаж при сохранении заданного уровня прибыльности и оборачиваемости склада<br />• Обсуждение условий сотрудничества с клиентами, принятие решения о сделке, управление рисками, оформление коммерческих предложений, договоров.<br />• Оформление счетов и отгрузочных документов в 1С8.<br />• Размещение заявок на закупку продукции, и их мониторинг в 1С8.<br />• Контроль дебиторской задолженности клиентов.<br />• Заполнение отчетов о своей работе.<br />• Обучение/постановка задач помощнику менеджера.</p>', '<p>Работа в офисе: г. Зеленоград,<br />График: 5/2, с 9.00 до 18.00 (с перерывом на обед).<br />Заработная плата: оклад + % с продаж.<br />Оклад на испытательный срок в 2 месяца фиксированный: 50 000-80 000 руб. по результатам собеседования.<br />Оформление в соответствии с Трудовым кодексом РФ.<br />Бесплатные обеды.</p>', '', '0', '0', '', '', '', '2', '256', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-04 17:18:51'),
('257', '3', 'Бухгалтер-экономист', 'Бухгалтер-экономист', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: высшее (бухгалтерское, экономическое, финансовое)<br />Необходимый стаж работы по специальности: от 3х лет, желательно в производственной компании<br />Необходимые навыки:<br />- Высокое чувство ответственности<br />- Исполнительность<br />- Обучаемость.<br />Готовность к освоению различных участков бухгалтерского учета.<br />ПК: Уверенный пользователь ПК (Excel; Word), знание программы 1С 8.3.</p>', '<p>• Ведение управленческого учета;<br />• Работа с первичной документацией;<br />• Начисление заработной платы, формирование отчетности по заработной плате.</p>', '<p>В компанию, специализирующуюся на предоставлении услуг по нанесению защитных покрытий на металлоконструкции и по промышленной очистке, требуется специалист на позицию Бухгалтер-экономист.<br />Заработная плата обсуждается на собеседовании.<br />Оформление в соответствии с ТК РФ.<br />Бесплатная парковка на территории Бизнес-центра.<br />Режим работы: 5/2, с 9:30 до 18:00.</p>', '', '0', '0', '', '', '', '2', '257', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-06 16:40:42'),
('258', '7', 'Ведущий frontend программист', 'Ведущий frontend программист', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Полностью белая заработная плата (обсуждается с каждым кандидатом индивидуально).</p>', '<p>В зеленоградскую компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности, требуется специалист на позицию \"Ведущий frontend программист\".</p>\r\n<p>Обязательно:<br />- знание JavaScript; <br />- AngularJS;<br />- Bootstrap;<br />- WebGL;<br />- WebSocket;<br />- HTML5;<br />- CSS3;<br />- умение работать в команде.<br />Будет плюсом:<br />- понимание технологии emscripten.</p>', '<p>- Участие в разработке и проектировании пользовательского web интерфейса систем видеонаблюдения и безопасности;<br />- Поддержка и развитие текущих проектов.</p>', '<p>Полностью белая заработная плата (обсуждается с каждым кандидатом индивидуально);<br />Социальные льготы: полное соблюдение ТК, офис в экологически чистом районе Москвы (г. Зеленоград) рядом с лесом и водоемом; работа на современном оборудовании (высокопроизводительные компьютеры, большие мониторы и т.д.);<br />Режим работы: пятидневная рабочая неделя.</p>', '', '0', '0', '', '', '', '2', '258', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-12 13:28:19'),
('259', '15', 'Инженер-схемотехник', 'Инженер-схемотехник', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается индивидуально на собеседовании, белая заработная плата</p>', '<p>В зеленоградскую компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности, требуется специалист на позицию \"Инженер-схемотехник\".</p>\r\n<p>Образование: высшее<br />Необходимый стаж работы по специальности: от 1-го года<br />Необходимые навыки:<br />Опыт работы схемотехником не менее 1 года.<br />Глубокое знание современной элементной базы.<br />Знание аналоговой, цифровой и высокочастотной схемотехники, опыт работы в Altium Designer/ Mentor Graphics, разводка многослойных печатных плат.<br />Опыт разработки схемотехники под микроконтроллеры, ПЛИС, АЦП/ЦАП, датчики.<br />Умение работать с I2C, SPI, RS-232, RS-485, 1-wire, Ethernet.<br />Знание технологий производства печатных плат.<br />Умение пользоваться паяльным и измерительным оборудованием.<br />Знание иностранного языка: знание английского языка приветствуется.</p>', '<p>Разработка микропроцессорных подсистем и цифровых узлов оборудования на базе процессоров архитектуры ARM/MIPS и ПЛИС.<br />Разработка принципиальных аналоговых и/или цифровых схем.<br />Разводка печатных плат с использованием специального программного обеспечения (Altium Designer/ Mentor Graphics).<br />Моделирование критически важных участков электрических принципиальных схем.<br />Отладка прототипов изделий.<br />Написание базовой документации для использования внутри и за пределами компании.<br />Участие в испытаниях изделий, составление программ и методик испытаний.<br />Составление комплекта технической документации согласно ЕСКД.<br />Техническое сопровождение опытных образцов, перевод изделий в серийное производство.</p>', '<p>Заработная плата (размер и форма оплаты): обсуждается индивидуально на собеседовании, белая заработная плата<br />Социальные льготы: полное соблюдение ТК<br />Режим работы: пятидневная рабочая неделя (5/2, 9-18)</p>', '', '0', '0', '', '', '', '2', '259', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-16 16:32:06'),
('260', '7', 'Ведущий программист C#', 'Ведущий программист C#', 'Самара', '0', '1970-01-01', '', '', '<p>Обсуждается индивидуально на собеседовании.</p>', '<p>В компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности в г. Зеленоград, требуется специалист на позицию \"Ведущий программист C#\".</p>\r\n<p>Образование: высшее;</p>\r\n<p>Опыт работы: от 3х лет;</p>\r\n<p>- знание С#, .NET Framework, <br />- знание сетевого программирования, <br />- знание многопоточного программирования, <br />- умение работать в команде<br />Будет плюсом: <br />- опыт разработки распределенных высоконагруженных сетевых приложений, <br />знание WPF, WiX, C++/CLI, ASP.NET (MVVM), SQL, <br />опыт руководства группой разработчиков.</p>', '<p>- участие в разработке и проектировании пользовательского интерфейса систем видеонаблюдения и безопасности;<br />- поддержка и развитие текущих проектов.</p>', '<p>Работа на базе подразделения в г. Самара.<br />Заработная плата: обсуждается индивидуально на собеседовании<br />Оформление по ТК РФ</p>', '', '0', '0', '', '', '', '2', '260', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-17 10:06:09'),
('262', '7', 'Разработчик ПО Linux', 'Разработчик ПО Linux', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается с каждым кандидатом индивидуально.</p>', '<p>В зеленоградскую компанию, которая является ведущим разработчиком и производителем высокотехнологичных систем безопасности, требуется специалист на позицию \"Разработчик ПО Linux\".</p>\r\n<p>Опыт программирования под ОС GNU/Linux (С/С++);<br />Желательно опыт работы в области обработки изображений/видео;<br />Понимание принципов работы камеры и процесса обработки сырых данных с камеры (Camera Processing Pipeline);<br />Знакомство с технологиями видео-кодирования MPEG-4, H.264, H.265, etc.;<br />Отличное знание принципов работы операционной системы Linux;<br />Умение собрать образ операционной системы из исходных кодов под различные платформы (Linux From Scratch);<br />Знание принципов работы протоколов UART, I2C, SPI, CAN, USB, Ethernet;<br />Опыт работы с периферийными устройствами (память, датчики и тд.);<br />Знание языков программирования C и С++;<br />Технический английский;<br />Коммуникабельность.<br />Приветствуются знания:<br />Buildroot, oolchain, RTSP, ONVIF, systemd, GStreamer.</p>', '<p>- Участие в исследовательской работе при разработке новых продуктов компании;<br />- Разработка прикладного программного обеспечения для ОС GNU/Linux (С/С++);<br />- Разработка драйверов устройств для ОС GNU/Linux.</p>', '<p>Полностью белая заработная плата (обсуждается с каждым кандидатом индивидуально);<br />Социальные льготы: полное соблюдение ТК, офис в экологически чистом районе Москвы (г. Зеленоград) рядом с лесом и водоемом; работа на современном оборудовании (высокопроизводительные компьютеры, большие мониторы и т.д.);<br />Режим работы: пятидневная рабочая неделя.</p>', '', '0', '0', '', '', '', '2', '262', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-17 10:43:46'),
('264', '18', 'Водитель на личном автомобиле', 'Водитель на личном автомобиле', 'Андреевка', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В интернет-магазин фермерских продуктов питания требуется \"Водитель на личном автомобиле\".</p>\r\n<p>Наличие автомобиля типа \"каблук\" (с рефрижератором – преимущество).<br />Необходимые навыки: <br />- Наличие действующих прав категории В;<br />- Стаж вождения от 3 лет;<br />- Знание правил ПДД;<br />- Оперативность;<br />- Пунктуальность;<br />- Стрессоустойчивость;<br />- Неконфликтность;<br />- Опрятный внешний вид;<br />- Желательно без вредных привычек.</p>', '<p>- Закупка необходимых продуктов для интернет-магазина;<br />- Выполнение поручений руководителя.</p>', '<p>Заработная плата: оклад (обсуждается на собеседовании) + компенсация ГСМ, оплата мобильной связи, возможность приобретать продукты питания со скидкой;<br />Режим работы: 5/2, плавающие выходные;<br />Офис и склад компании расположены недалеко от Зеленограда, в пос. Андреевка.</p>', '', '0', '0', '', '', '', '2', '264', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-20 15:38:19'),
('265', '15', 'Инженер по ремонту электроники', 'Инженер по ремонту электроники', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад (от 50 000 руб.) + премии за успешно завершенные проекты.</p>', '<p>В молодую, стремительно развивающуюся компанию требуется \"Инженер по ремонту электроники\". </p>\r\n<p>Образование: среднее специальное и выше;<br />Знание иностранных языков: английский или немецкий, разговорный;<br />Совершенное владение ПК;<br />Наличие прав категории В;<br />Целеустремленность, коммуникабельность, аккуратность;<br />Стремление к изучению, освоению и применению новых знаний и технологий;<br />Чтение и понимание электронных схем; <br />Знание элементной базы;<br />Диагностика, подбор аналогов. <br />Обязательное требование: <br />Силовая электроника: <br />- частотные преобразователи<br />- выпрямители, контроллеры, и пр. <br />Желательно:<br />- проектирование и производство механических компонентов;<br />- программирование ПЛК и панелей оператора; <br />- работа с промышленными полевыми шинами.</p>', '<p>Основные виды деятельности: ремонт и обслуживание приводов Baumueller, проекты и решения Baumueller.<br />Основные виды продукции: ПЛК, панели оператора, датчики.<br />- Технические консультации Заказчиков; <br />- Диагностика приводов Baumueller на площадке работодателя;<br />- Диагностика и ремонт (настройка, ПНР, обслуживание) приводов Baumueller на площадке Заказчика;<br />- Подбор нового оборудования, в замен устаревшего;<br />- Подготовка, согласование и защита технической документации по проектам;<br />- Организация, контроль и приемка работ подрядчиков;<br />- Проведение, согласование и организация работ на объекте Заказчика;<br />- Пред проектные работы;<br />- Переговоры, интервью, сдача работ Заказчику;<br />- Письменные отчеты, отчеты по проектам по их завершению.<br />В подчинении будут находится: электромеханики, а так же временные работники и подрядчики.</p>', '<p>Место работы: г. Зеленоград;<br />График работы: 5/2, с 9.00 до 18.00;<br />Заработная плата: оклад (не ниже 50 000 руб.) + премии за успешно завершенные проекты;<br />Оформление: по ТК РФ;<br />Испытательный срок: 3 месяца;<br />Командировки: да, по ЕАЭС.</p>', '', '0', '0', '', '', '', '2', '265', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-27 14:02:53'),
('266', '15', 'Обмотчик элементов электрических машин', 'Обмотчик элементов электрических машин', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад (от 50 000 руб.) + премии за успешно завершенные проекты.</p>', '<p>В зеленоградскую компанию, занимающуюся ремонтом и обслуживанием электродвигателей постоянного и переменного тока Baumueller, GRAF-SYTECO и другого электрооборудования, требуется \"Обмотчик элементов электрических машин\".</p>\r\n<p>Обязательные требования:</p>\r\n<p>Образование: среднее специальное и выше;<br />Совершенное владение ПК;<br />Наличие прав категории В;<br />Опыт ремонта электродвигателей постоянного тока с независимым возбуждением;<br />Чтение и составление схем обмоток электродвигателей;<br />Знание основ устройства и работы электродвигателей, способов обнаружения и устранение неисправностей;<br />Умение пользоваться измерительным и испытательным приборами.<br />Целеустремленность, коммуникабельность, аккуратность.</p>\r\n<p><br />Желательные требования:</p>\r\n<p>Знание иностранных языков: английский или немецкий, разговорный.</p>\r\n<p> </p>', '<p>Основные виды деятельности: ремонт и обслуживание электродвигателей постоянного и переменного тока Baumueller.<br />Выполнение работ согласно регламента отдела и непосредственно<br />руководителя.<br />Обязанности:<br />- обмотка элементов электрических машин;<br />- подготовка пазов к обмотке;<br />- протяжка одно- / двухслойной обмотки статора в пазы;<br />- укладка обмотки и уплотнение.<br />Обмотчик элементов электрических машин осуществляет:<br />- Соединение обмоток статоров по сложным схемам;<br />- Установку соединительных шин и пайку;<br />- Загибку концов секций с числом параллельных проводников до двух;<br />- Закрепление обмотки клиньями;<br />- Соединение обмотки по простым схемам;<br />- Рихтовку лобовых частей обмоток, разметку по схеме, подгонку, укладку, уплотнение, заклиновку обмоток;<br />- Соединение, крепление междукатушечных и межполосных соединений шнуром или лентой;<br />- Приготовление обмотки к испытанию;<br />- Установку соединительных шин, укладку уравнителей и термопар;<br />- Сборку и доводку электрических машин и аппаратов различной сложности в зависимости от квалификации;<br />- Балансировку электрических машин;<br />- Эксплуатацию проволочно-намоточных машин для наматывания мотков проволоки,<br />применяющихся в составе такого электрического оборудования и компонентов,<br />как электродвигатели и генераторы.<br />- Проводит осмотр и испытания готовых компонентов и узлов, монтаж проводки и цепей, а также<br />отбраковку неисправных сборочных узлов.<br />Обмотчик элементов электрических машин должен знать:<br />- Устройство и правила сборки обмоток уникальных элементов электрических машин;<br />- Конструкцию и назначение технологической оснастки и оборудования;<br />- Регулировку, подгонку каналов и методы испытания обмоток по электрическим параметрам.</p>', '<p>Место работы: г. Зеленоград;<br />График работы: 5/2, с 9.00 до 18.00;<br />Заработная плата: оклад (от 50 000 руб.) + премии за успешно завершенные проекты;<br />Оформление: по ТК РФ;<br />Испытательный срок: 3 месяца;<br />Командировки: да, по ЕАЭС.</p>', '', '0', '0', '', '', '', '2', '266', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-27 16:02:55'),
('267', '15', 'Менеджер проектов', 'Менеджер проектов', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад (от 50 000 руб.) + премии за успешно завершенные проекты.</p>', '<p>В молодую, стремительно развивающуюся компанию требуется \"Менеджер проектов\".</p>\r\n<p>Образование: высшее;<br />Знание иностранных языков: английский или немецкий, разговорный;<br />Совершенное владение ПК;<br />Наличие прав категории В;<br />Целеустремленность, коммуникабельность, аккуратность.<br />Конкретные виды профессионального оборудования:<br />- промышленные контроллеры;<br />- панели оператора;<br />- электропривод.<br />Желательно:<br />- проектирование и производство механических компонентов;<br />- программирование ПЛК и панелей оператора;<br />- работа с промышленными полевыми шинами.</p>', '<p>Основные виды деятельности: ремонт и обслуживание приводов Baumueller, проекты и решения Baumueller.<br />Основные виды продукции: ПЛК, панели оператора, датчики.<br />- Составление и согласование с Заказчиками ТЗ;<br />- Полное сопровождение проекта на всех стадиях;<br />- Делегирование и контроль задач по проектам на отделы и/или аутсорсинг;<br />- Подготовка и защита презентаций по техническим решениям и проектам;<br />- Подготовка, согласование и защита технической документации по проектам;<br />- Организация, контроль и приемка работ подрядчиков;<br />- Проведение, согласование и организация работ на объекте Заказчика;<br />- Пред проектные работы;<br />- Переговоры, интервью, сдача работ Заказчику.</p>', '<p>Место работы: г. Зеленоград;<br />График работы: 5/2, с 9.00 до 18.00;<br />Заработная плата: оклад (от 50 000 руб.) + премии за успешно завершенные проекты;<br />Оформление: по ТК РФ;<br />Испытательный срок: 3 месяца;<br />Командировки: да, по ЕАЭС.</p>', '', '0', '0', '', '', '', '2', '267', '*', '0', '0000-00-00 00:00:00', '479', '2020-03-27 16:10:43'),
('268', '5', 'Семейная пара с проживанием', 'Семейная пара с проживанием', 'Сходня', '0', '1970-01-01', '', '', '<p>Заработная плата обсуждается непосредственно с работодателем</p>', '<p>В частный дом требуется семейная пара (дом 500 кв.м., участок 40 соток). </p>\r\n<p>Образование: среднее и выше;<br />Стаж работы и профессиональный опыт: от 3 лет в аналогичной должности;<br />- опыт работы в семьях в аналогичной должности;<br />- наличие рекомендаций;<br />- у мужа должны быть права категории B, он должен быть исполнительным, со знанием работы<br />по дому, чтобы смог провести мелкий ремонт;<br />- также муж должен иметь опыт работы с бассейном (очистка бассейна, очистка фильтров);<br />- жена должна уметь готовить.<br />Спокойные, ответственные, доброжелательные, внимательные к деталям люди.</p>', '<p>В мужские обязанности входит:<br />- поездки в магазин / на рынок / по личным поручениям на машине (машина предоставляется);<br />- работа по дому (мелкий ремонт);<br />- работа по участку (уход за газоном, уход за растительностью);<br />- обслуживание бассейна (очистка бассейна, очистка фильтров);<br />- уход за территорией.<br />В женские обязанности входит:<br />- приготовление пищи (по потребности, не каждый день);<br />- сухая и влажная уборка дома;<br />- стирка, глажка;<br />- сезонное мытье окон;<br />- другие поручения, связанные с домашним хозяйством.</p>', '<p>Работа на постоянной основе с проживанием (недалеко от частного дома расположен<br />многоквартирный дом, в нем для проживания отводится 2-х комнатная квартира, проживание<br />в квартире оплачивает работодатель).<br />Для работы предоставляется автомобиль.<br />График работы: 6/1, предоставляется выходной и отпуск.<br />Условия оплаты труда и другие мотивации: заработная плата обсуждается непосредственно с работодателем.</p>', '', '0', '0', '', '', '', '2', '268', '*', '0', '0000-00-00 00:00:00', '479', '2020-04-22 12:09:55'),
('269', '10', 'PR-менеджер', 'PR-менеджер', 'Химки', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Образование: Высшее</p>\r\n<p>Опыт работы: От 2 лет</p>\r\n<p>Отличные коммуникативные навыки, чуткое отношение к людям, умение работать с негативом.<br />Владение русским языком:<br />- умение писать тексты, пресс-релизы, статьи, интервью, комментарии.<br />Знания в области дизайна:<br />- умение быстро сделать иллюстрацию, знание Photoshop или других графических программ;<br />- знание разницы между хорошим и плохим фото для СМИ.<br />Базовые знания в области SMM.<br />Обучаемость. Использование современных сервисов для автоматизации работы (рассылки, дизайн, сервисы вовлечения).<br />Любовь к трендам.<br />Проактивность, стрессоустойчивость.<br />Английский язык - не ниже уровня Intermediate (письменный обязателен).</p>', '<p>Press-relations:<br />- Создание текстов о проектах компании (написание пресс-релизов, комментариев, текстов для сайта группы компаний, составление пресс-китов).<br />- Поддержание актуальной базы СМИ (желательно наличие собственных контактов в СМИ)<br />- Взаимодействие со спикерами и журналистами.<br />Event-поддержка:<br />- Интеграция в профильные мероприятия (выставки, конференции).<br />- Создание кита раздаточных материалов: брошюра, базовая сувенирная продукция, рекламные конструкции.<br />Внутренние коммуникации:<br />- Организация внутрикорпоративных мероприятий, лекций, семинаров и корпоративов для сотрудников.<br />Интернет и SMM:<br />- Реализация стратегии присутствия компании в интернете: сведение сайта, определение каналов в социальных сетях (Facebook, Twitter, Instagram), налаживание работы социальных сетей, поддержание актуальной информации.</p>', '<p>В группу российских высокотехнологичных фармацевтических компаний требуется специалист на позицию PR-менеджер.<br />Место работы находится в Химках, график работы: 5/2, с 9:00 до 18:00 или с 10:00 до 19:00.<br />Должностные командировки: бывают не часто.<br />Трудоустройство по ТК РФ, оплачиваемый отпуск, \"белая\" заработная плата.<br />Есть перспективы карьерного роста.<br />Заработная плата обсуждается индивидуально, по результатам собеседования.</p>', '', '0', '0', '', '', '', '2', '269', '*', '0', '0000-00-00 00:00:00', '479', '2020-04-23 11:05:05'),
('270', '14', 'Заместитель коммерческого директора', 'Заместитель коммерческого директора', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании</p>', '<p>В зеленоградскую компанию, занимающуюся оптовой торговлей товарами для праздника, требуется \"Заместитель коммерческого директора\".</p>\r\n<p>Образование: Высшее (возможно среднее специальное при наличии опыта работы по профилю);<br />Необходимый стаж работы по специальности: от 2х лет;<br />Необходимые навыки: проведение сверки расчетов с клиентом;<br />Знание иностранного языка: приветствуется;<br />ПК: уверенный пользователь ПК, свободное владение программами Excel, Word, умение<br />работать с электронными фотографиями;<br />Дополнительные требования: приветствуется первичные знания бухгалтерского учета.</p>', '<p>- Прием и обработка заказов в учетной системе организации (САП);<br />- Оформление отгрузочной и сопроводительной документации;<br />- Отслеживание и выполнение договорных условий при организации поставок товара;<br />- Проведение сверки расчетов;<br />- Формирование и согласовывание ассортиментных предложений;<br />- Работа с претензиями и задолженностью (при наличии);<br />- Работа с федеральными и региональными сетевыми структурами: АШАН, Перекресток,<br />Детский мир, Метро;<br />- Работа с Marketplaces: Озон и т.д.</p>', '<p>Место работы: г. Зеленоград;<br />Заработная плата: обсуждается на собеседовании;<br />Социальные льготы: в соответствии с ТК РФ, доп. соц. пакет.;<br />Режим работы: с 9.00 до 18.00;<br />Командировки: да (иногда необходимы);<br />Испытательный срок: 2 месяца.</p>', '', '0', '0', '', '', '', '2', '270', '*', '0', '0000-00-00 00:00:00', '479', '2020-05-15 10:43:47'),
('272', '14', 'Менеджер по работе с маркетплейсами', 'Менеджер по работе с маркетплейсами', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>40 000 руб. + % от продаж</p>', '<p>В перспективную компанию в области производства и поставок комплектующих для евроокон и дверей требуется \"Менеджер по работе с маркетплейсами\".</p>\r\n<p>Образование: среднее специальное и выше;<br />Необходимый стаж работы по специальности: от 1 года;<br />Необходимые навыки:<br />- хорошее знание программ по обработке фотографий;<br />- хорошее знание программы 1С Предприятие 8.3;<br />- коммуникабельность, стрессоустойчивость, ответственность.<br />Желательно наличие собственного автомобиля - чтобы добираться до офиса (общественный транспорт ходит от Солнечногорска и Зеленограда. Офис находится в 100 метрах от Ленинградского шоссе).</p>', '<p>Организация и ведения продаж с нуля в:<br />- маркетплейсах;<br />- социальных сетях;<br />- на собственном сайте (с доработкой сайта под интернет продажи);<br />- на интернет сайтах крупных и мелких строительных сетевых магазинов Москвы, МО и регионов.<br />Ведение электронного документа оборота на платформе SYNERDOCS;<br />Организация отгрузок по заявкам маркетплейсов и интернет продаж.<br />Дополнительная информация: ассортимент товара не большой - до 100 позиций.<br />Стройматериалы (ручки для ПВХ окон, москитная сетка, радиаторы отопления).</p>', '<p>Место работы: Московская область, Солнечногорский район, д. Дурыкино;<br />Режим работы: 5/2, полный рабочий день;<br />Командировки: редко;<br />Заработная плата: 40 000 руб. + % от продаж.</p>', '', '0', '0', '', '', '', '2', '272', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-02 11:22:42'),
('273', '7', 'Программист 1С', 'Программист 1С', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>• Высшее техническое образование.<br />• Понимание существующего кода программы.<br />• Умение правильно встраивать свой код в стандартные конфигурации 1С.<br />• Знание одной или нескольких типовых конфигураций 1С: БП, УТ, УПП, опыт их доработки.<br />• Желательно наличие сертификатов 1С уровня специалист.<br />• Желателен опыт работы с основными механизмами платформы 8.2 / 8.3 не менее 2-3 лет.<br />• Аккуратность.<br />• Умение работать с большими объемами информации.<br />• Желание развиваться в сфере ERP, построения архитектуры 1С.</p>', '<p>• Создание архитектуры 1С, настройка и конфигурирование программных продуктов, программирование в среде 1С: Предприятие 8.x.<br />• Анализ существующего кода, выявление, устранение ошибок.<br />• Оптимизация производительности.<br />• Работа под руководством старшего специалиста.</p>', '<p>В компанию, занимающуюся производством и дистрибуцией электронных компонентов, требуется специалист на позицию \"Программист 1С\".<br />Заработная плата: обсуждается индивидуально.<br />Оформление по ТК РФ.</p>', '', '0', '0', '', '', '', '2', '273', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-02 16:02:53'),
('274', '17', 'Начальник участка на строительную площадку', 'Начальник участка на строительную площадку', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>- Образование среднее специальное или выше.<br />- Опыт работы с алюминиевыми конструкциями.<br />- Знание СНиПов, ГОСТов.<br />- Умение организовать работу участка.<br />- Умение разбираться в проектно-сметной документации.</p>', '<p>- Ведение технической и отчетной документации на объекте.<br />- Организация, ведение полного цикла работ на объекте от выхода на строительную площадку до ввода объекта в эксплуатацию.<br />- Постановка производственного задания Бригадирам, приемка выполненной работы.<br />- Контроль соблюдения требований охраны труда.<br />- Планирование и контроль выполнения работ на объекте.<br />- Работа с Заказчиком по вопросам согласования технических решений.<br />- Взаимодействие с контролирующими и проверяющими органами.</p>', '<p>В международную компанию, занимающуюся производством и реализацией светопрозрачных конструкций, требуется специалист на позицию \"Начальник участка на строительную площадку\" с опытом работы с алюминиевыми конструкциями.<br />Расположение производства: г. Солнечногорск.<br />Разъездной характер работы, работа преимущественно на стройке и очень редко в офисе.<br />График работы: 5/2.<br />Оформление по ТК РФ.<br />Заработная плата обсуждается индивидуально и зависит от профессиональных характеристик кандидата.</p>', '', '0', '0', '', '', '', '2', '274', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-05 17:02:47'),
('275', '15', 'Инженер ПТО', 'Инженер ПТО', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>- Высшее техническое образование.<br />- Опыт работы в сфере навесных вентилируемых фасадов и светопрозрачных<br />конструкций обязателен.<br />- Знание ГОСТов и СНиПов.<br />- Знание AutoCad приветствуется.</p>', '<p>- Анализ проектной документации.<br />- Получение информации по выполненным работам с объектов для оформления<br />исполнительной документации.<br />- Подготовка и формирование полного комплекта исполнительной документации<br />по выполненным работам (исполнительных схем, паспортов, сертификатов,<br />заключений лабораторий и проч.)<br />- Сдача исполнительной документации заказчику.<br />- Контроль соответствия выполняемых работ и подготовленной исполнительной<br />документации утвержденной сметной документации.<br />- Ведение электронного архива проектной и исполнительной документации.<br />- Составление сводных ведомостей по доп. работам.<br />- Обеспечение объекта строительства необходимой технической и проектной<br />документацией.<br />- Защита и подписание документации в службе технического надзора заказчика.<br />- Подготовка форм КС-2, КС-3 и других форм отчетных документов.</p>', '<p>В международную компанию, занимающуюся производством и реализацией светопрозрачных конструкций, требуется специалист на позицию \"Инженер ПТО\" с опытом работы в данной сфере.<br />Расположение производства: г. Солнечногорск.<br />График работы: 5/2.<br />Оформление по ТК РФ.<br />Заработная плата обсуждается индивидуально и зависит от профессиональных характеристик кандидата.</p>', '', '0', '0', '', '', '', '2', '275', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-05 17:03:53'),
('277', '15', 'Мастер по ремонту бытовой техники', 'Мастер по ремонту бытовой техники', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Оклад 20 000 руб. + премии в размере 20-25% от дохода.</p>', '<p>В мастерскую по ремонту и обслуживанию бытовой техники требуется \"Мастер по ремонту бытовой техники\".</p>\r\n<p>Образование: среднее и выше;<br />Опыт работы: от 1 года;<br />Умение проводить ремонт бытовой техники;<br />Ответственность, аккуратность, исполнительность, пунктуальность.</p>', '<p>- Диагностика неисправностей;<br />- Качественный ремонт и профилактика поломок;<br />- Замена неисправных запчастей.</p>', '<p>Место работы: г. Зеленоград;<br />Режим работы: 5/2, полный рабочий день;<br />Заработная плата: оклад 20 000 руб.+ премии в размере 20-25% от дохода.</p>', '', '0', '0', '', '', '', '2', '277', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-10 16:27:23'),
('278', '15', 'Мастер по ремонту бытовой техники', 'Мастер по ремонту бытовой техники', 'Москва', '0', '1970-01-01', '', '', '<p>Оклад 20 000 руб. + премии в размере 20-25% от дохода.</p>', '<p>В мастерскую по ремонту и обслуживанию бытовой техники требуется \"Мастер по ремонту бытовой техники\".</p>\r\n<p>Образование: среднее и выше;<br />Опыт работы: от 1 года;<br />Умение проводить ремонт бытовой техники;<br />Ответственность, аккуратность, исполнительность, пунктуальность.</p>', '<p>- Диагностика неисправностей;<br />- Качественный ремонт и профилактика поломок;<br />- Замена неисправных запчастей.</p>', '<p>Место работы: Москва, м. Октябрьское поле;<br />Режим работы: 5/2, полный рабочий день;<br />Заработная плата: оклад 20 000 руб.+ премии в размере 20-25% от дохода.</p>', '', '0', '0', '', '', '', '2', '278', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-10 16:29:43'),
('279', '17', 'Инженер-проектировщик', 'Инженер-проектировщик', 'Москва, м. Дубровка', '0', '1970-01-01', '', '', '<p>По договоренности</p>', '<p>Знание принципов устройства СПК и НВФ.<br />Знание профильных систем СИАЛ, Alutech, Schuko, Realit<br />Опыт разработки ППР на остекление и фасадные работы, знание основных узлов, примыканий и сечений в области СПК и НВФ.<br />Обязательное знание программ: MS.Word, MS.Excel, MSPowerPoint, AutoCAD, LogiKal, Schukal.</p>', '<p>- Проектирование светопрозрачных алюминиевых конструкций.<br />- Разработка полного комплекта чертежей КМ, КМД, выпуск спецификаций.<br />- Взаимодействие с архитекторами, проектировщиками, строителями по техническим вопросам проектов.<br />- Контроль над выполнением проектной документации в соответствии с ТЗ.<br />- Выезды на объекты.<br />- Разработка ППР и другой сопроводительной документации в составе исполнения работ по остеклению крупных жилых и коммерческих объектов.</p>', '<p>В международную компанию, занимающуюся изготовлением светопрозрачных алюминиевых металлоконструкций, требуется специалист на позицию Инженер-проектировщик.<br />Заработная плата: обсуждается на собеседовании и зависит от квалификационных характеристик кандидата.<br />Место работы: представительство компании в Москве в районе ст. м. Дубровка.<br />Первое собеседование проводится в офисе на производстве в г. Солнечногорск.<br />График работы: 5/2 (Пн-Пт), 8:00-17:00.<br />Оформление по ТК РФ.<br />Есть перспективы карьерного роста.</p>', '', '0', '0', '', '', '', '2', '279', '*', '0', '0000-00-00 00:00:00', '479', '2020-06-15 17:06:51'),
('280', '15', 'Нормоконтролер', 'Нормоконтролер', 'Зеленоград', '0', '1970-01-01', '', '', '<p>По результатам собеседования</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется специалист на позицию Нормоконтролер.</p>\r\n<p>Образование: Высшее техническое.<br />Необходимый стаж работы по специальности: от 3-х лет в аналогичной должности.<br />Необходимые навыки:<br />- Знание стандартов ЕСКД и ЕСТД (особенно приборостроительной отрасли);<br />- Наличие сертификатов и удостоверений приветствуется.<br />Личные качества:<br />- Внимательность;<br />- Умение работать с большим количеством документации;<br />- Умение находить компромиссные решения.</p>', '<p>- Нормоконтроль конструкторской документации (чертежи деталей, сборочные и габаритные чертежи, схемы электрические, спецификации, перечни и прочее);<br />- Нормоконтроль технической документации (технические условия на изделия, технические задания, руководства по эксплуатации, инструкции);<br />- Проверка технологической документации производства.</p>', '<p>Место работы: г. Зеленоград;<br />Режим работы: 5/2 с 9 до 18;<br />Работа в соответствие с ТК РФ;<br />Испытательный срок: до 3-х месяцев;<br />Заработная плата: по результатам собеседования с успешным кандидатом.</p>', '', '0', '0', '', '', '', '2', '280', '*', '0', '0000-00-00 00:00:00', '479', '2020-07-09 13:21:14'),
('281', '14', 'Менеджер по продажам', 'Менеджер по продажам', 'Зеленоград', '0', '1970-01-01', '', '', '<p>30 000 руб. + % от оптовых продаж. </p>', '<p>В перспективную компанию, которая занимается производством и поставками комплектующих для евроокон и дверей требуется \"Менеджер по продажам (комплектующих для евроокон и дверей)\".</p>\r\n<p>Образование: среднее специальное и выше<br />Необходимые навыки:<br />• Опыт оптовых продаж стройматериалов от 2х лет;<br />• Хорошее знание программ Word, Excel, CRM, 1С Предприятие 8.3;<br />• Коммуникабельность, стрессоустойчивость, ответственность.</p>', '<p>• Ведение поиска новых клиентов через личные контакты в интернете, СМИ, на выставках и используя другие источники (выдается небольшая база работающих клиентов, но поиск новых клиентов обязателен);<br />• Расширение продаваемого ассортимента товара старым Клиентам;<br />• Ведение переговоров с ген. директором, начальником отдела снабжения, техническими специалистами потенциальных Клиентов;<br />• Заключение договоров с потенциальными Клиентами;<br />• Составление и выполнение планов продаж;<br />• Составление Коммерческих предложений, маркетинговый анализ и корректировка цены реализации товара согласно рыночной ситуации;<br />• Оформление и корректировка счетов для Клиента в программе 1С Предприятие 8.3. Торговля и Склад;<br />• Ведение документооборота со своими клиентами;<br />• Введение базы клиентов в программу 1С Предприятие 8.3., CRM и в таблице Excel.</p>', '<p>Место работы: Московская область, д. Дурыкино (от Зеленограда ходит общественный транспорт, ехать около 15-20 минут. Офис находится в 100 метрах от Ленинградского шоссе);<br />Режим работы: 5/2, полный рабочий день;<br />Испытательный срок: 3 месяца;<br />Заработная плата: 30 000 руб. + % от оптовых продаж. Средний доход в месяц: 50 000 руб. – 100 000 руб.</p>', '', '0', '0', '', '', '', '2', '281', '*', '0', '0000-00-00 00:00:00', '479', '2020-07-20 15:52:30'),
('282', '5', 'Помощница по хозяйству', 'Помощница по хозяйству', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Будет обсуждаться на собеседовании</p>', '<p>В частный загородный дом, расположенный недалеко от Зеленограда в д. Поярково, требуется Помощница по хозяйству.</p>\r\n<p>Образование: среднее и выше<br />Необходимый стаж работы по специальности: от 2-х лет<br />Необходимые навыки: хозяйственность, умение готовить, опыт работы с детьми<br />• Наличие рекомендаций;<br />• Наличие действующей медицинской книжки.</p>', '<p>• Поддержание порядка и чистоты в доме;<br />• Приготовление пищи для взрослых и ребенка;<br />• Присмотр и уход за ребенком (мальчик, 7 лет);<br />• Прогулки с ребенком.</p>', '<p>Работа с проживанием, для проживания отводится небольшой отдельный дом со всеми удобствами (два этажа, на первом - санузел и кухня, на втором - спальня).<br />График работы: 6/1, предоставляется отпуск.<br />Заработная плата: будет обсуждаться на собеседовании.</p>', '', '0', '0', '', '', '', '2', '282', '*', '0', '0000-00-00 00:00:00', '479', '2020-07-27 12:23:32'),
('283', '16', 'Парикмахер-универсал', 'Парикмахер-универсал', 'Зеленоград', '2', '1970-01-01', '', '', '<p>Сдельная заработная плата, 45% от выручки, ежедневные выплаты, косметика салона</p>', '<p>В салон красоты \"Альбина\" требуется Парикмахер-универсал.</p>\r\n<p>Образование: среднее и выше<br />Необходимый стаж работы по специальности: от 2-х лет<br />Необходимые навыки: умение работать в коллективе, пунктуальность, вежливость</p>', '<p>• Обслуживание клиентов салона;<br />• Оказание всех видов парикмахерских услуг.</p>', '<p>Место работы: Зеленоград, корп. 418;<br />Режим работы: 2/2, с 9.00 до 21.00;<br />Заработная плата: сдельная заработная плата, 45% от выручки, ежедневные выплаты, косметика салона.</p>\r\n<p> </p>\r\n<p><strong>Контактное лицо:</strong> Александр Федорович</p>\r\n<p><strong>Телефон:</strong> 8 (916) 581 83 26</p>\r\n<p><strong>E-mail:</strong> Aleksandr_rm@mail.ru</p>', '', '0', '0', '', '', '', '2', '283', '*', '0', '0000-00-00 00:00:00', '479', '2020-07-29 12:15:12'),
('284', '15', 'Инженер КИПиА и СС', 'Инженер КИПиА и СС', 'Волхов', '0', '1970-01-01', '', '', '<p>Будет обсуждаться на собеседовании</p>', '<p>В крупную строительную компанию требуется специалист на позицию \"Инженер КИПиА и СС\".</p>\r\n<p>Образование: высшее<br />Необходимый стаж работы по специальности: от 5 лет<br />Необходимые навыки: <br />- уверенное понимание рабочей документации; <br />- чтение схем;<br />- работа по направлениям: АПТ, АТХ, АВК, АОВ, АТС, ПС, СС. <br />- коммуникабельность, организаторские способности, терпеливость, опыт управления людьми, работа в команде, энергичность, настойчивость, отзывчивость.<br />Знание иностранного языка: <br />ПК: уверенный пользователь Microsoft Office, желательно AutoCad, PDF Reader<br />Дополнительные требования: особый упор на направление АТХ.</p>', '<p>- Курирование по проведению СМР и ПНР подрядчиком на площадке строительства;<br />- Проверка выполненных подрядчиком строительно-монтажных и пуско-наладочных работ;<br />- Оперативное решение с проектной группой всех возникающих вопросов, касаемо рабочей документации;<br />- Ведение переговоров с представителями Заказчика, оперативное решение спорных вопросов, как с подрядчиком, так и с Заказчиком;<br />- Деловая переписка с Заказчиком.<br />- Проверка исполнительной документации, контроль на соответствие проектного и поставленного оборудования;<br />- Составление заявок на материалы и оборудование и отслеживание их по проработке в закупку;<br />- Планирование по производству работ;<br />- Отслеживание поставок заявленных материалов и оборудования;<br />- Проверка КС-форм, проверка ППР, технических карт, учет и ведение реестров монтируемого оборудования;<br />- Учет законченных ЭМР и подготовка необходимых данных для составления отчетности по объектам;<br />- Постоянное участие в обходах по площадкам строительства, комиссиях, совещаниях, проводимых Заказчиком;<br />- Ведение всей отчетности по производству ЭМР, КИПиА и слаботочным работам с предоставлением данных непосредственному руководителю;<br />- Составление графиков СМР и ПНР совместно с подрядчиком.<br />- Проверка на соответствие с рабочей документацией счетов на материалы и оборудование от поставщиков;<br />- Участие в освидетельствовании скрытых работ, проверка АОСР;<br />- Участие в ПНР, проверка составленных подрядчиком программ ПНР.</p>', '<p>Место работы: Ленинградская область, г. Волхов.<br />Заработная плата (размер и форма оплаты): будет обсуждаться на собеседовании.<br />Социальные льготы: проживание в отдельной квартире, аренда за работодателем. Фитнес центр на территории объекта.<br />Режим работы: 5/2, с 08:00 до 17:00.</p>', '', '0', '0', '', '', '', '2', '284', '*', '0', '0000-00-00 00:00:00', '479', '2020-08-20 15:40:58'),
('285', '18', 'Водитель-наполнитель', 'Водитель-наполнитель', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Условия:</p>\r\n<p>Заработная плата: 35000 рублей.<br />Режим работы: Пн-Пт; 8:00-17:00<br />Командировки: нет</p>\r\n<p>Место работы: Зеленоград, 2-й Западный проезд, дом 3, строение 9</p>', '<p>Дополнительные требования: наличие ДОПОГ.</p>\r\n<p>Образование: не ниже среднего</p>\r\n<p>Опыт работы: не менее 5 лет.</p>', '<p>Характер работы: Разъездная работа</p>', '<p>Должностные обязанность: Работа с газовыми баллонами, доставка газа клиентам</p>\r\n<p>Контактное лицо:</p>\r\n<p>Афанасьев Артем Андреевич</p>\r\n<p>Телефон: 89161083651</p>\r\n<p>E-mail: logika-krio@yandex.ru</p>', '', '0', '0', '', '', '', '2', '285', '*', '0', '0000-00-00 00:00:00', '479', '2020-08-21 17:10:58'),
('286', '2', 'Секретарь на ресепшн (фронт-деск менеджер)', 'Секретарь на ресепшн (фронт-деск менеджер)', 'Химки', '0', '1970-01-01', '', '', '<p>Заработная плата обсуждается индивидуально, по результатам собеседования</p>', '<p>В группу российских высокотехнологичных фармацевтических компаний требуется специалист на позицию Секретарь на ресепшн (фронт-деск менеджер).</p>\r\n<p>Образование: высшее<br />Опыт работы: желателен, но не обязателен<br />Необходимые навыки:<br />- Уровень владения английским языком - обязательно не ниже Intermediate (разговорный и письменный);<br />- Опытный пользователь ПК, знание MS Office, умение работать с оргтехникой;<br />- Коммуникабельность, ответственность, доброжелательность, внимательность, пунктуальность.</p>', '<p>- Секретариат (входящие звонки, факс);<br />- Обработка корреспонденции (прием, отправка, регистрация);<br />- Прием посетителей, заказ пропусков;<br />- Обеспечение жизнедеятельности ресепшн;<br />- Оперативное выполнение заданий руководителя;<br />- Работа с арендаторами - обеспечение внутреннего документооборота.</p>', '<p>Место работы: г. Химки, имеется бесплатный корпоративный транспорт от/до ж/д станции Химки.<br />График работы: 5/2, с 9:00 до 18:00.<br />Должностные командировки: возможны разовые поручения - поездки в Москву.<br />Трудоустройство по ТК РФ, оплачиваемый отпуск, \"белая\" заработная плата.<br />Есть перспективы карьерного роста в высокотехнологичной компании.<br />Заработная плата обсуждается индивидуально, по результатам собеседования.</p>', '', '0', '0', '', '', '', '2', '286', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-02 10:11:04'),
('287', '15', 'Инженер ПТО (производственно-технический отдел)', 'Инженер ПТО (производственно-технический отдел)', 'Москва', '0', '1970-01-01', '', '', '<p>от 100 000 руб.</p>', '<p>В компанию, которая занимается специальным строительством (предоставление услуг по нанесению защитных покрытий на металлоконструкции), требуется специалист на позицию Инженер ПТО.</p>\r\n<p>Опыт работы - от 3х лет на строительных и производственных объектах в области антикоррозийной защиты, огнезащиты, монтажа или изготовления металлоконструкций.<br />Опыт работы с AutoCAD, с исполнительной документацией, с чертежами.<br />Разработка и написание ППР (проектно-производственных работ), оформление приказов, инструкций, сдача работ.<br />Желательно наличие личного автотранспорта.</p>', '<p>- Оформление актов выполненных работ и исполнительной документации, контроль качества работ.<br />- Расчет объемов предполагаемых работ.<br />- Участие в разработке рабочей документации: разработка ППР, тех.регламентов, проектов выполнения работ, чертежей и т.п.<br />- Участие в разработке смет.</p>', '<p>Место работы: г. Москва, м. Проспект Вернадского.<br />Оформление по ТК РФ.<br />Постоянный график работы: с 9.00 - 18.00, 5 (6) дней в неделю.</p>', '', '0', '0', '', '', '', '2', '287', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-07 13:46:00'),
('288', '22', 'Менеджер отдела закупок', 'Менеджер отдела закупок', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Будет обсуждаться на собеседовании</p>', '<p>В зеленоградскую компанию, занимающуюся оптовой торговлей товарами для праздника, требуется \"Менеджер отдела закупок\".</p>\r\n<p>Образование: Высшее<br />Необходимый стаж работы по специальности: не менее 2 лет работы в качестве специалиста по импортным закупкам или ВЭД<br />Необходимые навыки: аналитические способности, ответственность, усидчивость, скрупулезность, обучаемость<br />Знание иностранного языка: хорошее знание английского языка (устно и письменно)<br />ПК: уверенный пользователь ПК, свободное владение программами Excel, Word</p>', '<p>• Осуществление закупок: планирование и формирование заказов, отслеживание сроков производства, доставки и задолженностей / платежей;<br />• Мониторинг рынка по своей группе товаров;<br />• Мониторинг и ведение поставщиков;<br />• Ведение в системе всех этапов закупки от формирования заказа до прихода товара;<br />• Ведение инфозаписи товара;<br />• Взаимодействие с ВЭД менеджерами по организации доставки товара и подготовка документов для таможенной очистки поставки;<br />• Взаимодействие с отделом продаж по новинкам и срокам поставки товара;<br />• Мониторинг запасов и продаж, формирование предложений по продвижению товара.</p>', '<p>Место работы: г. Зеленоград;<br />Заработная плата: будет обсуждаться на собеседовании;<br />Социальные льготы: в соответствии с ТК РФ, бесплатные обеды, доп. соц. пакет.;<br />Режим работы: 5/2, с 9.30 до 18.30;<br />Командировки: возможны;<br />Испытательный срок: 3 месяца.</p>', '', '0', '0', '', '', '', '2', '288', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-10 13:31:09'),
('290', '4', 'Руководитель/ менеджер направления по развитию финансовых продуктов и сервисов', 'Руководитель/ менеджер направления по развитию финансовых продуктов и сервисов', 'Москва', '0', '1970-01-01', '', '', '<p>Уровень заработной платы по договоренности в зависимости от опыта.</p>', '<p>В компанию, которая занимается развитием платежной системы требуется \"Руководитель/ менеджер направления по развитию финансовых продуктов и сервисов\".</p>\r\n<p>- Опыт создания и управления финансовым продуктом от 2 до 5 лет в платежных системах,<br />кредитных организациях;<br />- Опыт создания новых финансовых продуктов;<br />- Опыт ведения проектной работы в технической реализации программных продуктов;<br />- Опыт моделирования бизнес-процессов (карта бизнес-процессов, действия на уровне ролей,<br />описание бизнес-процессов);<br />- Способность грамотно расставлять приоритеты в работе, выбирать оптимальный вариант, решать проблемы с обоснованием;<br />- Наличие организационных и аналитических навыков, умение плодотворно взаимодействовать с командой разработки;<br />- Будет плюсом, если Вы владеете навыком построения бизнес-процессов с использованием MS<br />Visio; <br />- Хорошо ориентируетесь в нормативной базе, регулирующей банковскую деятельность и<br />деятельность платежных систем (161-ФЗ, 115-ФЗ, 54-ФЗ, 3085-1).</p>', '<p>1. Осуществлять разработку и запуск нового продукта с использованием электронных средств платежа (QR-технологии), а также расширение возможностей существующих продуктов (денежные переводы, мобильные сервисы, кошелек, карточные продукты, платежные сервисы);<br />2. Понимать потребности пользователей, собирать требования к продуктам, формировать цели продуктов и способы их достижения;<br />3. Анализировать рыночные возможности продукта, предлагать варианты в разработке стратегии введения нового продукта и непосредственное ведение проекта: выявление потребностей пользователей, сбор требований к продуктам, разработка/согласование бизнес-процессов, разработка внутренней нормативной документации т.д.;<br />4. Грамотно приоритизировать проблемы, задачи и уметь с обоснованием предлагать возможные решения;<br />5. Выполнять функции бизнес-заказчика для реализации IT-доработок по профилю продукта (подготовка бизнес-требований, взаимодействие с IT в процессе реализации);<br />6. Проводить анализ проделанной работы для оперативного принятия корректирующих или усиливающих мер с учетом рыночных возможностей продукта.</p>', '<p>- Оформление с соблюдением трудового законодательства;<br />- Уровень заработной платы по договоренности в зависимости от опыта;<br />- Возможности решения интересных проектов в области финтеха;<br />- Место работы в шаговой доступности от м. Серпуховская.</p>', '', '0', '0', '', '', '', '2', '290', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-22 12:26:24'),
('291', '14', 'Менеджер отдела продаж', 'Менеджер отдела продаж', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата (полностью белая): оклад + бонус за выполнение плана.</p>', '<p>В активно растущую высокотехнологичную компанию, один из лидеров рынка контрактного производства, требуется менеджер в отдел продаж.</p>\r\n<p>- Опыт в продажах услуг производственных предприятий, особенно в высокотехнологичных сферах. Таких как производство электроники, элементной базы, создание программного обеспечения и систем связи, консалтинговые услуги;<br />- Высокая ответственность за результаты своего труда;<br />- Коммуникабельность, знание технологий продаж, умение преподнести себя, умение составлять презентации под вновь возникающие задачи, умение планировать продажи и добиваться исполнение плана;<br />- Знание программы - 1С, пакет Microsoft Office и т.д;<br />- Желательно навыки работы со специализированным ПО - ALTIUM или PCAD, CAM viewer на уровне просмотра документов;<br />- Базовые знания английского языка;<br />- Желательно наличие автомобиля.</p>', '<p>- Привлечение новых клиентов;<br />- Расширение клиентской базы;<br />- Активные продажи;<br />- Поездки к клиентам;</p>', '<p>- Место работы: г. Зеленоград;<br />- График работы: с 9:00 до 18:00;<br />- Перерыв на обед 1 час;<br />- Заработная плата (полностью белая): оклад + бонус за выполнение плана;<br />- Испытательный срок: 3 месяца;<br />- Молодой коллектив;<br />- Постоянное повышение квалификации после прохождения испытательного срока.</p>', '', '0', '0', '', '', '', '2', '291', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-28 15:26:57'),
('292', '15', 'Кладовщик-комплектовщик', 'Кладовщик-комплектовщик', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата (полностью белая): оклад + бонус.</p>', '<p>В активно растущую высокотехнологичную компанию, один из лидеров рынка контрактного производства, требуется кладовщик-комплектовщик.</p>\r\n<p>Образование: среднее специальное и выше<br />Необходимый стаж работы по специальности: от 2 лет<br />Необходимые навыки: <br />- Знание электронной компонентной базы (ЭКБ);<br />- Знание основ приемки продукции;<br />- Знание процессов инвентаризации;<br />- Знание 1С;<br />- Педантичность, точность, внимательность, пунктуальность;<br />- Отсутствие вредных привычек.</p>', '<p>- Приемка продукции на склад, проведение входного контроля, отгрузка товаров;<br />- Обработка сопроводительных документов;<br />- Проведение инвентаризаций;<br />- Контроль и поддержание состояния склада в соответствии с требованиями;<br />- Взаимодействие с другими подразделениями компании;<br />- Соблюдение и знание нормативной документации, действующей в организации.</p>', '<p>- Место работы: г. Зеленоград;<br />- График работы: с 9:00 до 18:00 (перерыв на обед 1 час);<br />- Заработная плата (полностью белая): оклад + бонус.</p>', '', '0', '0', '', '', '', '2', '292', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-28 16:48:59'),
('293', '18', 'Водитель категории Е', 'Водитель категории Е', 'Зеленоград', '3', '1970-01-01', '', '', '<p>Выплата заработной платы производится 2 раза в месяц. Повременная 1000 руб. - каждый день + Сдельная 5 руб. / км.</p>', '<p>В стабильную транспортную компанию требуется водитель категории \"Е\" на автомобиль марки Volvo (тягач с полуприцепом 20 т., рефрижератор). Автомобили 2012 - 2019 гг. и новые. Компания организует перевозку грузов по всей России (на сегодняшний день до Урала).</p>\r\n<p>Необходимый стаж работы по специальности: от 5-ти лет<br />Необходимые навыки:<br />• Готовность открыть ИП;<br />• Водительское удостоверение категории Е;<br />• Опыт работы водителем-дальнобойщиком на междугородних перевозках от 5-ти лет;<br />• Опыт работы на рефрижераторах;<br />• Наличие медицинской книжки;<br />• Наличие карты водителя без СКЗИ (евро);<br />• Знание и опыт работы с транспортной документацией;<br />• Знание правил загрузки/выгрузки;<br />• Умение расчета нагрузки на ось грузового автомобиля с полуприцепом;<br />• Ответственное и бережное отношение к технике;<br />• Аккуратность, ответственность, честность, пунктуальность;<br />• Отсутствие судимостей.</p>', '<p>• Качественная и своевременная доставка грузов по маршрутам на территории РФ;<br />• Контроль размещения груза;<br />• Контроль загрузки/выгрузки;<br />• Доставка товара в строгом соответствии с указанным в маршрутном листе графиком доставки, а также соблюдение температурного режима при доставке;<br />• Поддержание автомобиля в технически исправном состоянии;<br />• Осуществление МЕЛКОГО ремонта, при возникновении неисправности в пути следования;<br />• Аккуратное вождение и соблюдение ПДД;<br />• За каждым водителем закреплен постоянный диспетчер для сопровождения на протяжении всего пути следования.</p>', '<p>Заработная плата (размер и форма оплаты): Выплата заработной платы производится 2 раза в месяц. Повременная 1000 руб. - каждый день + Сдельная 5 руб. / км.<br />Дополнительно: Компенсация налогов и бухгалтерского сопровождения связанных с предпринимательской деятельностью.<br />Режим работы: Вахтовый метод работы. Вахты 25/5.</p>', '', '0', '0', '', '', '', '2', '293', '*', '0', '0000-00-00 00:00:00', '479', '2020-09-29 17:12:53'),
('294', '10', 'Менеджер по продвижению и рекламе', 'Менеджер по продвижению и рекламе', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата по результатам собеседования.</p>', '<p>В научно-производственную компанию, которая занимается разработкой и производством РЭА и светотехническим оборудованием на основе светодиодов, требуется Менеджер по продвижению и рекламе.</p>\r\n<p>Образование: высшее (желательно техническое)<br />Необходимый стаж работы в релевантной должности: от 2х лет<br />Необходимые навыки/опыт:<br />• опыт работы и/или желание развиваться;<br />• хорошие коммуникативные навыки;<br />• умение грамотно вести деловую переписку;<br />• грамотная речь;<br />• готовность к командировкам;<br />• презентабельная внешность.</p>', '<p>• Участие в выставках и иные тематические мероприятиях, презентация компании;<br />• Создание текстов, редактирование текстов;<br />• Работа с сайтом (подготовка и публикация новостей, обновлении данных о продукции, ответы на обращения через сайт);<br />• Участие в создании сувенирной / полиграфической продукции, рекламных конструкций, взаимодействие с дизайнером;<br />• Помощь руководителям проектов;<br />• Участие в тендерах.</p>', '<p>Заработная плата по результатам собеседования;<br />Работа в соответствие с ТК РФ;<br />График работы: 5/2, с 09:00 до 18:00;<br />Командировки: 2 раза в год по неделе + редкие суточные командировки.</p>', '', '0', '0', '', '', '', '2', '294', '*', '0', '0000-00-00 00:00:00', '479', '2020-10-12 09:56:32'),
('295', '20', 'Менеджер по подбору персонала', 'Менеджер по подбору персонала', 'Зеленоград', '0', '1970-01-01', '', '', '<p>Заработная плата по результатам собеседования.</p>', '<p>В научно-производственную компанию требуется Менеджер по подбору персонала.</p>\r\n<p>Образование: высшее (желательно техническое)<br />Необходимый стаж работы в релевантной должности: от 2х лет<br />Необходимые навыки/опыт:<br />• опыт подбора технических специалистов;<br />• навыки работы с кадровой документацией;<br />• знание трудового законодательства и иных актов, содержащих нормы трудового права;<br />• знание законодательства РФ о персональных данных;<br />• хорошие коммуникативные навыки;<br />• организаторские способности;<br />• грамотная речь, умение грамотно вести деловую переписку.</p>', '<p>• Подбор и адаптация всего персонала организации:<br />- КБ (схемотехники, конструкторы, технические писатели, испытатели, ведущие и линейные специалисты);<br />- Производство (слесари, монтажники, регулировщики РЭА, мастера, рабочие производства);<br />- ОТК (контролеры входного, промежуточного и выходного контроля);<br />- Служба качества (инженер СМК);<br />- Снабжение и кооперация (специалисты по снабжению и кооперации);<br />- Склад (кладовщики, комплектовщики);<br />- Экономическая служба (экономисты);<br />- Секретариат (секретарь);<br />- Руководство (руководители и замы руководителей структурных подразделений).<br />• Ведение кадровой документации.</p>', '<p>Заработная плата по результатам собеседования;<br />Работа в соответствие с ТК РФ;<br />График работы: 5/2, с 09:00 до 18:00.</p>', '', '0', '0', '', '', '', '2', '295', '*', '0', '0000-00-00 00:00:00', '479', '2020-10-12 11:03:17'),
('296', '15', 'Инженер по оборудованию', 'Инженер по оборудованию', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>Обсуждается на собеседовании.</p>', '<p>В стабильную компанию по производству декоративной косметики, работающей на современном итальянском оборудовании, требуется инженер по оборудованию.</p>\r\n<p>Образование: высшее профессиональное (техническое) образование.<br />Необходимый стаж работы по специальности: от 5-ти лет.<br />Необходимые навыки: <br />- высшее техническое образование (уверенные знания в областях: механика, электрика, гидравлика);<br />- опыт эксплуатации и ремонта производственного оборудования;<br />- знание нормативных документов, регламентирующих производственно-хозяйственную деятельность предприятия;<br />- знание единой системы планово-предупредительного ремонта и рациональной эксплуатации технологического оборудования;<br />- наличие допуска по электробезопасности 4 группы;<br />- знания о порядке заключения договоров;<br />- ответственное и бережное отношение к технике;<br />- аккуратность, ответственность, пунктуальность.</p>', '<p>- ремонт и техническое обслуживание конвейерных линий;<br />- организация работ по наладке и ремонту всех видов производственного оборудования;<br />- разработка планов и графиков проведения наладочных и ремонтных работ оборудования;<br />- взаимодействие с подрядными сервисными и обслуживающими организациями;<br />- контроль качества ремонтных работ и расходования средств;<br />- учет и паспортизация оборудования, составление необходимой технической документации и ведение установленной отчетности;<br />- ведение технической документации;<br />- участие в подготовке заключений по проектам реконструкции и модернизации оборудования предприятия;<br />- участие в испытаниях и приемке производственного, механического и энергетического оборудования в промышленную эксплуатацию;<br />- заключение договоров со сторонними организациями на обслуживание и ремонт оборудования;<br />- подготовка заявок (и необходимых расчетов к ним) на приобретение запасных частей для оборудования;<br />- контроль проведения осмотров оборудования;<br />- осуществление руководства группой наладчиков (6 человек), контроль и оценка их работы;<br />- контроль за соблюдением обслуживающего персонала правил охраны труда и техники безопасности.</p>', '<p>Место работы: Московская обл., Солнечногорский р-н, д. Есипово;<br />Заработная плата (размер и форма оплаты): обсуждается на собеседовании, выплата заработной платы производится 2 раза в месяц;<br />Дополнительно: компенсация мобильной связи;<br />Режим работы: 5/2, выходные – суббота, воскресенье;<br />Командировки: есть.</p>', '', '0', '0', '', '', '', '2', '296', '*', '0', '0000-00-00 00:00:00', '479', '2020-10-15 12:49:15'),
('297', '5', 'Няня, помощница по хозяйству', 'Няня, помощница по хозяйству', 'Красногорск', '0', '1970-01-01', '', '', '<p>Обсуждается индивидуально.</p>', '<p>В семью требуется няня с функциями помощницы по хозяйству.</p>\r\n<p>Образование: высшее (педагогическое образование).<br />Необходимый стаж работы по специальности: от 5 лет.<br />Необходимые навыки:<br />• Опыт работы с детьми от года до школьного возраста;<br />• Опыт работы в дошкольных учреждениях приветствуется;<br />• Наличие рекомендаций с прежних мест работы;<br />• Вежливая, соблюдающая субординацию, активная, дружелюбная.</p>', '<p>• Развитие ребенка (ребёнку 1 год);<br />• Оперативная деятельность по поддержанию быта малыша (кормление, приготовление еды, мытье, прогулки и пр.);<br />• Помощь маме по хозяйству с поддерживающей функцией (когда надо приготовить еду, постирать, погладить, протереть полы). Отдельно есть приходящая уборщица.</p>', '<p>Место работы: Московская обл., г. Красногорск;<br />Заработная плата: обсуждается индивидуально;<br />Режим работы: 5/2 с проживанием на территории работодателя (из-за пандемии), суббота и воскресенье выходные;<br />Дополнительные условия: для проживания отводится отдельная комната и собственный санузел.</p>', '', '0', '0', '', '', '', '2', '297', '*', '0', '0000-00-00 00:00:00', '479', '2020-10-15 13:35:38'),
('298', '7', 'Системный администратор', 'Системный администратор', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>Оклад 40 000 руб. + премии по результатам работы.</p>', '<p>В компанию, которая занимается производством и поставками комплектующих для евроокон и дверей требуется \"Системный администратор\".</p>\r\n<p>Образование: среднее и выше<br />Необходимый стаж работы по специальности: от 2х лет.<br />Необходимые навыки:<br />• Опыт установки и поддержки ОС Windows (различных версий);<br />• Опыт установки и поддержки серверного программного обеспечения;<br />• Знание распространенного программного обеспечения (MS Office, 1С);<br />• Знание принципов работы сетевых протоколов, принципов построения компьютерных сетей;<br />• Знание аппаратной части ПК и возможность диагностики и устранения неполадок;<br />• Опыт работы с удаленными пользователями;<br />• Внимательность, ответственность, сосредоточенность, самостоятельность.</p>', '<p>• Комплектовка, установка и налаживание работы нового сервера;<br />• Участие в установке на новый сервер и наладка программы 1С Бухгалтерия Предприятия 8.3 (лицензия);<br />• Совмещение работы 1С с сайтами компании и программой ПрофСтрой 4;<br />• Создание надежной системы копирования и хранения данных 1С, базы данных клиентов и видеозаписи;<br />• Внедрение СРМО через 1С и IP-телефонию;<br />• Контроль и усиление работы интернета;<br />• Контроль и улучшение работы IP-телефонии и мобильной рабочей связи (мобильных рабочих телефонов);<br />• Наполнение (фотографии и текст) нового и старого сайта и интернет магазина;<br />• Добавление новых скринов на сайты и в интернет магазины;<br />• Улучшение и доработка сайтов интернет-магазинов;<br />• Улучшение работы компьютеров и всей оргтехники в офисе;<br />• Наладка видеонаблюдения в офисе, на складе и на территории компании;<br />• Подключение и налаживание удаленной работы сотрудников. Удаленная работа в 1С, на офисных компьютерах.</p>', '<p>Место работы: Московская область, д. Дурыкино (от Зеленограда ходит общественный транспорт, ехать около 20 минут. Офис находится в 100 метрах от Ленинградского шоссе);<br />Режим работы: 5/2, с 8.30 до 17.30;<br />Испытательный срок: 3 месяца;<br />Заработная плата: оклад 40 000 руб. + премии по результатам работы.</p>', '', '0', '0', '', '', '', '2', '298', '*', '0', '0000-00-00 00:00:00', '479', '2020-10-19 11:06:19'),
('300', '3', 'Бухгалтер по расчету заработной платы со знанием КДП', 'Бухгалтер по расчету заработной платы со знанием КДП', 'Солнечногорск', '0', '1970-01-01', '', '', '<p>Будет обсуждаться на собеседовании.</p>', '<p>В стабильную компанию по производству декоративной косметики, работающей на современном итальянском оборудовании, в Подмосковье требуется бухгалтер по расчету заработной платы со знанием КДП.</p>\r\n<p>Образование: высшее <br />Необходимый стаж работы по специальности: от 3х лет<br />Необходимые навыки: <br />- опыт работы бухгалтером по расчету заработной платы;<br />- знание кадрового учета;<br />- опыт работы на производстве;<br />- внимательность, аккуратность.<br />ПК: уверенный пользователь.</p>', '<p>- расчет заработной платы (220 сотрудников); <br />- ведение кадрового делопроизводства; <br />- ведение трудовых книжек, выдача справок.<br />Уровень подчинения (место в структуре): главному бухгалтеру.</p>', '<p>Место работы: Солнечногорский р-н, д. Есипово.<br />Имеется корпоративный транспорт, автобус ходит из Зеленограда (станция Крюково) и из Солнечногорска.<br />Режим работы: 5/2, с 8.30 до 17.00 (если добираться на корп. транспорте), с 9.00 до 17.30 (если добираться на личном автомобиле). <br />Оформление по ТК РФ.<br />Заработная плата (размер и форма оплаты): будет обсуждаться на собеседовании.</p>', '', '0', '0', '', '', '', '2', '300', '*', '0', '0000-00-00 00:00:00', '479', '2020-11-11 15:49:36');/**ABDB**/
